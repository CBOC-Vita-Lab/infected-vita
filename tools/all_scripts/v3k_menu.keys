# Vita3K: mission 1 with the DEFAULT settings, then the settings menu through the pad chord (SELECT+START held), options changed,
# the menu closed and the game played on. The pad script (pad.script, a CROSS every 100 flips) keeps the game going.
# Presses are held 1 s and spaced 1.5 s: the menu's ticks are slow in the emulator and a press is an edge.
waitlog 1700 flips=25[0-9][0-9][(]
wait 3
shot a_play_default_hd2x
# ---- opening 1: HD textures best available -> off
down select; down start; wait 2.5; up start; up select
wait 8
shot b1_menu_open
press right 1.0; wait 2
shot b2_menu_hd_off
press circle 1.0; wait 3
wait 30
shot c_play_hd_off
# ---- opening 2: HD textures off -> 2x pack
down select; down start; wait 2.5; up start; up select
wait 8
press right 1.0; wait 2
shot d1_menu_hd_2x
press circle 1.0; wait 3
wait 30
shot d2_play_hd_2x
# ---- opening 3: texture filter, mipmaps, anti-aliasing, pixel lighting, effects resolution; then show fps on the second page
down select; down start; wait 2.5; up start; up select
wait 8
press down 1.0; wait 1.5
press right 1.0; wait 1.5
press down 1.0; wait 1.5
press right 1.0; wait 1.5
press down 1.0; wait 1.5
press right 1.0; wait 1.5
press down 1.0; wait 1.5
press right 1.0; wait 1.5
press down 1.0; wait 1.5
press right 1.0; wait 1.5
shot e1_menu_options_changed
press r 1.0; wait 2
press down 1.0; wait 1.5
press right 1.0; wait 2
shot e2_menu_performance_fps_on
press l 1.0; wait 2
press circle 1.0; wait 3
wait 40
shot f_play_options_changed
wait 40
shot g_play_later
# ---- the way out: START+SELECT+L+R held
down select; down start; down l; down r; wait 4
up r; up l; up start; up select
wait 10
