+#include "iso_read_cache.hpp"
+
+#include <algorithm>
+#include <chrono>
+#include <cstring>
+#include <thread>
+
+namespace portablekit {
+namespace {
+
+IoThreadPlatform g_platform{};
+
+struct StdThread {
+    std::thread thread;
+};
+
+void *default_start(void (*fn)(void *), void *arg, const char *, int, int, std::size_t) {
+    auto *t = new StdThread;
+    t->thread = std::thread([fn, arg] { fn(arg); });
+    return t;
+}
+
+void default_join(void *handle) {
+    auto *t = static_cast<StdThread *>(handle);
+    if (t->thread.joinable()) t->thread.join();
+    delete t;
+}
+
+std::uint64_t now_us() {
+    return static_cast<std::uint64_t>(
+        std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+} // namespace
+
+void set_io_thread_platform(const IoThreadPlatform &platform) { g_platform = platform; }
+IoThreadPlatform io_thread_platform() { return g_platform; }
+
+IsoReadCache::IsoReadCache(std::unique_ptr<BlockSource> source, std::uint64_t size_bytes, const Config &config)
+    : source_(std::move(source)), config_(config), size_bytes_(size_bytes) {
+    capacity_blocks_ = std::max<std::size_t>(8u, config_.capacity_bytes / std::max<std::size_t>(config_.block_bytes, 1u));
+    if (!config_.worker) return;
+    platform_ = g_platform;
+    if (platform_.thread_start == nullptr || platform_.thread_join == nullptr) {
+        platform_.thread_start = &default_start;
+        platform_.thread_join = &default_join;
+    }
+    thread_ = platform_.thread_start(&IsoReadCache::worker_main, this, "iso-readahead", platform_.core, platform_.priority, 128u * 1024u);
+}
+
+IsoReadCache::~IsoReadCache() {
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        stop_ = true;
+    }
+    work_.notify_all();
+    changed_.notify_all();
+    if (thread_ != nullptr) platform_.thread_join(thread_);
+}
+
+void IsoReadCache::worker_main(void *self) { static_cast<IsoReadCache *>(self)->worker_loop(); }
+
+std::shared_ptr<const IsoReadCache::Block> IsoReadCache::load_block(std::uint64_t index, bool &failed) {
+    failed = false;
+    const std::uint64_t start = index * config_.block_bytes;
+    const std::size_t want = static_cast<std::size_t>(std::min<std::uint64_t>(config_.block_bytes, size_bytes_ - start));
+    auto block = std::make_shared<Block>();
+    block->data.resize(want);
+    std::lock_guard<std::mutex> source_lock(source_mutex_);
+    BlockSource::Result result = source_->read(start, block->data.data(), want);
+    if (result.error) {
+        // One more try after the source was opened again (the console may have slept or the card been re-seated).
+        bool reopened = source_->reopen();
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            ++stats_.reopens;
+        }
+        if (reopened) result = source_->read(start, block->data.data(), want);
+        if (!reopened || result.error) {
+            failed = true;
+            return nullptr;
+        }
+    }
+    block->data.resize(result.count);
+    return block;
+}
+
+void IsoReadCache::evict_locked() {
+    while (lru_.size() > capacity_blocks_) {
+        const std::uint64_t victim = lru_.back();
+        lru_.pop_back();
+        table_.erase(victim);
+    }
+}
+
+void IsoReadCache::publish_locked(std::uint64_t index, Entry &entry, std::shared_ptr<const Block> block) {
+    (void)index;
+    entry.block = std::move(block);
+    entry.state = State::Ready;
+    lru_.push_front(index);
+    entry.lru = lru_.begin();
+    evict_locked();
+}
+
+std::shared_ptr<const IsoReadCache::Block> IsoReadCache::acquire(std::uint64_t index) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    bool counted_wait = false;
+    for (;;) {
+        auto it = table_.find(index);
+        if (it != table_.end() && it->second.state == State::Ready) {
+            lru_.splice(lru_.begin(), lru_, it->second.lru);
+            if (!counted_wait) ++stats_.hits;
+            return it->second.block;
+        }
+        if (it != table_.end() && it->second.state == State::Loading) {
+            if (!counted_wait) {
+                ++stats_.waits;
+                counted_wait = true;
+            }
+            const std::uint64_t t0 = now_us();
+            changed_.wait(lock);
+            stats_.wait_us += now_us() - t0;
+            if (stop_ && table_.find(index) == table_.end()) break;
+            continue;
+        }
+        // Not there, or queued but not started: read it here and now.
+        if (it == table_.end()) it = table_.emplace(index, Entry{}).first;
+        it->second.state = State::Loading;
+        ++stats_.misses;
+        const std::uint64_t t0 = now_us();
+        lock.unlock();
+        bool failed = false;
+        std::shared_ptr<const Block> block = load_block(index, failed);
+        lock.lock();
+        stats_.wait_us += now_us() - t0;
+        it = table_.find(index);
+        if (it != table_.end()) {
+            if (failed) {
+                table_.erase(it);
+                ++stats_.errors;
+            } else {
+                publish_locked(index, it->second, block);
+            }
+        }
+        changed_.notify_all();
+        return failed ? nullptr : block;
+    }
+    return nullptr;
+}
+
+std::size_t IsoReadCache::read_direct(std::uint64_t offset, std::span<std::uint8_t> output) {
+    std::lock_guard<std::mutex> source_lock(source_mutex_);
+    BlockSource::Result result = source_->read(offset, output.data(), output.size());
+    if (result.error) {
+        const bool reopened = source_->reopen();
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            ++stats_.reopens;
+        }
+        if (reopened) result = source_->read(offset, output.data(), output.size());
+        if (!reopened || result.error) {
+            std::lock_guard<std::mutex> lock(mutex_);
+            ++stats_.errors;
+            return 0u;
+        }
+    }
+    return result.count;
+}
+
+void IsoReadCache::queue_range_locked(std::uint64_t first, std::uint64_t last) {
+    if (thread_ == nullptr) return;
+    bool added = false;
+    for (std::uint64_t b = first; b <= last; ++b) {
+        if (b * config_.block_bytes >= size_bytes_) break;
+        if (queue_.size() >= 64u || table_.size() >= capacity_blocks_ + 16u) break;
+        if (table_.count(b) != 0u) continue;
+        table_.emplace(b, Entry{});  // state Queued
+        queue_.push_back(b);
+        added = true;
+    }
+    if (added) work_.notify_one();
+}
+
+void IsoReadCache::note_stream(std::uint64_t offset, std::uint64_t length) {
+    if (thread_ == nullptr || length == 0u) return;
+    const std::uint64_t block = config_.block_bytes;
+    const std::uint64_t end = offset + length;
+    std::lock_guard<std::mutex> lock(mutex_);
+    Stream *match = nullptr;
+    Stream *oldest = &streams_[0];
+    for (Stream &s : streams_) {
+        if (s.used < oldest->used) oldest = &s;
+        if (s.used != 0u && offset + block >= s.next && offset <= s.next + block) {
+            match = &s;
+            break;
+        }
+    }
+    if (match == nullptr) {
+        match = oldest;
+        *match = Stream{};
+    } else {
+        ++match->streak;
+    }
+    match->next = end;
+    match->used = ++tick_;
+    if (match->streak < 1u) return;  // the first read of a new stream may be a single seek
+    const std::uint64_t first = (end + block - 1u) / block;
+    const std::uint64_t last = first + config_.ahead_blocks - 1u;
+    if (last + 1u > match->ahead_to / block || match->ahead_to < end) {
+        queue_range_locked(first, last);
+        match->ahead_to = (last + 1u) * block;
+    }
+}
+
+std::size_t IsoReadCache::read(std::uint64_t offset, std::span<std::uint8_t> output) {
+    if (offset >= size_bytes_ || output.empty()) return 0u;
+    const std::size_t count = static_cast<std::size_t>(std::min<std::uint64_t>(output.size(), size_bytes_ - offset));
+    std::size_t written = 0u;
+    if (count >= config_.bypass_bytes) {
+        written = read_direct(offset, output.first(count));
+        std::lock_guard<std::mutex> lock(mutex_);
+        ++stats_.bypassed;
+        stats_.bytes += written;
+        return written;
+    }
+    const std::uint64_t block = config_.block_bytes;
+    std::uint64_t position = offset;
+    const std::uint64_t end = offset + count;
+    while (position < end) {
+        const std::uint64_t index = position / block;
+        std::shared_ptr<const Block> data = acquire(index);
+        if (!data) break;
+        const std::uint64_t block_start = index * block;
+        const std::size_t within = static_cast<std::size_t>(position - block_start);
+        if (within >= data->data.size()) break;
+        const std::size_t want = static_cast<std::size_t>(std::min<std::uint64_t>(end - position, block - within));
+        const std::size_t have = std::min(want, data->data.size() - within);
+        std::memcpy(output.data() + written, data->data.data() + within, have);
+        written += have;
+        position += have;
+        if (have < want) break;  // the source holds less than the image said: a short read, as the file would give
+    }
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        stats_.bytes += written;
+    }
+    note_stream(offset, count);
+    return written;
+}
+
+void IsoReadCache::hint(std::uint64_t offset, std::uint64_t length) {
+    if (thread_ == nullptr || length == 0u || offset >= size_bytes_) return;
+    const std::uint64_t block = config_.block_bytes;
+    std::uint64_t last = (offset + length - 1u) / block;
+    const std::uint64_t first = offset / block;
+    last = std::min<std::uint64_t>(last, first + config_.hint_blocks_max - 1u);
+    std::lock_guard<std::mutex> lock(mutex_);
+    queue_range_locked(first, last);
+}
+
+bool IsoReadCache::reopen() {
+    std::lock_guard<std::mutex> source_lock(source_mutex_);
+    const bool ok = source_->reopen();
+    std::lock_guard<std::mutex> lock(mutex_);
+    ++stats_.reopens;
+    return ok;
+}
+
+IsoCacheStats IsoReadCache::stats() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return stats_;
+}
+
+std::size_t IsoReadCache::cached_blocks() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return lru_.size();
+}
+
+void IsoReadCache::drain() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    while (!stop_ && (!queue_.empty() || busy_ != 0u)) changed_.wait_for(lock, std::chrono::milliseconds(5));
+}
+
+void IsoReadCache::worker_loop() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    for (;;) {
+        work_.wait(lock, [this] { return stop_ || !queue_.empty(); });
+        if (stop_) return;
+        const std::uint64_t index = queue_.front();
+        queue_.pop_front();
+        auto it = table_.find(index);
+        if (it == table_.end() || it->second.state != State::Queued) {
+            changed_.notify_all();
+            continue;
+        }
+        it->second.state = State::Loading;
+        ++busy_;
+        lock.unlock();
+        bool failed = false;
+        std::shared_ptr<const Block> block = load_block(index, failed);
+        lock.lock();
+        --busy_;
+        it = table_.find(index);
+        if (it != table_.end()) {
+            if (failed) {
+                table_.erase(it);  // a reader will try again itself and report the error if it persists
+                ++stats_.errors;
+            } else {
+                publish_locked(index, it->second, block);
+                ++stats_.prefetched;
+            }
+        }
+        changed_.notify_all();
+    }
+}
+
+} // namespace portablekit
diff --git a/host/kernel/iso_read_cache.hpp b/host/kernel/iso_read_cache.hpp
new file mode 100644
index 0000000..a7cd248
--- /dev/null
+++ b/host/kernel/iso_read_cache.hpp
@@ -0,0 +1,140 @@
+#pragma once
+
+#include <condition_variable>
+#include <cstddef>
+#include <cstdint>
+#include <list>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <deque>
+#include <span>
+#include <vector>
+
+namespace portablekit {
+
+// Where the cache gets its bytes. One implementation reads a host file; the tests use a memory image that can fail on demand.
+// The cache calls a source from one thread at a time (it holds its own source mutex), so an implementation needs no locking.
+class BlockSource {
+public:
+    struct Result {
+        std::size_t count{};  // bytes delivered, which may be fewer than asked for
+        bool error{};         // the read failed (card removed, device asleep): a short count without an error is the end of the data
+    };
+    virtual ~BlockSource() = default;
+    virtual Result read(std::uint64_t offset, std::uint8_t *destination, std::size_t length) = 0;
+    // Opens the source again after an error or after the console slept. True when it can be read from now on.
+    virtual bool reopen() = 0;
+};
+
+// Starts and stops the read-ahead thread. The default is std::thread; the Vita build installs one that can name the core and the
+// priority (set_io_thread_platform), so that the worker runs on the system's core 3 when the application may use it.
+struct IoThreadPlatform {
+    void *(*thread_start)(void (*fn)(void *), void *arg, const char *name, int core, int priority, std::size_t stack_bytes) = nullptr;
+    void (*thread_join)(void *thread) = nullptr;
+    int core = -1;      // where the worker should run: -1 any, otherwise the platform's core number
+    int priority = 0;   // relative: positive is less urgent than the game thread
+};
+void set_io_thread_platform(const IoThreadPlatform &platform);
+[[nodiscard]] IoThreadPlatform io_thread_platform();
+
+struct IsoCacheStats {
+    std::uint64_t hits{};        // blocks a read found in the cache
+    std::uint64_t misses{};      // blocks a read had to read from the source itself
+    std::uint64_t waits{};       // blocks a read found being read by the worker and waited for
+    std::uint64_t prefetched{};  // blocks the worker read ahead
+    std::uint64_t bypassed{};    // large reads that skipped the cache
+    std::uint64_t errors{};      // reads that failed even after the source was opened again
+    std::uint64_t reopens{};     // times the source was opened again after an error
+    std::uint64_t bytes{};       // bytes handed to callers
+    std::uint64_t wait_us{};     // time callers spent waiting for the worker or reading a block
+};
+
+// A read cache in front of a read-only disc image: aligned blocks, least recently used out first, and a worker that reads blocks
+// ahead of a sequential reader or where the game said it will read. The data returned is always exactly what the source holds.
+class IsoReadCache {
+public:
+    struct Config {
+        std::size_t block_bytes = 64u * 1024u;       // a power of two
+        std::size_t capacity_bytes = 8u * 1024u * 1024u;
+        unsigned ahead_blocks = 4u;                  // how far a sequential reader is read ahead of
+        unsigned hint_blocks_max = 32u;              // the most one read-ahead hint of the game queues
+        std::size_t bypass_bytes = 1024u * 1024u;    // a read this large goes straight to the source
+        bool worker = true;                          // false: no thread and no read-ahead
+    };
+
+    IsoReadCache(std::unique_ptr<BlockSource> source, std::uint64_t size_bytes, const Config &config);
+    ~IsoReadCache();
+    IsoReadCache(const IsoReadCache &) = delete;
+    IsoReadCache &operator=(const IsoReadCache &) = delete;
+
+    // Reads up to output.size() bytes at an absolute offset; fewer only at the end of the data or when the source fails twice.
+    // Safe to call from any thread.
+    std::size_t read(std::uint64_t offset, std::span<std::uint8_t> output);
+    // The game said it will read this range soon (the UMD read-ahead command): queue it for the worker.
+    void hint(std::uint64_t offset, std::uint64_t length);
+    // Opens the source again (after the console woke from sleep). The cached blocks stay: the image does not change.
+    bool reopen();
+    [[nodiscard]] IsoCacheStats stats() const;
+    [[nodiscard]] bool worker_running() const noexcept { return thread_ != nullptr; }
+    [[nodiscard]] const Config &config() const noexcept { return config_; }
+    [[nodiscard]] std::size_t cached_blocks() const;
+    // Blocks until the worker has nothing queued or loading (tests, shutdown).
+    void drain();
+
+private:
+    enum class State { Queued, Loading, Ready };
+    struct Block {
+        std::vector<std::uint8_t> data;  // what the source delivered: less than a block at the end of the image
+    };
+    struct Entry {
+        State state{State::Queued};
+        std::shared_ptr<const Block> block;
+        std::list<std::uint64_t>::iterator lru;
+    };
+    struct Stream {
+        std::uint64_t next{};      // where this reader would read next
+        std::uint64_t ahead_to{};  // the end of what has been queued for it
+        unsigned streak{};
+        std::uint64_t used{};
+    };
+
+    // Loads one block from the source: one retry after the source was opened again. Null when it could not be read.
+    std::shared_ptr<const Block> load_block(std::uint64_t block_index, bool &failed);
+    std::shared_ptr<const Block> acquire(std::uint64_t block_index);
+    std::size_t read_direct(std::uint64_t offset, std::span<std::uint8_t> output);
+    void note_stream(std::uint64_t offset, std::uint64_t length);
+    void queue_range_locked(std::uint64_t first_block, std::uint64_t last_block);
+    void evict_locked();
+    void publish_locked(std::uint64_t block_index, Entry &entry, std::shared_ptr<const Block> block);
+    static void worker_main(void *self);
+    void worker_loop();
+
+    // The one mutex every read of the source goes through (ifstream is not thread safe, and the stdio layer under it is not either on
+    // the Vita). Lock order, for the Vita port's stdio lock (--wrap of fopen/fclose and the stdio writers, a recursive lock): this
+    // mutex may be held while a wrapped fopen/fclose (the source's reopen) takes the stdio lock, so the order is always
+    // source_mutex_ -> stdio lock. Nothing holds the stdio lock while calling into the cache (the wrapped functions call only libc),
+    // and reads (fread) are not wrapped, so the two cannot deadlock. mutex_ is taken after source_mutex_ (statistics) and never before it.
+    std::mutex source_mutex_;
+    std::unique_ptr<BlockSource> source_;
+
+    mutable std::mutex mutex_;                // the table, the LRU list, the queue and the statistics
+    std::condition_variable changed_;         // a block became Ready or was dropped
+    std::condition_variable work_;            // the worker has something to do
+    std::map<std::uint64_t, Entry> table_;
+    std::list<std::uint64_t> lru_;            // Ready blocks, most recently used first
+    std::deque<std::uint64_t> queue_;
+    Stream streams_[4];
+    std::uint64_t tick_{0};
+    unsigned busy_{0};                        // blocks the worker is reading
+    bool stop_{false};
+    IsoCacheStats stats_;
+
+    const Config config_;
+    const std::uint64_t size_bytes_;
+    std::size_t capacity_blocks_{};
+    void *thread_{nullptr};
+    IoThreadPlatform platform_;
+};
+
+} // namespace portablekit
