+// The cache's own handle on the image file.
+class FileSource final : public BlockSource {
+public:
+    explicit FileSource(std::filesystem::path path) : path_(std::move(path)), file_(path_, std::ios::binary) {}
+    Result read(std::uint64_t offset, std::uint8_t *destination, std::size_t length) override {
+        Result result;
+        if (!file_.is_open()) {
+            result.error = true;
+            return result;
+        }
+        file_.clear();
+        file_.seekg(static_cast<std::streamoff>(offset));
+        file_.read(reinterpret_cast<char *>(destination), static_cast<std::streamsize>(length));
+        result.count = static_cast<std::size_t>(file_.gcount());
+        // Fewer bytes with the end of the file reached is a short file; fewer without it is a failure of the device.
+        result.error = result.count < length && !file_.eof();
+        return result;
+    }
+    bool reopen() override {
+        file_.close();
+        file_.clear();
+        file_.open(path_, std::ios::binary);
+        return file_.is_open();
+    }
+
+private:
+    std::filesystem::path path_;
+    std::ifstream file_;
+};
+} // namespace
+
+bool iso_cache_stats(IsoCacheStats &out) {
+    const IsoReadCache *cache = g_cache.load(std::memory_order_acquire);
+    if (cache == nullptr) return false;
+    out = cache->stats();
+    return true;
+}
+
+void IsoImage::enable_cache(const IsoReadCache::Config &config) {
+    if (cache_ != nullptr) return;
+    cache_ = std::make_unique<IsoReadCache>(std::make_unique<FileSource>(path_), size_bytes_, config);
+    g_cache.store(cache_.get(), std::memory_order_release);
+    std::cout << "Disc: read cache on, " << config.capacity_bytes / (1024u * 1024u) << " MiB in blocks of "
+              << config.block_bytes / 1024u << " KiB, read-ahead " << config.ahead_blocks << " blocks, "
+              << (cache_->worker_running() ? "worker thread running" : "no worker thread") << "\n";
+}
+
+void IsoImage::prefetch(std::uint64_t offset, std::uint64_t length) {
+    if (cache_ != nullptr) cache_->hint(offset, length);
+}
+
+bool IsoImage::reopen() {
+    bool ok;
+    if (cache_ != nullptr) ok = cache_->reopen();
+    else ok = true;
+    file_.close();
+    file_.clear();
+    file_.open(path_, std::ios::binary);
+    return ok && file_.is_open();
+}
+
+bool IsoImage::cache_stats(IsoCacheStats &out) const {
+    if (cache_ == nullptr) return false;
+    out = cache_->stats();
+    return true;
+}
