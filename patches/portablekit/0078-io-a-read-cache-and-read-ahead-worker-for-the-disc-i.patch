diff --git a/tests/iso_read_cache_tests.cpp b/tests/iso_read_cache_tests.cpp
new file mode 100644
index 0000000..cee3f39
--- /dev/null
+++ b/tests/iso_read_cache_tests.cpp
@@ -0,0 +1,319 @@
+// The disc read cache and its read-ahead worker: byte-identical data against direct reads (random and concurrent), the end of
+// the image, a source that fails and is opened again, hints, eviction, and the cache under IsoImage on a synthetic ISO file.
+// No game and no disc: the images here are made from a counter.
+
+#include "kernel/iso_image.hpp"
+#include "kernel/iso_read_cache.hpp"
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <random>
+#include <thread>
+#include <vector>
+
+using namespace portablekit;
+
+namespace {
+
+int g_failures = 0;
+void check(bool condition, const char *what) {
+    std::printf("%s %s\n", condition ? "ok  " : "FAIL", what);
+    if (!condition) ++g_failures;
+}
+
+std::vector<std::uint8_t> make_image(std::size_t size, std::uint32_t seed) {
+    std::vector<std::uint8_t> data(size);
+    std::mt19937 rng(seed);
+    for (auto &b : data) b = static_cast<std::uint8_t>(rng());
+    return data;
+}
+
+// A memory image as a source. Faults: `fail_reads` reads fail (error), `reopen_ok` says whether reopening works,
+// `truncate_to` makes the source deliver less than the image size (a short file without an error).
+struct MemSource final : BlockSource {
+    struct Shared {
+        std::vector<std::uint8_t> data;
+        std::atomic<int> fail_reads{0};
+        std::atomic<bool> reopen_ok{true};
+        std::atomic<std::uint64_t> reads{0};
+        std::atomic<std::uint64_t> reopens{0};
+        std::atomic<int> delay_us{0};
+        std::size_t truncate_to{~static_cast<std::size_t>(0)};
+    };
+    std::shared_ptr<Shared> s;
+    explicit MemSource(std::shared_ptr<Shared> shared) : s(std::move(shared)) {}
+    Result read(std::uint64_t offset, std::uint8_t *dst, std::size_t length) override {
+        ++s->reads;
+        if (s->delay_us.load() > 0) std::this_thread::sleep_for(std::chrono::microseconds(s->delay_us.load()));
+        Result r;
+        if (s->fail_reads.load() > 0) {
+            --s->fail_reads;
+            r.error = true;
+            return r;
+        }
+        const std::size_t limit = std::min(s->data.size(), s->truncate_to);
+        if (offset < limit) r.count = std::min<std::size_t>(length, limit - static_cast<std::size_t>(offset));
+        if (r.count != 0u) std::memcpy(dst, s->data.data() + offset, r.count);
+        return r;
+    }
+    bool reopen() override {
+        ++s->reopens;
+        return s->reopen_ok.load();
+    }
+};
+
+std::shared_ptr<MemSource::Shared> shared_image(std::size_t size, std::uint32_t seed = 1u) {
+    auto s = std::make_shared<MemSource::Shared>();
+    s->data = make_image(size, seed);
+    return s;
+}
+
+IsoReadCache::Config small_config(bool worker) {
+    IsoReadCache::Config c;
+    c.block_bytes = 4096u;
+    c.capacity_bytes = 64u * 4096u;
+    c.ahead_blocks = 4u;
+    c.bypass_bytes = 256u * 1024u;
+    c.worker = worker;
+    return c;
+}
+
+bool same(const std::vector<std::uint8_t> &image, std::uint64_t offset, const std::vector<std::uint8_t> &got, std::size_t n) {
+    return offset + n <= image.size() && std::memcmp(image.data() + offset, got.data(), n) == 0;
+}
+
+void random_reads(bool worker) {
+    auto shared = shared_image(1000003u);   // not a multiple of the block size
+    IsoReadCache cache(std::make_unique<MemSource>(shared), shared->data.size(), small_config(worker));
+    std::mt19937_64 rng(7);
+    bool ok = true;
+    for (int i = 0; i < 4000 && ok; ++i) {
+        const std::uint64_t off = rng() % shared->data.size();
+        const std::size_t len = static_cast<std::size_t>(rng() % (i % 50 == 0 ? 400000u : 20000u));
+        std::vector<std::uint8_t> got(len);
+        const std::size_t n = cache.read(off, got);
+        const std::size_t want = static_cast<std::size_t>(std::min<std::uint64_t>(len, shared->data.size() - off));
+        ok = n == want && same(shared->data, off, got, n);
+    }
+    check(ok, worker ? "random reads equal direct reads (read-ahead on)" : "random reads equal direct reads (no worker)");
+    check(cache.stats().hits + cache.stats().misses > 0u && cache.cached_blocks() <= 64u, "the cache stays within its capacity");
+}
+
+void concurrent_reads() {
+    auto shared = shared_image(2u * 1024u * 1024u + 77u, 3u);
+    IsoReadCache cache(std::make_unique<MemSource>(shared), shared->data.size(), small_config(true));
+    std::atomic<int> bad{0};
+    std::vector<std::thread> threads;
+    for (int t = 0; t < 6; ++t) {
+        threads.emplace_back([&, t] {
+            std::mt19937_64 rng(100u + static_cast<unsigned>(t));
+            std::uint64_t seq = static_cast<std::uint64_t>(t) * 300000u;
+            for (int i = 0; i < 1500; ++i) {
+                std::uint64_t off;
+                std::size_t len = 1u + static_cast<std::size_t>(rng() % 9000u);
+                if (t % 2 == 0) {  // a sequential stream, which the worker reads ahead of
+                    off = seq;
+                    seq += len;
+                    if (seq >= shared->data.size()) seq = 0u;
+                } else {
+                    off = rng() % shared->data.size();
+                }
+                if (i % 97 == 0) cache.hint(rng() % shared->data.size(), 100000u);
+                std::vector<std::uint8_t> got(len);
+                const std::size_t n = cache.read(off, got);
+                const std::size_t want = static_cast<std::size_t>(std::min<std::uint64_t>(len, shared->data.size() - off));
+                if (n != want || !same(shared->data, off, got, n)) ++bad;
+            }
+        });
+    }
+    for (auto &th : threads) th.join();
+    check(bad.load() == 0, "six threads reading at once (sequential and random, with hints) get the file's bytes");
+    check(cache.stats().prefetched > 0u, "the worker read blocks ahead");
+}
+
+void end_and_short_reads() {
+    auto shared = shared_image(10000u);
+    IsoReadCache cache(std::make_unique<MemSource>(shared), shared->data.size(), small_config(true));
+    std::vector<std::uint8_t> got(5000);
+    check(cache.read(8000u, got) == 2000u && same(shared->data, 8000u, got, 2000u), "a read across the end gets what is left");
+    check(cache.read(10000u, got) == 0u && cache.read(99999u, got) == 0u, "a read at or past the end gets nothing");
+    check(cache.read(0u, std::span<std::uint8_t>{}) == 0u, "an empty read is empty");
+    std::vector<std::uint8_t> one(1);
+    check(cache.read(9999u, one) == 1u && one[0] == shared->data[9999], "the last byte is readable");
+
+    // The source holds less than the image said (a truncated copy on the card): the read is short, with no error.
+    auto cut = shared_image(20000u, 5u);
+    cut->truncate_to = 9000u;
+    IsoReadCache truncated(std::make_unique<MemSource>(cut), cut->data.size(), small_config(false));
+    std::vector<std::uint8_t> big(20000);
+    check(truncated.read(0u, big) == 9000u && same(cut->data, 0u, big, 9000u) && truncated.stats().errors == 0u,
+          "a truncated source gives a short read, not an error");
+}
+
+void error_and_reopen() {
+    auto shared = shared_image(300000u, 9u);
+    IsoReadCache cache(std::make_unique<MemSource>(shared), shared->data.size(), small_config(false));
+    std::vector<std::uint8_t> got(10000);
+    shared->fail_reads = 1;
+    check(cache.read(5000u, got) == 10000u && same(shared->data, 5000u, got, 10000u), "a failed read is retried after the source is opened again");
+    check(cache.stats().reopens >= 1u && cache.stats().errors == 0u && shared->reopens.load() >= 1u, "the retry is counted as a reopen, not an error");
+
+    shared->fail_reads = 1000;
+    shared->reopen_ok = false;
+    const std::size_t n = cache.read(120000u, got);
+    check(n == 0u && cache.stats().errors >= 1u, "when the source cannot be opened again the read fails short and counts an error");
+    shared->fail_reads = 0;
+    shared->reopen_ok = true;
+    check(cache.read(120000u, got) == 10000u && same(shared->data, 120000u, got, 10000u), "once the source is back the same read works (the failure was not cached)");
+
+    // Opened again from outside (the console woke from sleep): the cached blocks still serve, the source is read again.
+    const std::uint64_t before = shared->reopens.load();
+    check(cache.reopen() && shared->reopens.load() == before + 1u, "reopen() opens the source again");
+    check(cache.read(5000u, got) == 10000u && same(shared->data, 5000u, got, 10000u), "reads after a reopen are correct");
+
+    // A big read goes round the cache and gets the same retry.
+    std::vector<std::uint8_t> big(280000);
+    shared->fail_reads = 1;
+    check(cache.read(0u, big) == big.size() && same(shared->data, 0u, big, big.size()), "a read that bypasses the cache is retried too");
+}
+
+void worker_failure_is_not_fatal() {
+    auto shared = shared_image(400000u, 11u);
+    IsoReadCache cache(std::make_unique<MemSource>(shared), shared->data.size(), small_config(true));
+    shared->fail_reads = 1;
+    shared->reopen_ok = false;   // the worker's read fails for good: the block is dropped, not cached as bad
+    cache.hint(200000u, 8192u);
+    cache.drain();
+    shared->reopen_ok = true;
+    shared->fail_reads = 0;
+    std::vector<std::uint8_t> got(8192);
+    check(cache.read(200000u, got) == 8192u && same(shared->data, 200000u, got, 8192u), "a block the worker could not read is read by the caller");
+}
+
+void hints_and_ahead() {
+    auto shared = shared_image(1024u * 1024u, 13u);
+    IsoReadCache cache(std::make_unique<MemSource>(shared), shared->data.size(), small_config(true));
+    cache.hint(40960u, 16384u);   // four blocks
+    cache.drain();
+    const IsoCacheStats before = cache.stats();
+    std::vector<std::uint8_t> got(16384);
+    check(cache.read(40960u, got) == 16384u && same(shared->data, 40960u, got, 16384u), "a hinted range reads correctly");
+    const IsoCacheStats after = cache.stats();
+    check(before.prefetched >= 4u && after.misses == before.misses && after.hits >= before.hits + 4u, "a hinted range is served from the cache without a miss");
+
+    // A sequential reader finds the blocks after it already read.
+    shared->delay_us = 200;
+    std::vector<std::uint8_t> small(2048);
+    std::uint64_t off = 400000u;
+    for (int i = 0; i < 40; ++i) {
+        cache.read(off, small);
+        off += small.size();
+        if (i % 4 == 3) cache.drain();
+    }
+    const IsoCacheStats seq = cache.stats();
+    check(seq.prefetched > before.prefetched && seq.hits > after.hits, "a sequential reader is read ahead of");
+    shared->delay_us = 0;
+}
+
+void eviction() {
+    auto shared = shared_image(1024u * 1024u, 17u);
+    IsoReadCache::Config c = small_config(false);
+    c.capacity_bytes = 8u * c.block_bytes;
+    IsoReadCache cache(std::make_unique<MemSource>(shared), shared->data.size(), c);
+    std::vector<std::uint8_t> got(4096);
+    for (std::uint64_t b = 0; b < 40u; ++b) cache.read(b * 4096u, got);
+    check(cache.cached_blocks() == 8u, "the least recently used blocks are evicted at the capacity");
+    const std::uint64_t reads = shared->reads.load();
+    cache.read(39u * 4096u, got);
+    check(shared->reads.load() == reads, "the most recent block is still cached");
+    cache.read(0u, got);
+    check(shared->reads.load() == reads + 1u && same(shared->data, 0u, got, 4096u), "an evicted block is read again, with the same bytes");
+}
+
+// A minimal ISO 9660 image: the volume descriptor, a root directory with one file.
+std::vector<std::uint8_t> make_iso(std::size_t file_bytes, std::uint32_t &file_lba) {
+    constexpr std::size_t S = 2048u;
+    const std::uint32_t root_lba = 20u;
+    file_lba = 24u;
+    const std::size_t total = (file_lba * S) + ((file_bytes + S - 1u) / S) * S;
+    std::vector<std::uint8_t> iso(total, 0u);
+    auto le32 = [&](std::size_t at, std::uint32_t v) { for (int i = 0; i < 4; ++i) iso[at + i] = static_cast<std::uint8_t>(v >> (8 * i)); };
+    std::uint8_t *pvd = iso.data() + 16u * S;
+    pvd[0] = 1u;
+    std::memcpy(pvd + 1, "CD001", 5);
+    le32(16u * S + 156u + 2u, root_lba);
+    le32(16u * S + 156u + 10u, static_cast<std::uint32_t>(S));
+    const std::string name = "DATA.BIN;1";
+    std::uint8_t *rec = iso.data() + root_lba * S;
+    rec[0] = static_cast<std::uint8_t>(34u + name.size() + ((name.size() % 2u) == 0u ? 1u : 0u));
+    le32(root_lba * S + 2u, file_lba);
+    le32(root_lba * S + 10u, static_cast<std::uint32_t>(file_bytes));
+    rec[25] = 0u;
+    rec[32] = static_cast<std::uint8_t>(name.size());
+    std::memcpy(rec + 33, name.data(), name.size());
+    const auto payload = make_image(file_bytes, 21u);
+    std::memcpy(iso.data() + file_lba * S, payload.data(), payload.size());
+    return iso;
+}
+
+void iso_image_with_cache() {
+    std::uint32_t lba = 0u;
+    const std::size_t file_bytes = 3u * 1024u * 1024u + 123u;
+    const auto iso = make_iso(file_bytes, lba);
+    const auto path = std::filesystem::temp_directory_path() / "pk_iso_cache_test.iso";
+    { std::ofstream out(path, std::ios::binary); out.write(reinterpret_cast<const char *>(iso.data()), static_cast<std::streamsize>(iso.size())); }
+
+    IsoImage image(path);
+    const auto entry = image.find("DATA.BIN");
+    check(entry && entry->size == file_bytes, "the synthetic ISO is parsed");
+    if (!entry) return;
+    IsoReadCache::Config config;
+    config.capacity_bytes = 1024u * 1024u;
+    image.enable_cache(config);
+    check(image.cache_enabled(), "the cache is enabled");
+    const std::uint64_t base = static_cast<std::uint64_t>(entry->lba) * IsoImage::kSectorSize;
+    std::mt19937_64 rng(5);
+    bool ok = true;
+    for (int i = 0; i < 600 && ok; ++i) {
+        const std::uint64_t off = rng() % (iso.size() + 1000u);
+        std::vector<std::uint8_t> got(1u + rng() % 70000u);
+        const std::size_t n = image.read(off, got);
+        const std::size_t want = off >= iso.size() ? 0u : static_cast<std::size_t>(std::min<std::uint64_t>(got.size(), iso.size() - off));
+        ok = n == want && (n == 0u || std::memcmp(got.data(), iso.data() + off, n) == 0);
+        if (i % 50 == 0) image.prefetch(base + (rng() % file_bytes), 200000u);
+    }
+    check(ok, "IsoImage::read through the cache equals the file");
+    // A sequential walk of the whole file in 32 KiB reads.
+    std::vector<std::uint8_t> chunk(32768);
+    bool whole = true;
+    for (std::uint64_t off = 0; off < file_bytes; off += chunk.size()) {
+        const std::size_t n = image.read(base + off, chunk);
+        whole = whole && std::memcmp(chunk.data(), iso.data() + base + off, n) == 0 && n == std::min<std::size_t>(chunk.size(), iso.size() - static_cast<std::size_t>(base + off));
+    }
+    check(whole, "a sequential walk of the file is identical");
+    IsoCacheStats stats;
+    check(iso_cache_stats(stats) && stats.hits > 0u, "the statistics are reachable");
+    check(image.reopen(), "IsoImage::reopen() opens the file again");
+    check(image.read(base, chunk) == chunk.size() && std::memcmp(chunk.data(), iso.data() + base, chunk.size()) == 0, "reads work after the reopen");
+    std::filesystem::remove(path);
+}
+
+} // namespace
+
+int main() {
+    random_reads(false);
+    random_reads(true);
+    concurrent_reads();
+    end_and_short_reads();
+    error_and_reopen();
+    worker_failure_is_not_fatal();
+    hints_and_ahead();
+    eviction();
+    iso_image_with_cache();
+    if (g_failures != 0) std::printf("%d failed\n", g_failures);
+    return g_failures == 0 ? 0 : 1;
+}
