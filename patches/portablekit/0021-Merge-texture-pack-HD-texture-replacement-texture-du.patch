+class GlHdTextures {
+public:
+    GlHdTextures();
+    ~GlHdTextures();
+
+    // Sets the mode, the data root, the budget and the dump from the config; opens the pack of the mode.
+    void configure(const HdConfig &config);
+    // The renderer's glBindTexture with its cache, so the upload binds through it.
+    void set_binder(std::function<void(std::uint32_t)> bind) { bind_ = std::move(bind); }
+    // Switches the pack at run time. The renderer must drop every texture it holds (see tick).
+    void set_mode(HdMode mode);
+    [[nodiscard]] HdMode mode() const noexcept { return config_.mode; }
+    [[nodiscard]] bool has_pack() const noexcept { return pack_.is_open(); }
+    [[nodiscard]] std::uint32_t scale() const noexcept { return pack_.is_open() ? pack_.scale() : 1u; }
+    // Once per display list: re-reads the setting now and then; true when the mode changed since the last
+    // call, i.e. the renderer has to clear its texture cache so every texture is uploaded again.
+    bool tick(std::uint64_t frame);
+
+    // Whether the texture hook has anything to do (a pack is loaded or a dump is being written).
+    [[nodiscard]] bool active() const noexcept { return pack_.is_open() || dump_.active(); }
+    [[nodiscard]] bool dumping() const noexcept { return dump_.active(); }
+
+    // A texture is about to be uploaded: finds its replacement. True when `texture` now holds the replacement
+    // (with its mip chain); false when the caller uploads the original. `info` is the entry's.
+    bool upload(std::uint32_t texture, const GuestMemory &memory, const TextureState &state, HdTextureInfo &info);
+    // The entry is gone from the GPU.
+    void released(HdTextureInfo &info);
+    // A draw used the texture (texture dump metadata only).
+    void note_draw(const HdTextureInfo &info, const DrawCall &call);
+
+    [[nodiscard]] const HdStats &stats() const noexcept { return stats_; }
+    [[nodiscard]] std::string summary() const;
+    [[nodiscard]] const HdPackFile &pack() const noexcept { return pack_; }
+
+private:
+    void open_pack();
+    bool upload_blob(std::uint32_t texture, const HdRecord &record, const std::vector<std::uint8_t> &blob,
+                     std::uint64_t &gpu_bytes, std::uint8_t &levels);
+    // The texture's full key is not in the pack: looks for its image under the image key and rebuilds the
+    // replacement for the palette in use. True when `texture` holds it.
+    bool try_recolour(std::uint32_t texture, const GuestMemory &memory, const TextureState &state, HdTextureInfo &info);
+    bool admit(std::uint64_t needed_bytes);   // budget check with hysteresis; logs the first refusal
+
+    HdConfig config_;
+    HdPackFile pack_;
+    HdTextureDump dump_;
+    HdStats stats_;
+    std::function<void(std::uint32_t)> bind_;
+    bool s3tc_{true};
+    bool s3tc_known_{};
+    bool exhausted_{};          // the budget was spent: no replacements until memory is freed
+    bool logged_exhausted_{};
+    bool missing_logged_{};
+    bool mode_changed_{};
+    std::uint64_t last_poll_{};
+    std::uint64_t frame_{};
+    struct Thrash {
+        std::uint64_t window_start{};
+        std::uint32_t count{};
+        std::uint64_t refuse_until{};
+        bool logged{};
+    };
+    std::unordered_map<std::uint64_t, Thrash> thrash_;   // image key -> recolours in the current window
+    std::filesystem::file_time_type settings_time_{};
+    std::vector<std::uint8_t> blob_;
+    std::vector<std::uint32_t> decode_;
+    std::vector<std::uint32_t> recolour_base_, recolour_level_, recolour_mip_;
+    std::vector<std::uint8_t> level_;
+};
+
+} // namespace portablekit::gpu
