+#include <sstream>
+
+#define STB_IMAGE_WRITE_STATIC
+#define STB_IMAGE_WRITE_IMPLEMENTATION
+#include "stb_image_write.h"
+
+namespace portablekit::gpu {
+namespace {
+
+constexpr std::uint32_t kRecordBytes = 28u;
+constexpr std::uint32_t kHeaderBytes = 16u;
+
+std::uint32_t read32(const std::uint8_t *at) {
+    return static_cast<std::uint32_t>(at[0]) | static_cast<std::uint32_t>(at[1]) << 8u |
+           static_cast<std::uint32_t>(at[2]) << 16u | static_cast<std::uint32_t>(at[3]) << 24u;
+}
+std::uint64_t read64(const std::uint8_t *at) { return read32(at) | static_cast<std::uint64_t>(read32(at + 4)) << 32u; }
+std::uint16_t read16(const std::uint8_t *at) { return static_cast<std::uint16_t>(at[0] | at[1] << 8u); }
+
+void put32(std::vector<std::uint8_t> &out, std::uint32_t value) {
+    for (int i = 0; i < 4; ++i) out.push_back(static_cast<std::uint8_t>(value >> (8 * i)));
+}
+void put16(std::vector<std::uint8_t> &out, std::uint32_t value) {
+    out.push_back(static_cast<std::uint8_t>(value));
+    out.push_back(static_cast<std::uint8_t>(value >> 8u));
+}
+
+const char *format_name(TextureFormat format) {
+    switch (format) {
+    case TextureFormat::Rgba5650: return "rgb565";
+    case TextureFormat::Rgba5551: return "rgba5551";
+    case TextureFormat::Rgba4444: return "rgba4444";
+    case TextureFormat::Rgba8888: return "rgba8888";
+    case TextureFormat::Clut4: return "clut4";
+    case TextureFormat::Clut8: return "clut8";
+    case TextureFormat::Clut16: return "clut16";
+    case TextureFormat::Clut32: return "clut32";
+    case TextureFormat::Dxt1: return "dxt1";
+    case TextureFormat::Dxt3: return "dxt3";
+    case TextureFormat::Dxt5: return "dxt5";
+    }
+    return "?";
+}
+
+const char *clut_format_name(std::uint32_t format) {
+    switch (format) {
+    case 0u: return "rgb565";
+    case 1u: return "rgba5551";
+    case 2u: return "rgba4444";
+    default: return "rgba8888";
+    }
+}
+
+std::string hex_key(std::uint64_t key) {
+    char text[17];
+    std::snprintf(text, sizeof text, "%016llx", static_cast<unsigned long long>(key));
+    return text;
+}
+
+std::string trim(std::string text) {
+    const auto not_space = [](unsigned char c) { return !std::isspace(c); };
+    text.erase(text.begin(), std::find_if(text.begin(), text.end(), not_space));
+    text.erase(std::find_if(text.rbegin(), text.rend(), not_space).base(), text.end());
+    return text;
+}
+
+const char *env_any(const char *name) {
+    if (const char *value = portablekit::env(name); value != nullptr && *value != '\0') return value;
+    const std::string full = std::string("INFECTED_") + name;
+    if (const char *value = std::getenv(full.c_str()); value != nullptr && *value != '\0') return value;
+    return nullptr;
+}
+
+} // namespace
+
+std::uint32_t hd_level_bytes(HdFormat format, std::uint32_t width, std::uint32_t height) {
+    width = std::max(width, 1u);
+    height = std::max(height, 1u);
+    switch (format) {
+    case HdFormat::Dxt1: return ((width + 3u) / 4u) * ((height + 3u) / 4u) * 8u;
+    case HdFormat::Dxt5: return ((width + 3u) / 4u) * ((height + 3u) / 4u) * 16u;
+    default: return width * height * 4u;
+    }
+}
+
+std::uint32_t hd_chain_bytes(HdFormat format, std::uint32_t width, std::uint32_t height, std::uint32_t levels) {
+    std::uint32_t total = 0u;
+    for (std::uint32_t level = 0; level < levels; ++level) {
+        total += hd_level_bytes(format, width, height);
+        width = std::max(width / 2u, 1u);
+        height = std::max(height / 2u, 1u);
+    }
+    return total;
+}
+
+// ---- the pack file -----------------------------------------------------------------------------
+
+HdPackFile::~HdPackFile() { close(); }
+
+void HdPackFile::close() {
+    if (file_ != nullptr) std::fclose(file_);
+    file_ = nullptr;
+    keys_.clear();
+    keys_.shrink_to_fit();
+    scale_ = 0u;
+    recolour_records_ = 0u;
+}
+
+bool HdPackFile::open(const std::filesystem::path &path, std::string &error) {
+    close();
+    file_ = std::fopen(path.string().c_str(), "rb");
+    if (file_ == nullptr) {
+        error = "cannot open " + path.string();
+        return false;
+    }
+    std::fseek(file_, 0, SEEK_END);
+    file_size_ = static_cast<std::uint64_t>(std::ftell(file_));
+    std::fseek(file_, 0, SEEK_SET);
+    std::uint8_t header[kHeaderBytes];
+    if (std::fread(header, 1, sizeof header, file_) != sizeof header || std::memcmp(header, "IFTP", 4) != 0 ||
+        read32(header + 4) != 1u) {
+        error = path.string() + " is not an IFTP version 1 texture pack";
+        close();
+        return false;
+    }
+    const std::uint32_t count = read32(header + 8);
+    scale_ = read32(header + 12);
+    index_offset_ = kHeaderBytes;
+    if (index_offset_ + static_cast<std::uint64_t>(count) * kRecordBytes > file_size_) {
+        error = path.string() + ": the index runs past the end of the file";
+        close();
+        return false;
+    }
+    // Only the keys stay in RAM: read the index in blocks.
+    keys_.reserve(count);
+    std::vector<std::uint8_t> block(kRecordBytes * 2048u);
+    std::uint32_t done = 0u;
+    bool sorted = true;
+    while (done < count) {
+        const std::uint32_t n = std::min<std::uint32_t>(count - done, 2048u);
+        if (std::fread(block.data(), kRecordBytes, n, file_) != n) {
+            error = path.string() + ": short read in the index";
+            close();
+            return false;
+        }
+        for (std::uint32_t i = 0; i < n; ++i) {
+            const std::uint64_t key = read64(block.data() + i * kRecordBytes);
+            if (!keys_.empty() && key <= keys_.back()) sorted = false;
+            keys_.push_back(key);
+            if ((read16(block.data() + i * kRecordBytes + 26u) & kHdFlagRecolour) != 0u) ++recolour_records_;
+        }
+        done += n;
+    }
+    bytes_read_ += static_cast<std::uint64_t>(count) * kRecordBytes + kHeaderBytes;
+    if (!sorted) {
+        error = path.string() + ": the index is not sorted by key";
+        close();
+        return false;
+    }
+    return true;
+}
+
+bool HdPackFile::find(std::uint64_t key, HdRecord &record) {
+    if (file_ == nullptr) return false;
+    const auto at = std::lower_bound(keys_.begin(), keys_.end(), key);
+    if (at == keys_.end() || *at != key) return false;
+    const std::uint64_t position = static_cast<std::uint64_t>(at - keys_.begin());
+    std::uint8_t raw[kRecordBytes];
+    if (std::fseek(file_, static_cast<long>(index_offset_ + position * kRecordBytes), SEEK_SET) != 0 ||
+        std::fread(raw, 1, sizeof raw, file_) != sizeof raw)
+        return false;
+    bytes_read_ += sizeof raw;
+    record.key = read64(raw);
+    record.offset = read64(raw + 8);
+    record.size = read32(raw + 16);
+    record.width = read16(raw + 20);
+    record.height = read16(raw + 22);
+    record.format = static_cast<HdFormat>(raw[24]);
+    record.mip_count = raw[25];
+    record.flags = read16(raw + 26);
+    return record.key == key && record.offset + record.size <= file_size_ && record.mip_count != 0u;
+}
+
+bool HdPackFile::read_blob(const HdRecord &record, std::vector<std::uint8_t> &out) {
+    if (file_ == nullptr) return false;
+    out.resize(record.size);
+    if (std::fseek(file_, static_cast<long>(record.offset), SEEK_SET) != 0 ||
+        std::fread(out.data(), 1, record.size, file_) != record.size)
+        return false;
+    bytes_read_ += record.size;
+    return true;
+}
+
+// ---- recolour records ----------------------------------------------------------------------------
+
+bool hd_unpackbits(const std::uint8_t *in, std::size_t in_size, std::uint8_t *out, std::size_t out_size) {
+    std::size_t i = 0u, o = 0u;
+    while (i < in_size && o < out_size) {
+        const std::uint8_t n = in[i++];
+        if (n < 128u) {  // n + 1 literal bytes
+            const std::size_t count = static_cast<std::size_t>(n) + 1u;
+            if (i + count > in_size || o + count > out_size) return false;
+            std::memcpy(out + o, in + i, count);
+            i += count;
+            o += count;
+        } else if (n > 128u) {  // the next byte, 257 - n times
+            const std::size_t count = 257u - n;
+            if (i >= in_size || o + count > out_size) return false;
+            std::memset(out + o, in[i++], count);
+            o += count;
+        }
+    }
+    return o == out_size && i == in_size;
+}
+
+bool hd_parse_recolour(const HdRecord &record, const std::vector<std::uint8_t> &blob, HdRecolour &out) {
+    if (blob.size() < 8u) return false;
+    const std::uint32_t entries = read16(blob.data());
+    const std::uint32_t encoding = read16(blob.data() + 2);
+    const std::uint32_t encoded = read32(blob.data() + 4);
+    if (entries == 0u || entries > 256u) return false;
+    const std::size_t pixels = static_cast<std::size_t>(record.width) * record.height;
+    const std::size_t palette_at = 8u, map_at = palette_at + entries * 4u, base_at = map_at + encoded;
+    if (base_at > blob.size() || pixels == 0u) return false;
+    if (blob.size() - base_at < hd_level_bytes(record.format, record.width, record.height)) return false;
+    out.palette_entries = entries;
+    out.base_palette.resize(entries);
+    for (std::uint32_t i = 0; i < entries; ++i) out.base_palette[i] = read32(blob.data() + palette_at + i * 4u);
+    out.index_map.resize(pixels);
+    if (encoding == 0u) {
+        if (encoded != pixels) return false;
+        std::memcpy(out.index_map.data(), blob.data() + map_at, pixels);
+    } else if (encoding == 1u) {
+        if (!hd_unpackbits(blob.data() + map_at, encoded, out.index_map.data(), pixels)) return false;
+    } else {
+        return false;
+    }
+    for (const std::uint8_t index : out.index_map)
+        if (index >= entries) return false;
+    out.base_offset = base_at;
+    return true;
+}
+
+void hd_apply_recolour(const HdRecolour &recolour, const std::uint32_t *base_rgba, const std::uint32_t *new_palette,
+                       std::uint32_t *out_rgba) {
+    // The change of each palette entry, per channel; a pixel moves by the change of the entry it belongs to.
+    std::int16_t delta[256][4];
+    for (std::uint32_t i = 0; i < recolour.palette_entries; ++i)
+        for (std::uint32_t c = 0; c < 4u; ++c)
+            delta[i][c] = static_cast<std::int16_t>(static_cast<int>((new_palette[i] >> (8u * c)) & 0xFFu) -
+                                                    static_cast<int>((recolour.base_palette[i] >> (8u * c)) & 0xFFu));
+    const std::size_t pixels = recolour.index_map.size();
+    for (std::size_t p = 0; p < pixels; ++p) {
+        const std::int16_t *d = delta[recolour.index_map[p]];
+        const std::uint32_t v = base_rgba[p];
+        std::uint32_t result = 0u;
+        for (std::uint32_t c = 0; c < 4u; ++c) {
+            const int value = static_cast<int>((v >> (8u * c)) & 0xFFu) + d[c];
+            result |= static_cast<std::uint32_t>(value < 0 ? 0 : (value > 255 ? 255 : value)) << (8u * c);
+        }
+        out_rgba[p] = result;
+    }
+}
+
+// ---- settings ----------------------------------------------------------------------------------
+
+const char *hd_mode_name(HdMode mode) {
+    switch (mode) {
+    case HdMode::X2: return "2x";
+    case HdMode::X4: return "4x";
+    default: return "off";
+    }
+}
+
+bool hd_parse_mode(const std::string &text, HdMode &mode) {
+    if (text == "off" || text == "0" || text == "false") mode = HdMode::Off;
+    else if (text == "2x" || text == "2") mode = HdMode::X2;
+    else if (text == "4x" || text == "4") mode = HdMode::X4;
+    else return false;
+    return true;
+}
+
+std::filesystem::path hd_data_root() {
+    if (const char *dir = env_any("DATA_DIR")) return dir;
+    return std::filesystem::current_path();
+}
+
+HdMode hd_textures_setting(const std::filesystem::path &data_root) {
+    // This function is the one place gfx.hd_textures is read; the port settings header replaces its body.
+    HdMode mode = HdMode::Off;
+    if (const char *text = env_any("HD_TEXTURES")) {
+        if (hd_parse_mode(text, mode)) return mode;
+        std::cerr << "[hdtex] " << text << " is not off, 2x or 4x\n";
+    }
+    std::ifstream settings(data_root / "settings.txt");
+    std::string line;
+    while (std::getline(settings, line)) {
+        const std::size_t eq = line.find('=');
+        if (eq == std::string::npos || trim(line.substr(0, eq)) != "gfx.hd_textures") continue;
+        const std::string value = trim(line.substr(eq + 1));
+        if (hd_parse_mode(value, mode)) return mode;
+        break;  // "auto" or a word we do not know: the default below
+    }
+    // Default: the best pack present.
+    std::error_code ignored;
+    if (std::filesystem::exists(data_root / "texpack_4x.bin", ignored)) return HdMode::X4;
+    if (std::filesystem::exists(data_root / "texpack_2x.bin", ignored)) return HdMode::X2;
+    return HdMode::Off;
+}
+
+HdConfig hd_config_from_environment() {
+    HdConfig config;
+    config.data_root = hd_data_root();
+    config.mode = hd_textures_setting(config.data_root);
+    if (const char *text = env_any("HD_BUDGET_MB")) config.budget_bytes = std::strtoull(text, nullptr, 10) * 1024ull * 1024ull;
+    if (const char *text = env_any("TEX_DUMP")) config.dump_dir = text;
+    config.dump_raw = env_any("TEX_DUMP_RAW") != nullptr;
+    return config;
+}
+
+// ---- the dump ----------------------------------------------------------------------------------
+
+void HdTextureDump::open(const std::filesystem::path &directory, bool raw) {
+    directory_ = directory;
+    raw_ = raw;
+    std::error_code ignored;
+    std::filesystem::create_directories(directory_, ignored);
+    active_ = !directory.empty();
+    // A dump directory that already holds textures: they are known, not written again.
+    if (active_) {
+        for (const auto &entry : std::filesystem::directory_iterator(directory_, ignored)) {
+            const std::string name = entry.path().filename().string();
+            if (name.size() == 21u && name.compare(16, 5, ".json") == 0)
+                seen_.insert(std::strtoull(name.substr(0, 16).c_str(), nullptr, 16));
+        }
+    }
+}
+
+void HdTextureDump::texture(std::uint64_t key, const TextureState &state, const std::uint8_t *texels,
+                            std::size_t texel_bytes, const std::uint8_t *clut, std::size_t clut_bytes,
+                            const std::vector<std::uint32_t> &rgba) {
+    if (!active_ || key == 0u || !seen_.insert(key).second) return;
+    Meta meta;
+    meta.state = state;
+    meta.image_key = texture_image_key(state, texels);
+    std::size_t zero = 0, opaque = 0;
+    for (const std::uint32_t texel : rgba) {
+        const std::uint32_t alpha = texel >> 24u;
+        if (alpha == 0u) ++zero;
+        else if (alpha == 255u) ++opaque;
+    }
+    const double total = rgba.empty() ? 1.0 : static_cast<double>(rgba.size());
+    meta.zero = static_cast<double>(zero) / total;
+    meta.opaque = static_cast<double>(opaque) / total;
+    meta.partial = 1.0 - meta.zero - meta.opaque;
+    const std::string stem = (directory_ / hex_key(key)).string();
+    if (!rgba.empty())
+        stbi_write_png((stem + ".png").c_str(), state.width, state.height, 4, rgba.data(), static_cast<int>(state.width) * 4);
+    if (raw_ && texels != nullptr) {
+        std::vector<std::uint8_t> out;
+        out.insert(out.end(), {'I', 'F', 'R', 'W'});
+        put32(out, 1u);
+        out.push_back(static_cast<std::uint8_t>(state.format));
+        out.push_back(static_cast<std::uint8_t>(state.clut_format));
+        out.push_back(state.swizzled ? 1u : 0u);
+        out.push_back(0u);
+        put16(out, state.width);
+        put16(out, state.height);
+        put16(out, state.buffer_width);
+        put16(out, state.clut_shift);
+        put16(out, state.clut_mask);
+        put16(out, state.clut_offset);
+        put32(out, static_cast<std::uint32_t>(texel_bytes));
+        put32(out, static_cast<std::uint32_t>(clut_bytes));
+        out.insert(out.end(), texels, texels + texel_bytes);
+        if (clut != nullptr) out.insert(out.end(), clut, clut + clut_bytes);
+        std::ofstream file(stem + ".raw", std::ios::binary);
+        file.write(reinterpret_cast<const char *>(out.data()), static_cast<std::streamsize>(out.size()));
+    }
+    write_json(key, meta);
+    meta_.emplace(key, std::move(meta));
+}
+
+void HdTextureDump::draw(std::uint64_t key, const HdDrawInfo &info) {
+    if (!active_) return;
+    const auto found = meta_.find(key);
+    if (found == meta_.end()) return;
+    Meta &meta = found->second;
+    bool changed = false;
+    const char *kind = info.through ? "through" : "3d";
+    if (meta.first_draw.empty()) {
+        meta.first_draw = kind;
+        changed = true;
+    }
+    (info.through ? meta.used_through : meta.used_3d) = true;
+    const std::uint32_t wrap = info.wrap_s | info.wrap_t << 8u | (info.through ? 1u : 0u) << 16u;
+    changed |= meta.wraps.insert(wrap).second;
+    const std::uint32_t filter = info.min_filter | info.mag_filter << 8u | (info.through ? 1u : 0u) << 16u;
+    changed |= meta.filters.insert(filter).second;
+    changed |= meta.functions.insert(info.function | (info.alpha_from_texture ? 0x100u : 0u)).second;
+    if (info.alpha_test && !meta.alpha_test) meta.alpha_test = changed = true;
+    if (info.blend && !meta.blend) meta.blend = changed = true;
+    if (changed) write_json(key, meta);
+}
+
+void HdTextureDump::write_json(std::uint64_t key, const Meta &meta) {
+    const TextureState &s = meta.state;
+    std::ostringstream out;
+    out << "{\n";
+    out << "  \"key\": \"" << hex_key(key) << "\",\n";
+    if (meta.image_key != 0u) out << "  \"image_key\": \"" << hex_key(meta.image_key) << "\",\n";
+    out << "  \"width\": " << s.width << ",\n  \"height\": " << s.height << ",\n";
+    out << "  \"buffer_width\": " << s.buffer_width << ",\n";
+    out << "  \"format\": \"" << format_name(s.format) << "\",\n";
+    out << "  \"swizzled\": " << (s.swizzled ? "true" : "false") << ",\n";
+    out << "  \"clut_format\": " << (s.format >= TextureFormat::Clut4 && s.format <= TextureFormat::Clut32
+                                         ? std::string("\"") + clut_format_name(s.clut_format) + "\""
+                                         : std::string("null")) << ",\n";
+    out << "  \"clut_shift\": " << s.clut_shift << ", \"clut_mask\": " << s.clut_mask << ", \"clut_start\": " << s.clut_offset << ",\n";
+    out << "  \"alpha\": {\"zero\": " << meta.zero << ", \"opaque\": " << meta.opaque << ", \"partial\": " << meta.partial
+        << ", \"cutout\": " << ((meta.partial < 0.001 && meta.zero > 0.0005) ? "true" : "false") << "},\n";
+    out << "  \"first_draw\": \"" << meta.first_draw << "\",\n";
+    out << "  \"used_through\": " << (meta.used_through ? "true" : "false")
+        << ", \"used_3d\": " << (meta.used_3d ? "true" : "false") << ",\n";
+    out << "  \"alpha_test\": " << (meta.alpha_test ? "true" : "false") << ", \"blend\": " << (meta.blend ? "true" : "false") << ",\n";
+    out << "  \"wrap\": [";
+    bool first = true;
+    for (const std::uint32_t wrap : meta.wraps) {
+        out << (first ? "" : ", ") << "{\"s\": \"" << ((wrap & 0xFFu) != 0u ? "clamp" : "repeat") << "\", \"t\": \""
+            << (((wrap >> 8u) & 0xFFu) != 0u ? "clamp" : "repeat") << "\", \"through\": " << (((wrap >> 16u) & 1u) != 0u ? "true" : "false") << "}";
+        first = false;
+    }
+    out << "],\n  \"filter\": [";
+    first = true;
+    for (const std::uint32_t filter : meta.filters) {
+        out << (first ? "" : ", ") << "{\"min\": " << (filter & 0xFFu) << ", \"mag\": " << ((filter >> 8u) & 0xFFu)
+            << ", \"through\": " << (((filter >> 16u) & 1u) != 0u ? "true" : "false") << "}";
+        first = false;
+    }
+    out << "],\n  \"texture_function\": [";
+    first = true;
+    for (const std::uint32_t function : meta.functions) {
+        out << (first ? "" : ", ") << "{\"tfx\": " << (function & 0xFFu) << ", \"tcc\": " << (((function >> 8u) & 1u) != 0u ? 1 : 0) << "}";
+        first = false;
+    }
+    out << "]\n}\n";
+    std::ofstream file(directory_ / (hex_key(key) + ".json"));
+    file << out.str();
+}
+
+} // namespace portablekit::gpu
