+#pragma once
+
+#include "ge_state.hpp"
+
+#include <cstdint>
+#include <cstdio>
+#include <filesystem>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+// HD texture packs for a renderer that replaces whole textures by key
+// (docs/ARCHITECTURE.md section 7): texpack_2x.bin / texpack_4x.bin, a sorted
+// index of replacement keys (texture_key.hpp) and one blob per texture holding
+// its mip chain, DXT1, DXT5 or RGBA8.
+//
+// Nothing here touches a graphics API. The GL side, which uploads a blob, is
+// gl/gl_hd_textures.hpp. The pack is read from one file; only the keys of the
+// index stay in RAM (8 bytes per texture), a record and its blob are read
+// the first time a texture is seen.
+//
+//   file (little endian):
+//     "IFTP"  u32 version=1  u32 count  u32 scale
+//     count x { u64 key  u64 offset  u32 size  u16 width  u16 height
+//               u8 format (0 RGBA8, 1 DXT1, 2 DXT5)  u8 mip_count  u16 reserved }   sorted by key
+//     blobs: offset is absolute in the file, size bytes, the mip chain largest first, each level
+//            tightly packed: RGBA8 w*h*4 bytes, DXT max(1,(w+3)/4)*max(1,(h+3)/4) blocks of 8 or 16 bytes.
+//
+//   reserved = flags. Bit 0 (kHdFlagRecolour) marks a recolour record: its key is the image key
+//   (texture_image_key, the texels without the palette) and its blob is
+//        u16 palette_entries (16 or 256)  u16 encoding (0 raw, 1 PackBits)  u32 encoded_bytes
+//        palette_entries x RGBA8        the palette the picture was upscaled with
+//        encoded index map              width*height bytes: the palette index each upscaled pixel belongs to
+//        level 0 of the colour picture  in the record's format (mip_count is 1)
+//   The renderer rebuilds the picture for the palette the game uses now: pixel + new[index] - old[index].
+namespace portablekit::gpu {
+
+enum class HdMode : std::uint8_t { Off = 0, X2 = 2, X4 = 4 };
+
+enum class HdFormat : std::uint8_t { Rgba8 = 0, Dxt1 = 1, Dxt5 = 2 };
+
+constexpr std::uint16_t kHdFlagRecolour = 1u;
+
+struct HdRecord {
+    std::uint64_t key{};
+    std::uint64_t offset{};
+    std::uint32_t size{};
+    std::uint16_t width{};
+    std::uint16_t height{};
+    HdFormat format{HdFormat::Rgba8};
+    std::uint8_t mip_count{};
+    std::uint16_t flags{};
+};
+
+// Bytes of one mip level of the given size and format.
+[[nodiscard]] std::uint32_t hd_level_bytes(HdFormat format, std::uint32_t width, std::uint32_t height);
+// Bytes of a whole chain of `levels` levels starting at width x height (each level half the one before, at least 1).
+[[nodiscard]] std::uint32_t hd_chain_bytes(HdFormat format, std::uint32_t width, std::uint32_t height,
+                                           std::uint32_t levels);
+
+class HdPackFile {
+public:
+    HdPackFile() = default;
+    ~HdPackFile();
+    HdPackFile(const HdPackFile &) = delete;
+    HdPackFile &operator=(const HdPackFile &) = delete;
+
+    bool open(const std::filesystem::path &path, std::string &error);
+    void close();
+    [[nodiscard]] bool is_open() const noexcept { return file_ != nullptr; }
+    [[nodiscard]] std::uint32_t scale() const noexcept { return scale_; }
+    [[nodiscard]] std::uint32_t count() const noexcept { return static_cast<std::uint32_t>(keys_.size()); }
+    // Bytes the index occupies in RAM.
+    [[nodiscard]] std::size_t index_ram_bytes() const noexcept { return keys_.capacity() * sizeof(std::uint64_t); }
+    [[nodiscard]] std::uint64_t file_bytes() const noexcept { return file_size_; }
+    // Whether the pack has recolour records (looked up by image key after a miss of the full key).
+    [[nodiscard]] std::uint32_t recolour_count() const noexcept { return recolour_records_; }
+    // Binary search over the keys in RAM; on a hit the record is read from the file.
+    [[nodiscard]] bool find(std::uint64_t key, HdRecord &record);
+    // The blob of a record.
+    bool read_blob(const HdRecord &record, std::vector<std::uint8_t> &out);
+    [[nodiscard]] std::uint64_t bytes_read() const noexcept { return bytes_read_; }
+
+private:
+    std::FILE *file_{};
+    std::uint32_t scale_{};
+    std::uint64_t index_offset_{};
+    std::uint64_t file_size_{};
+    std::uint64_t bytes_read_{};
+    std::uint32_t recolour_records_{};
+    std::vector<std::uint64_t> keys_;
+};
+
+// ---- recolour records -------------------------------------------------------------------------
+
+struct HdRecolour {
+    std::uint32_t palette_entries{};
+    std::vector<std::uint32_t> base_palette;  // the palette of the stored picture, RGBA bytes (red in the low byte)
+    std::vector<std::uint8_t> index_map;      // record.width * record.height palette indices
+    std::size_t base_offset{};                // offset of the colour picture (level 0) in the blob
+};
+
+// Parses a recolour blob; false when it is malformed.
+[[nodiscard]] bool hd_parse_recolour(const HdRecord &record, const std::vector<std::uint8_t> &blob, HdRecolour &out);
+// out = clamp(base + new_palette[index] - base_palette[index]) per channel, for width*height pixels.
+// `new_palette` has at least palette_entries colours.
+void hd_apply_recolour(const HdRecolour &recolour, const std::uint32_t *base_rgba, const std::uint32_t *new_palette,
+                       std::uint32_t *out_rgba);
+// PackBits decoder used by the index map (false when the data does not decode to exactly out_size bytes).
+[[nodiscard]] bool hd_unpackbits(const std::uint8_t *in, std::size_t in_size, std::uint8_t *out, std::size_t out_size);
+
+// ---- settings ---------------------------------------------------------------------------------
+
+// Everything the HD texture code takes from outside, from one place.
+struct HdConfig {
+    HdMode mode{HdMode::Off};
+    std::filesystem::path data_root;   // where texpack_<n>x.bin lives
+    std::uint64_t budget_bytes{64ull * 1024ull * 1024ull};  // GPU memory the replacements may use
+    std::filesystem::path dump_dir;    // INFECTED_TEX_DUMP: write every distinct texture seen, empty for none
+    bool dump_raw{};                   // also write <key>.raw (state, texel bytes, palette) for the pack tools
+    bool log{true};
+};
+
+// THE place gfx.hd_textures is read from. Until host/settings/port_settings.hpp lands this looks at
+// <PREFIX>_HD_TEXTURES (off|2x|4x) and then at settings.txt in the data root; replace the body by a
+// lookup in the port settings header. `auto_best` is what the setting's default means: the largest
+// pack present in the data root.
+[[nodiscard]] HdMode hd_textures_setting(const std::filesystem::path &data_root);
+// The port data root ($<PREFIX>_DATA_DIR).
+[[nodiscard]] std::filesystem::path hd_data_root();
+// Mode, data root, budget (<PREFIX>_HD_BUDGET_MB), dump directory (<PREFIX>_TEX_DUMP) from the environment and settings.txt.
+[[nodiscard]] HdConfig hd_config_from_environment();
+[[nodiscard]] const char *hd_mode_name(HdMode mode);
+[[nodiscard]] bool hd_parse_mode(const std::string &text, HdMode &mode);
+
+// ---- counters ---------------------------------------------------------------------------------
+
+struct HdStats {
+    std::uint64_t keyed{};             // textures a key was computed for (once per texture upload)
+    std::uint64_t key_failed{};        // textures that could not be keyed
+    std::uint64_t hits{};              // keys found in the pack and uploaded
+    std::uint64_t misses{};            // keys not in the pack (the original is used)
+    std::uint64_t skipped_budget{};    // hits not replaced because the budget was spent
+    std::uint64_t upload_failed{};     // blobs that could not be read or uploaded
+    std::uint64_t key_ns{};            // time computing keys
+    std::uint64_t lookup_ns{};         // time searching the index and reading records
+    std::uint64_t upload_ns{};         // time reading blobs and uploading them
+    std::uint64_t blob_bytes{};        // bytes read from the pack
+    std::uint64_t resident_textures{}; // replaced textures on the GPU now
+    std::uint64_t resident_bytes{};    // their GPU bytes
+    std::uint64_t peak_bytes{};
+    std::uint64_t flushes{};           // times the mode changed and everything was reloaded
+    std::uint64_t not_replaceable{};   // render-target copies (8888): skipped without a key
+    std::uint64_t recolour_hits{};     // textures rebuilt from a recolour record (image key found, palette differs)
+    std::uint64_t recolour_refused{};  // recolours not done because the texture's palette kept changing
+    std::uint64_t recolour_ns{};       // time rebuilding recoloured pictures (decode, palette transfer, mips)
+};
+
+// ---- the texture dump --------------------------------------------------------------------------
+
+// What is known about a draw that uses a texture, for the dump's metadata.
+struct HdDrawInfo {
+    bool through{};
+    std::uint32_t wrap_s{}, wrap_t{};
+    std::uint32_t min_filter{}, mag_filter{};
+    std::uint32_t function{};
+    bool alpha_from_texture{};
+    bool alpha_test{};
+    bool blend{};
+};
+
+// INFECTED_TEX_DUMP=<dir>: every distinct texture (by replacement key) as <key>.png (the renderer's own
+// RGBA decode) and <key>.json (sizes, formats, palette mapping, alpha statistics, how it was drawn),
+// and with raw on <key>.raw. It is a development tool and the way to harvest textures from live play.
+class HdTextureDump {
+public:
+    void open(const std::filesystem::path &directory, bool raw);
+    [[nodiscard]] bool active() const noexcept { return active_; }
+    [[nodiscard]] bool known(std::uint64_t key) const { return seen_.count(key) != 0u; }
+    // The texture the renderer decoded (RGBA, red in the low byte), keyed. Writes the files the first time.
+    void texture(std::uint64_t key, const TextureState &state, const std::uint8_t *texels, std::size_t texel_bytes,
+                 const std::uint8_t *clut, std::size_t clut_bytes, const std::vector<std::uint32_t> &rgba);
+    // A draw that uses the texture; rewrites the JSON when it adds something new.
+    void draw(std::uint64_t key, const HdDrawInfo &info);
+    [[nodiscard]] std::size_t distinct() const noexcept { return seen_.size(); }
+
+private:
+    struct Meta {
+        TextureState state;
+        std::uint64_t image_key{};
+        double zero{}, opaque{}, partial{};
+        bool used_through{}, used_3d{};
+        std::string first_draw;  // "through", "3d" or "" until drawn
+        std::unordered_set<std::uint32_t> wraps;  // wrap_s | wrap_t << 8 | draw kind << 16
+        bool alpha_test{}, blend{};
+        std::unordered_set<std::uint32_t> filters;
+        std::unordered_set<std::uint32_t> functions;
+    };
+    void write_json(std::uint64_t key, const Meta &meta);
+    bool active_{};
+    bool raw_{};
+    std::filesystem::path directory_;
+    std::unordered_set<std::uint64_t> seen_;
+    std::unordered_map<std::uint64_t, Meta> meta_;
+};
+
+} // namespace portablekit::gpu
diff --git a/host/gpu/texture_key.cpp b/host/gpu/texture_key.cpp
new file mode 100644
index 0000000..c9ddc75
--- /dev/null
+++ b/host/gpu/texture_key.cpp
@@ -0,0 +1,164 @@
+#include "texture_key.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <vector>
+
+#define XXH_INLINE_ALL
+#include "xxhash/xxhash.h"
+
+namespace portablekit::gpu {
+namespace {
+
+std::uint32_t bits_per_texel(TextureFormat format) {
+    switch (format) {
+    case TextureFormat::Clut4: return 4u;
+    case TextureFormat::Clut8: return 8u;
+    case TextureFormat::Rgba5650:
+    case TextureFormat::Rgba5551:
+    case TextureFormat::Rgba4444:
+    case TextureFormat::Clut16: return 16u;
+    case TextureFormat::Rgba8888:
+    case TextureFormat::Clut32: return 32u;
+    default: return 0u;
+    }
+}
+
+// How many index values the format produces (the palette is read once for each).
+std::uint32_t index_count(TextureFormat format) {
+    switch (format) {
+    case TextureFormat::Clut4: return 16u;
+    case TextureFormat::Clut8: return 256u;
+    default: return 65536u;  // CLUT16 and CLUT32: every value the GE's 8-bit mask can tell apart, generously
+    }
+}
+
+std::uint32_t clut_entry_bytes(const TextureState &texture) { return texture.clut_format == 3u ? 4u : 2u; }
+
+// The palette entry an index value reads (what texture_decode's read_clut computes).
+std::uint32_t clut_entry(const TextureState &texture, std::uint32_t index) {
+    return ((index >> std::min(texture.clut_shift, 31u)) & texture.clut_mask) | (texture.clut_offset << 4u);
+}
+
+void put16(std::uint8_t *at, std::uint32_t value) {
+    at[0] = static_cast<std::uint8_t>(value);
+    at[1] = static_cast<std::uint8_t>(value >> 8u);
+}
+
+} // namespace
+
+bool texture_is_indexed(TextureFormat format) {
+    return format == TextureFormat::Clut4 || format == TextureFormat::Clut8 || format == TextureFormat::Clut16 ||
+           format == TextureFormat::Clut32;
+}
+
+std::uint32_t texture_stored_bytes(const TextureState &texture) {
+    const std::uint32_t width = texture.width, height = texture.height;
+    if (width == 0u || height == 0u || width > 1024u || height > 1024u) return 0u;
+    switch (texture.format) {
+    case TextureFormat::Dxt1: return ((width + 3u) / 4u) * ((height + 3u) / 4u) * 8u;
+    case TextureFormat::Dxt3:
+    case TextureFormat::Dxt5: return ((width + 3u) / 4u) * ((height + 3u) / 4u) * 16u;
+    default: break;
+    }
+    const std::uint32_t bits = bits_per_texel(texture.format);
+    if (bits == 0u) return 0u;
+    const std::uint32_t stride = texture.buffer_width != 0u ? texture.buffer_width : width;
+    return stride * bits / 8u * height;
+}
+
+std::uint32_t texture_clut_bytes_needed(const TextureState &texture) {
+    if (!texture_is_indexed(texture.format)) return 0u;
+    std::uint32_t highest = 0u;
+    const std::uint32_t count = index_count(texture.format);
+    for (std::uint32_t index = 0; index < count; ++index) highest = std::max(highest, clut_entry(texture, index));
+    return std::min(highest + 1u, 512u) * clut_entry_bytes(texture);
+}
+
+std::uint64_t texture_replacement_key(const TextureState &texture, const std::uint8_t *texels,
+                                      const std::uint8_t *clut, std::size_t clut_bytes) {
+    const std::uint32_t stored = texture_stored_bytes(texture);
+    if (stored == 0u || texels == nullptr) return 0u;
+    const bool indexed = texture_is_indexed(texture.format);
+
+    std::array<std::uint8_t, 16> header{};
+    header[0] = 'I';
+    header[1] = 'F';
+    header[2] = 'K';
+    header[3] = static_cast<std::uint8_t>(kTextureKeyVersion);
+    header[4] = static_cast<std::uint8_t>(texture.format);
+    header[5] = indexed ? static_cast<std::uint8_t>(texture.clut_format) : 0xFFu;
+    header[6] = texture.swizzled ? 1u : 0u;
+    put16(&header[8], texture.width);
+    put16(&header[10], texture.height);
+    put16(&header[12], texture.buffer_width != 0u && texture.buffer_width != texture.width ? texture.buffer_width : 0u);
+
+    std::uint64_t key = XXH3_64bits_withSeed(header.data(), header.size(), 0u);
+    key = XXH3_64bits_withSeed(texels, stored, key);
+
+    if (indexed) {
+        const std::uint32_t entry_bytes = clut_entry_bytes(texture);
+        const std::uint32_t count = index_count(texture.format);
+        if (clut == nullptr || clut_bytes < texture_clut_bytes_needed(texture)) return 0u;
+        // The palette in index order. The common sizes stay on the stack.
+        std::array<std::uint8_t, 256u * 4u> small;
+        std::vector<std::uint8_t> large;
+        std::uint8_t *out = small.data();
+        if (count > 256u) {
+            large.resize(static_cast<std::size_t>(count) * entry_bytes);
+            out = large.data();
+        }
+        if (entry_bytes == 2u) {
+            for (std::uint32_t index = 0; index < count; ++index)
+                std::memcpy(out + index * 2u, clut + clut_entry(texture, index) * 2u, 2u);
+        } else {
+            for (std::uint32_t index = 0; index < count; ++index)
+                std::memcpy(out + index * 4u, clut + clut_entry(texture, index) * 4u, 4u);
+        }
+        key = XXH3_64bits_withSeed(out, static_cast<std::size_t>(count) * entry_bytes, key);
+    }
+    return key != 0u ? key : 1u;
+}
+
+std::uint64_t texture_image_key(const TextureState &texture, const std::uint8_t *texels) {
+    const std::uint32_t stored = texture_stored_bytes(texture);
+    if (stored == 0u || texels == nullptr || !texture_is_indexed(texture.format)) return 0u;
+    std::array<std::uint8_t, 16> header{};
+    header[0] = 'I';
+    header[1] = 'F';
+    header[2] = 'I';
+    header[3] = static_cast<std::uint8_t>(kTextureKeyVersion);
+    header[4] = static_cast<std::uint8_t>(texture.format);
+    header[5] = 0xFFu;
+    header[6] = texture.swizzled ? 1u : 0u;
+    put16(&header[8], texture.width);
+    put16(&header[10], texture.height);
+    put16(&header[12], texture.buffer_width != 0u && texture.buffer_width != texture.width ? texture.buffer_width : 0u);
+    std::uint64_t key = XXH3_64bits_withSeed(header.data(), header.size(), 0u);
+    key = XXH3_64bits_withSeed(texels, stored, key);
+    return key != 0u ? key : 1u;
+}
+
+std::uint64_t texture_image_key(const GuestMemory &memory, const TextureState &texture) {
+    const std::uint32_t stored = texture_stored_bytes(texture);
+    if (stored == 0u || !texture_is_indexed(texture.format)) return 0u;
+    return texture_image_key(texture, memory.raw_pointer(texture.address, stored));
+}
+
+std::uint64_t texture_replacement_key(const GuestMemory &memory, const TextureState &texture) {
+    const std::uint32_t stored = texture_stored_bytes(texture);
+    if (stored == 0u) return 0u;
+    const std::uint8_t *texels = memory.raw_pointer(texture.address, stored);
+    if (texels == nullptr) return 0u;
+    const std::uint8_t *clut = nullptr;
+    std::size_t clut_bytes = 0u;
+    if (texture_is_indexed(texture.format)) {
+        clut_bytes = texture_clut_bytes_needed(texture);
+        clut = memory.raw_pointer(texture.clut_address, clut_bytes);
+        if (clut == nullptr) return 0u;
+    }
+    return texture_replacement_key(texture, texels, clut, clut_bytes);
+}
+
+} // namespace portablekit::gpu
diff --git a/host/gpu/texture_key.hpp b/host/gpu/texture_key.hpp
new file mode 100644
index 0000000..73af0c1
--- /dev/null
+++ b/host/gpu/texture_key.hpp
@@ -0,0 +1,64 @@
+#pragma once
+
+#include "ge_state.hpp"
+
+#include <cstddef>
+#include <cstdint>
+
+// The replacement key: the identity under which a texture pack stores the
+// replacement of one texture image (docs/ARCHITECTURE.md section 7).
+//
+// It is a 64-bit hash of what the GE would sample, and of nothing else:
+//
+//   * the texel bytes as the GE addresses them: the stored layout (swizzled or
+//     linear) of buffer_width x height texels, or the blocks of a block format;
+//   * the palette as the texture sees it, for the indexed formats: for every
+//     index value the format can produce (16 for CLUT4, 256 for CLUT8), in
+//     index order, the stored bytes of the entry ((index >> shift) & mask) |
+//     start << 4. So a palette is identified by its contents and by how the
+//     draw maps indices onto it, not by where in CLUT memory it was loaded, and
+//     two palettes of one image give two keys;
+//   * the pixel format, the CLUT entry format, the width, the height, the
+//     buffer width when it differs from the width, and the swizzle flag.
+//
+// The address of the texture or of the palette, the texture function, the
+// filtering and wrap modes, and the host (byte order, SIMD, GL) do not enter.
+// The hash is XXH3-64 (platform independent by its specification), chained over
+// a small header, the texel bytes and the palette bytes.
+//
+// The renderer computes it once per texture cache entry, when the texture is
+// first uploaded or found changed, never per draw. The pack tools call the same
+// function (the raw-pointer form) on the rasters they extract from the disc.
+namespace portablekit::gpu {
+
+constexpr std::uint32_t kTextureKeyVersion = 1u;
+
+// How many bytes of texel data the GE reads for this texture (its stored size),
+// 0 for a texture the key cannot describe (zero or oversized dimensions).
+[[nodiscard]] std::uint32_t texture_stored_bytes(const TextureState &texture);
+
+// True for the formats that read a palette.
+[[nodiscard]] bool texture_is_indexed(TextureFormat format);
+
+// Bytes of palette memory, counted from the palette's first entry, that must be
+// readable to key this texture (0 for a direct-colour or block texture).
+[[nodiscard]] std::uint32_t texture_clut_bytes_needed(const TextureState &texture);
+
+// The key from the bytes. `texels` points at texture_stored_bytes(texture) bytes,
+// `clut` at the palette's entry 0 with `clut_bytes` readable (at least
+// texture_clut_bytes_needed). Returns 0 when the texture cannot be keyed.
+[[nodiscard]] std::uint64_t texture_replacement_key(const TextureState &texture, const std::uint8_t *texels,
+                                                     const std::uint8_t *clut, std::size_t clut_bytes);
+
+// The same from guest memory (0 when the texels or the palette are not readable).
+[[nodiscard]] std::uint64_t texture_replacement_key(const GuestMemory &memory, const TextureState &texture);
+
+// The image key of an indexed texture: the same hash without the palette (texel bytes, pixel format, width,
+// height, buffer width, swizzle). A game that recolours a texture by rewriting its palette at run time (the
+// characters' clothes, hair and skin) draws one image with palettes no disc stream contains, so the full key
+// misses; the pack stores such images under their image key and the renderer recolours the replacement with the
+// palette it finds (docs/ARCHITECTURE.md section 7, recolour records). 0 for a texture that is not indexed.
+[[nodiscard]] std::uint64_t texture_image_key(const TextureState &texture, const std::uint8_t *texels);
+[[nodiscard]] std::uint64_t texture_image_key(const GuestMemory &memory, const TextureState &texture);
+
+} // namespace portablekit::gpu
