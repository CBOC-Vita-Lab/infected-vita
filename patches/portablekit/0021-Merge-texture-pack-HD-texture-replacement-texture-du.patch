+namespace portablekit::gpu {
+namespace {
+
+using Clock = std::chrono::steady_clock;
+
+std::uint64_t nanoseconds_since(Clock::time_point start) {
+    return static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() - start).count());
+}
+
+// ---- DXT in software, for a driver without S3TC (a desktop Mesa without it) -------------------
+
+std::uint32_t expand565(std::uint32_t c) {
+    const std::uint32_t r = (c >> 11u) & 31u, g = (c >> 5u) & 63u, b = c & 31u;
+    return ((r << 3u) | (r >> 2u)) | (((g << 2u) | (g >> 4u)) << 8u) | (((b << 3u) | (b >> 2u)) << 16u);
+}
+
+void decode_bc1_colors(const std::uint8_t *block, std::uint32_t *out, bool punch_through) {
+    const std::uint32_t c0 = block[0] | block[1] << 8u, c1 = block[2] | block[3] << 8u;
+    std::uint32_t palette[4];
+    palette[0] = expand565(c0) | 0xFF000000u;
+    palette[1] = expand565(c1) | 0xFF000000u;
+    const auto mix = [](std::uint32_t a, std::uint32_t b, std::uint32_t wa, std::uint32_t wb, std::uint32_t div) {
+        std::uint32_t result = 0xFF000000u;
+        for (std::uint32_t shift = 0; shift < 24u; shift += 8u)
+            result |= (((a >> shift) & 0xFFu) * wa + ((b >> shift) & 0xFFu) * wb) / div << shift;
+        return result;
+    };
+    if (c0 > c1 || !punch_through) {
+        if (c0 > c1) {
+            palette[2] = mix(palette[0], palette[1], 2u, 1u, 3u);
+            palette[3] = mix(palette[0], palette[1], 1u, 2u, 3u);
+        } else {
+            palette[2] = mix(palette[0], palette[1], 1u, 1u, 2u);
+            palette[3] = 0xFF000000u;
+        }
+    } else {
+        palette[2] = mix(palette[0], palette[1], 1u, 1u, 2u);
+        palette[3] = 0u;
+    }
+    const std::uint32_t indices = block[4] | block[5] << 8u | block[6] << 16u | static_cast<std::uint32_t>(block[7]) << 24u;
+    for (std::uint32_t i = 0; i < 16u; ++i) out[i] = palette[(indices >> (2u * i)) & 3u];
+}
+
+void decode_bc3_alpha(const std::uint8_t *block, std::uint32_t *out) {
+    const std::uint32_t a0 = block[0], a1 = block[1];
+    std::uint32_t table[8] = {a0, a1};
+    if (a0 > a1) {
+        for (std::uint32_t i = 1; i < 7u; ++i) table[i + 1u] = ((7u - i) * a0 + i * a1) / 7u;
+    } else {
+        for (std::uint32_t i = 1; i < 5u; ++i) table[i + 1u] = ((5u - i) * a0 + i * a1) / 5u;
+        table[6] = 0u;
+        table[7] = 255u;
+    }
+    std::uint64_t bits = 0u;
+    for (int i = 0; i < 6; ++i) bits |= static_cast<std::uint64_t>(block[2 + i]) << (8 * i);
+    for (std::uint32_t i = 0; i < 16u; ++i) out[i] = (out[i] & 0x00FFFFFFu) | table[(bits >> (3u * i)) & 7u] << 24u;
+}
+
+void decode_dxt_level(HdFormat format, const std::uint8_t *data, std::uint32_t width, std::uint32_t height,
+                      std::vector<std::uint32_t> &rgba) {
+    rgba.assign(static_cast<std::size_t>(width) * height, 0u);
+    const std::uint32_t bw = (width + 3u) / 4u, bh = (height + 3u) / 4u;
+    const std::uint32_t block_bytes = format == HdFormat::Dxt1 ? 8u : 16u;
+    std::uint32_t texels[16];
+    for (std::uint32_t by = 0; by < bh; ++by)
+        for (std::uint32_t bx = 0; bx < bw; ++bx) {
+            const std::uint8_t *block = data + (static_cast<std::size_t>(by) * bw + bx) * block_bytes;
+            if (format == HdFormat::Dxt1) {
+                decode_bc1_colors(block, texels, false);
+            } else {
+                decode_bc1_colors(block + 8, texels, false);
+                decode_bc3_alpha(block, texels);
+            }
+            for (std::uint32_t y = 0; y < 4u && by * 4u + y < height; ++y)
+                for (std::uint32_t x = 0; x < 4u && bx * 4u + x < width; ++x)
+                    rgba[static_cast<std::size_t>(by * 4u + y) * width + bx * 4u + x] = texels[y * 4u + x];
+        }
+}
+
+} // namespace
+
+GlHdTextures::GlHdTextures() = default;
+GlHdTextures::~GlHdTextures() = default;
+
+void GlHdTextures::configure(const HdConfig &config) {
+    config_ = config;
+    if (!config_.dump_dir.empty() && !dump_.active()) dump_.open(config_.dump_dir, config_.dump_raw);
+    open_pack();
+    if (config_.log && (pack_.is_open() || dump_.active()))
+        std::cout << "[hdtex] mode " << hd_mode_name(config_.mode) << ", budget " << config_.budget_bytes / (1024u * 1024u)
+                  << " MB" << (pack_.is_open() ? ", pack of " + std::to_string(pack_.count()) + " textures (index " +
+                                                       std::to_string(pack_.index_ram_bytes()) + " bytes in RAM)"
+                                                 : std::string())
+                  << (dump_.active() ? ", dumping to " + config_.dump_dir.string() : std::string()) << "\n";
+}
+
+void GlHdTextures::open_pack() {
+    pack_.close();
+    missing_logged_ = false;
+    if (config_.mode == HdMode::Off) return;
+    const std::filesystem::path path =
+        config_.data_root / (config_.mode == HdMode::X2 ? "texpack_2x.bin" : "texpack_4x.bin");
+    std::string error;
+    if (!pack_.open(path, error)) {
+        if (config_.log) std::cerr << "[hdtex] " << error << "; the original textures are used\n";
+        missing_logged_ = true;
+    }
+}
+
+void GlHdTextures::set_mode(HdMode mode) {
+    if (mode == config_.mode) return;
+    config_.mode = mode;
+    open_pack();
+    exhausted_ = false;
+    mode_changed_ = true;
+    ++stats_.flushes;
+    if (config_.log) std::cout << "[hdtex] gfx.hd_textures is now " << hd_mode_name(mode) << "\n";
+}
+
+bool GlHdTextures::tick(std::uint64_t frame) {
+    frame_ = frame;
+    if (frame < last_poll_ || frame >= last_poll_ + 60u) {
+        last_poll_ = frame;
+        // The environment decides for the whole run; otherwise settings.txt may have been edited (the overlay saves it).
+        if (std::getenv("INFECTED_HD_TEXTURES") == nullptr) {
+            std::error_code error;
+            const auto time = std::filesystem::last_write_time(config_.data_root / "settings.txt", error);
+            if (!error && time != settings_time_) {
+                settings_time_ = time;
+                set_mode(hd_textures_setting(config_.data_root));
+            }
+        }
+    }
+    const bool changed = mode_changed_;
+    mode_changed_ = false;
+    return changed;
+}
+
+bool GlHdTextures::upload_blob(std::uint32_t texture, const HdRecord &record, const std::vector<std::uint8_t> &blob,
+                               std::uint64_t &gpu_bytes, std::uint8_t &levels) {
+    if (!s3tc_known_) {
+        s3tc_known_ = true;
+#if defined(__vita__)
+        s3tc_ = true;
+#else
+        const char *extensions = reinterpret_cast<const char *>(glGetString(GL_EXTENSIONS));
+        s3tc_ = extensions != nullptr && (std::strstr(extensions, "GL_EXT_texture_compression_s3tc") != nullptr ||
+                                          std::strstr(extensions, "GL_EXT_texture_compression_dxt1") != nullptr);
+        if (!s3tc_ && config_.log) std::cerr << "[hdtex] the driver has no S3TC: DXT levels are expanded to RGBA8 on the CPU\n";
+#endif
+    }
+    if (bind_) bind_(texture);
+    else glBindTexture(GL_TEXTURE_2D, texture);
+    std::uint32_t width = record.width, height = record.height;
+    std::size_t offset = 0u;
+    gpu_bytes = 0u;
+    std::uint32_t uploaded = 0u;
+    for (std::uint32_t level = 0; level < record.mip_count; ++level) {
+        const std::uint32_t bytes = hd_level_bytes(record.format, width, height);
+        if (offset + bytes > blob.size()) return false;
+#if defined(__vita__)
+        // vitaGL swizzles compressed levels in 4x4 blocks; the chain stops at the last level that is whole blocks.
+        if (record.format != HdFormat::Rgba8 && (width < 4u || height < 4u)) break;
+#endif
+        const std::uint8_t *data = blob.data() + offset;
+        if (record.format == HdFormat::Rgba8) {
+            glTexImage2D(GL_TEXTURE_2D, static_cast<GLint>(level), GL_RGBA, static_cast<GLsizei>(width),
+                         static_cast<GLsizei>(height), 0, GL_RGBA, GL_UNSIGNED_BYTE, data);
+            gpu_bytes += bytes;
+        } else if (s3tc_) {
+            glCompressedTexImage2D(GL_TEXTURE_2D, static_cast<GLint>(level),
+                                   record.format == HdFormat::Dxt1 ? GL_COMPRESSED_RGB_S3TC_DXT1_EXT
+                                                                   : GL_COMPRESSED_RGBA_S3TC_DXT5_EXT,
+                                   static_cast<GLsizei>(width), static_cast<GLsizei>(height), 0, static_cast<GLsizei>(bytes), data);
+            gpu_bytes += bytes;
+        } else {
+            decode_dxt_level(record.format, data, width, height, decode_);
+            glTexImage2D(GL_TEXTURE_2D, static_cast<GLint>(level), GL_RGBA, static_cast<GLsizei>(width),
+                         static_cast<GLsizei>(height), 0, GL_RGBA, GL_UNSIGNED_BYTE, decode_.data());
+            gpu_bytes += static_cast<std::uint64_t>(width) * height * 4u;
+        }
+        offset += bytes;
+        ++uploaded;
+        width = std::max(width / 2u, 1u);
+        height = std::max(height / 2u, 1u);
+    }
+    levels = static_cast<std::uint8_t>(uploaded);
+    return uploaded != 0u;
+}
+
+bool GlHdTextures::admit(std::uint64_t needed) {
+    if (exhausted_ && stats_.resident_bytes < config_.budget_bytes / 10u * 9u) exhausted_ = false;
+    if (exhausted_ || stats_.resident_bytes + needed > config_.budget_bytes) {
+        exhausted_ = true;
+        ++stats_.skipped_budget;
+        if (!logged_exhausted_ && config_.log) {
+            logged_exhausted_ = true;
+            std::cerr << "[hdtex] replacement textures reached the budget of " << config_.budget_bytes / (1024u * 1024u)
+                      << " MB; the remaining textures use the originals (this is logged once)\n";
+        }
+        return false;
+    }
+    return true;
+}
+
+namespace {
+
+// RGBA bytes (red in the low byte) of the palette entry each index value reads, as the renderer's decode sees it.
+void read_palette(const TextureState &state, const std::uint8_t *clut, std::uint32_t entries, std::uint32_t *out) {
+    for (std::uint32_t index = 0; index < entries; ++index) {
+        const std::uint32_t entry = ((index >> std::min(state.clut_shift, 31u)) & state.clut_mask) | state.clut_offset << 4u;
+        if (state.clut_format == 3u) {
+            const std::uint8_t *at = clut + entry * 4u;
+            out[index] = at[0] | at[1] << 8u | at[2] << 16u | static_cast<std::uint32_t>(at[3]) << 24u;
+            continue;
+        }
+        const std::uint32_t v = clut[entry * 2u] | clut[entry * 2u + 1u] << 8u;
+        std::uint32_t r, g, b, a = 255u;
+        if (state.clut_format == 0u) {
+            r = (v & 31u) * 255u / 31u; g = ((v >> 5u) & 63u) * 255u / 63u; b = ((v >> 11u) & 31u) * 255u / 31u;
+        } else if (state.clut_format == 1u) {
+            r = (v & 31u) * 255u / 31u; g = ((v >> 5u) & 31u) * 255u / 31u; b = ((v >> 10u) & 31u) * 255u / 31u;
+            a = ((v >> 15u) & 1u) * 255u;
+        } else {
+            r = (v & 15u) * 17u; g = ((v >> 4u) & 15u) * 17u; b = ((v >> 8u) & 15u) * 17u; a = ((v >> 12u) & 15u) * 17u;
+        }
+        out[index] = r | g << 8u | b << 16u | a << 24u;
+    }
+}
+
+// Halves an RGBA picture with a box filter (odd sizes keep the last row or column).
+void halve(const std::vector<std::uint32_t> &in, std::uint32_t w, std::uint32_t h, std::vector<std::uint32_t> &out) {
+    const std::uint32_t nw = std::max(w / 2u, 1u), nh = std::max(h / 2u, 1u);
+    out.resize(static_cast<std::size_t>(nw) * nh);
+    for (std::uint32_t y = 0; y < nh; ++y)
+        for (std::uint32_t x = 0; x < nw; ++x) {
+            const std::uint32_t x0 = std::min(x * 2u, w - 1u), x1 = std::min(x * 2u + 1u, w - 1u);
+            const std::uint32_t y0 = std::min(y * 2u, h - 1u), y1 = std::min(y * 2u + 1u, h - 1u);
+            const std::uint32_t p[4] = {in[y0 * w + x0], in[y0 * w + x1], in[y1 * w + x0], in[y1 * w + x1]};
+            std::uint32_t result = 0u;
+            for (std::uint32_t c = 0; c < 4u; ++c)
+                result |= (((p[0] >> (8u * c)) & 255u) + ((p[1] >> (8u * c)) & 255u) + ((p[2] >> (8u * c)) & 255u) +
+                           ((p[3] >> (8u * c)) & 255u) + 2u) / 4u << (8u * c);
+            out[static_cast<std::size_t>(y) * nw + x] = result;
+        }
+}
+
+constexpr std::uint64_t kRecolourWindowFrames = 120u;   // a texture whose palette changes this often is left alone
+constexpr std::uint32_t kRecoloursPerWindow = 6u;
+constexpr std::uint64_t kRecolourPenaltyFrames = 1800u;
+
+} // namespace
+
+bool GlHdTextures::try_recolour(std::uint32_t texture, const GuestMemory &memory, const TextureState &state,
+                                HdTextureInfo &info) {
+    const std::uint64_t image_key = texture_image_key(memory, state);
+    if (image_key == 0u) return false;
+    HdRecord record;
+    if (!pack_.find(image_key, record) || (record.flags & kHdFlagRecolour) == 0u) return false;
+    // A palette that changes every few frames (a colour animation of a recolourable image) would cost a rebuild
+    // each time: such a texture keeps its original.
+    Thrash &thrash = thrash_[image_key];
+    if (frame_ < thrash.refuse_until) {
+        ++stats_.recolour_refused;
+        return false;
+    }
+    if (frame_ >= thrash.window_start + kRecolourWindowFrames || frame_ < thrash.window_start) {
+        thrash.window_start = frame_;
+        thrash.count = 0u;
+    }
+    if (++thrash.count > kRecoloursPerWindow) {
+        thrash.refuse_until = frame_ + kRecolourPenaltyFrames;
+        ++stats_.recolour_refused;
+        if (!thrash.logged && config_.log) {
+            thrash.logged = true;
+            std::cerr << "[hdtex] the palette of image " << std::hex << image_key << std::dec
+                      << " changes too often to recolour: its original is used for a while (logged once per image)\n";
+        }
+        return false;
+    }
+    const std::uint64_t needed = static_cast<std::uint64_t>(record.width) * record.height * 4u * 4u / 3u;
+    if (!admit(needed)) return false;
+
+    const Clock::time_point start = Clock::now();
+    if (!pack_.read_blob(record, blob_)) {
+        ++stats_.upload_failed;
+        return false;
+    }
+    HdRecolour recolour;
+    if (!hd_parse_recolour(record, blob_, recolour)) {
+        ++stats_.upload_failed;
+        return false;
+    }
+    const std::uint32_t clut_bytes = texture_clut_bytes_needed(state);
+    const std::uint8_t *clut = memory.raw_pointer(state.clut_address, clut_bytes);
+    if (clut == nullptr) return false;
+    std::uint32_t palette[256];
+    read_palette(state, clut, recolour.palette_entries, palette);
+
+    const std::uint32_t width = record.width, height = record.height;
+    const std::uint8_t *base_data = blob_.data() + recolour.base_offset;
+    const std::vector<std::uint32_t> *base = nullptr;
+    if (record.format == HdFormat::Rgba8) {
+        recolour_base_.resize(static_cast<std::size_t>(width) * height);
+        std::memcpy(recolour_base_.data(), base_data, recolour_base_.size() * 4u);
+    } else {
+        decode_dxt_level(record.format, base_data, width, height, recolour_base_);
+    }
+    base = &recolour_base_;
+    std::vector<std::uint32_t> &level = recolour_level_;
+    level.resize(static_cast<std::size_t>(width) * height);
+    hd_apply_recolour(recolour, base->data(), palette, level.data());
+
+    if (bind_) bind_(texture);
+    else glBindTexture(GL_TEXTURE_2D, texture);
+    std::uint64_t gpu_bytes = 0u;
+    std::uint32_t levels = 0u, w = width, h = height;
+    for (;;) {
+        glTexImage2D(GL_TEXTURE_2D, static_cast<GLint>(levels), GL_RGBA, static_cast<GLsizei>(w), static_cast<GLsizei>(h), 0,
+                     GL_RGBA, GL_UNSIGNED_BYTE, level.data());
+        gpu_bytes += static_cast<std::uint64_t>(w) * h * 4u;
+        ++levels;
+        if (w == 1u && h == 1u) break;
+        halve(level, w, h, recolour_mip_);
+        level.swap(recolour_mip_);
+        w = std::max(w / 2u, 1u);
+        h = std::max(h / 2u, 1u);
+    }
+    stats_.blob_bytes += record.size;
+    ++stats_.recolour_hits;
+    ++stats_.hits;
+    info.replaced = true;
+    info.recoloured = true;
+    info.gpu_bytes = gpu_bytes;
+    info.width = record.width;
+    info.height = record.height;
+    info.mips = static_cast<std::uint8_t>(levels);
+    ++stats_.resident_textures;
+    stats_.resident_bytes += gpu_bytes;
+    stats_.peak_bytes = std::max(stats_.peak_bytes, stats_.resident_bytes);
+    stats_.recolour_ns += nanoseconds_since(start);
+    return true;
+}
+
+bool GlHdTextures::upload(std::uint32_t texture, const GuestMemory &memory, const TextureState &state, HdTextureInfo &info) {
+    const bool was_replaced = info.replaced;
+    if (was_replaced) {
+        stats_.resident_bytes -= std::min(stats_.resident_bytes, info.gpu_bytes);
+        if (stats_.resident_textures != 0u) --stats_.resident_textures;
+        info.replaced = false;
+        info.gpu_bytes = 0u;
+        info.mips = 0u;
+    }
+    info.key = 0u;
+    if (!active()) {
+        info.respecify = was_replaced;
+        return false;
+    }
+
+    // 8888 textures are copies of render targets (the game's own post effects): never replaced, never keyed.
+    if (state.format == TextureFormat::Rgba8888) {
+        ++stats_.not_replaceable;
+        info.respecify = was_replaced;
+        return false;
+    }
+
+    // The key: once per upload of a texture (first sight or changed contents), never per draw.
+    const Clock::time_point key_start = Clock::now();
+    const std::uint64_t key = texture_replacement_key(memory, state);
+    stats_.key_ns += nanoseconds_since(key_start);
+    ++stats_.keyed;
+    info.key = key;
+    if (key == 0u) {
+        ++stats_.key_failed;
+        info.respecify = was_replaced;
+        return false;
+    }
+
+    if (dump_.active() && !dump_.known(key)) {
+        std::vector<std::uint32_t> rgba;
+        decode_texture(memory, state, rgba);
+        const std::uint32_t stored = texture_stored_bytes(state);
+        const std::uint32_t clut_bytes = texture_clut_bytes_needed(state);
+        dump_.texture(key, state, memory.raw_pointer(state.address, stored), stored,
+                      clut_bytes != 0u ? memory.raw_pointer(state.clut_address, clut_bytes) : nullptr, clut_bytes, rgba);
+    }
+
+    info.recoloured = false;
+    bool replaced = false;
+    if (pack_.is_open()) {
+        const Clock::time_point lookup_start = Clock::now();
+        HdRecord record;
+        const bool found = pack_.find(key, record);
+        stats_.lookup_ns += nanoseconds_since(lookup_start);
+        if (!found || (record.flags & kHdFlagRecolour) != 0u) {
+            // The full key is not in the pack. A recolourable image (a character whose clothes the game recolours)
+            // is found by its image key and rebuilt for the palette in use.
+            if (pack_.recolour_count() != 0u && texture_is_indexed(state.format) && try_recolour(texture, memory, state, info))
+                replaced = true;
+            else
+                ++stats_.misses;
+        } else {
+            const std::uint64_t needed = hd_chain_bytes(record.format, record.width, record.height, record.mip_count);
+            if (!admit(needed)) {
+                // refused by the budget: the original is used
+            } else {
+                const Clock::time_point upload_start = Clock::now();
+                std::uint64_t gpu_bytes = 0u;
+                std::uint8_t levels = 0u;
+                if (pack_.read_blob(record, blob_) && upload_blob(texture, record, blob_, gpu_bytes, levels)) {
+                    stats_.blob_bytes += record.size;
+                    ++stats_.hits;
+                    info.replaced = replaced = true;
+                    info.gpu_bytes = gpu_bytes;
+                    info.width = record.width;
+                    info.height = record.height;
+                    info.mips = levels;
+                    ++stats_.resident_textures;
+                    stats_.resident_bytes += gpu_bytes;
+                    stats_.peak_bytes = std::max(stats_.peak_bytes, stats_.resident_bytes);
+                } else {
+                    ++stats_.upload_failed;
+                }
+                stats_.upload_ns += nanoseconds_since(upload_start);
+            }
+        }
+    }
+    info.respecify = was_replaced && !replaced;
+    return replaced;
+}
+
+void GlHdTextures::released(HdTextureInfo &info) {
+    if (info.replaced) {
+        stats_.resident_bytes -= std::min(stats_.resident_bytes, info.gpu_bytes);
+        if (stats_.resident_textures != 0u) --stats_.resident_textures;
+    }
+    info = HdTextureInfo{};
+}
+
+void GlHdTextures::note_draw(const HdTextureInfo &info, const DrawCall &call) {
+    if (!dump_.active() || info.key == 0u) return;
+    HdDrawInfo draw;
+    draw.through = call.through;
+    draw.wrap_s = call.texture.wrap_s;
+    draw.wrap_t = call.texture.wrap_t;
+    draw.min_filter = call.texture.min_filter;
+    draw.mag_filter = call.texture.mag_filter;
+    draw.function = call.texture.function;
+    draw.alpha_from_texture = call.texture.alpha_from_texture;
+    draw.alpha_test = call.alpha_test.enabled;
+    draw.blend = call.blend.enabled;
+    dump_.draw(info.key, draw);
+}
+
+std::string GlHdTextures::summary() const {
+    std::ostringstream out;
+    const HdStats &s = stats_;
+    const auto n = [](std::uint64_t v) { return static_cast<unsigned long long>(v); };
+    char text[512];
+    std::snprintf(text, sizeof text,
+                  "hd textures %s: keyed %llu (%.2f us each), hits %llu (recoloured %llu, %.2f ms), misses %llu, no key %llu, "
+                  "render-target copies skipped %llu, budget refusals %llu, recolour refusals %llu, failed %llu; "
+                  "resident %llu textures %.2f MB (peak %.2f MB), read %.2f MB, lookup %.2f ms, upload %.2f ms, flushes %llu",
+                  hd_mode_name(config_.mode), n(s.keyed), s.keyed != 0u ? static_cast<double>(s.key_ns) / 1000.0 / static_cast<double>(s.keyed) : 0.0,
+                  n(s.hits), n(s.recolour_hits), static_cast<double>(s.recolour_ns) / 1.0e6, n(s.misses), n(s.key_failed),
+                  n(s.not_replaceable), n(s.skipped_budget), n(s.recolour_refused), n(s.upload_failed), n(s.resident_textures),
+                  static_cast<double>(s.resident_bytes) / 1048576.0, static_cast<double>(s.peak_bytes) / 1048576.0,
+                  static_cast<double>(s.blob_bytes) / 1048576.0, static_cast<double>(s.lookup_ns) / 1.0e6,
+                  static_cast<double>(s.upload_ns) / 1.0e6, n(s.flushes));
+    return text;
+}
+
+} // namespace portablekit::gpu
