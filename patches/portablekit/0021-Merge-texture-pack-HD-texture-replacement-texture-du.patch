diff --git a/tools/texkey/texkey.cpp b/tools/texkey/texkey.cpp
new file mode 100644
index 0000000..0e667a7
--- /dev/null
+++ b/tools/texkey/texkey.cpp
@@ -0,0 +1,134 @@
+// texkey: the replacement key and the decoded picture of PSP-native rasters, computed by the same
+// functions the renderer uses (host/gpu/texture_key.cpp, host/gpu/texture_decode.cpp), for the offline
+// texture pack tools (tools/texpack in the port repository).
+//
+//   texkey batch IN.raw [OUT_DIR] [--png] [--rgba]
+//       IN.raw is a concatenation of records in the format of the renderer's texture dump (<key>.raw):
+//         "IFRW" u32 version=1 | u8 format u8 clut_format u8 swizzled u8 0 | u16 width u16 height u16 buffer_width
+//         u16 clut_shift u16 clut_mask u16 clut_start | u32 texel_bytes u32 clut_bytes | texels | palette bytes
+//       One line per record on stdout:  <index> <key hex> <width> <height> <format> <zero%> <opaque%> <partial%> <decoded hash> <image key (palette excluded; 0 when not indexed)>
+//       --png writes OUT_DIR/<key>.png once per distinct key (the renderer's RGBA decode of the raster);
+//       --rgba writes OUT_DIR/<key>.rgba (width*height*4 raw bytes) instead of or as well.
+//   texkey key FILE.raw      prints the key of one record.
+#include "gpu/ge_state.hpp"
+#include "gpu/texture_decode.hpp"
+#include "gpu/texture_key.hpp"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <memory>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+#define STB_IMAGE_WRITE_STATIC
+#define STB_IMAGE_WRITE_IMPLEMENTATION
+#include "stb_image_write.h"
+
+namespace {
+
+using namespace portablekit::gpu;
+
+std::uint32_t rd32(const std::uint8_t *at) {
+    return at[0] | at[1] << 8u | at[2] << 16u | static_cast<std::uint32_t>(at[3]) << 24u;
+}
+std::uint32_t rd16(const std::uint8_t *at) { return at[0] | at[1] << 8u; }
+
+constexpr std::uint32_t kTexelAddress = 0x08A00000u;
+constexpr std::uint32_t kClutAddress = 0x08C00000u;
+
+} // namespace
+
+int main(int argc, char **argv) {
+    if (argc < 3) {
+        std::cerr << "usage: texkey batch IN.raw [OUT_DIR] [--png] [--rgba] | texkey key FILE.raw\n";
+        return 2;
+    }
+    const std::string command = argv[1];
+    std::string input = argv[2], out_dir;
+    bool png = false, rgba_out = false;
+    for (int i = 3; i < argc; ++i) {
+        const std::string arg = argv[i];
+        if (arg == "--png") png = true;
+        else if (arg == "--rgba") rgba_out = true;
+        else out_dir = arg;
+    }
+    std::ifstream file(input, std::ios::binary);
+    if (!file) {
+        std::cerr << "cannot open " << input << "\n";
+        return 1;
+    }
+    std::vector<std::uint8_t> data((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+    if (!out_dir.empty()) std::filesystem::create_directories(out_dir);
+
+    portablekit::gpu::GuestMemory memory(32u * 1024u * 1024u);
+    std::unordered_set<std::uint64_t> written;
+    std::vector<std::uint32_t> rgba;
+    std::size_t at = 0, index = 0;
+    while (at + 40u <= data.size()) {
+        const std::uint8_t *r = data.data() + at;
+        if (std::memcmp(r, "IFRW", 4) != 0 || rd32(r + 4) != 1u) {
+            std::cerr << "bad record at byte " << at << "\n";
+            return 1;
+        }
+        TextureState state;
+        state.enabled = true;
+        state.format = static_cast<TextureFormat>(r[8]);
+        state.clut_format = r[9];
+        state.swizzled = r[10] != 0u;
+        state.width = static_cast<std::uint16_t>(rd16(r + 12));
+        state.height = static_cast<std::uint16_t>(rd16(r + 14));
+        state.buffer_width = rd16(r + 16);
+        state.clut_shift = rd16(r + 18);
+        state.clut_mask = rd16(r + 20);
+        state.clut_offset = rd16(r + 22);
+        const std::uint32_t texel_bytes = rd32(r + 24), clut_bytes = rd32(r + 28);
+        if (at + 32u + texel_bytes + clut_bytes > data.size()) {
+            std::cerr << "truncated record at byte " << at << "\n";
+            return 1;
+        }
+        state.address = kTexelAddress;
+        state.clut_address = kClutAddress;
+        memory.zero(kClutAddress, 2048u);
+        memory.copy_in(kTexelAddress, std::span<const std::uint8_t>(r + 32, texel_bytes));
+        if (clut_bytes != 0u) memory.copy_in(kClutAddress, std::span<const std::uint8_t>(r + 32 + texel_bytes, clut_bytes));
+        const std::uint64_t key = texture_replacement_key(memory, state);
+        double zero = 0, opaque = 0, partial = 0;
+        std::uint64_t picture_hash = 0;
+        if (key != 0u && decode_texture(memory, state, rgba)) {
+            std::size_t z = 0, o = 0;
+            for (const std::uint32_t texel : rgba) {
+                const std::uint32_t a = texel >> 24u;
+                if (a == 0u) ++z;
+                else if (a == 255u) ++o;
+                picture_hash = (picture_hash ^ texel) * 0x100000001B3ull;
+            }
+            const double n = rgba.empty() ? 1.0 : static_cast<double>(rgba.size());
+            zero = 100.0 * static_cast<double>(z) / n;
+            opaque = 100.0 * static_cast<double>(o) / n;
+            partial = 100.0 - zero - opaque;
+            if (!out_dir.empty() && written.insert(key).second) {
+                char name[40];
+                std::snprintf(name, sizeof name, "%016llx", static_cast<unsigned long long>(key));
+                const std::string stem = (std::filesystem::path(out_dir) / name).string();
+                if (png) stbi_write_png((stem + ".png").c_str(), state.width, state.height, 4, rgba.data(), state.width * 4);
+                if (rgba_out) {
+                    std::ofstream out(stem + ".rgba", std::ios::binary);
+                    out.write(reinterpret_cast<const char *>(rgba.data()), static_cast<std::streamsize>(rgba.size() * 4u));
+                }
+            }
+        }
+        const std::uint64_t image_key = texture_image_key(memory, state);
+        std::printf("%zu %016llx %u %u %u %.3f %.3f %.3f %016llx %016llx\n", index, static_cast<unsigned long long>(key),
+                    state.width, state.height, static_cast<unsigned>(state.format), zero, opaque, partial,
+                    static_cast<unsigned long long>(picture_hash), static_cast<unsigned long long>(image_key));
+        at += 32u + texel_bytes + clut_bytes;
+        ++index;
+        if (command == "key") break;
+    }
+    return 0;
+}
