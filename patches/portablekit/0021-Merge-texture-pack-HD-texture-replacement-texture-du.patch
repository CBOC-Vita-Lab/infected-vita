From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 10 Oct 2026 04:43:15 +0000
Subject: [PATCH] Merge texture-pack (HD texture replacement, texture dump)
 into the Vita line

Brings in:
* HD texture packs: replacement key, pack reader, GL hook, texture dump, ge_replay switches
* texkey CLI (batch keys over raw texture records), ge_replay parser fix for HD options
* HD textures: image key and recolour records (palette-agnostic replacement rebuilt for the palette in use)
* gl hd textures: never replace 8888 render-target copies (counted as not_replaceable)
* HD textures: work in progress at interruption (renderer counters, replay switches)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 89afd32..91a06a8 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -596,6 +596,8 @@ if(PORTABLEKIT_GE_REPLAY)
         "${PORTABLEKIT_ROOT}/tools/ge_replay/ge_replay.cpp"
         "${PORTABLEKIT_ROOT}/host/gpu/ge_state.cpp"
         "${PORTABLEKIT_ROOT}/host/gpu/texture_decode.cpp"
+        "${PORTABLEKIT_ROOT}/host/gpu/texture_key.cpp"
+        "${PORTABLEKIT_ROOT}/host/gpu/hd_texture_pack.cpp"
         "${PORTABLEKIT_ROOT}/host/gpu/ge_dump.cpp"
         "${PORTABLEKIT_ROOT}/host/gpu/ge_worker.cpp"
         "${PORTABLEKIT_ROOT}/host/profile.cpp"
@@ -629,6 +631,29 @@ if(PORTABLEKIT_GE_REPLAY)
     set_target_properties(ge_replay PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
 endif()
 
+# texkey: the replacement key and decoded picture of raster records, from the same code the renderer
+# uses; the offline texture pack tools (the port repository's tools/texpack) run it.
+option(PORTABLEKIT_TEXKEY "Build texkey, the offline replacement-key tool" OFF)
+if(PORTABLEKIT_TEXKEY)
+    add_executable(texkey
+        "${PORTABLEKIT_ROOT}/tools/texkey/texkey.cpp"
+        "${PORTABLEKIT_ROOT}/host/gpu/texture_decode.cpp"
+        "${PORTABLEKIT_ROOT}/host/gpu/texture_key.cpp"
+        "${PORTABLEKIT_ROOT}/host/profile.cpp"
+        "${PORTABLEKIT_ROOT}/host/perf/frame_stats.cpp"
+        "${PORTABLEKIT_ROOT}/host/settings/settings.cpp"
+        "${PORTABLEKIT_ROOT}/host/input/bindings.cpp"
+        "${PORTABLEKIT_ROOT}/host/install/user_data.cpp"
+        "${PORTABLEKIT_ROOT}/host/app_paths.cpp"
+        "${PORTABLEKIT_ROOT}/tests/test_profile.cpp")
+    target_compile_features(texkey PRIVATE cxx_std_20)
+    target_include_directories(texkey PRIVATE "${PORTABLEKIT_ROOT}/host" "${PORTABLEKIT_ROOT}/third_party")
+    target_link_libraries(texkey PRIVATE psprecomp_core ${CMAKE_DL_LIBS})
+    find_package(Threads REQUIRED)
+    target_link_libraries(texkey PRIVATE Threads::Threads)
+    set_target_properties(texkey PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
+endif()
+
