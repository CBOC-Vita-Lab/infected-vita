+set(CMAKE_SYSTEM_NAME Linux)
+set(CMAKE_SYSTEM_PROCESSOR arm)
+set(CMAKE_C_COMPILER arm-linux-gnueabihf-gcc)
+set(CMAKE_CXX_COMPILER arm-linux-gnueabihf-g++)
+set(ARCH "-mcpu=cortex-a9 -mfpu=neon -mfloat-abi=hard -mthumb")
+set(CMAKE_C_FLAGS_INIT "${ARCH} -g -fno-stack-protector -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=0")
+set(CMAKE_CXX_FLAGS_INIT "${ARCH} -g -fno-math-errno -fno-stack-protector -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=0")
+set(CMAKE_FIND_ROOT_PATH /usr/arm-linux-gnueabihf $ENV{ARMPROF_SYSROOT})
+set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
+set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
+set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
+set(CMAKE_EXE_LINKER_FLAGS_INIT "-static")
