diff --git a/tools/armprof/tbcount.c b/tools/armprof/tbcount.c
new file mode 100644
index 0000000..c002e75
--- /dev/null
+++ b/tools/armprof/tbcount.c
@@ -0,0 +1,110 @@
+// tbcount: a QEMU TCG plugin that counts executed guest instructions per translation block, only while the program is
+// between calls of two marker functions (on=ADDR, off=ADDR: their entry addresses, from nm). Writes "pc insns execs" lines.
+#include <glib.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <qemu-plugin.h>
+
+QEMU_PLUGIN_EXPORT int qemu_plugin_version = QEMU_PLUGIN_VERSION;
+
+typedef struct {
+    uint64_t pc;
+    uint64_t insns;
+    uint64_t execs;
+} Block;
+
+static GHashTable *blocks;
+static GMutex lock;
+static const char *out_path = "tbcount.out";
+static uint64_t on_addr = 1, off_addr = 1;   // 1: never a block address (thumb bit cleared below)
+static volatile int active;                  // 0 until the on marker runs when markers are given
+// watch=ADDR:ADDR:...: functions whose callers are counted (the block that ran just before each call's entry block).
+static uint64_t watched[16];
+static int watched_count;
+static uint64_t last_pc;
+static GHashTable *calls;   // (entry << 32 | caller pc) -> count
+
+static void exec_on(unsigned int cpu, void *udata) { active = 1; }
+static void exec_off(unsigned int cpu, void *udata) { active = 0; }
+static void exec_block(unsigned int cpu, void *udata) {
+    Block *b = udata;
+    if (active) b->execs++;
+    last_pc = b->pc;
+}
+static void exec_watched(unsigned int cpu, void *udata) {
+    if (!active) return;
+    uint64_t key = ((uint64_t)(uintptr_t)udata << 32) | (last_pc & 0xFFFFFFFFull);
+    uint64_t *count = g_hash_table_lookup(calls, &key);
+    if (count == NULL) {
+        uint64_t *k = g_new(uint64_t, 1);
+        *k = key;
+        count = g_new0(uint64_t, 1);
+        g_hash_table_insert(calls, k, count);
+    }
+    ++*count;
+}
+
+static void tb_trans(qemu_plugin_id_t id, struct qemu_plugin_tb *tb) {
+    uint64_t pc = qemu_plugin_tb_vaddr(tb);
+    size_t n = qemu_plugin_tb_n_insns(tb);
+    if (pc == on_addr) qemu_plugin_register_vcpu_tb_exec_cb(tb, exec_on, QEMU_PLUGIN_CB_NO_REGS, NULL);
+    if (pc == off_addr) qemu_plugin_register_vcpu_tb_exec_cb(tb, exec_off, QEMU_PLUGIN_CB_NO_REGS, NULL);
+    for (int i = 0; i < watched_count; ++i)
+        if (pc == watched[i]) qemu_plugin_register_vcpu_tb_exec_cb(tb, exec_watched, QEMU_PLUGIN_CB_NO_REGS, (void *)(uintptr_t)pc);
+    uint64_t key = pc ^ ((uint64_t)n << 52);
+    g_mutex_lock(&lock);
+    Block *b = g_hash_table_lookup(blocks, &key);
+    if (b == NULL) {
+        b = g_new0(Block, 1);
+        b->pc = pc;
+        b->insns = n;
+        uint64_t *k = g_new(uint64_t, 1);
+        *k = key;
+        g_hash_table_insert(blocks, k, b);
+    }
+    g_mutex_unlock(&lock);
+    qemu_plugin_register_vcpu_tb_exec_cb(tb, exec_block, QEMU_PLUGIN_CB_NO_REGS, b);
+}
+
+static void plugin_exit(qemu_plugin_id_t id, void *p) {
+    FILE *f = fopen(out_path, "w");
+    if (f == NULL) return;
+    GHashTableIter it;
+    gpointer k, v;
+    g_hash_table_iter_init(&it, blocks);
+    while (g_hash_table_iter_next(&it, &k, &v)) {
+        Block *b = v;
+        if (b->execs) fprintf(f, "%llx %llu %llu 0\n", (unsigned long long)b->pc, (unsigned long long)b->insns,
+                              (unsigned long long)b->execs);
+    }
+    fclose(f);
+    if (watched_count == 0) return;
+    char path[512];
+    snprintf(path, sizeof path, "%s.calls", out_path);
+    f = fopen(path, "w");
+    if (f == NULL) return;
+    g_hash_table_iter_init(&it, calls);
+    while (g_hash_table_iter_next(&it, &k, &v))
+        fprintf(f, "%llx %llx %llu\n", (unsigned long long)(*(uint64_t *)k >> 32), (unsigned long long)(*(uint64_t *)k & 0xFFFFFFFFull),
+                (unsigned long long)*(uint64_t *)v);
+    fclose(f);
+}
+
+QEMU_PLUGIN_EXPORT int qemu_plugin_install(qemu_plugin_id_t id, const qemu_info_t *info, int argc, char **argv) {
+    active = 1;
+    for (int i = 0; i < argc; ++i) {
+        if (g_str_has_prefix(argv[i], "out=")) out_path = g_strdup(argv[i] + 4);
+        if (g_str_has_prefix(argv[i], "on=")) { on_addr = strtoull(argv[i] + 3, NULL, 16) & ~1ull; active = 0; }
+        if (g_str_has_prefix(argv[i], "off=")) off_addr = strtoull(argv[i] + 4, NULL, 16) & ~1ull;
+        if (g_str_has_prefix(argv[i], "watch=")) {
+            gchar **parts = g_strsplit(argv[i] + 6, ":", 16);
+            for (int j = 0; parts[j] != NULL && watched_count < 16; ++j) watched[watched_count++] = strtoull(parts[j], NULL, 16) & ~1ull;
+            g_strfreev(parts);
+        }
+    }
+    blocks = g_hash_table_new(g_int64_hash, g_int64_equal);
+    calls = g_hash_table_new(g_int64_hash, g_int64_equal);
+    qemu_plugin_register_vcpu_tb_trans_cb(id, tb_trans);
+    qemu_plugin_register_atexit_cb(id, plugin_exit, NULL);
+    return 0;
+}
