--- /dev/null
+++ b/tools/armprof/callers.py
@@ -0,0 +1,21 @@
+"""callers.py BINARY CALLS_R1 CALLS_R3 [FRAMES]: per frame, which function called each watched function (tbcount watch=)."""
+import bisect, subprocess, sys
+binary=sys.argv[1]
+syms=[]
+for line in subprocess.run(['arm-linux-gnueabihf-nm','-C','--defined-only','-S','--numeric-sort',binary],capture_output=True,text=True).stdout.splitlines():
+    p=line.split(' ',3)
+    if len(p)<4 or p[2] not in 'tTwW': continue
+    syms.append((int(p[0],16)&~1,int(p[1],16),p[3]))
+syms.sort(); starts=[s[0] for s in syms]
+def fn(pc):
+    i=bisect.bisect_right(starts,pc)-1
+    return syms[i][2] if i>=0 and pc<syms[i][0]+max(syms[i][1],2) else hex(pc)
+def load(p):
+    d={}
+    for line in open(p):
+        e,c,n=line.split(); key=(fn(int(e,16)),fn(int(c,16))); d[key]=d.get(key,0)+int(n)
+    return d
+a=load(sys.argv[2]); b=load(sys.argv[3])
+frames=float(sys.argv[4]) if len(sys.argv)>4 else 20.0
+rows=sorted(((b[k]-a.get(k,0))/frames,k) for k in b); rows.reverse()
+for v,(e,c) in rows[:30]: print(f'{v:9.0f}  {e[:20]:20s} <- {c[:120]}')
diff --git a/tools/armprof/lines.py b/tools/armprof/lines.py
new file mode 100644
index 0000000..80ca39f
--- /dev/null
+++ b/tools/armprof/lines.py
@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+"""lines.py BINARY TB_R1 TB_R3 FRAMES FUNC_SUBSTRING [N]: per-source-line ARM instruction counts per frame inside one
+function (by every instruction of every translated block, so inlined code is counted on its own line), innermost line
+and the line of the function itself it was inlined at."""
+import bisect, collections, re, subprocess, sys
+
+binary, a_path, b_path, frames, want = sys.argv[1], sys.argv[2], sys.argv[3], float(sys.argv[4]), sys.argv[5]
+top = int(sys.argv[6]) if len(sys.argv) > 6 else 40
+
+syms = []
+for line in subprocess.run(['arm-linux-gnueabihf-nm', '-C', '--defined-only', '-S', '--numeric-sort', binary],
+                           capture_output=True, text=True).stdout.splitlines():
+    parts = line.split(' ', 3)
+    if len(parts) < 4 or parts[2] not in 'tTwW':
+        continue
+    syms.append((int(parts[0], 16) & ~1, int(parts[1], 16), parts[3]))
+targets = [s for s in syms if want in s[2]]
+if not targets:
+    sys.exit('no function matches ' + want)
+start, size, name = max(targets, key=lambda s: s[1])
+print('function:', name[:150], hex(start), size)
+
+dis = subprocess.run(['arm-linux-gnueabihf-objdump', '-d', '--no-show-raw-insn', f'--start-address={start:#x}',
+                      f'--stop-address={start + size:#x}', binary], capture_output=True, text=True).stdout
+insns = [int(m.group(1), 16) for m in re.finditer(r'^\s*([0-9a-f]+):\s', dis, re.M)]
+index = {a: i for i, a in enumerate(insns)}
+
+
+def load(path):
+    d = collections.Counter()
+    for line in open(path):
+        pc, n, e, _ = line.split()
+        pc = int(pc, 16) & ~1
+        if pc in index:
+            d[(pc, int(n))] += int(e)
+    return d
+
+
+a, b = load(a_path), load(b_path)
+per_insn = collections.Counter()
+for key, execs in b.items():
+    pc, n = key
+    delta = execs - a.get(key, 0)
+    if delta <= 0:
+        continue
+    i = index[pc]
+    for addr in insns[i:i + n]:
+        per_insn[addr] += delta
+
+addrs = sorted(per_insn)
+chains = {}
+batch = 400
+for k in range(0, len(addrs), batch):
+    chunk = addrs[k:k + batch]
+    args = []
+    for x in chunk:
+        args += [hex(x), '0x0']
+    res = subprocess.run(['arm-linux-gnueabihf-addr2line', '-i', '-f', '-C', '-e', binary] + args,
+                         capture_output=True, text=True).stdout.splitlines()
+    pairs = [(res[j], res[j + 1]) for j in range(0, len(res) - 1, 2)]
+    cur, idx = [], 0
+    for fn, loc in pairs:
+        if loc.startswith('??') and fn == '??' and cur:
+            chains[chunk[idx]] = cur
+            cur, idx = [], idx + 1
+            continue
+        if fn == '??' and not cur:
+            continue
+        cur.append((fn, loc.split(' ')[0].split('/')[-1]))
+    if cur and idx < len(chunk):
+        chains[chunk[idx]] = cur
+
+inner, outer = collections.Counter(), collections.Counter()
+total = 0
+for addr, n in per_insn.items():
+    total += n
+    chain = chains.get(addr, [('?', '?')])
+    inner[f'{chain[0][1]}  [{chain[0][0][:60]}]'] += n
+    outer[chain[-1][1]] += n
+print(f'total {total / frames:,.0f} instructions per frame')
+print('-- by the line of the function itself (inlined calls folded in):')
+for k, n in outer.most_common(top):
+    print(f'{n / frames:12,.0f}  {k}')
+print('-- by innermost line:')
+for k, n in inner.most_common(top):
+    print(f'{n / frames:12,.0f}  {k}')
diff --git a/tools/armprof/run_calls.sh b/tools/armprof/run_calls.sh
new file mode 100755
index 0000000..f514280
--- /dev/null
+++ b/tools/armprof/run_calls.sh
@@ -0,0 +1,20 @@
+#!/bin/bash
+# run_calls.sh LABEL walk|submit DUMP_DIR FUNCTION... : who calls each named function (by its symbol), per frame.
+set -u
+here=$(cd "$(dirname "$0")" && pwd)
+label=$1; which=$2; dumps=$3; shift 3
+B=${ARMPROF_BUILD:?set ARMPROF_BUILD}/bin/ge_replay
+QEMU=${QEMU:-qemu-arm}; PLUGIN=${PLUGIN:-$here/libtbcount.so}; FLIPS=${FLIPS:-4201-4210}
+addr() { arm-linux-gnueabihf-nm "$B" | awk -v n="$1" '$3==n{print $1; exit}'; }
+case $which in
+  walk) ON=$(addr ge_replay_profile_on); OFF=$(addr ge_replay_profile_off);;
+  submit) ON=$(addr ge_replay_profile_submit_on); OFF=$(addr ge_replay_profile_submit_off);;
+esac
+W=""
+for f in "$@"; do a=$(addr "$f"); [ -n "$a" ] && W="$W${W:+:}$a" || echo "no symbol $f"; done
+n=$(echo "$FLIPS" | awk -F- '{print $2-$1+1}')
+for r in 1 3; do
+  "$QEMU" -plugin "$PLUGIN,out=tbc_${label}_r$r.out,on=$ON,off=$OFF,watch=$W" "$B" "$dumps" --flips "$FLIPS" --repeat $r --scale 2 \
+    > /dev/null 2>&1 || echo "run failed r$r"
+done
+python3 "$here/callers.py" "$B" "tbc_${label}_r1.out.calls" "tbc_${label}_r3.out.calls" $((2 * n))
diff --git a/tools/armprof/run_prof.sh b/tools/armprof/run_prof.sh
new file mode 100755
index 0000000..8d87bd6
--- /dev/null
+++ b/tools/armprof/run_prof.sh
@@ -0,0 +1,25 @@
+#!/bin/bash
+# run_prof.sh LABEL walk|submit DUMP_DIR [extra ge_replay args]
+# Per-frame ARM instruction counts by function, between ge_replay's profile markers: `walk` around the list walk (which
+# includes the renderer's submit() when it runs inline), `submit` around Renderer::submit only. Runs the flips twice
+# (--repeat 1 and 3) and takes the difference, so loading the dump and first-use work cancel out; prints per frame.
+# Environment: QEMU (qemu-arm built with --enable-plugins), ARMPROF_BUILD (the ARM build directory), PLUGIN (libtbcount.so),
+# FLIPS (default 4201-4210).
+set -u
+here=$(cd "$(dirname "$0")" && pwd)
+label=$1; which=$2; dumps=$3; shift 3
+B=${ARMPROF_BUILD:?set ARMPROF_BUILD}/bin/ge_replay
+QEMU=${QEMU:-qemu-arm}; PLUGIN=${PLUGIN:-$here/libtbcount.so}; FLIPS=${FLIPS:-4201-4210}
+addr() { arm-linux-gnueabihf-nm "$B" | awk -v n="$1" '$3==n{print $1; exit}'; }
+case $which in
+  walk) ON=$(addr ge_replay_profile_on); OFF=$(addr ge_replay_profile_off);;
+  submit) ON=$(addr ge_replay_profile_submit_on); OFF=$(addr ge_replay_profile_submit_off);;
+  *) echo "walk or submit"; exit 2;;
+esac
+n=$(echo "$FLIPS" | awk -F- '{print $2-$1+1}')
+for r in 1 3; do
+  "$QEMU" -plugin "$PLUGIN,out=tb_${label}_r$r.out,on=$ON,off=$OFF" "$B" "$dumps" --flips "$FLIPS" --repeat $r --scale 2 "$@" \
+    > "run_${label}_r$r.log" 2>&1 || echo "run failed r$r"
+done
+python3 "$here/attribute.py" "$B" "tb_${label}_r1.out" "tb_${label}_r3.out" $((2 * n)) | tail -n +2 > "prof_${label}.txt"
+head -40 "prof_${label}.txt"
