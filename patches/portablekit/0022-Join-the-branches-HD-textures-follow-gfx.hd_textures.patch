+// <prefix>_SCREENSHOT_FLIPS=A,B-C,D-E/STEP: capture the presented picture at those flips (the guest's
+// sceDisplaySetFrameBuf count, 1 for the first; the numbering of <prefix>_SHOT_FLIPS) into
+// <dir>/flip_NNNNNN.png. With it set, <prefix>_SCREENSHOT_EVERY is not used unless given too. Returns the path to
+// capture this flip to (<prefix>_SCREENSHOT_DIR is set), or an empty string.
+std::string screenshot_path_for_flip(std::uint64_t flip) {
+    struct FlipRange {
+        std::uint64_t first{}, last{}, step{1};
+    };
+    static const char *directory = portablekit::env("SCREENSHOT_DIR");
+    static const std::vector<FlipRange> ranges = [] {
+        std::vector<FlipRange> list;
+        const char *text = portablekit::env("SCREENSHOT_FLIPS");
+        if (text == nullptr) return list;
+        std::stringstream items(text);
+        std::string item;
+        while (std::getline(items, item, ',')) {
+            FlipRange r;
+            char *end = nullptr;
+            r.first = std::strtoull(item.c_str(), &end, 10);
+            r.last = r.first;
+            if (*end == '-') r.last = std::strtoull(end + 1, &end, 10);
+            if (*end == '/') r.step = std::max<std::uint64_t>(1u, std::strtoull(end + 1, nullptr, 10));
+            list.push_back(r);
+        }
+        return list;
+    }();
+    if (directory == nullptr || ranges.empty()) return std::string();
+    for (const FlipRange &r : ranges) {
+        if (flip >= r.first && flip <= r.last && (flip - r.first) % r.step == 0u) {
+            char name[64];
+            std::snprintf(name, sizeof name, "/flip_%06llu.png", static_cast<unsigned long long>(flip));
+            return std::string(directory) + name;
+        }
+    }
+    return std::string();
+}
