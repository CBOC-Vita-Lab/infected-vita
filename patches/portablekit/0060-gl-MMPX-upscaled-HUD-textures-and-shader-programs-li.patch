+    constexpr std::uint64_t kLullUs = 20000u;
+    if (impl.frames != 0u && quiet_us < kLullUs) return false;
+    while (impl.warm_next < impl.warm_flags.size() && impl.programs.count(impl.warm_flags[impl.warm_next]) != 0u) ++impl.warm_next;
