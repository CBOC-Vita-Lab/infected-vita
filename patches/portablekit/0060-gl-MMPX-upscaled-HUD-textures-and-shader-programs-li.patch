+    // Whether a texture first sampled by a through-mode draw may be a candidate (decided once, at its creation).
+    bool ui_shape_suits(const TextureState &state) const {
+        if (!settings.ui_upscale) return false;
+        switch (state.format) {
+        case TextureFormat::Rgba8888:   // a copy of a render target (the game's post effects)
+        case TextureFormat::Dxt1:
+        case TextureFormat::Dxt3:
+        case TextureFormat::Dxt5: return false;
+        default: break;
+        }
+        const std::uint32_t pixels = static_cast<std::uint32_t>(state.width) * state.height;
+        return pixels > 256u && std::min(state.width, state.height) >= 8u && pixels <= kUi2xMaxPixels;
+    }
+
+    // At most `limit` distinct colours in `texels`?
+    static bool few_colours(const std::uint32_t *texels, std::size_t count, std::uint32_t limit) {
+        std::uint32_t table[1024]{};      // open addressing; 0 = empty (a colour of 0 is tracked separately)
+        bool zero_seen = false;
+        std::uint32_t distinct = 0u;
+        for (std::size_t i = 0; i < count; ++i) {
+            const std::uint32_t colour = texels[i];
+            if (colour == 0u) {
+                if (!zero_seen) { zero_seen = true; if (++distinct > limit) return false; }
+                continue;
+            }
+            std::uint32_t slot = (colour * 2654435761u) >> 22u;
+            while (table[slot] != 0u && table[slot] != colour) slot = (slot + 1u) & 1023u;
+            if (table[slot] == 0u) {
+                table[slot] = colour;
+                if (++distinct > limit) return false;
+            }
+        }
         return true;
     }
 
