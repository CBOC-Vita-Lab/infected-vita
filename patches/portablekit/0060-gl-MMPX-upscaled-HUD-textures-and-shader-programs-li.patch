+    static std::string folder_of(const std::string &path) {
+        const std::size_t slash = path.find_last_of("/\\:");
+        return slash == std::string::npos ? std::string() : path.substr(0, slash + 1u);
+    }
+
+    // Reads one list; returns the flags in file order. `state`: 0 no such file, 1 read, 2 another flag layout (nothing read).
+    static std::vector<std::uint32_t> read_variant_list(const std::string &path, int &state) {
+        std::vector<std::uint32_t> result;
+        state = 0;
+        std::FILE *file = std::fopen(path.c_str(), "rb");
+        if (file == nullptr) return result;
+        state = 1;
+        char line[128];
+        bool first = true;
+        while (std::fgets(line, sizeof line, file) != nullptr) {
+            std::size_t length = std::strlen(line);
+            while (length != 0u && (line[length - 1u] == '\n' || line[length - 1u] == '\r' || line[length - 1u] == ' ')) line[--length] = '\0';
+            if (first) {
+                first = false;
+                if (std::strcmp(line, kVariantHeader) != 0) { state = 2; result.clear(); break; }
+                continue;
+            }
+            if (length == 0u || line[0] == '#') continue;
+            char *end = nullptr;
+            const unsigned long value = std::strtoul(line, &end, 16);
+            if (end != line && value <= 0xFFFFFFFFul) result.push_back(static_cast<std::uint32_t>(value));
+        }
+        std::fclose(file);
+        return result;
+    }
+
+    // The lists' places, and what they hold (once).
+    std::vector<std::uint32_t> prepare_variants() {
+        std::vector<std::uint32_t> flags;
+        if (variants_prepared) return flags;
