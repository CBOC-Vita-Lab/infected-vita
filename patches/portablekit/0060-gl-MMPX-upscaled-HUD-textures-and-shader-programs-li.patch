+        if (!settings.prewarm) return flags;
+        std::string dir = settings.variant_dir;
+        if (dir.empty()) dir = folder_of(port::settings().path());
+        if (dir.empty()) return flags;
+        const std::string shipped = dir + "shader_cache/variants.txt";
+        variant_record_path = dir + "shader_variants.txt";
+        int state = 0;
+        for (const std::uint32_t value : read_variant_list(shipped, state))
+            if (listed_variants.insert(value).second) flags.push_back(value);
+        for (const std::uint32_t value : read_variant_list(variant_record_path, state))
+            if (listed_variants.insert(value).second) flags.push_back(value);
+        variant_file_started = state == 1;   // appended to; a missing or foreign file is written anew
+        return flags;
+    }
+
+    // A program just linked: appended to the recorded list unless a list has it.
+    void record_variant(std::uint32_t flags) {
+        if (!settings.prewarm) return;
+        if (!variants_prepared) (void)prepare_variants();   // names the file and what it holds
