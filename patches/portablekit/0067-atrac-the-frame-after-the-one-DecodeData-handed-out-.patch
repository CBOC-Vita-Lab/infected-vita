+        if (!frame_bytes(memory, context, index, bytes)) return false;
         return context.decoder.decode(bytes, context.cached.data()) != 0u;
     };
     if (frame != context.next_frame) {
@@ -273,6 +441,24 @@ bool load_frame(const psprecomp::GuestMemory &memory, AtracContext &context, std
     return decoded;
 }
 
+// Starts decoding the frame the next DecodeData starts in, when it follows the
+// one just decoded and its bytes are there.
+void decode_ahead(const psprecomp::GuestMemory &memory, AtracContext &context) {
+    if (!ahead_enabled() || context.low_level || !context.decoder.is_open()) return;
+    AheadJob &job = context.ahead.job;
+    if (job.state.load(std::memory_order_relaxed) != AheadJob::Idle) return;
+    const TrackInfo &track = context.track;
+    if (context.position > track.end_sample) return;
+    const auto frame_samples = static_cast<std::int64_t>(audio::atrac_frame_samples(track.codec));
+    const std::int64_t frame = (static_cast<std::int64_t>(context.position) + track.skip) / frame_samples;
+    if (frame == context.cached_frame || frame != context.next_frame) return;
+    if (!frame_bytes(memory, context, frame, job.bytes)) return;
+    job.decoder = &context.decoder;
+    job.frame = frame;
+    job.out.resize(static_cast<std::size_t>(frame_samples) * 2u);
+    if (AheadWorker::instance().submit(job)) context.next_frame = frame + 1;
+}
