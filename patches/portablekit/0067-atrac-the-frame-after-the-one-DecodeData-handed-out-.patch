+// ---- decode-ahead
+// After DecodeData has handed out a frame, the frame after it is decoded on the
+// decode-ahead core (the movie decoder's thread platform: core 3 when the system
+// allows it, else beside the display-list walker) while the guest runs on. The
+// next DecodeData then only copies samples. The job decodes with the context's
+// own decoder, in order, so its state is exactly what decoding in the guest's
+// thread would have made; a request for any other frame, or bytes that changed
+// since the job copied them, take the ordinary path (which reseeds the decoder
+// when the request is not the frame after the last one decoded).
+// <PREFIX>_ATRAC_AHEAD=0 decodes in the guest's thread as before.
+struct AheadJob {
+    enum State : int { Idle = 0, Queued = 1, Done = 2 };
+    std::atomic<int> state{Idle};
+    audio::AtracDecoder *decoder{};
+    std::int64_t frame{-1};
+    std::vector<std::uint8_t> bytes;
+    std::vector<std::int16_t> out;
+    bool decoded{};
+};
+
+bool ahead_enabled() {
+    static const bool enabled = [] {
+        const char *text = portablekit::env("ATRAC_AHEAD");
+        return !(text != nullptr && text[0] == '0');
+    }();
+    return enabled;
+}
+
+class AheadWorker {
+public:
+    static AheadWorker &instance() {
+        static AheadWorker worker;
+        return worker;
+    }
+    // False when no thread could be started (the caller decodes itself).
+    bool submit(AheadJob &job) {
+        if (!start()) return false;
+        job.state.store(AheadJob::Queued, std::memory_order_release);
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            for (AheadJob *&slot : queue_) {
+                if (slot == nullptr) {
+                    slot = &job;
+                    platform_.event_signal(wake_);
+                    return true;
+                }
+            }
+        }
+        job.state.store(AheadJob::Idle, std::memory_order_release);
+        return false;
+    }
+    void wait(AheadJob &job) {
+        while (job.state.load(std::memory_order_acquire) == AheadJob::Queued) platform_.event_wait(done_, 2'000u);
+    }
+
+private:
+    bool start() {
+        if (thread_ != nullptr) return true;
+        if (failed_) return false;
+        platform_ = movie::decode_thread_platform();
+        if (platform_.event_create == nullptr || platform_.event_wait == nullptr || platform_.event_signal == nullptr ||
+            platform_.thread_start == nullptr) {
+            failed_ = true;
+            return false;
+        }
+        wake_ = platform_.event_create();
+        done_ = platform_.event_create();
+        thread_ = platform_.thread_start(&AheadWorker::main, this, "atrac-ahead", platform_.core, 256u * 1024u);
+        if (thread_ == nullptr) failed_ = true;
+        std::cout << "Audio: ATRAC frames are decoded one ahead on their own thread (core " << platform_.core << ")"
+                  << (thread_ == nullptr ? ": the thread did not start, decoding in the caller" : "") << "\n";
+        return thread_ != nullptr;
+    }
+    AheadJob *take() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        for (AheadJob *&slot : queue_) {
+            if (slot != nullptr) {
+                AheadJob *job = slot;
+                slot = nullptr;
+                return job;
+            }
+        }
+        return nullptr;
+    }
+    static void main(void *self) {
+        auto &worker = *static_cast<AheadWorker *>(self);
+        for (;;) {
+            AheadJob *job = worker.take();
+            if (job == nullptr) {
+                worker.platform_.event_wait(worker.wake_, 50'000u);
+                continue;
+            }
+            job->decoded = job->decoder->decode(job->bytes, job->out.data()) != 0u;
+            job->state.store(AheadJob::Done, std::memory_order_release);
+            worker.platform_.event_signal(worker.done_);
+        }
+    }
+    // The thread lives as long as the program (it sleeps when there is nothing to decode).
+    movie::DecodeThreadPlatform platform_{};
+    void *thread_{};
+    void *wake_{};
+    void *done_{};
+    bool failed_{};
+    std::mutex mutex_;
+    std::array<AheadJob *, 8> queue_{};
+};
+
+// Owns a context's job; waits for it before the decoder it uses goes away. The
+// last member of AtracContext, so it is destroyed first.
+struct AheadSlot {
+    AheadJob job;
+    ~AheadSlot() {
+        if (job.state.load(std::memory_order_acquire) == AheadJob::Queued) AheadWorker::instance().wait(job);
+    }
+};
