+// Copies frame `index` of the stream into `bytes` (block_align of them), from
+// the bytes stored as the game added them, or from the guest buffer for a track
+// that is all in memory; false when they are not there.
+bool frame_bytes(const psprecomp::GuestMemory &memory, const AtracContext &context, std::int64_t index,
+                 std::vector<std::uint8_t> &bytes) {
+    const TrackInfo &track = context.track;
+    if (index < 0) return false;
+    bytes.resize(track.block_align);
+    const std::uint64_t offset = track.data_offset + static_cast<std::uint64_t>(index) * track.block_align;
+    if (context.streaming) {
+        if (offset < context.stored_from || offset + track.block_align > context.stored_from + context.stored.size())
+            return false;
+        const auto start = context.stored.begin() + static_cast<std::ptrdiff_t>(offset - context.stored_from);
+        std::copy(start, start + track.block_align, bytes.begin());
+        return true;
+    }
+    if (offset + track.block_align > std::min<std::uint64_t>(context.buffer_size, track.data_offset + track.data_size))
+        return false;
+    memory.copy_out(context.buffer + static_cast<std::uint32_t>(offset), bytes);
+    return true;
+}
+
+// Waits for the context's decode-ahead job, if one is out. The decoder is then
+// past the job's frame (next_frame already says so); its samples stay in the
+// job until load_frame takes them or another request discards them.
+void settle_ahead(AtracContext &context) {
+    AheadJob &job = context.ahead.job;
+    if (job.state.load(std::memory_order_acquire) == AheadJob::Queued) AheadWorker::instance().wait(job);
+}
+
+// Settles the job and forgets its samples, for a caller about to reposition.
+void drop_ahead(AtracContext &context) {
+    settle_ahead(context);
+    context.ahead.job.state.store(AheadJob::Idle, std::memory_order_relaxed);
+}
