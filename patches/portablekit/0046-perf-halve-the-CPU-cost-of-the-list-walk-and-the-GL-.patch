+// The value of a field of the lighting or material state, and the version that says it changed: moved only when the
+// value does, since a game sends the same values with each model and every move costs the renderer a refresh and
+// keeps two draws apart.
+template <typename T> inline void set_tracked(T &field, T value, std::uint64_t &version) {
+    if constexpr (std::is_same_v<T, float>) {
+        // Bit for bit: -0 and 0 are the same number but not the same register value.
+        if (std::bit_cast<std::uint32_t>(field) == std::bit_cast<std::uint32_t>(value)) return;
+    } else {
+        if (field == value) return;
+    }
+    field = value;
+    ++version;
+}
+
+// One value of a matrix upload. 3x4 matrices arrive as 12 values, three basis rows then a translation row; the
+// projection matrix has all 16. The 3x4 forms are expanded into the column-major 4x4 the shader multiplies as M * v.
+// Also called from execute() directly: matrix values are a third of the command words of a frame.
+inline void GeState::store_matrix_value(std::uint32_t command, std::uint32_t data) {
+    const float value = decode_float24(data);
+    // matrix_version_ moves when a value of the world, view or projection matrix changes (bit for bit): a game
+    // uploads the same matrices again for each model.
+    const auto set = [&](float &slot, float to) {
+        if (std::bit_cast<std::uint32_t>(slot) == std::bit_cast<std::uint32_t>(to)) return;
+        slot = to;
+        ++matrix_version_;
+    };
+    const auto store_3x4 = [&](std::array<float, 16> &matrix, std::uint32_t &index) {
+        if (index < 12u) {
+            set(matrix[(index / 3u) * 4u + (index % 3u)], value);
+            set(matrix[3], 0.0f);
+            set(matrix[7], 0.0f);
+            set(matrix[11], 0.0f);
+            set(matrix[15], 1.0f);
+        }
+        ++index;
+    };
+    switch (command) {
+    case kBoneMatrixData:
+        if (bone_write_index_ < bone_matrices_.size()) bone_matrices_[bone_write_index_] = value;
+        ++bone_write_index_;
+        break;
+    case kWorldMatrixData: store_3x4(world_, world_write_index_); break;
+    case kViewMatrixData: store_3x4(view_, view_write_index_); break;
+    case kTexGenMatrixData: {
+        // Not one of the matrices matrix_version_ stands for.
+        const std::uint64_t version = matrix_version_;
+        store_3x4(texture_matrix_, texture_write_index_);
+        matrix_version_ = version;
+        break;
+    }
+    default:  // kProjMatrixData
+        if (projection_write_index_ < 16u) set(projection_[projection_write_index_], value);
+        ++projection_write_index_;
+        break;
+    }
+}
