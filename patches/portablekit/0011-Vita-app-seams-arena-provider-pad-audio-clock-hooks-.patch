From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 10 Oct 2026 01:05:10 +0000
Subject: [PATCH] Vita app seams: arena provider, pad/audio/clock hooks, phase
 timers, desktop-only stubs

- guest_memory: ArenaProvider so the app can hand out the 66 MiB arena (1 MiB aligned memblock)
- pad_provider.hpp, audio_sink AudioOutput, KernelPlatform clock: plat-backed input/audio/time on Vita
- perf/phase_timers.hpp: per-phase us counters (GE walk, GL submit, present, decode, audio, ISO read, idle)
- kernel: switch_count(); hle_media: media_renderer(); gl_platform.h: vitaGL shims (no glBlendColor/GL_DITHER)
- corpus_library/overlays/game_font/adhoc: whole-file stubs under __vita__ (dlfcn, mman, ifaddrs absent)
- CMake: PORTABLEKIT_PLATFORM_CUSTOM + NO_HOST_THREADS for pk_runtime on VITA

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>

diff --git a/CMakeLists.txt b/CMakeLists.txt
index fb96372..4ce2aaa 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -462,8 +462,15 @@ if(PSPRECOMP_BUILD_TESTS OR PORTABLEKIT_BUILD_RUNTIME_LIBRARY)
     target_compile_features(pk_runtime PUBLIC cxx_std_20)
     target_include_directories(pk_runtime PUBLIC "${PORTABLEKIT_ROOT}/host" "${PORTABLEKIT_ROOT}/third_party")
     target_link_libraries(pk_runtime PUBLIC psprecomp_core)
-    find_package(Threads REQUIRED)
-    target_link_libraries(pk_runtime PUBLIC Threads::Threads ${CMAKE_DL_LIBS})
+    if(VITA)
+        # vitasdk (vita.toolchain.cmake sets VITA): pthread-embedded is part of the SDK and there is no dlopen. The
+        # kernel uses the platform seam instead of host threads, and the sources a Vita build cannot compile
+        # (corpus_library, overlays, game_font, the ad hoc server) carry #if defined(__vita__) stubs.
+        target_compile_definitions(pk_runtime PUBLIC PORTABLEKIT_PLATFORM_CUSTOM=1 PORTABLEKIT_NO_HOST_THREADS=1)
+    else()
+        find_package(Threads REQUIRED)
+        target_link_libraries(pk_runtime PUBLIC Threads::Threads ${CMAKE_DL_LIBS})
+    endif()
     if(WIN32)
         target_link_libraries(pk_runtime PUBLIC ws2_32 iphlpapi)
     endif()
