diff --git a/host/input/pad_provider.hpp b/host/input/pad_provider.hpp
new file mode 100644
index 0000000..3e8eb0c
--- /dev/null
+++ b/host/input/pad_provider.hpp
@@ -0,0 +1,25 @@
+#pragma once
+
+#include <cstdint>
+
+// A platform layer's controller, for a build whose renderer has no window and no pad of its own (the GLES2 backend):
+// the Vita build's buttons and sticks. sample_ctrl() (hle/hle_media.cpp) asks it for every sceCtrl read, in the PSP's bit
+// layout; a scripted pad (<prefix>_PAD_SCRIPT) is added on top, as with a window.
+namespace portablekit {
+
+struct PadSample {
+    std::uint32_t buttons{};
+    std::uint8_t analog_x{0x80u};
+    std::uint8_t analog_y{0x80u};
+    std::uint8_t right_x{0x80u};
+    std::uint8_t right_y{0x80u};
+};
+
+// Fills `out` with the pad as it is now; false when it cannot be read (the sample then stays neutral).
+using PadProvider = bool (*)(PadSample &out);
+
+inline PadProvider g_pad_provider = nullptr;
+inline void set_pad_provider(PadProvider provider) noexcept { g_pad_provider = provider; }
+[[nodiscard]] inline PadProvider pad_provider() noexcept { return g_pad_provider; }
+
+} // namespace portablekit
