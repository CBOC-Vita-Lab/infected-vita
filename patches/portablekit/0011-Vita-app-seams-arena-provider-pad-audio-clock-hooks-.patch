diff --git a/host/perf/phase_timers.hpp b/host/perf/phase_timers.hpp
new file mode 100644
index 0000000..2db96ff
--- /dev/null
+++ b/host/perf/phase_timers.hpp
@@ -0,0 +1,58 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// Where a frame's time goes, for a platform layer that reports it (the Vita build's per-second status line). Off until the
+// platform installs a clock with set_clock(); a scope then costs two clock reads and one atomic add, with it off one
+// pointer test. The totals are 32-bit microsecond counters that wrap (take differences), so another thread may read them
+// while the owners of the phases write them.
+//
+// Phases are leaves of the guest's work and do not nest into each other except GeWalk, which contains the GlSubmit of
+// its draws. What is left of a frame is the guest's own code and the HLE calls that were not timed.
+namespace portablekit::phase {
+
+enum Phase : unsigned {
+    GeWalk,    // running a display list (GeState::execute): command decode, vertex decode, GlSubmit included
+    GlSubmit,  // the renderer's handling of a draw call from the list
+    Present,   // the flip: texture uploads for movies, write-back, the renderer's present and swap
+    Hle,       // HLE calls that returned without switching threads (needs the import hook: <app> stats_hle)
+    Decode,    // ATRAC3plus and H.264 decoding
+    Audio,     // mixing into the audio sink
+    IsoRead,   // reading the disc image
+    Idle,      // the kernel waiting for real time
+    kCount
+};
+
+struct Table {
+    std::atomic<std::uint32_t> us[kCount];
+    std::atomic<std::uint32_t> calls[kCount];
+};
+inline Table g_table{};
+inline std::uint64_t (*g_clock)() = nullptr;
+
+inline void set_clock(std::uint64_t (*clock)()) noexcept { g_clock = clock; }
+[[nodiscard]] inline bool enabled() noexcept { return g_clock != nullptr; }
+[[nodiscard]] inline std::uint64_t stamp() noexcept { return g_clock != nullptr ? g_clock() : 0u; }
+inline void add(Phase phase, std::uint64_t microseconds) noexcept {
+    g_table.us[phase].fetch_add(static_cast<std::uint32_t>(microseconds), std::memory_order_relaxed);
+    g_table.calls[phase].fetch_add(1u, std::memory_order_relaxed);
+}
+[[nodiscard]] inline std::uint32_t total_us(Phase phase) noexcept { return g_table.us[phase].load(std::memory_order_relaxed); }
+[[nodiscard]] inline std::uint32_t total_calls(Phase phase) noexcept { return g_table.calls[phase].load(std::memory_order_relaxed); }
+
+class Scope {
+public:
+    explicit Scope(Phase phase) noexcept : phase_(phase), start_(stamp()) {}
+    ~Scope() {
+        if (g_clock != nullptr) add(phase_, g_clock() - start_);
+    }
+    Scope(const Scope &) = delete;
+    Scope &operator=(const Scope &) = delete;
+
+private:
+    Phase phase_;
+    std::uint64_t start_;
+};
+
+} // namespace portablekit::phase
