+// A platform layer's playback device, for a build without SDL audio (the Vita's: a pump thread fed through a ring).
+// The sink pushes the frames it retires: everything older than its prebuffer, as soon as a producer has mixed past it.
+// Install it with set_audio_output() before AudioSink::initialize().
+struct AudioOutput {
+    // Opens the device for 44100 Hz stereo s16; false: run silent.
+    bool (*open)() = nullptr;
+    // Hands the device `count` interleaved stereo frames; returns how many it took (the rest are dropped and counted).
+    std::size_t (*write)(const std::int16_t *frames, std::size_t count) = nullptr;
+    void (*close)() = nullptr;
+    void (*set_gain)(float gain) = nullptr;       // optional, 0..1
+    void (*set_paused)(bool paused) = nullptr;    // optional
+};
+void set_audio_output(const AudioOutput &output) noexcept;
+
 // Host playback for the guest's 44100 Hz stereo stream.
 //
 // The guest and the audio device run on unrelated clocks: the kernel's virtual
