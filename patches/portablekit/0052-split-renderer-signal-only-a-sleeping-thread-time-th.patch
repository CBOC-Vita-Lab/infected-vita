From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 16 Oct 2026 23:08:17 +0000
Subject: [PATCH] split renderer: signal only a sleeping thread, time threads
 by their sleeps

Measured on the PS Vita, where a system call is not free: an event signal
(sceKernelSetEventFlag) costs 3.9 us and a clock read 0.7 us. The GE worker's
ring signalled its consumer on every post and its producer after every job,
and read the clock twice a job; with the split renderer that is a job per
draw, some 1,500 signals and 3,000 clock reads a frame across the walker and
the GL thread. Now:

- GeWorker signals the consumer only when it may be asleep (a flag set
  before its last look at the ring) and a waiter for space or completion only
  when there is one; both sides are sequentially consistent and every sleep
  still times out, so no wake-up is lost.
- No per-job timing. A worker can add its sleeps to a phase (WalkIdle,
  GlIdle); a thread's busy time is the frame less those. New phases also
  say what the guest waited for (GeSync: sceGeDrawSync/ListSync; FlipWait:
  frames in flight) and when the walker waited for the GL thread
  (SplitWait). The kernel's real-time sleeps count as Idle.
- The split's draw slots give back vertex and index storage above 256
  vertices / 1,024 indices: storage circulates through every slot, so each
  grew to the largest draw it had carried (the heap grew by 50 MiB in two
  minutes). The ring is 1,024 draws.
- Developer switches for measuring: <PREFIX>_GE_SPLIT_SLOTS,
  _GE_SPLIT_PRESENTS_AHEAD, _GE_SPLIT_EARLY_SYNC (a job completes when walked,
  not drawn; measured slower on the Vita, off).
- The walker reports when thread_local is shared between threads (a C++
  runtime linked single-threaded), which had made Split run every GL call
  on the walker.
- sceGe list/sync calls are in the <PREFIX>_TRACE_PACING trace, which now
  writes through std::cout so that a platform logging the streams gets it.

Mission 1 on the console with the bot: 25 fps before (one thread really),
30-31 after. Desktop: framework tests pass; replays of three dump sets
(337 frames) byte-identical to the reference, inline and threaded.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/host/gpu/ge_worker.cpp b/host/gpu/ge_worker.cpp
index 732ab25..988a236 100644
--- a/host/gpu/ge_worker.cpp
+++ b/host/gpu/ge_worker.cpp
@@ -1,5 +1,7 @@
 #include "gpu/ge_worker.hpp"
 
+#include "perf/phase_timers.hpp"
+
 #include "kernel/kernel_platform.hpp"
 #include "settings/port_settings.hpp"
 #include "profile.hpp"
@@ -132,21 +134,34 @@ GeWorker::~GeWorker() {
 
 void GeWorker::post(Job job) {
     const std::uint64_t tail = tail_.load(std::memory_order_relaxed);
-    while (tail - head_.load(std::memory_order_acquire) >= capacity_) {
+    if (tail - head_.load(std::memory_order_acquire) >= capacity_) {
         // Full: the GE thread is behind by a whole ring. Wait for it in host time.
-        if (g_platform.event_wait != nullptr && space_event_ != nullptr) g_platform.event_wait(space_event_, kSleepUs);
+        space_waiters_.fetch_add(1u, std::memory_order_seq_cst);
+        while (tail - head_.load(std::memory_order_seq_cst) >= capacity_) {
+            if (g_platform.event_wait != nullptr && space_event_ != nullptr) g_platform.event_wait(space_event_, kSleepUs);
+        }
+        space_waiters_.fetch_sub(1u, std::memory_order_relaxed);
     }
     slots_[tail % capacity_].job = std::move(job);
-    tail_.store(tail + 1u, std::memory_order_release);
+    tail_.store(tail + 1u, std::memory_order_seq_cst);
     posted_.store(tail + 1u, std::memory_order_release);
-    if (g_platform.event_signal != nullptr && work_event_ != nullptr) g_platform.event_signal(work_event_);
+    if (consumer_sleeping_.load(std::memory_order_seq_cst) && g_platform.event_signal != nullptr && work_event_ != nullptr)
+        g_platform.event_signal(work_event_);
 }
 
 void GeWorker::wait_completed(std::uint64_t target) {
-    while (completed() < target) {
+    if (completed() >= target) return;
+    space_waiters_.fetch_add(1u, std::memory_order_seq_cst);
+    while (completed_.load(std::memory_order_seq_cst) < target) {
         if (g_platform.event_wait != nullptr && space_event_ != nullptr)
             g_platform.event_wait(space_event_, kSleepUs);
     }
+    space_waiters_.fetch_sub(1u, std::memory_order_relaxed);
+}
+
+void GeWorker::signal_space() noexcept {
+    if (space_waiters_.load(std::memory_order_seq_cst) != 0u && g_platform.event_signal != nullptr && space_event_ != nullptr)
+        g_platform.event_signal(space_event_);
 }
 
 void GeWorker::nap_on_ge_thread(std::uint64_t us) {
@@ -163,35 +178,40 @@ void GeWorker::run_loop() {
         const std::uint64_t head = head_.load(std::memory_order_relaxed);
         if (head == tail_.load(std::memory_order_acquire)) {
             if (stop_.load(std::memory_order_acquire) && head == tail_.load(std::memory_order_acquire)) return;
-            if (g_platform.event_wait != nullptr && work_event_ != nullptr) g_platform.event_wait(work_event_, kSleepUs);
+            consumer_sleeping_.store(true, std::memory_order_seq_cst);
+            if (head == tail_.load(std::memory_order_seq_cst) && !stop_.load(std::memory_order_acquire) &&
+                g_platform.event_wait != nullptr && work_event_ != nullptr) {
+                const std::uint64_t asleep = idle_phase_ >= 0 ? phase::stamp() : 0u;
+                g_platform.event_wait(work_event_, kSleepUs);
+                if (idle_phase_ >= 0 && phase::enabled())
+                    phase::add(static_cast<phase::Phase>(idle_phase_), phase::stamp() - asleep);
+            }
+            consumer_sleeping_.store(false, std::memory_order_relaxed);
             continue;
         }
         Slot &slot = slots_[head % capacity_];
-        const std::uint64_t start = g_platform.monotonic_us != nullptr ? g_platform.monotonic_us() : 0u;
         if (slot.job) slot.job();
         slot.job = nullptr;
-        if (g_platform.monotonic_us != nullptr)
-            busy_us_.fetch_add(g_platform.monotonic_us() - start, std::memory_order_relaxed);
-        head_.store(head + 1u, std::memory_order_release);
+        head_.store(head + 1u, std::memory_order_seq_cst);
         if (forwarder_ != nullptr) {
             // Someone else finishes this job's work: they publish its completion (mark_completed). The producer may be
             // waiting for ring space, which the head just made.
             forwarder_(forwarder_context_, head + 1u);
-            if (g_platform.event_signal != nullptr && space_event_ != nullptr) g_platform.event_signal(space_event_);
+            signal_space();
             continue;
         }
-        completed_.store(head + 1u, std::memory_order_release);
+        completed_.store(head + 1u, std::memory_order_seq_cst);
         // The guest may be waiting for this job (sceGeDrawSync, a full ring, a frame in flight): wake it.
-        if (g_platform.event_signal != nullptr && space_event_ != nullptr) g_platform.event_signal(space_event_);
+        signal_space();
         if (wake_hook_ != nullptr) wake_hook_();
     }
 }
 
 void GeWorker::mark_completed(std::uint64_t value) {
     std::uint64_t current = completed_.load(std::memory_order_acquire);
-    while (current < value && !completed_.compare_exchange_weak(current, value, std::memory_order_acq_rel)) {
+    while (current < value && !completed_.compare_exchange_weak(current, value, std::memory_order_seq_cst)) {
     }
-    if (g_platform.event_signal != nullptr && space_event_ != nullptr) g_platform.event_signal(space_event_);
+    signal_space();
     if (wake_hook_ != nullptr) wake_hook_();
 }
 
@@ -229,6 +249,11 @@ bool GeWorker::run_with_guest_thread(void (*guest)(void *), void *arg, int guest
 
 GeWorker &ge_worker() {
     static GeWorker worker;
+    static const bool timed = [] {
+        worker.set_idle_phase(phase::WalkIdle);   // the GE thread's sleeps: its busy time is the rest
+        return true;
+    }();
+    (void)timed;
     return worker;
 }
 
