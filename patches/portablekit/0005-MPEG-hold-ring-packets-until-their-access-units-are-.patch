+// <prefix>_TRACE_SWITCH=<seconds>: one line per switch to a thread and per wake-up, from that
+// moment of emulated time on (1 or 0: from the start).
+bool trace_switch_on(std::uint64_t now_us) {
+    static const char *text = portablekit::env("TRACE_SWITCH");
+    static const std::uint64_t from_us = text != nullptr ? static_cast<std::uint64_t>(std::strtod(text, nullptr) * 1e6) : 0u;
+    return text != nullptr && now_us >= from_us;
+}
 constexpr std::int32_t kInterruptIdentity = -2;
