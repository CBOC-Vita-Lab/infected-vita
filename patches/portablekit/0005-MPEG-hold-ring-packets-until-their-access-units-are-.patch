 // Interpreted instructions without a system call before the spin hook fires.
@@ -419,8 +427,7 @@ void Kernel::thread_body(Thread &thread) {
 }
 
 void Kernel::run_thread(Thread &thread) {
-    static const bool trace_switch = portablekit::env("TRACE_SWITCH") != nullptr;
-    if (trace_switch)
+    if (trace_switch_on(now_us_))
         std::fprintf(stderr, "[switch] t=%llu -> %s(%d prio %u) pc=0x%08X\n", static_cast<unsigned long long>(now_us_),
                      thread.name.c_str(), thread.uid, thread.priority, thread.context.pc);
     thread.status = ThreadStatus::Running;
@@ -592,8 +599,7 @@ void Kernel::block(AllegrexContext &ctx, const WaitState &wait, std::uint32_t re
 }
 
 void Kernel::wake(Thread &thread, std::uint32_t result) {
-    static const bool trace_switch = portablekit::env("TRACE_SWITCH") != nullptr;
-    if (trace_switch)
+    if (trace_switch_on(now_us_))
         std::fprintf(stderr, "[wake] t=%llu %s(prio %u) result=0x%X by=%s\n", static_cast<unsigned long long>(now_us_),
                      thread.name.c_str(), thread.priority, result,
                      current_thread() != nullptr ? current_thread()->name.c_str() : "idle/irq");
@@ -900,7 +906,30 @@ void Kernel::remove_waiter(Thread &thread) {
     }
 }
 
+// <prefix>_THREAD_BACKTRACE=1: with each thread in the dump, the return addresses found on its
+// guest stack (words that follow a jal or jalr), innermost first. A guess, not an unwinder.
+std::string Kernel::guest_backtrace(const Thread &thread) const {
+    std::string text = " sp=" + psprecomp::hex32(thread.context.gpr[29]) + " bt=";
+    const std::uint32_t sp = thread.context.gpr[29];
+    const std::uint32_t top = thread.stack_bottom + thread.stack_size;
+    int found = 0;
+    auto &memory = runtime_->memory();
+    for (std::uint32_t address = sp; address < top && address < sp + 0x1000u && found < 16; address += 4u) {
+        if (!memory.contains(address, 4u)) break;
+        const std::uint32_t value = memory.load32(address);
+        if ((value & 3u) != 0u || value < 0x08804000u || value >= 0x0A000000u || !memory.contains(value - 8u, 4u)) continue;
+        const std::uint32_t call = memory.load32(value - 8u);
+        const bool is_jal = (call >> 26u) == 3u;
+        const bool is_jalr = (call >> 26u) == 0u && (call & 0x3Fu) == 9u;
+        if (!is_jal && !is_jalr) continue;
+        text += " " + psprecomp::hex32(value);
+        ++found;
+    }
+    return text;
+}
+
 std::string Kernel::describe_threads() const {
+    static const bool backtraces = portablekit::env("THREAD_BACKTRACE") != nullptr;
     std::string report = "threads (virtual time " + std::to_string(now_us_ / 1000u) + " ms, vblanks " +
                          std::to_string(vblank_count_) + "):";
     for (const auto &[uid, thread] : threads_) {
@@ -922,6 +951,7 @@ std::string Kernel::describe_threads() const {
             if (thread->wait.deadline_us) report += " deadline=" + std::to_string(*thread->wait.deadline_us / 1000u) + "ms";
         }
         if (thread->status != ThreadStatus::Dormant) report += " pc=" + psprecomp::hex32(thread->context.pc);
+        if (thread->status != ThreadStatus::Dormant && backtraces) report += guest_backtrace(*thread);
     }
     return report;
 }
