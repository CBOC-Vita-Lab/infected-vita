--- a/host/hle/hle_mpeg.cpp
+++ b/host/hle/hle_mpeg.cpp
@@ -24,6 +24,7 @@
 
 #include <algorithm>
 #include <cstdlib>
+#include <deque>
 #include <iostream>
 #include <map>
 #include <memory>
@@ -82,12 +83,35 @@ bool trace_mpeg() {
     return enabled;
 }
 
+// <prefix>_MPEG_EAGER_RELEASE=1: hand a pack back to the feeder as soon as it
+// has been demultiplexed, which is how this library behaved before packs were
+// held until their access units were taken (see MpegState::held).
+bool eager_pack_release() {
+    static const bool enabled = portablekit::env("MPEG_EAGER_RELEASE") != nullptr;
+    return enabled;
+}
+
 struct MpegState {
     std::uint32_t mpeg{};        // guest address of the SceMpeg variable
     std::uint32_t work{};        // the work area sceMpegCreate was given
     std::uint32_t ringbuffer{};
     std::uint32_t stream_packets{};  // packets in the movie, from its header
     std::uint32_t packets_demuxed{};
+    // Packs the demultiplexer has read whose access units the game has not all
+    // taken yet. A pack stays in the ring (it counts as filled, so neither the
+    // feeder's room nor sceMpegRingbufferAvailableSize give it back) until the
+    // game has fetched every unit of a registered stream that was complete
+    // when the pack was read. A game that tests for an entirely free ring to
+    // tell that the movie is over (the only way to know with a read callback
+    // that signals the end of the file early) then never sees it free while
+    // a frame or an audio block it has not fetched is still queued here.
+    struct HeldPack {
+        std::uint64_t video;  // units of the stream that had to be taken before the pack is free
+        std::uint64_t audio;
+    };
+    std::deque<HeldPack> held;
+    std::uint64_t video_taken{};
+    std::uint64_t audio_taken{};
     std::map<std::uint32_t, StreamType> streams;  // handle -> type
     std::uint32_t next_stream{};
     movie::PsmfDemuxer demuxer;
@@ -153,9 +177,33 @@ void write_unit(psprecomp::GuestMemory &memory, std::uint32_t address, const mov
     memory.store32(address + au::kSize, static_cast<std::uint32_t>(unit.data.size()));
 }
 
+// Streams the game has registered: units of a stream nobody fetches from must
+// not keep packs in the ring.
+bool stream_registered(const MpegState &state, StreamType type) {
+    return std::any_of(state.streams.begin(), state.streams.end(),
+                       [type](const auto &entry) { return entry.second == type; });
+}
+
+// Gives the feeder back the packs whose access units have all been taken.
+void release_held_packs(psprecomp::GuestMemory &memory, MpegState &state) {
+    if (state.ringbuffer == 0u) {
+        state.held.clear();
+        return;
+    }
+    std::uint32_t freed = 0u;
+    while (!state.held.empty() && state.held.front().video <= state.video_taken &&
+           state.held.front().audio <= state.audio_taken) {
+        state.held.pop_front();
+        ++freed;
+    }
+    if (freed == 0u) return;
+    const std::uint32_t filled = memory.load32(state.ringbuffer + ring::kFilled);
+    memory.store32(state.ringbuffer + ring::kFilled, filled > freed ? filled - freed : 0u);
+}
+
 // Demultiplexes packs out of the ring until `ready` holds or the ring is
-// empty. Consumed packets are handed back to the feeder at once: their
-// contents now live in the demultiplexer's queues.
+// empty. A pack is handed back to the feeder once the game has taken every
+// unit that was complete when it was read (release_held_packs).
 template <typename Ready>
 bool demux_until(psprecomp::GuestMemory &memory, MpegState &state, Ready ready) {
     const std::uint32_t buffer = state.ringbuffer;
@@ -164,8 +212,9 @@ bool demux_until(psprecomp::GuestMemory &memory, MpegState &state, Ready ready)
     const std::uint32_t data = memory.load32(buffer + ring::kData);
     std::vector<std::uint8_t> pack(movie::kPackSize);
     while (!ready()) {
-        std::uint32_t filled = memory.load32(buffer + ring::kFilled);
-        if (filled == 0u || packets == 0u) {
+        const std::uint32_t filled = memory.load32(buffer + ring::kFilled);
+        const std::uint32_t unread = filled > state.held.size() ? filled - static_cast<std::uint32_t>(state.held.size()) : 0u;
+        if (unread == 0u || packets == 0u) {
             if (state.stream_packets != 0u && state.packets_demuxed >= state.stream_packets) {
                 state.demuxer.end_of_stream();
                 return ready();
@@ -177,8 +226,15 @@ bool demux_until(psprecomp::GuestMemory &memory, MpegState &state, Ready ready)
         (void)state.demuxer.push_pack(pack);
         ++state.packets_demuxed;
         memory.store32(buffer + ring::kRead, (read + 1u) % packets);
-        memory.store32(buffer + ring::kFilled, filled - 1u);
         if (state.stream_packets != 0u && state.packets_demuxed >= state.stream_packets) state.demuxer.end_of_stream();
+        if (eager_pack_release()) {
+            memory.store32(buffer + ring::kFilled, filled - 1u);
+            continue;
+        }
+        state.held.push_back(MpegState::HeldPack{
+            stream_registered(state, StreamType::Avc) ? state.video_taken + state.demuxer.video_queued() : 0u,
+            stream_registered(state, StreamType::Atrac) ? state.audio_taken + state.demuxer.audio_queued() : 0u});
+        release_held_packs(memory, state);
     }
     return true;
 }
@@ -374,9 +430,19 @@ void register_library(HleRegistrar &hle) {
         finish_traced(ctx, "sceMpegQueryAtracEsSize", 0u, {}, 3u);
     });
     // Drops everything demultiplexed so far, for a restart or a stop.
-    hle.add("sceMpeg", "sceMpegFlushAllStream", [](Runtime &, AllegrexContext &ctx) {
+    hle.add("sceMpeg", "sceMpegFlushAllStream", [](Runtime &rt, AllegrexContext &ctx) {
         if (MpegState *state = find_mpeg(arg(ctx, 0))) {
             state->demuxer.reset();
+            state->video_taken = state->audio_taken = 0u;
+            if (state->ringbuffer != 0u) {
+                // What was held is gone with the units; the ring keeps the
+                // packs nobody has read yet.
+                auto &memory = rt.memory();
+                const auto held = static_cast<std::uint32_t>(state->held.size());
+                const std::uint32_t filled = memory.load32(state->ringbuffer + ring::kFilled);
+                memory.store32(state->ringbuffer + ring::kFilled, filled > held ? filled - held : 0u);
+            }
+            state->held.clear();
             state->video.reset();
             state->video_unit.reset();
             state->audio_unit.reset();
@@ -397,6 +463,8 @@ void register_library(HleRegistrar &hle) {
             return;
         }
         state->video_unit = state->demuxer.pop_video();
+        ++state->video_taken;
+        release_held_packs(memory, *state);
         write_unit(memory, arg(ctx, 2), *state->video_unit);
         if (arg(ctx, 3) != 0u) memory.store32(arg(ctx, 3), 1u);
         finish_traced(ctx, "sceMpegGetAvcAu", 0u,
@@ -416,6 +484,8 @@ void register_library(HleRegistrar &hle) {
             return;
         }
         state->audio_unit = state->demuxer.pop_audio();
+        ++state->audio_taken;
+        release_held_packs(memory, *state);
         write_unit(memory, arg(ctx, 2), *state->audio_unit);
         if (arg(ctx, 3) != 0u) memory.store32(arg(ctx, 3), 0u);
         finish_traced(ctx, "sceMpegGetAtracAu", 0u, "pts=" + std::to_string(state->audio_unit->pts));
