+// Prints the result of a traced call: `[ret]` with the thread, the import and v0 and v1.
+void post_import(psprecomp::Runtime &, psprecomp::AllegrexContext &ctx) {
+    State &s = state();
+    const auto pending = s.pending_result.find(psprecomp::runtime_thread_uid());
+    if (pending == s.pending_result.end()) return;
+    std::printf("[ret]  %10llu us                    %-14s %s v0=%08X v1=%08X\n",
+                static_cast<unsigned long long>(kernel().now_us()), psprecomp::runtime_thread_name(),
+                pending->second.c_str(), ctx.gpr[2], ctx.gpr[3]);
+    s.pending_result.erase(pending);
+}
