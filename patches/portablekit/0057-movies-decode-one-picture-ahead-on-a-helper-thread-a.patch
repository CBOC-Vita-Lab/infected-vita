diff --git a/host/movie/yuv_convert.hpp b/host/movie/yuv_convert.hpp
new file mode 100644
index 0000000..4b620cd
--- /dev/null
+++ b/host/movie/yuv_convert.hpp
@@ -0,0 +1,115 @@
+#pragma once
+
+// One row of a planar YCbCr 4:2:0 picture as 8-bit R, G, B, A (BT.601; limited-range luma is stretched to full range), the
+// conversion the movie player runs for every picture it hands to the game. It was a per-pixel loop with three std::clamp and two
+// heap-allocated row buffers: about 16 ms of a 480 x 272 picture on a 444 MHz Cortex-A9, half of the time the intro movie had
+// for a frame. This header is the same arithmetic, in the same integer steps, so the output is bit-identical:
+//   luma = (y - 16) * 76309 (limited) or y * 65536 (full); cb, cr minus 128;
+//   R = clamp((luma + 91881 cr) >> 16), G = clamp((luma - 22554 cb - 46802 cr) >> 16), B = clamp((luma + 116130 cb) >> 16).
+// The scalar form needs one table lookup per term and one chroma sample per two pixels; with NEON eight pixels go at once.
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+
+#if defined(__ARM_NEON) && !defined(PORTABLEKIT_NO_NEON)
+#include <arm_neon.h>
+#define PORTABLEKIT_YUV_NEON 1
+#endif
+
+namespace portablekit::movie {
+
+namespace yuv_detail {
+
+struct Tables {
+    std::int32_t luma_limited[256];
+    std::int32_t luma_full[256];
+    std::int32_t cr_r[256];   // 91881 * (cr - 128)
+    std::int32_t cr_g[256];   // 46802 * (cr - 128)
+    std::int32_t cb_g[256];   // 22554 * (cb - 128)
+    std::int32_t cb_b[256];   // 116130 * (cb - 128)
+    std::uint8_t clip[1024];  // clip[v + 256] = clamp(v, 0, 255) for the shifted sums, which stay inside [-256, 767]
+    Tables() {
+        for (int i = 0; i < 256; ++i) {
+            luma_limited[i] = (i - 16) * 76309;
+            luma_full[i] = i * (1 << 16);
+            cr_r[i] = 91881 * (i - 128);
+            cr_g[i] = 46802 * (i - 128);
+            cb_g[i] = 22554 * (i - 128);
+            cb_b[i] = 116130 * (i - 128);
+        }
+        for (int v = -256; v < 768; ++v) clip[v + 256] = static_cast<std::uint8_t>(std::clamp(v, 0, 255));
+    }
+};
+
+inline const Tables &tables() {
+    static const Tables instance;
+    return instance;
+}
+
+} // namespace yuv_detail
+
+// `columns` pixels of one row. `y` points at the row's luma, `cb` and `cr` at the chroma row it shares (rows 2k and 2k + 1 use the
+// same one). `out` receives columns * 4 bytes: R, G, B, 0xFF.
+inline void yuv420_row_to_rgba(const std::uint8_t *y, const std::uint8_t *cb, const std::uint8_t *cr, std::uint32_t columns,
+                               bool full_range, std::uint8_t *out) {
+    std::uint32_t column = 0;
+#if defined(PORTABLEKIT_YUV_NEON)
+    {
+        const std::int32_t scale = full_range ? (1 << 16) : 76309;
+        const std::int16_t bias = full_range ? 0 : 16;
+        const int16x8_t y_bias = vdupq_n_s16(bias);
+        const int16x8_t c_bias = vdupq_n_s16(128);
+        for (; column + 8u <= columns; column += 8u) {
+            const uint8x8_t y8 = vld1_u8(y + column);
+            // four chroma samples cover eight pixels: duplicate each
+            uint8x8_t cb4 = vdup_n_u8(0), cr4 = vdup_n_u8(0);
+            std::uint32_t cb_word, cr_word;
+            __builtin_memcpy(&cb_word, cb + column / 2u, 4);
+            __builtin_memcpy(&cr_word, cr + column / 2u, 4);
+            cb4 = vreinterpret_u8_u32(vdup_n_u32(cb_word));
+            cr4 = vreinterpret_u8_u32(vdup_n_u32(cr_word));
+            const uint8x8_t cb8 = vzip_u8(cb4, cb4).val[0];
+            const uint8x8_t cr8 = vzip_u8(cr4, cr4).val[0];
+
+            const int16x8_t y16 = vsubq_s16(vreinterpretq_s16_u16(vmovl_u8(y8)), y_bias);
+            const int16x8_t cb16 = vsubq_s16(vreinterpretq_s16_u16(vmovl_u8(cb8)), c_bias);
+            const int16x8_t cr16 = vsubq_s16(vreinterpretq_s16_u16(vmovl_u8(cr8)), c_bias);
+
+            const int32x4_t luma_lo = vmulq_n_s32(vmovl_s16(vget_low_s16(y16)), scale);
+            const int32x4_t luma_hi = vmulq_n_s32(vmovl_s16(vget_high_s16(y16)), scale);
+            const int32x4_t cb_lo = vmovl_s16(vget_low_s16(cb16)), cb_hi = vmovl_s16(vget_high_s16(cb16));
+            const int32x4_t cr_lo = vmovl_s16(vget_low_s16(cr16)), cr_hi = vmovl_s16(vget_high_s16(cr16));
+
+            const int32x4_t r_lo = vshrq_n_s32(vmlaq_n_s32(luma_lo, cr_lo, 91881), 16);
+            const int32x4_t r_hi = vshrq_n_s32(vmlaq_n_s32(luma_hi, cr_hi, 91881), 16);
+            const int32x4_t g_lo = vshrq_n_s32(vmlsq_n_s32(vmlsq_n_s32(luma_lo, cb_lo, 22554), cr_lo, 46802), 16);
+            const int32x4_t g_hi = vshrq_n_s32(vmlsq_n_s32(vmlsq_n_s32(luma_hi, cb_hi, 22554), cr_hi, 46802), 16);
+            const int32x4_t b_lo = vshrq_n_s32(vmlaq_n_s32(luma_lo, cb_lo, 116130), 16);
+            const int32x4_t b_hi = vshrq_n_s32(vmlaq_n_s32(luma_hi, cb_hi, 116130), 16);
+
+            // saturating narrows clamp to [0, 255]: signed 32 -> unsigned 16 (negative -> 0), then unsigned 16 -> 8
+            uint8x8x4_t pixels;
+            pixels.val[0] = vqmovn_u16(vcombine_u16(vqmovun_s32(r_lo), vqmovun_s32(r_hi)));
+            pixels.val[1] = vqmovn_u16(vcombine_u16(vqmovun_s32(g_lo), vqmovun_s32(g_hi)));
+            pixels.val[2] = vqmovn_u16(vcombine_u16(vqmovun_s32(b_lo), vqmovun_s32(b_hi)));
+            pixels.val[3] = vdup_n_u8(0xFF);
+            vst4_u8(out + static_cast<std::size_t>(column) * 4u, pixels);
+        }
+    }
+#endif
+    const yuv_detail::Tables &t = yuv_detail::tables();
+    const std::int32_t *luma = full_range ? t.luma_full : t.luma_limited;
+    const std::uint8_t *clip = t.clip + 256;
+    for (; column < columns; ++column) {
+        const std::size_t chroma = column / 2u;
+        const std::int32_t l = luma[y[column]];
+        std::uint8_t *pixel = out + static_cast<std::size_t>(column) * 4u;
+        pixel[0] = clip[(l + t.cr_r[cr[chroma]]) >> 16];
+        pixel[1] = clip[(l - t.cb_g[cb[chroma]] - t.cr_g[cr[chroma]]) >> 16];
+        pixel[2] = clip[(l + t.cb_b[cb[chroma]]) >> 16];
+        pixel[3] = 0xFFu;
+    }
+}
+
+} // namespace portablekit::movie
