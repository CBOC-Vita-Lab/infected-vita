+// What the decode-ahead thread needs from the machine, for a platform with its own threads and events (the Vita's: a thread pinned to
+// the idle core with a stack of known size, a kernel event). Without it a std::thread and a condition variable do the same.
+struct DecodeThreadPlatform {
+    void *(*event_create)() = nullptr;                                   // auto-reset event
+    void (*event_destroy)(void *event) = nullptr;
+    void (*event_wait)(void *event, std::uint64_t timeout_us) = nullptr; // returns early once signalled since the last return
+    void (*event_signal)(void *event) = nullptr;
+    // Runs fn(arg) on a new thread pinned to `core` with a stack of `stack_bytes`; returns a handle or nullptr.
+    void *(*thread_start)(void (*fn)(void *), void *arg, const char *name, int core, std::size_t stack_bytes) = nullptr;
+    void (*thread_join)(void *handle) = nullptr;
+    int core = -1;
+};
+void set_decode_thread_platform(const DecodeThreadPlatform &platform) noexcept;
+
