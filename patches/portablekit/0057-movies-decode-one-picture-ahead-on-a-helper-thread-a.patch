+// The default thread and event: std::thread and a condition variable.
+struct DefaultEvent {
+    std::mutex mutex;
+    std::condition_variable wake;
+    bool signalled{};
+};
+void *default_event_create() { return new DefaultEvent(); }
+void default_event_destroy(void *event) { delete static_cast<DefaultEvent *>(event); }
+void default_event_wait(void *event, std::uint64_t timeout_us) {
+    auto *e = static_cast<DefaultEvent *>(event);
+    std::unique_lock<std::mutex> lock(e->mutex);
+    if (!e->signalled) e->wake.wait_for(lock, std::chrono::microseconds(timeout_us));
+    e->signalled = false;
+}
+void default_event_signal(void *event) {
+    auto *e = static_cast<DefaultEvent *>(event);
+    {
+        std::lock_guard<std::mutex> lock(e->mutex);
+        e->signalled = true;
+    }
+    e->wake.notify_all();
+}
+struct DefaultThread {
+    std::thread thread;
+};
+void *default_thread_start(void (*fn)(void *), void *arg, const char *, int, std::size_t) {
+    auto *t = new DefaultThread();
+    t->thread = std::thread([fn, arg] { fn(arg); });
+    return t;
+}
+void default_thread_join(void *handle) {
+    auto *t = static_cast<DefaultThread *>(handle);
+    if (t->thread.joinable()) t->thread.join();
+    delete t;
+}
+
+DecodeThreadPlatform g_decode_platform{&default_event_create, &default_event_destroy, &default_event_wait, &default_event_signal,
+                                       &default_thread_start, &default_thread_join, -1};
+
+} // namespace
