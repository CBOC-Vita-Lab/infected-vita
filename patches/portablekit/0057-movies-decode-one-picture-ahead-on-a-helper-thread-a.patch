+    // ---- decode-ahead (open_async). The guest thread owns `job_unit` and `result` while `state` is Idle, the worker while it is
+    // Queued or Running; the release/acquire pairs on `state` hand them over.
+    enum State : int { Idle = 0, Queued = 1, Done = 2 };
+    DecodeThreadPlatform platform{};
+    void *worker{};
+    void *wake{};      // the worker sleeps on this
+    void *done{};      // the guest thread sleeps on this
+    std::atomic<int> state{Idle};
+    std::atomic<bool> quit{false};
+    std::vector<std::uint8_t> job_unit;
+    Picture result;
+    bool result_produced{};
+    bool in_flight{};  // a unit was handed over and its picture not yet taken (guest thread only)
+
     ~Impl() { close(); }
 
+    void stop_worker() {
+        if (worker == nullptr) return;
+        quit.store(true, std::memory_order_release);
+        platform.event_signal(wake);
+        platform.thread_join(worker);
+        worker = nullptr;
+        platform.event_destroy(wake);
+        platform.event_destroy(done);
+        wake = done = nullptr;
+        state.store(Idle, std::memory_order_release);
+        quit.store(false, std::memory_order_release);
+        in_flight = false;
+    }
+
     void close() {
+        stop_worker();
         avcodec_free_context(&context);
         av_packet_free(&packet);
         av_frame_free(&frame);
         draining = false;
     }
 
+    // The worker: one unit at a time, in order.
+    static void worker_main(void *self) {
+        Impl &impl = *static_cast<Impl *>(self);
+        while (!impl.quit.load(std::memory_order_acquire)) {
+            if (impl.state.load(std::memory_order_acquire) != Queued) {
+                impl.platform.event_wait(impl.wake, 20'000u);
+                continue;
+            }
+            impl.result_produced = impl.decode_now(impl.job_unit, impl.result);
+            impl.state.store(Done, std::memory_order_release);
+            impl.platform.event_signal(impl.done);
+        }
+    }
+
+    // Starts the thread; false when there is none (the caller keeps decoding in its own thread).
+    bool start_worker() {
+        static const bool disabled = [] {
+            const char *text = portablekit::env("MOVIE_ASYNC");
+            return text != nullptr && std::string(text) == "0";
+        }();
+        if (disabled) return false;
+        platform = g_decode_platform;
+        if (platform.event_create == nullptr || platform.thread_start == nullptr || platform.thread_join == nullptr ||
+            platform.event_wait == nullptr || platform.event_signal == nullptr || platform.event_destroy == nullptr)
+            return false;
+        wake = platform.event_create();
+        done = platform.event_create();
+        state.store(Idle, std::memory_order_release);
+        quit.store(false, std::memory_order_release);
+        worker = platform.thread_start(&Impl::worker_main, this, "movie-decode", platform.core, 256u * 1024u);
+        if (worker == nullptr) {
+            platform.event_destroy(wake);
+            platform.event_destroy(done);
+            wake = done = nullptr;
+            return false;
+        }
+        return true;
+    }
+
+    // Waits (host time) for the unit in flight and takes its picture into `picture`; the result of that unit.
+    bool collect(Picture &picture) {
+        if (!in_flight) return false;
+        while (state.load(std::memory_order_acquire) != Done) platform.event_wait(done, 2'000u);
+        in_flight = false;
+        const bool produced = result_produced;
+        if (produced) std::swap(picture, result);
+        state.store(Idle, std::memory_order_release);
+        return produced;
+    }
+
+    // One unit through the decoder, in the calling thread.
+    bool decode_now(std::span<const std::uint8_t> unit, Picture &picture) {
+        av_packet_unref(packet);
+        if (av_new_packet(packet, static_cast<int>(unit.size())) < 0) return false;
+        std::memcpy(packet->data, unit.data(), unit.size());
+        if (avcodec_send_packet(context, packet) < 0) return false;
+        return take(picture);
+    }
+
     // Copies the frame FFmpeg holds into `picture`, dropping row padding.
     bool take(Picture &picture) {
         if (avcodec_receive_frame(context, frame) < 0) return false;
@@ -84,6 +224,12 @@ bool AvcDecoder::open() {
