+// yuv420_row_to_rgba (host/movie/yuv_convert.hpp) against the per-pixel conversion it replaced, which is repeated here as the
+// reference: every (y, cb, cr) in both ranges, then random rows of every length from 1 to 41 (the scalar tail after the NEON
+// blocks, odd widths, chroma that changes along the row). Exit status 0 only when every byte is identical.
+#include "movie/yuv_convert.hpp"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <random>
+#include <vector>
+
+namespace {
+
+// The loop that stood in picture_row_to_rgba: one pixel at a time, std::clamp, a division for the chroma index.
+void reference_row(const std::uint8_t *y_row, const std::uint8_t *cb_row, const std::uint8_t *cr_row, std::uint32_t columns,
+                   bool full_range, std::uint8_t *out) {
+    for (std::uint32_t column = 0; column < columns; ++column) {
+        int y = y_row[column];
+        const std::size_t chroma = column / 2u;
+        const int cb = cb_row[chroma] - 128;
+        const int cr = cr_row[chroma] - 128;
+        int scale = 1 << 16;
+        if (!full_range) {
+            y -= 16;
+            scale = 76309;
+        }
+        const int luma = y * scale;
+        std::uint8_t *pixel = out + static_cast<std::size_t>(column) * 4u;
+        pixel[0] = static_cast<std::uint8_t>(std::clamp((luma + 91881 * cr) >> 16, 0, 255));
+        pixel[1] = static_cast<std::uint8_t>(std::clamp((luma - 22554 * cb - 46802 * cr) >> 16, 0, 255));
+        pixel[2] = static_cast<std::uint8_t>(std::clamp((luma + 116130 * cb) >> 16, 0, 255));
+        pixel[3] = 0xFFu;
+    }
+}
+
+} // namespace
+
+int main() {
+    long checked = 0, bad = 0;
+    // 1. every colour, 256 pixels (a multiple of 8) per row
+    {
+        std::vector<std::uint8_t> y(256), cb(128), cr(128), got(256 * 4), want(256 * 4);
+        for (int i = 0; i < 256; ++i) y[i] = static_cast<std::uint8_t>(i);
+        for (int range = 0; range < 2; ++range)
+            for (int b = 0; b < 256; ++b)
+                for (int r = 0; r < 256; ++r) {
+                    std::fill(cb.begin(), cb.end(), static_cast<std::uint8_t>(b));
+                    std::fill(cr.begin(), cr.end(), static_cast<std::uint8_t>(r));
+                    portablekit::movie::yuv420_row_to_rgba(y.data(), cb.data(), cr.data(), 256, range == 1, got.data());
+                    reference_row(y.data(), cb.data(), cr.data(), 256, range == 1, want.data());
+                    checked += 256;
+                    if (got != want) {
+                        if (bad++ < 5) std::printf("MISMATCH range %d cb %d cr %d\n", range, b, r);
+                    }
+                }
+    }
+    // 2. random rows of every length
+    {
+        std::mt19937 rng(12345);
+        for (int round = 0; round < 4000; ++round) {
+            const std::uint32_t columns = 1u + static_cast<std::uint32_t>(round % 41);
+            const bool full = (round & 1) != 0;
+            std::vector<std::uint8_t> y(columns + 16), cb(columns / 2 + 16), cr(columns / 2 + 16);
+            std::vector<std::uint8_t> got(columns * 4 + 16, 0xEE), want(columns * 4 + 16, 0xEE);
+            for (auto &v : y) v = static_cast<std::uint8_t>(rng());
+            for (auto &v : cb) v = static_cast<std::uint8_t>(rng());
+            for (auto &v : cr) v = static_cast<std::uint8_t>(rng());
+            portablekit::movie::yuv420_row_to_rgba(y.data(), cb.data(), cr.data(), columns, full, got.data());
+            reference_row(y.data(), cb.data(), cr.data(), columns, full, want.data());
+            checked += columns;
+            if (got != want) {   // the guard bytes past the row are compared too: nothing may be written beyond it
+                if (bad++ < 5) std::printf("MISMATCH random row, %u columns, %s\n", columns, full ? "full" : "limited");
+            }
+        }
+    }
+#if defined(PORTABLEKIT_YUV_NEON)
+    const char *path = "NEON blocks of 8 + scalar tail";
+#else
+    const char *path = "scalar tables";
+#endif
+    std::printf("%s: %ld pixels checked, %ld mismatching rows -> %s\n", path, checked, bad, bad == 0 ? "OK" : "FAILED");
+    return bad == 0 ? 0 : 1;
+}
