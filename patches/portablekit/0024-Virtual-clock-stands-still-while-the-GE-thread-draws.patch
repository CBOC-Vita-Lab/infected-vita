 }
 
-void Kernel::wait_host(AllegrexContext &ctx, std::optional<std::uint64_t> timeout_us, HostWaitPoll poll) {
+void Kernel::wait_host(AllegrexContext &ctx, std::optional<std::uint64_t> timeout_us, HostWaitPoll poll, bool zero_time) {
     // Already satisfied: no thread switch.
     if (const auto result = poll(false)) {
         finish(ctx, *result);
@@ -648,6 +649,7 @@ void Kernel::wait_host(AllegrexContext &ctx, std::optional<std::uint64_t> timeou
     }
     WaitState wait{};
     wait.type = WaitType::Host;
+    wait.zero_time = zero_time;
     if (timeout_us) wait.deadline_us = now_us() + *timeout_us;
     wait.host_poll = std::move(poll);
     // The poll result replaces v0 when the wait ends.
@@ -853,6 +855,13 @@ bool Kernel::pace_to_real_time() {
     return true;
 }
 
+bool Kernel::zero_time_host_wait_pending() const {
+    return std::any_of(threads_.begin(), threads_.end(), [](const auto &entry) {
+        return entry.second->status == ThreadStatus::Waiting && entry.second->wait.type == WaitType::Host &&
+               entry.second->wait.zero_time;
+    });
+}
+
 std::optional<std::uint64_t> Kernel::next_event_us() const {
     std::optional<std::uint64_t> next = next_vblank_us_;
     const auto consider = [&](std::uint64_t value) {
