     return names;
@@ -2275,6 +2277,18 @@ void GlRenderer::begin_display_list() {
     if (!impl.ready) return;
     impl.flush();
     if (impl.hd.tick(impl.frames)) clear_texture_cache();  // gfx.hd_textures changed: every texture is uploaded again
+    if (impl.settings.stats_every != 0u && impl.frames >= impl.next_stats_frame) {
+        const bool first = impl.next_stats_frame == 0u;
+        impl.next_stats_frame = impl.frames + impl.settings.stats_every;
+        if (!first) {
+            const HdStats &h = impl.hd.stats();
+            std::cout << "[gl] textures: " << impl.textures.size() << " cached " << (impl.texture_bytes >> 10u) << " KiB of "
+                      << (impl.settings.texture_budget >> 20u) << " MB | hd " << hd_mode_name(impl.hd.mode()) << ": resident "
+                      << h.resident_textures << " tex " << (h.resident_bytes >> 10u) << " KiB (peak " << (h.peak_bytes >> 10u)
+                      << " KiB), hits " << h.hits << ", misses " << h.misses << ", over budget " << h.skipped_budget
+                      << ", failed " << h.upload_failed << ", read " << (h.blob_bytes >> 10u) << " KiB" << std::endl;
+        }
+    }
     ++impl.list_serial;
     impl.clut_hashes.clear();
     impl.target_verdicts.clear();
