diff --git a/host/kernel/kernel.cpp b/host/kernel/kernel.cpp
index 6058803..ba0b1c9 100644
--- a/host/kernel/kernel.cpp
+++ b/host/kernel/kernel.cpp
@@ -554,6 +554,7 @@ void Kernel::scheduler_loop() {
                 return;
             }
             if (clock_mode_ == ClockMode::Realtime) sleep_until_event(*next);
+            else if (zero_time_host_wait_pending()) sleep_host(200u);   // the GE thread is drawing: the clock waits for it
