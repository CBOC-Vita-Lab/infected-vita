+        check(replay.size() == 2u && replay[0] == expected && replay[1] == unit_of(false),
+              "the replay starts with the parameter sets, in front of the IDR unit that has none");
+        // Taking over at an IDR unit that has its own sets after a replay that needs none added.
+        check(session.show(memory, destination, stride, first_idr, pts_of(7), true), "replaced again at picture 7");
+        check(!session.show(memory, destination, stride, unit_of(false), pts_of(8), false), "the original again at picture 8");
+        const auto again = session.take_replay();
+        check(again.size() == 1u && again[0] == first_idr, "an IDR unit with its sets is replayed as it is");
+    }
     check(g_closed, "the source is closed with the session");
+    check(!HdSession::any_live(), "no session exists after the last");
+
+    // A source that cannot be opened (no decoder, the decoder is busy): the original plays, every time, without a retry per picture.
+    g_fail_open = true;
+    {
+        HdSession session(movie, timing);
+        bool any = false;
+        for (int i = 0; i < 3; ++i) any = any || session.show(memory, destination, stride, unit_of(i == 0), 90000 + 3003 * i, true);
+        check(!any, "a source that cannot open leaves every picture to the original");
+        check(session.original() == 3u && session.shown() == 0u, "and the session counts them as original");
+    }
+    g_fail_open = false;
     set_hd_source_factory(nullptr);
 }
 
