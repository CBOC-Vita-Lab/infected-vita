+namespace {
+
+// Calls `visit(type, begin, end)` for every NAL unit of an Annex B access unit; `end` leaves out the zero bytes in front of the next start code.
+template <typename Visit>
+void for_each_nal(std::span<const std::uint8_t> unit, Visit visit) {
+    std::size_t begin = 0u;
+    bool open = false;
+    const auto close = [&](std::size_t stop) {
+        while (stop > begin && unit[stop - 1u] == 0u) --stop;
+        if (stop > begin) visit(static_cast<unsigned>(unit[begin] & 0x1Fu), begin, stop);
+    };
+    for (std::size_t i = 0; i + 2u < unit.size(); ++i) {
+        if (unit[i] == 0u && unit[i + 1u] == 0u && unit[i + 2u] == 1u) {
+            if (open) close(i);
+            begin = i + 3u;
+            open = begin < unit.size();
+            i += 2u;
+        }
+    }
+    if (open) close(unit.size());
+}
+
+}  // namespace
+
+bool has_parameter_sets(std::span<const std::uint8_t> unit) noexcept {
+    bool sps = false, pps = false;
+    for_each_nal(unit, [&](unsigned type, std::size_t, std::size_t) {
+        sps = sps || type == 7u;
+        pps = pps || type == 8u;
+    });
+    return sps && pps;
+}
+
+std::vector<std::uint8_t> extract_parameter_sets(std::span<const std::uint8_t> unit) {
+    std::vector<std::uint8_t> sets;
+    for_each_nal(unit, [&](unsigned type, std::size_t begin, std::size_t end) {
+        if (type != 7u && type != 8u) return;
+        const std::uint8_t start[4] = {0u, 0u, 0u, 1u};
+        sets.insert(sets.end(), start, start + 4);
+        sets.insert(sets.end(), unit.begin() + static_cast<std::ptrdiff_t>(begin), unit.begin() + static_cast<std::ptrdiff_t>(end));
+    });
+    return sets;
+}
