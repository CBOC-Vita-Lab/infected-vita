+bool HdFrameStore::clear_if_unchanged(std::uint64_t serial) {
+    // The pictures are released after the lock: a platform frame's last reference ends in the platform's own code.
+    std::shared_ptr<const HdPicture> dropped[kSlots];
+    {
+        const std::lock_guard<std::mutex> lock(mutex_);
