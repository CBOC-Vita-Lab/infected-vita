+    [[nodiscard]] static std::uint64_t micros_since(Clock::time_point start) {
+        return static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(Clock::now() - start).count());
+    }
+    // Wraps one GL draw: the first one after a target switch is counted apart.
+    template <typename Draw> void timed_draw(Draw &&draw) {
+        if (settings.timing == 0u) {
+            draw();
+            scene_fresh = false;
+            return;
+        }
+        const Clock::time_point start = Clock::now();
+        draw();
+        const std::uint64_t us = micros_since(start);
+        if (scene_fresh) {
+            gt.first_us += us;
+            gt.max_first_us = std::max(gt.max_first_us, us);
+            ++gt.firsts;
+        } else {
+            gt.draw_us += us;
+            ++gt.draws;
+        }
+        scene_fresh = false;
+    }
