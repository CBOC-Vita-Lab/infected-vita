         if (inv_size != nullptr) uniform(program, glsl::kUInvSize, inv_size);
-        if (!settings.null_draw) glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+        if (!settings.null_draw) timed_draw([] { glDrawArrays(GL_TRIANGLE_STRIP, 0, 4); });
