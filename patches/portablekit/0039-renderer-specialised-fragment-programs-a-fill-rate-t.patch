+    }
     // The post passes: FXAA and the bicubic enlargement (the multisample resolve is a desktop preview and is not built here).
     if (impl.ensure_post_program(impl.fxaa_program, impl.fxaa_failed, [] { return glsl::fxaa_fragment_source(); }, "fxaa")) ++built;
     else ++failed;
diff --git a/host/gpu/gl/gl_renderer.hpp b/host/gpu/gl/gl_renderer.hpp
index bc8687c..78cbc73 100644
--- a/host/gpu/gl/gl_renderer.hpp
+++ b/host/gpu/gl/gl_renderer.hpp
@@ -58,6 +58,11 @@ struct GlSettings {
     bool merge_draws{true};
     // Skip the glDraw* calls (the replayer's null-draw mode: everything else still runs).
     bool null_draw{false};
+    // Cut every game draw and clear to a 2x2 scissor: a test of how much of the frame is the GPU's fill (FILL_TEST=1).
+    bool fill_test{false};
+    // Compile each draw's texture function, alpha comparison and blend fix-up into its fragment program (more programs,
+    // far shorter ones); off, one program per flag set chooses them per fragment from uniforms.
+    bool specialize{true};
