@@ -2106,6 +2114,14 @@ struct GlRenderer::Impl {
             state.alpha[0] = static_cast<float>(call.alpha_test.function);
             state.alpha[1] = static_cast<float>(call.alpha_test.reference);
         }
+        // The texture function, the alpha comparison and the blend fix-up compiled into the fragment program
