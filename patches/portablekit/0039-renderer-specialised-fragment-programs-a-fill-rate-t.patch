+                state.program_flags, static_cast<std::uint32_t>(state.texenv[0] + 0.5f), state.texenv[1] > 0.5f,
+                state.texenv[2] > 0.5f, static_cast<std::uint32_t>(state.alpha[0] + 0.5f),
+                static_cast<std::uint32_t>(state.shader_blend[0] + 0.5f));
+        }
         // Transform.
         if (!through) {
             if (!memo_valid || call.world != memo_world || call.view != memo_view || call.projection != memo_projection) {
@@ -2406,6 +2422,8 @@ bool apply_gl_setting(GlSettings &settings, const std::string &name, const std::
     else if (name == "texture_always_validate") settings.texture_always_validate = flag;
     else if (name == "merge") settings.merge_draws = flag;
     else if (name == "null_draw") settings.null_draw = flag;
+    else if (name == "fill_test") settings.fill_test = flag;
