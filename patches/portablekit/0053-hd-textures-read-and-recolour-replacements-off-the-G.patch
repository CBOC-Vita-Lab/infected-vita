+void GlHdTextures::Loader::build_recolour(const Job &job, Read &read) {
+    HdRecolour recolour;
+    if (!hd_parse_recolour(job.record, read.blob, recolour) || job.clut.empty()) return;
+    std::uint32_t palette[256];
+    read_palette(job.state, job.clut.data(), recolour.palette_entries, palette);
+    const std::uint32_t width = job.record.width, height = job.record.height;
+    const std::uint8_t *base_data = read.blob.data() + recolour.base_offset;
+    std::vector<std::uint32_t> base;
+    if (job.record.format == HdFormat::Rgba8) {
+        base.resize(static_cast<std::size_t>(width) * height);
+        std::memcpy(base.data(), base_data, base.size() * 4u);
+    } else {
+        decode_dxt_level(job.record.format, base_data, width, height, base);
+    }
+    std::vector<std::uint32_t> level(static_cast<std::size_t>(width) * height), next;
+    hd_apply_recolour(recolour, base.data(), palette, level.data());
+    // The chain the GL thread's recolour builds (GlHdTextures::try_recolour), level by level down to 1x1.
+    read.levels.clear();
+    std::uint32_t w = width, h = height;
+    for (;;) {
+        read.levels.insert(read.levels.end(), level.begin(), level.end());
+        if (w == 1u && h == 1u) break;
+        halve(level, w, h, next);
+        level.swap(next);
+        w = std::max(w / 2u, 1u);
+        h = std::max(h / 2u, 1u);
+    }
+    read.width = width;
+    read.height = height;
+    read.blob.clear();
+    read.ok = true;
+}
+
+void GlHdTextures::Loader::run() {
+    for (;;) {
+        Job job;
+        {
+            std::unique_lock<std::mutex> lock(mutex);
+            wake.wait(lock, [this] { return stopping || !queue.empty(); });
+            if (stopping) return;
+            job = std::move(queue.front());
+            queue.pop_front();
+        }
+        Read read;
+        read.ok = pack.read_blob_with(file, job.record, read.blob);
+        if (read.ok && job.recolour) {
+            read.ok = false;
+            build_recolour(job, read);
+        }
+        const std::lock_guard<std::mutex> lock(mutex);
+        done_bytes += read.bytes();
+        done[job.key] = std::move(read);
+        done_order.push_back(job.key);
+        while (done_bytes > kKeptBytes && !done_order.empty()) {
+            const std::uint64_t oldest = done_order.front();
+            done_order.pop_front();
+            const auto found = done.find(oldest);
+            if (found == done.end() || oldest == job.key) continue;
+            done_bytes -= std::min(done_bytes, found->second.bytes());
+            done.erase(found);
+            asked.erase(oldest);
+        }
+        if (done_order.size() > done.size() * 2u + 64u)   // keys claimed long ago
+            std::erase_if(done_order, [this](std::uint64_t key) { return done.count(key) == 0u; });
+        done_count.store(static_cast<std::uint32_t>(done.size()), std::memory_order_release);
+    }
+}
+
+bool GlHdTextures::upload_recoloured(std::uint32_t texture, const std::vector<std::uint32_t> &chain, std::uint32_t width,
+                                     std::uint32_t height, HdTextureInfo &info) {
+    if (bind_) bind_(texture);
+    else glBindTexture(GL_TEXTURE_2D, texture);
+    std::uint64_t gpu_bytes = 0u;
+    std::uint32_t levels = 0u, w = width, h = height;
+    std::size_t offset = 0u;
+    for (;;) {
+        const std::size_t texels = static_cast<std::size_t>(w) * h;
+        if (offset + texels > chain.size()) break;
+        glTexImage2D(GL_TEXTURE_2D, static_cast<GLint>(levels), GL_RGBA, static_cast<GLsizei>(w), static_cast<GLsizei>(h), 0,
+                     GL_RGBA, GL_UNSIGNED_BYTE, chain.data() + offset);
+        gpu_bytes += texels * 4u;
+        offset += texels;
+        ++levels;
+        if (w == 1u && h == 1u) break;
+        w = std::max(w / 2u, 1u);
+        h = std::max(h / 2u, 1u);
+    }
+    if (levels == 0u) return false;
+    ++stats_.recolour_hits;
+    ++stats_.hits;
+    info.replaced = true;
+    info.recoloured = true;
+    info.gpu_bytes = gpu_bytes;
+    info.width = static_cast<std::uint16_t>(width);
+    info.height = static_cast<std::uint16_t>(height);
+    info.mips = static_cast<std::uint8_t>(levels);
+    ++stats_.resident_textures;
+    stats_.resident_bytes += gpu_bytes;
+    stats_.peak_bytes = std::max(stats_.peak_bytes, stats_.resident_bytes);
+    return true;
+}
