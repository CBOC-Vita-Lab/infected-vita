+// ---- the loader thread (HdConfig::async_load) ---------------------------------------------------------------------
+// The GL thread asks for a record's blob and goes on drawing the original; the loader reads it through a handle of its
+// own and leaves it for the GL thread, which uploads it at the texture's next draw (GlHdTextures::ready, upload). Only
+// the reading moves: the upload stays on the GL thread, which owns the GL context.
+struct GlHdTextures::Loader {
+    // What the GL thread asks for: a record's blob, or a recoloured picture (the record of the image, rebuilt for the
+    // palette the texture had when it was asked for).
+    struct Job {
+        HdRecord record;
+        std::uint64_t key{};               // the record's key, or for a recolour the texture's full key (one per palette)
+        bool recolour{};
+        TextureState state;                // a recolour: the palette's format, shift, mask and offset
+        std::vector<std::uint8_t> clut;    // a recolour: the palette's bytes
+    };
+    struct Read {
+        std::vector<std::uint8_t> blob;        // a record's blob
+        std::vector<std::uint32_t> levels;     // a recolour: every mip level, level 0 first
+        std::uint32_t width{}, height{};
+        bool ok{};
+        [[nodiscard]] std::size_t bytes() const noexcept { return blob.size() + levels.size() * 4u; }
+    };
+    // Results not claimed yet are dropped past this (a texture that left the screen before its replacement came).
+    static constexpr std::size_t kKeptBytes = 8u * 1024u * 1024u;
+
+    const HdPackFile &pack;
+    std::FILE *file{};
+    std::mutex mutex;
+    std::condition_variable wake;
+    std::deque<Job> queue;                            // asked, not done yet
+    std::unordered_set<std::uint64_t> asked;          // keys queued, being done, or done and not claimed
+    std::unordered_map<std::uint64_t, Read> done;     // done, not claimed
+    std::deque<std::uint64_t> done_order;             // oldest first, for the cap
+    std::size_t done_bytes{};
+    std::atomic<std::uint32_t> done_count{0u};        // done.size(), read without the lock
+    bool stopping{};
+    std::thread thread;
+
+    explicit Loader(const HdPackFile &source) : pack(source), file(source.open_reader()) {
+        if (file != nullptr) thread = std::thread([this] { run(); });
+    }
+    ~Loader() {
+        {
+            const std::lock_guard<std::mutex> lock(mutex);
+            stopping = true;
+        }
+        wake.notify_all();
+        if (thread.joinable()) thread.join();
+        if (file != nullptr) std::fclose(file);
+    }
+    [[nodiscard]] bool running() const noexcept { return file != nullptr; }
+
+    void request(Job job) {
+        {
+            const std::lock_guard<std::mutex> lock(mutex);
+            if (!asked.insert(job.key).second) return;
+            queue.push_back(std::move(job));
+        }
+        wake.notify_one();
+    }
+    [[nodiscard]] bool has(std::uint64_t key) {
+        if (done_count.load(std::memory_order_acquire) == 0u) return false;
+        const std::lock_guard<std::mutex> lock(mutex);
+        return done.count(key) != 0u;
+    }
+    // The result for `key` if it is done (it leaves the loader).
+    bool take(std::uint64_t key, Read &out) {
+        if (done_count.load(std::memory_order_acquire) == 0u) return false;
+        const std::lock_guard<std::mutex> lock(mutex);
+        const auto found = done.find(key);
+        if (found == done.end()) return false;
+        out = std::move(found->second);
+        done_bytes -= std::min(done_bytes, out.bytes());
+        done.erase(found);
+        asked.erase(key);
+        done_count.store(static_cast<std::uint32_t>(done.size()), std::memory_order_release);
+        return true;
+    }
+
+    void run();   // below, after the picture helpers
+    static void build_recolour(const Job &job, Read &read);
+};
+
 GlHdTextures::GlHdTextures() = default;
 GlHdTextures::~GlHdTextures() = default;
 
+bool GlHdTextures::ready(const HdTextureInfo &info) {
+    return info.pending && loader_ != nullptr && loader_->has(info.key);
+}
