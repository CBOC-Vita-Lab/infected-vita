+
+    // ---- the last rung of Auto: the 3D picture at a smaller scale --------------------------------------------------------
+    // A frame of the game draws the 3D world into the display target, then the glow and blur chain (targets of their own that
+    // sample the display and are composited back onto it), then the HUD (through-mode draws and a few 3D ones, after a depth
+    // clear of its own). With the rung on, a frame that begins with a full-screen clear of the display target (a frame the
+    // one before it showed to be a 3D frame) draws everything up to the HUD into a smaller twin of that target: the twin takes the
+    // display target's place in `targets`, so the glow chain samples it and draws back into it by address, as before. Where the
+    // HUD begins (the rule of FXAA's scene step: a through draw after 32 3D draws that does not sample a target, or a 3D draw after
+    // a composite) the twin is enlarged into the display target with one bilinear pass, the display target's depth is cleared as a
+    // new target's is, and the display target takes its place again: the HUD and the rest of the frame run at full size. A frame
+    // that turns out not to be a 3D one (a through draw before 32 3D draws: a menu) does the same at once, the twin holding no
+    // more than the clear, and draws at full size the rest of the way.
+    enum class SsPhase : std::uint8_t { Idle, Active, Done };
+    SsPhase ss_phase{SsPhase::Done};
+    std::unique_ptr<Target> ss_twin;     // the smaller target, made once (a pre-allocated pair: colour and depth)
+    std::unique_ptr<Target> ss_parked;   // the display target while the twin stands in for it
+    std::uint32_t ss_key{};
+    std::uint32_t ss_draws{};            // 3D draws on the twin this frame
+    bool ss_composite{};
+    bool ss_ended_early{};               // this frame went back to full size before the HUD (not counted as a scaled frame)
+    bool ss_active_frame{};              // this frame began at the smaller scale
+    bool ss_depth_cleared{};
+    std::uint32_t ss_frame_xform{};      // 3D draws on a display-sized target this frame, whether the rung runs or not
+    bool ss_prev_scene{};                // the last frame was a 3D one
+
+    [[nodiscard]] bool scene_scale_armed() const {
+        return settings.scene_scale == 2u || (settings.scene_scale == 1u && opt.scene_scale);
+    }
+
+    // After a present: what the next frame does.
+    void scene_scale_frame_start() {
+        ss_prev_scene = ss_frame_xform >= kFxaaMinDraws;
+        ss_frame_xform = 0u;
+        ss_draws = 0u;
+        ss_composite = false;
+        ss_ended_early = false;
+        ss_active_frame = false;
+        ss_depth_cleared = false;
+        ss_phase = scene_scale_armed() ? SsPhase::Idle : SsPhase::Done;
+    }
+
+    // `call` covers the whole display: a clear of the target as a sprite or as the GE's clear mode.
+    [[nodiscard]] static bool covers_display(const DrawCall &call, const Target &display) {
+        if (call.vertices.size() < 2u || call.texture.enabled) return false;
+        if (!call.through && !call.clear_mode) return false;
+        if (call.primitive != PrimitiveType::Sprites && !call.clear_mode) return false;
+        if (call.pixel_mask_rgb != 0u) return false;   // a depth-only clear leaves the colour: the twin would not hold it
+        const float x0 = std::min(call.vertices[0].position[0], call.vertices[1].position[0]);
+        const float x1 = std::max(call.vertices[0].position[0], call.vertices[1].position[0]);
+        const float y0 = std::min(call.vertices[0].position[1], call.vertices[1].position[1]);
+        const float y1 = std::max(call.vertices[0].position[1], call.vertices[1].position[1]);
+        return x0 <= 0.5f && y0 <= 0.5f && x1 >= static_cast<float>(display.psp_width) - 0.5f && y1 >= static_cast<float>(display.psp_height) - 0.5f;
+    }
+
+    // Makes the twin of a new display target when Auto may need it (so the first scale-down is not a render-target allocation in
+    // the middle of a slow frame: some 3 MB of colour and depth on the console).
+    void scene_scale_prepare(const Target &display) {
+        const bool may = settings.scene_scale == 2u || (settings.scene_scale == 1u && opt.aa_auto && settings.display_scale_percent == 0u && ssaa_scale == 0u);
+        if (!may || display.fbo == 0u) return;
+        if (!ss_twin) ss_twin = std::make_unique<Target>();
+        scene_scale_size_twin(*ss_twin, display);
+    }
+
+    // Gives `twin` the size of `display` at the scene scale, allocating its colour and depth when that changes.
+    void scene_scale_size_twin(Target &twin, const Target &display) {
+        const float scale = display.scale * static_cast<float>(settings.scene_scale_percent) / 100.0f;
+        if (twin.fbo != 0u && twin.stride == display.stride && twin.psp_width == display.psp_width && twin.psp_height == display.psp_height &&
+            twin.scale == scale && twin.format == display.format)
+            return;
+        twin.scene_twin = true;
+        twin.stride = display.stride;
+        twin.format = display.format;
+        twin.psp_width = display.psp_width;
+        twin.psp_height = display.psp_height;
+        twin.scale = scale;
+        allocate_target(twin);
+    }
+
+    bool scene_scale_begin(std::uint32_t key, const DrawCall &call) {
+        const auto found = targets.find(key);
+        if (found == targets.end() || found->second->fbo == 0u || found->second->scene_twin) return false;
+        Target &display = *found->second;
+        if (!covers_display(call, display)) return false;
+        flush();
+        if (!ss_twin) ss_twin = std::make_unique<Target>();
+        Target &twin = *ss_twin;
+        scene_scale_size_twin(twin, display);
+        twin.address = key;
+        twin.guest_words.clear();
+        twin.last_drawn_frame = ~0ull;
+        twin.copy_serial = ~0ull;
+        twin.draw_serial = display.draw_serial + 1u;
+        ss_parked = std::move(found->second);
+        found->second = std::move(ss_twin);
+        ss_key = key;
+        ss_draws = 0u;
+        ss_composite = false;
+        ss_phase = SsPhase::Active;
+        return true;
+    }
+
+    // Enlarges the twin into the display target and puts the display target back. `early`: the frame was no 3D picture after all.
+    void scene_scale_end(bool early) {
+        if (ss_phase != SsPhase::Active) return;
+        flush();
+        const auto found = targets.find(ss_key);
+        Target &twin = *found->second;
+        Target &display = *ss_parked;
+        bind_target(display, "scene scale: enlarge");
+        blit(twin.color, 0, 0, static_cast<std::int32_t>(display.width), static_cast<std::int32_t>(display.height), false, true);
+        ++display.draw_serial;
+        display.guest_words.clear();
+        ss_twin = std::move(found->second);
+        found->second = std::move(ss_parked);
+        ss_phase = SsPhase::Done;
+        ss_ended_early = early;
+        ++st().scene_scale_resolves;
+        if (early) ++st().scene_scale_aborts; else { ++st().scene_scaled_frames; ss_frames.fetch_add(1u, std::memory_order_relaxed); }
+    }
+
+    // Called for every draw on a display-sized target before its target is looked up.
+    void scene_scale_step(const DrawCall &call, const GuestMemory &memory) {
+        if (!call.through && !call.clear_mode) ++ss_frame_xform;
+        if (ss_phase == SsPhase::Done) {
+            // After the enlargement the display target's depth is empty: a 3D draw that tests depth before the game's own depth clear
+            // (a through draw that writes depth) would have met the scene's depth. Counted, to see that it does not happen.
+            if (ss_active_frame && !ss_ended_early && !ss_depth_cleared) {
+                if (call.through && call.depth.write_enabled) ss_depth_cleared = true;
+                else if (!call.through && !call.clear_mode && call.depth.test_enabled) ++st().scene_scale_late_3d;
+            }
+            return;
+        }
+        const std::uint32_t key = GuestMemory::canonical(call.target.color_address);
+        if (ss_phase == SsPhase::Idle) {
+            // The first draw on a display-sized target this frame.
+            ss_phase = SsPhase::Done;
+            if (settings.scene_scale == 2u || ss_prev_scene) {
+                if (scene_scale_begin(key, call)) {
+                    ss_active_frame = true;
+                    ss_phase = SsPhase::Active;
+                }
+            }
+            return;
+        }
+        if (key != ss_key) {   // the other display buffer: this frame is not what the twin was made for
+            scene_scale_end(true);
+            return;
+        }
+        if (call.clear_mode) return;
+        if (call.through) {
+            if (ss_draws < kFxaaMinDraws) {
+                scene_scale_end(true);
+            } else {
+                const bool samples = call.texture.enabled && settings.target_textures && find_target_texture(memory, call.texture).target != nullptr;
+                if (samples) ss_composite = true;
+                else scene_scale_end(false);
+            }
+        } else if (ss_composite && ss_draws >= kFxaaMinDraws) {
+            scene_scale_end(false);
+        } else {
+            ++ss_draws;
+        }
+    }
+
     // ---- the picture on show, the overlay and the counter --------------------------------------------------------
     struct Composed {
         GLuint fbo{};
