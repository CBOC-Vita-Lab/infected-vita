 namespace portablekit::gpu {
 namespace {
 
+// value * 255 / max for every value of a 5- or 6-bit channel: a lookup instead of a division per channel per texel (the
+// results are the same numbers).
+template <std::size_t N> constexpr std::array<std::uint8_t, N> channel_table(std::uint32_t max) {
+    std::array<std::uint8_t, N> table{};
+    for (std::uint32_t v = 0; v < N; ++v) table[v] = static_cast<std::uint8_t>(v * 255u / max);
+    return table;
+}
+constexpr std::array<std::uint8_t, 32> kChannel5 = channel_table<32>(31u);
+constexpr std::array<std::uint8_t, 64> kChannel6 = channel_table<64>(63u);
+
 std::uint32_t expand_5650(std::uint16_t value) {
-    const std::uint32_t r = (value & 0x1Fu) * 255u / 31u;
-    const std::uint32_t g = ((value >> 5u) & 0x3Fu) * 255u / 63u;
-    const std::uint32_t b = ((value >> 11u) & 0x1Fu) * 255u / 31u;
+    const std::uint32_t r = kChannel5[value & 0x1Fu];
+    const std::uint32_t g = kChannel6[(value >> 5u) & 0x3Fu];
+    const std::uint32_t b = kChannel5[(value >> 11u) & 0x1Fu];
     return 0xFF000000u | (b << 16u) | (g << 8u) | r;
 }
 
 std::uint32_t expand_5551(std::uint16_t value) {
-    const std::uint32_t r = (value & 0x1Fu) * 255u / 31u;
-    const std::uint32_t g = ((value >> 5u) & 0x1Fu) * 255u / 31u;
-    const std::uint32_t b = ((value >> 10u) & 0x1Fu) * 255u / 31u;
+    const std::uint32_t r = kChannel5[value & 0x1Fu];
+    const std::uint32_t g = kChannel5[(value >> 5u) & 0x1Fu];
+    const std::uint32_t b = kChannel5[(value >> 10u) & 0x1Fu];
     const std::uint32_t a = ((value >> 15u) & 1u) * 255u;
     return (a << 24u) | (b << 16u) | (g << 8u) | r;
 }
@@ -95,6 +105,93 @@ void unswizzle(std::vector<std::uint8_t> &data, std::uint32_t row_bytes, std::ui
     }
 }
 
+std::uint32_t read_clut(const GuestMemory &memory, const TextureState &texture, std::uint32_t index);
+
+// The same as unswizzle(), from a run of host memory that holds every stored block (swizzled_stored_bytes()) into `destination`
+// (row_bytes * rows bytes): one pass, no copy of the source first.
+void unswizzle_blocks(const std::uint8_t *source, std::uint8_t *destination, std::uint32_t row_bytes, std::uint32_t rows) {
+    const std::uint32_t block_columns = (row_bytes + 15u) / 16u;
+    const std::uint32_t block_rows = (rows + 7u) / 8u;
+    for (std::uint32_t block_row = 0; block_row < block_rows; ++block_row) {
+        for (std::uint32_t block_column = 0; block_column < block_columns; ++block_column) {
+            const std::uint32_t column_bytes = std::min<std::uint32_t>(16u, row_bytes - block_column * 16u);
+            const std::uint8_t *block = source + (static_cast<std::size_t>(block_row) * block_columns + block_column) * 128u;
+            for (std::uint32_t row = 0; row < 8u; ++row) {
+                const std::uint32_t y = block_row * 8u + row;
+                if (y >= rows) break;
+                std::memcpy(destination + static_cast<std::size_t>(y) * row_bytes + static_cast<std::size_t>(block_column) * 16u,
+                            block + row * 16u, column_bytes);
+            }
+        }
+    }
+}
+
+// A palette texture (CLUT4 or CLUT8) read straight from host memory into RGBA: the palette is expanded once, then each texel is
+// one lookup, and a swizzled texture is walked block by block instead of being unswizzled first. Only for a texture whose rows
+// are no narrower than its width and (swizzled) whose blocks are all there; the caller falls back to the general path otherwise.
+// `stored` is the size of the swizzled blocks; the result is the general path's, texel for texel (tests/texture_decode_tests.cpp).
+bool decode_indexed_fused(const GuestMemory &memory, const TextureState &texture, std::uint32_t width, std::uint32_t height,
+                          std::uint32_t row_bytes, std::size_t total, std::size_t stored, std::vector<std::uint32_t> &out) {
+    const bool four_bit = texture.format == TextureFormat::Clut4;
+    if (!four_bit && texture.format != TextureFormat::Clut8) return false;
+    const std::uint32_t texels_per_row = four_bit ? row_bytes * 2u : row_bytes;
+    if (texels_per_row < width) return false;
+    const std::size_t needed = texture.swizzled ? stored : total;
+    if (!memory.contains(texture.address, needed)) return false;
+    const std::uint8_t *source = memory.raw_pointer(texture.address, needed);
+    if (source == nullptr) return false;
+    std::array<std::uint32_t, 256> palette;
+    const std::uint32_t entries = four_bit ? 16u : 256u;
+    for (std::uint32_t i = 0; i < entries; ++i) palette[i] = read_clut(memory, texture, i);
+    std::uint32_t *destination = out.data();
+    if (!texture.swizzled) {
+        for (std::uint32_t y = 0; y < height; ++y) {
+            const std::uint8_t *row = source + static_cast<std::size_t>(y) * row_bytes;
+            std::uint32_t *line = destination + static_cast<std::size_t>(y) * width;
+            if (four_bit) {
+                std::uint32_t x = 0;
+                for (; x + 1u < width; x += 2u) {
+                    const std::uint8_t byte = row[x >> 1u];
+                    line[x] = palette[byte & 0xFu];
+                    line[x + 1u] = palette[byte >> 4u];
+                }
+                if (x < width) line[x] = palette[row[x >> 1u] & 0xFu];
+            } else {
+                for (std::uint32_t x = 0; x < width; ++x) line[x] = palette[row[x]];
+            }
+        }
+        return true;
+    }
+    const std::uint32_t block_columns = (row_bytes + 15u) / 16u;
+    const std::uint32_t block_rows = (height + 7u) / 8u;
+    for (std::uint32_t block_row = 0; block_row < block_rows; ++block_row) {
+        for (std::uint32_t block_column = 0; block_column < block_columns; ++block_column) {
+            const std::uint8_t *block = source + (static_cast<std::size_t>(block_row) * block_columns + block_column) * 128u;
+            const std::uint32_t first = block_column * (four_bit ? 32u : 16u);   // the block's first texel in its row
+            if (first >= width) continue;
+            const std::uint32_t count = std::min<std::uint32_t>(four_bit ? 32u : 16u, width - first);
+            for (std::uint32_t row = 0; row < 8u; ++row) {
+                const std::uint32_t y = block_row * 8u + row;
+                if (y >= height) break;
+                const std::uint8_t *bytes = block + row * 16u;
+                std::uint32_t *line = destination + static_cast<std::size_t>(y) * width + first;
+                if (four_bit) {
+                    std::uint32_t x = 0;
+                    for (; x + 1u < count; x += 2u) {
+                        const std::uint8_t byte = bytes[x >> 1u];
+                        line[x] = palette[byte & 0xFu];
+                        line[x + 1u] = palette[byte >> 4u];
+                    }
+                    if (x < count) line[x] = palette[bytes[x >> 1u] & 0xFu];
+                } else {
+                    for (std::uint32_t x = 0; x < count; ++x) line[x] = palette[bytes[x]];
+                }
+            }
+        }
+    }
+    return true;
+}
+
 std::uint32_t read_clut(const GuestMemory &memory, const TextureState &texture, std::uint32_t index) {
     const std::uint32_t entry = ((index >> texture.clut_shift) & texture.clut_mask) | texture.clut_offset << 4u;
     switch (texture.clut_format) {
@@ -417,20 +514,34 @@ bool decode_texture(const GuestMemory &memory, const TextureState &texture, std:
     thread_local std::vector<std::uint8_t> kept;
     std::vector<std::uint8_t> fresh;
     std::vector<std::uint8_t> &data = reuse_buffers() ? kept : fresh;
-    data.assign(load, 0u);
     static const bool slow = portablekit::env("NO_FAST_TEXTURE_DECODE") != nullptr;
-    if (slow) return decode_texels_slow(memory, texture, width, height, row_bytes, data, out);
-    // The texels as one run of host memory where they are one, else byte by byte.
-    if (const std::uint8_t *source = memory.raw_pointer(texture.address, load)) {
-        std::memcpy(data.data(), source, load);
-    } else {
-        // Not one run of host memory (a picture that wraps past the end of VRAM): run by run. Byte by byte this was
-        // 80 ms per megabyte on a 444 MHz ARM, which is every frame of a movie whose picture sits at the end of VRAM.
-        memory.copy_out(texture.address, std::span<std::uint8_t>(data.data(), load));
+    // <prefix>_NO_FUSED_DECODE=1: the general path below for every texture (the fused one is for palette textures and
+    // swizzled 16-bit ones: no copy of the whole texture before the palette lookups).
+    static const bool no_fused = portablekit::env("NO_FUSED_DECODE") != nullptr;
+    bool done = false;
+    if (!slow && !no_fused) done = decode_indexed_fused(memory, texture, width, height, row_bytes, total, stored, out);
+    if (!done) {
+        data.assign(load, 0u);
+        if (slow) return decode_texels_slow(memory, texture, width, height, row_bytes, data, out);
+        // The texels as one run of host memory where they are one, else byte by byte.
+        const std::uint8_t *source = memory.raw_pointer(texture.address, load);
+        if (source != nullptr && texture.swizzled && load == stored && !no_fused) {
+            // Every block is there: unswizzled straight from guest memory, in one pass.
+            data.resize(total);
+            unswizzle_blocks(source, data.data(), row_bytes, height);
+        } else {
+            if (source != nullptr) {
+                std::memcpy(data.data(), source, load);
+            } else {
+                // Not one run of host memory (a picture that wraps past the end of VRAM): run by run. Byte by byte this was
+                // 80 ms per megabyte on a 444 MHz ARM, which is every frame of a movie whose picture sits at the end of VRAM.
+                memory.copy_out(texture.address, std::span<std::uint8_t>(data.data(), load));
+            }
+            if (texture.swizzled) unswizzle(data, row_bytes, height);
+        }
+        decode_texels([&](std::uint32_t index) { return read_clut(memory, texture, index); }, texture, width, height,
+                      row_bytes, data, out);
     }
-    if (texture.swizzled) unswizzle(data, row_bytes, height);
-    decode_texels([&](std::uint32_t index) { return read_clut(memory, texture, index); }, texture, width, height,
-                  row_bytes, data, out);
     // <prefix>_CHECK_TEXTURE_DECODE: every texture decoded both ways, compared.
     static const bool check = portablekit::env("CHECK_TEXTURE_DECODE") != nullptr;
     if (check) {
diff --git a/tests/texture_decode_tests.cpp b/tests/texture_decode_tests.cpp
new file mode 100644
index 0000000..e789113
--- /dev/null
+++ b/tests/texture_decode_tests.cpp
@@ -0,0 +1,152 @@
+// The texture decoder against a plain reference written from the format rules: every format that has a bit depth, linear and
+// swizzled, widths and heights that fill the swizzle blocks and ones that do not, buffer widths wider than the texture, and
+// palette masks, shifts and offsets. decode_texture() has fast paths (a palette texture is read straight from guest memory,
+// a swizzled one is walked block by block); each must give the reference's texels exactly.
+//
+// Not a game's data: random bytes.
+
+#include "gpu/ge_state.hpp"
+#include "gpu/texture_decode.hpp"
+#include "perf/frame_stats.hpp"
+
+#include <psprecomp/guest_memory.hpp>
+
+#include <cstdint>
+#include <iostream>
+#include <random>
+#include <vector>
+
+// The decoder asks whether an alternate path is switched off; the test has no frame statistics to ask.
+namespace portablekit::perf {
+bool alternate_off(NewPath) { return false; }
+}  // namespace portablekit::perf
+
+namespace {
+
+using namespace portablekit::gpu;
+
+int failures{};
+std::uint64_t compared{};
+
+std::uint32_t expand_5650(std::uint16_t v) {
+    return 0xFF000000u | ((((v >> 11) & 0x1Fu) * 255u / 31u) << 16) | ((((v >> 5) & 0x3Fu) * 255u / 63u) << 8) | ((v & 0x1Fu) * 255u / 31u);
+}
+std::uint32_t expand_5551(std::uint16_t v) {
+    return (((v >> 15) & 1u) * 255u << 24) | ((((v >> 10) & 0x1Fu) * 255u / 31u) << 16) | ((((v >> 5) & 0x1Fu) * 255u / 31u) << 8) |
+           ((v & 0x1Fu) * 255u / 31u);
+}
+std::uint32_t expand_4444(std::uint16_t v) {
+    return ((((v >> 12) & 0xFu) * 17u) << 24) | ((((v >> 8) & 0xFu) * 17u) << 16) | ((((v >> 4) & 0xFu) * 17u) << 8) | ((v & 0xFu) * 17u);
+}
+
+std::uint32_t bits_of(TextureFormat f) {
+    switch (f) {
+    case TextureFormat::Clut4: return 4;
+    case TextureFormat::Clut8: return 8;
+    case TextureFormat::Rgba5650:
+    case TextureFormat::Rgba5551:
+    case TextureFormat::Rgba4444:
+    case TextureFormat::Clut16: return 16;
+    default: return 32;
+    }
+}
+
+// The byte of a texture's storage that holds byte `bx` of row `y`.
+std::size_t storage_offset(const TextureState &t, std::uint32_t row_bytes, std::uint32_t bx, std::uint32_t y) {
+    if (!t.swizzled) return static_cast<std::size_t>(y) * row_bytes + bx;
+    const std::uint32_t block_columns = (row_bytes + 15u) / 16u;
+    return (static_cast<std::size_t>(y / 8u) * block_columns + bx / 16u) * 128u + (y % 8u) * 16u + bx % 16u;
+}
+
+std::uint32_t palette_entry(const psprecomp::GuestMemory &memory, const TextureState &t, std::uint32_t index) {
+    const std::uint32_t entry = ((index >> t.clut_shift) & t.clut_mask) | t.clut_offset << 4u;
+    switch (t.clut_format) {
+    case 0u: return expand_5650(memory.load16(t.clut_address + entry * 2u));
+    case 1u: return expand_5551(memory.load16(t.clut_address + entry * 2u));
+    case 2u: return expand_4444(memory.load16(t.clut_address + entry * 2u));
+    default: return memory.load32(t.clut_address + entry * 4u);
+    }
+}
+
+std::vector<std::uint32_t> reference(const psprecomp::GuestMemory &memory, const TextureState &t) {
+    const std::uint32_t bits = bits_of(t.format);
+    const std::uint32_t stride = t.buffer_width != 0u ? t.buffer_width : t.width;
+    const std::uint32_t row_bytes = stride * bits / 8u;
+    std::vector<std::uint32_t> out(static_cast<std::size_t>(t.width) * t.height, 0xFF000000u);
+    for (std::uint32_t y = 0; y < t.height; ++y) {
+        for (std::uint32_t x = 0; x < t.width; ++x) {
+            const std::uint32_t bx = x * bits / 8u;
+            if (bx + bits / 8u > row_bytes && bits >= 8u) continue;   // past the row: left as it was (not reached here)
+            const auto byte = [&](std::uint32_t k) { return memory.load8(t.address + static_cast<std::uint32_t>(storage_offset(t, row_bytes, bx + k, y))); };
+            std::uint32_t value = 0u;
+            switch (t.format) {
+            case TextureFormat::Clut4: {
+                const std::uint8_t b = memory.load8(t.address + static_cast<std::uint32_t>(storage_offset(t, row_bytes, x / 2u, y)));
+                value = palette_entry(memory, t, (x & 1u) != 0u ? b >> 4u : b & 0xFu);
+                break;
+            }
+            case TextureFormat::Clut8: value = palette_entry(memory, t, byte(0)); break;
+            case TextureFormat::Rgba5650: value = expand_5650(static_cast<std::uint16_t>(byte(0) | byte(1) << 8)); break;
+            case TextureFormat::Rgba5551: value = expand_5551(static_cast<std::uint16_t>(byte(0) | byte(1) << 8)); break;
+            case TextureFormat::Rgba4444: value = expand_4444(static_cast<std::uint16_t>(byte(0) | byte(1) << 8)); break;
+            case TextureFormat::Clut16: value = palette_entry(memory, t, byte(0) | byte(1) << 8); break;
+            case TextureFormat::Rgba8888: value = byte(0) | byte(1) << 8 | byte(2) << 16 | static_cast<std::uint32_t>(byte(3)) << 24; break;
+            default: value = palette_entry(memory, t, byte(0) | byte(1) << 8 | byte(2) << 16 | static_cast<std::uint32_t>(byte(3)) << 24); break;
+            }
+            out[static_cast<std::size_t>(y) * t.width + x] = value;
+        }
+    }
+    return out;
+}
+
+}  // namespace
+
+int main() {
+    psprecomp::GuestMemory memory;
+    std::mt19937 random(12345u);
+    constexpr std::uint32_t kTexels = 0x08A00000u;
+    constexpr std::uint32_t kClut = 0x08B00000u;
+    const TextureFormat formats[] = {TextureFormat::Clut4,    TextureFormat::Clut8,    TextureFormat::Rgba5650, TextureFormat::Rgba5551,
+                                     TextureFormat::Rgba4444, TextureFormat::Rgba8888, TextureFormat::Clut16};
+    const std::uint32_t sizes[] = {1, 2, 3, 7, 8, 9, 15, 16, 17, 24, 31, 32, 33, 48, 64, 100, 128};
+    for (int round = 0; round < 1500; ++round) {
+        TextureState t;
+        t.format = formats[random() % (sizeof(formats) / sizeof(formats[0]))];
+        t.swizzled = (random() & 1u) != 0u;
+        t.width = static_cast<std::uint16_t>(sizes[random() % (sizeof(sizes) / sizeof(sizes[0]))]);
+        t.height = static_cast<std::uint16_t>(sizes[random() % (sizeof(sizes) / sizeof(sizes[0]))]);
+        // The buffer is as wide as the texture, or wider (a 512x512 texture in a 480-wide buffer is the other way round and
+        // is not exercised: the decoders handle it by leaving texels unread).
+        t.buffer_width = (random() % 3u == 0u) ? t.width + 8u * (1u + random() % 4u) : t.width;
+        t.address = kTexels;
+        t.clut_address = kClut;
+        t.clut_format = random() % 4u;
+        t.clut_shift = (random() % 4u == 0u) ? random() % 3u : 0u;
+        t.clut_mask = (random() % 3u == 0u) ? 0x0Fu + (random() % 2u) * 0xF0u : 0xFFu;
+        t.clut_offset = random() % 2u;
+        const std::uint32_t bits = bits_of(t.format);
+        if ((t.buffer_width * bits) % 8u != 0u) continue;   // a 4-bit row of an odd number of texels is not a whole number of bytes
+        const std::uint32_t row_bytes = t.buffer_width * bits / 8u;
+        const std::uint32_t stored = t.swizzled ? ((row_bytes + 15u) & ~15u) * ((t.height + 7u) & ~7u) : row_bytes * t.height;
+        for (std::uint32_t i = 0; i < stored + 64u; ++i) memory.store8(kTexels + i, static_cast<std::uint8_t>(random()));
+        for (std::uint32_t i = 0; i < 4096u; ++i) memory.store8(kClut + i, static_cast<std::uint8_t>(random()));
+        // A width that is not a whole number of bytes (CLUT4, odd width) makes a row's last byte half used; fine.
+        std::vector<std::uint32_t> got;
+        const bool ok = decode_texture(memory, t, got);
+        const std::vector<std::uint32_t> want = reference(memory, t);
+        ++compared;
+        if (!ok || got != want) {
+            ++failures;
+            if (failures < 10)
+                std::cout << "FAIL: format " << static_cast<int>(t.format) << (t.swizzled ? " swizzled " : " linear ") << t.width << "x" << t.height
+                          << " buffer " << t.buffer_width << " clut fmt " << t.clut_format << " shift " << t.clut_shift << " mask 0x" << std::hex
+                          << t.clut_mask << std::dec << " offset " << t.clut_offset << (ok ? "" : " (decode refused)") << "\n";
+        }
+    }
+    if (failures != 0) {
+        std::cout << failures << " of " << compared << " textures differ from the reference\n";
+        return 1;
+    }
+    std::cout << "texture decode tests passed (" << compared << " textures)\n";
+    return 0;
+}
