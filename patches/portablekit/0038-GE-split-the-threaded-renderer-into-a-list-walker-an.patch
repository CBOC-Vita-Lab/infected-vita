diff --git a/host/gpu/ge_worker.cpp b/host/gpu/ge_worker.cpp
index 5e23be7..732ab25 100644
--- a/host/gpu/ge_worker.cpp
+++ b/host/gpu/ge_worker.cpp
@@ -173,6 +173,13 @@ void GeWorker::run_loop() {
         if (g_platform.monotonic_us != nullptr)
             busy_us_.fetch_add(g_platform.monotonic_us() - start, std::memory_order_relaxed);
         head_.store(head + 1u, std::memory_order_release);
+        if (forwarder_ != nullptr) {
+            // Someone else finishes this job's work: they publish its completion (mark_completed). The producer may be
+            // waiting for ring space, which the head just made.
+            forwarder_(forwarder_context_, head + 1u);
+            if (g_platform.event_signal != nullptr && space_event_ != nullptr) g_platform.event_signal(space_event_);
+            continue;
+        }
         completed_.store(head + 1u, std::memory_order_release);
         // The guest may be waiting for this job (sceGeDrawSync, a full ring, a frame in flight): wake it.
         if (g_platform.event_signal != nullptr && space_event_ != nullptr) g_platform.event_signal(space_event_);
@@ -180,6 +187,14 @@ void GeWorker::run_loop() {
     }
 }
 
+void GeWorker::mark_completed(std::uint64_t value) {
+    std::uint64_t current = completed_.load(std::memory_order_acquire);
+    while (current < value && !completed_.compare_exchange_weak(current, value, std::memory_order_acq_rel)) {
+    }
+    if (g_platform.event_signal != nullptr && space_event_ != nullptr) g_platform.event_signal(space_event_);
+    if (wake_hook_ != nullptr) wake_hook_();
+}
+
 namespace {
 struct GuestThreadArgs {
     void (*fn)(void *);
diff --git a/host/gpu/ge_worker.hpp b/host/gpu/ge_worker.hpp
index b520758..1c5b888 100644
--- a/host/gpu/ge_worker.hpp
+++ b/host/gpu/ge_worker.hpp
@@ -97,6 +97,18 @@ public:
     // Marks the worker active for a caller that runs run_loop() itself.
     void set_active(bool active) noexcept { active_.store(active, std::memory_order_release); }
 
+    // ---- completion that is decided elsewhere (gpu/split_renderer.hpp) ---------------------------------------------
+    // With a forwarder set, run_loop() does not publish completed() itself after a job: it hands the job's number to
+    // the forwarder, and whoever finishes the job's work later (the GL thread) calls mark_completed() with it. Set it
+    // before the loop runs and clear it after.
+    using CompletionForwarder = void (*)(void *context, std::uint64_t completed);
+    void set_completion_forwarder(CompletionForwarder forwarder, void *context) noexcept {
+        forwarder_ = forwarder;
+        forwarder_context_ = context;
+    }
+    // Publishes completed() = `value` (never backwards) and wakes the guest as run_loop() does. Any thread.
+    void mark_completed(std::uint64_t value);
+
 private:
     struct Slot {
         Job job;
@@ -114,6 +126,8 @@ private:
     void *work_event_ = nullptr;      // the consumer sleeps here when the ring is empty
     void *space_event_ = nullptr;     // the producer sleeps here when the ring is full
     void (*wake_hook_)() = nullptr;
+    CompletionForwarder forwarder_ = nullptr;
+    void *forwarder_context_ = nullptr;
 };
 
