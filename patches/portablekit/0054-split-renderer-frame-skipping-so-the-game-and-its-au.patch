diff --git a/tests/split_renderer_tests.cpp b/tests/split_renderer_tests.cpp
new file mode 100644
index 0000000..e9816b2
--- /dev/null
+++ b/tests/split_renderer_tests.cpp
@@ -0,0 +1,193 @@
+// The split renderer's frame skipping (host/gpu/split_renderer.hpp), with a renderer that draws nothing and a GL thread whose
+// speed the test chooses: a game that waits for every frame, one that is let run ahead of a slow GL thread, and what is and is not
+// handed to the renderer. The threads are the host's own (std::thread through the GE worker's default platform).
+//
+// Exit status 0 when every check passes. Timing checks are loose (a busy machine must not fail them): they compare two runs of the
+// same scenario, not a run with a number.
+
+#include "gpu/ge_worker.hpp"
+#include "gpu/renderer.hpp"
+#include "gpu/split_renderer.hpp"
+#include "profile.hpp"
+
+#include <psprecomp/guest_memory.hpp>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <iostream>
+#include <memory>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace {
+
+using namespace portablekit;
+using Clock = std::chrono::steady_clock;
+
+int g_failures = 0;
+void check(bool condition, const std::string &what) {
+    if (condition) return;
+    ++g_failures;
+    std::cout << "FAIL: " << what << "\n";
+}
+
+// What the renderer saw, written by the GL thread (the thread that calls run()).
+struct Seen {
+    std::uint64_t begins = 0;
+    std::uint64_t submits = 0;
+    std::uint64_t presents = 0;
+    std::uint64_t uploads = 0;
+    std::vector<std::uint64_t> drawn_frames;   // the frame number of each draw (DrawCall::matrix_version), once per frame
+};
+
+class FakeRenderer final : public gpu::Renderer {
+public:
+    FakeRenderer(Seen &seen, unsigned present_us) : seen_(seen), present_us_(present_us) {}
+    bool initialize(const gpu::RendererConfig &, std::string &) override { return true; }
+    void shutdown() override {}
+    bool available() const noexcept override { return true; }
+    void begin_display_list() override { ++seen_.begins; }
+    void submit(const gpu::DrawCall &call, const psprecomp::GuestMemory &) override {
+        ++seen_.submits;
+        if (seen_.drawn_frames.empty() || seen_.drawn_frames.back() != call.matrix_version) seen_.drawn_frames.push_back(call.matrix_version);
+    }
+    void write_back_frame(psprecomp::GuestMemory &) override {}
+    void read_back_framebuffer(std::uint32_t, psprecomp::GuestMemory &) override {}
+    void upload_frame(std::uint32_t, const std::uint8_t *, std::uint32_t, std::uint32_t, std::uint32_t) override { ++seen_.uploads; }
+    bool present(std::uint32_t, std::optional<std::chrono::steady_clock::time_point>) override {
+        // The GL thread's cost of a frame: the drawing and the swap.
+        if (present_us_ != 0u) std::this_thread::sleep_for(std::chrono::microseconds(present_us_));
+        ++seen_.presents;
+        ++presented_;
+        return true;
+    }
+    bool capture_frame(const std::string &) override { return true; }
+    std::uint64_t frames_presented() const noexcept override { return presented_; }
+    std::uint64_t draws_submitted() const noexcept override { return seen_.submits; }
+
+private:
+    Seen &seen_;
+    unsigned present_us_;
+    std::uint64_t presented_ = 0;
+};
+
+struct Scenario {
+    const char *frame_skip;     // <PREFIX>_FRAME_SKIP
+    unsigned gl_frame_us;       // the GL thread's cost of one frame
+    unsigned logic_us = 20000;  // the guest's own work per frame
+    unsigned frames = 40;
+    unsigned draws = 20;
+};
+
+struct Outcome {
+    Seen seen;
+    double guest_ms = 0.0;
+    gpu::FrameSkipStats stats;
+    std::uint64_t flips = 0;
+};
+
+struct GuestArgs {
+    gpu::GeWorker *walker = nullptr;
+    gpu::SplitRenderer *split = nullptr;
+    psprecomp::GuestMemory *memory = nullptr;
+    const Scenario *scenario = nullptr;
+    Outcome *outcome = nullptr;
+};
+
+void guest_main(void *pointer) {
+    auto *args = static_cast<GuestArgs *>(pointer);
+    gpu::GeWorker &walker = *args->walker;
+    gpu::SplitRenderer &split = *args->split;
+    const Scenario &s = *args->scenario;
+    const auto start = Clock::now();
+    for (unsigned frame = 1; frame <= s.frames; ++frame) {
+        // One list: the draws of the frame, as a game's display list run would hand them over.
+        walker.post([&split, args, frame, &s] {
+            split.begin_display_list();
+            for (unsigned i = 0; i < s.draws; ++i) {
+                gpu::DrawCall call;
+                call.matrix_version = frame;
+                split.submit(call, *args->memory);
+            }
+        });
+        const std::uint64_t list = walker.posted();
+        // The flip.
+        walker.post([&split] { (void)split.present(0x04000000u); });
+        ++args->outcome->flips;
+        // sceGeDrawSync of the list, then the game's own work for the frame.
+        walker.wait_completed(list);
+        std::this_thread::sleep_for(std::chrono::microseconds(s.logic_us));
+    }
+    args->outcome->guest_ms = std::chrono::duration<double, std::milli>(Clock::now() - start).count();
+}
+
+Outcome run_scenario(const Scenario &scenario) {
+    ::setenv(portablekit::env_name("FRAME_SKIP").c_str(), scenario.frame_skip, 1);
+    Outcome outcome;
+    psprecomp::GuestMemory memory(32u * 1024u * 1024u);
+    gpu::GeWorker walker(256u);
+    auto fake = std::make_unique<FakeRenderer>(outcome.seen, scenario.gl_frame_us);
+    gpu::SplitRenderer split(std::move(fake), 64u);
+    GuestArgs args{&walker, &split, &memory, &scenario, &outcome};
+    const bool ran = split.run(walker, &guest_main, &args, -1, 256 * 1024, -1, 256 * 1024, -1);
+    check(ran, "the split renderer starts its threads");
+    outcome.stats = split.frame_skip_stats();
+    std::cout << "  frame_skip=" << scenario.frame_skip << " gl=" << scenario.gl_frame_us / 1000.0 << " ms/frame: guest " << outcome.guest_ms
+              << " ms for " << scenario.frames << " frames, presented " << outcome.seen.presents << ", skipped " << outcome.stats.skipped_frames
+              << ", catch-up frames " << outcome.stats.catchup_frames << ", lag " << outcome.stats.lag_us / 1000.0 << " ms\n";
+    return outcome;
+}
+
+} // namespace
+
+int main() {
+    // 1. A GL thread that keeps up: nothing is skipped, every frame is drawn, the guest is never let run ahead.
+    {
+        const Outcome o = run_scenario({"auto", 2000u});
+        check(o.stats.skipped_frames == 0u, "a fast GL thread: no frame is skipped");
+        check(o.seen.presents == 40u && o.seen.submits == 40u * 20u, "a fast GL thread: every frame is drawn and presented");
+        check(o.seen.begins == 40u, "a fast GL thread: every list reaches the renderer");
+        check(!o.stats.catchup, "a fast GL thread: the guest still waits for the drawing");
+    }
+
+    // 2. A GL thread that cannot keep up, frame skipping off: every frame is drawn and the guest is held to the GL thread's pace.
+    Outcome slow_off;
+    {
+        slow_off = run_scenario({"off", 45000u});
+        check(slow_off.stats.skipped_frames == 0u, "frame skipping off: no frame is skipped");
+        check(slow_off.seen.presents == 40u, "frame skipping off: every frame is presented");
+        check(slow_off.guest_ms > 40 * 45.0 * 0.85, "frame skipping off: the guest waits for the GL thread (it runs at its pace)");
+    }
+
+    // 3. The same GL thread with frame skipping auto: the guest keeps closer to its own pace, frames are left out, and what is left out
+    // never reaches the renderer; the picture is never more than a few frames stale.
+    {
+        const Outcome o = run_scenario({"auto", 45000u});
+        check(o.stats.skipped_frames > 0u, "a slow GL thread: frames are skipped");
+        check(o.stats.catchup_frames > 0u, "a slow GL thread: the guest is let run ahead");
+        check(o.seen.presents + o.stats.skipped_frames == 40u, "a slow GL thread: every frame is either presented or skipped");
+        check(o.seen.submits == o.seen.presents * 20u, "a slow GL thread: a skipped frame sends no draw to the renderer");
+        check(o.guest_ms < slow_off.guest_ms * 0.8, "a slow GL thread: the guest finishes sooner than with frame skipping off");
+        std::uint64_t largest_gap = 0;
+        for (std::size_t i = 1; i < o.seen.drawn_frames.size(); ++i)
+            largest_gap = std::max(largest_gap, o.seen.drawn_frames[i] - o.seen.drawn_frames[i - 1]);
+        check(largest_gap <= 3u, "a slow GL thread: no more than two frames in a row are skipped (largest step " +
+                                     std::to_string(largest_gap) + ")");
+        check(!o.seen.drawn_frames.empty() && o.seen.drawn_frames.front() == 1u, "a slow GL thread: the first frame is drawn");
+    }
+
+    // 4. 'always': the guest runs ahead from the start; a fast GL thread then still draws every frame.
+    {
+        const Outcome o = run_scenario({"always", 2000u});
+        check(o.stats.catchup_frames >= 39u, "always: the guest runs ahead of the GL thread");
+        check(o.stats.skipped_frames == 0u, "always with a fast GL thread: nothing is skipped");
+        check(o.seen.presents == 40u, "always with a fast GL thread: every frame is presented");
+    }
+
+    std::cout << (g_failures == 0 ? "all passed\n" : "FAILURES\n");
+    return g_failures == 0 ? 0 : 1;
+}
