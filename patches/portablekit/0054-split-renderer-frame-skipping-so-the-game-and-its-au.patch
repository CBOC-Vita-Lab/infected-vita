 #include <utility>
 
 namespace portablekit::gpu {
@@ -69,9 +71,55 @@ bool ge_split_early_sync_enabled() {
     return text == "1" || text == "on" || text == "true" || text == "yes";
 }
 
+namespace {
+// Microseconds on the platform's monotonic clock (the same one the kernel uses).
+std::uint64_t clock_us() {
+    const GeWorkerPlatform &platform = ge_worker_platform();
+    if (platform.monotonic_us != nullptr) return platform.monotonic_us();
+    return static_cast<std::uint64_t>(
+        std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+// How far behind the walker the GL thread is, smoothed over the markers it reaches (about six a frame), decides what happens:
+//  - above kCatchupEnterUs the guest is let run ahead (GE jobs complete at the walker): with the GL thread the slower side a
+//    frame then costs the guest what its own code needs, not what the drawing needs;
+//  - below kCatchupLeaveUs it waits for the drawing again (the exact behaviour, no texture is ever read after the guest rewrote it);
+//  - while running ahead and more than kSkipLagUs behind, the frame about to begin is not drawn (at most kMaxSkipStreak in a row).
+// The numbers are for a 30 fps game: a healthy frame on the Vita leaves the guest waiting about 10 ms for the last draw.
+// <PREFIX>_FRAME_SKIP_ENTER_US, _LEAVE_US, _LAG_US and _STREAK change them for measuring.
+struct SkipTuning {
+    std::int32_t enter_us;
+    std::int32_t leave_us;
+    std::int32_t skip_us;
+    std::uint32_t streak;
+};
+const SkipTuning &skip_tuning() {
+    static const SkipTuning tuning{static_cast<std::int32_t>(env_count("FRAME_SKIP_ENTER_US", 14000u, 1000u, 500000u)),
+                                   static_cast<std::int32_t>(env_count("FRAME_SKIP_LEAVE_US", 5000u, 0u, 500000u)),
+                                   static_cast<std::int32_t>(env_count("FRAME_SKIP_LAG_US", 28000u, 1000u, 1000000u)),
+                                   env_count("FRAME_SKIP_STREAK", 2u, 0u, 8u)};
+    return tuning;
+}
+// A skipped frame whose present never comes (a list run with no flip after it) is drawn again after this long.
+constexpr std::uint64_t kSkipHoldLimitUs = 120000u;
+} // namespace
+
+FrameSkipMode frame_skip_mode() {
+    const char *value = portablekit::env("FRAME_SKIP");
+    if (value != nullptr && *value != '\0') {
+        std::string text(value);
+        for (char &c : text) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+        if (text == "0" || text == "off" || text == "false" || text == "no") return FrameSkipMode::Off;
+        if (text == "always") return FrameSkipMode::Always;
+        return FrameSkipMode::Auto;
+    }
+    return port::frame_skip() ? FrameSkipMode::Auto : FrameSkipMode::Off;
+}
+
 SplitRenderer::SplitRenderer(std::unique_ptr<Renderer> inner, std::uint32_t draw_slots)
     : inner_(std::move(inner)), queue_(16384u), slots_(env_count("GE_SPLIT_SLOTS", std::max<std::uint32_t>(draw_slots, 64u), 64u, 8192u)),
-      presents_ahead_(env_count("GE_SPLIT_PRESENTS_AHEAD", kPresentsAhead, 1u, 4u)), early_sync_(ge_split_early_sync_enabled()) {
+      presents_ahead_(env_count("GE_SPLIT_PRESENTS_AHEAD", kPresentsAhead, 1u, 4u)), early_sync_(ge_split_early_sync_enabled()),
+      slow_gl_us_(env_count("GE_SPLIT_SLOW_PRESENT_US", 0u, 0u, 500000u)) {
     g_instance = this;
 }
 
