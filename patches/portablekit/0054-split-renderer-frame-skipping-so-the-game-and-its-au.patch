@@ -186,6 +232,12 @@ bool SplitRenderer::run(GeWorker &walker, void (*guest)(void *), void *arg, int
     queue_.run_loop();
     platform.thread_join(guest_thread);
     platform.thread_join(walker_thread);
+    {
+        const FrameSkipStats stats = frame_skip_stats();
+        std::cerr << "[split] frame skipping: " << stats.skipped_frames << " frame(s) left undrawn, " << stats.catchup_frames
+                  << " frame(s) run ahead of the GL thread, last lag " << stats.lag_us / 1000.0 << " ms; "
+                  << presents_posted_ << " present(s) queued" << std::endl;
+    }
     walker.set_active(false);
     walker.set_completion_forwarder(nullptr, nullptr);
     queue_.set_active(false);
@@ -194,6 +246,72 @@ bool SplitRenderer::run(GeWorker &walker, void (*guest)(void *), void *arg, int
     return true;
 }
 
+// ---- frame skipping -----------------------------------------------------------------------------------------------
+
+void SplitRenderer::forward_job_done(GeWorker &walker, std::uint64_t completed) {
+    const std::uint64_t stamp = clock_us();
+    if (catchup_) {
+        // The guest is let run ahead: the job counts as completed now, and the GL thread only measures how far behind it is.
+        // The interrupts the job raised keep their place in the GL thread's queue (raise_ge_interrupt), so they stay in order.
+        walker.mark_completed(completed);
+        queue_.post([this, stamp] { note_lag(stamp); });
+        return;
+    }
+    // Published when the GL thread reaches this point of its queue: everything the job queued has been drawn by then.
+    queue_.post([this, &walker, completed, stamp] {
+        note_lag(stamp);
+        walker.mark_completed(completed);
+    });
+}
+
+void SplitRenderer::note_lag(std::uint64_t posted_us) {
+    const std::uint64_t now = clock_us();
+    const std::uint64_t behind = now > posted_us ? std::min<std::uint64_t>(now - posted_us, 1000000u) : 0u;
+    const std::int32_t old = lag_us_.load(std::memory_order_relaxed);
+    lag_us_.store((old * 3 + static_cast<std::int32_t>(behind)) / 4, std::memory_order_relaxed);
+}
+
+void SplitRenderer::start_frame() {
+    frame_open_ = true;
+    frame_started_us_ = clock_us();
+    skip_frame_ = false;
+    // Early sync (a developer switch) already lets the guest run ahead, with no markers to measure by: nothing to decide.
+    const FrameSkipMode mode = early_sync_ ? FrameSkipMode::Off : frame_skip_mode();
+    const SkipTuning &tuning = skip_tuning();
+    const std::int32_t lag = lag_us_.load(std::memory_order_relaxed);
+    switch (mode) {
+    case FrameSkipMode::Off: catchup_ = false; break;
+    case FrameSkipMode::Always: catchup_ = true; break;
+    case FrameSkipMode::Auto:
+        if (!catchup_ && lag > tuning.enter_us) catchup_ = true;
+        else if (catchup_ && lag < tuning.leave_us) catchup_ = false;
+        break;
+    }
+    catchup_visible_.store(catchup_, std::memory_order_relaxed);
+    if (catchup_) frames_catchup_.fetch_add(1u, std::memory_order_relaxed);
+    skip_frame_ = catchup_ && lag > tuning.skip_us && skip_streak_ < tuning.streak;
+}
+
+void SplitRenderer::end_frame(bool skipped) {
+    frame_open_ = false;
+    skip_frame_ = false;
+    if (skipped) {
+        ++skip_streak_;
+        frames_skipped_.fetch_add(1u, std::memory_order_relaxed);
+    } else {
+        skip_streak_ = 0u;
+    }
+}
+
+FrameSkipStats SplitRenderer::frame_skip_stats() const noexcept {
+    FrameSkipStats stats;
+    stats.skipped_frames = frames_skipped_.load(std::memory_order_relaxed);
+    stats.catchup_frames = frames_catchup_.load(std::memory_order_relaxed);
+    stats.lag_us = lag_us_.load(std::memory_order_relaxed);
+    stats.catchup = catchup_visible_.load(std::memory_order_relaxed);
+    return stats;
+}
+
 // ---- Renderer ----------------------------------------------------------------------------------------------------
 
 bool SplitRenderer::initialize(const RendererConfig &config, std::string &error) {
@@ -207,6 +325,14 @@ void SplitRenderer::shutdown() {
 }
 
 void SplitRenderer::begin_display_list() {
+    if (forwarding() && t_walker && !t_gl) {
+        if (!frame_open_) start_frame();
+        if (skip_frame_) {
+            // Nothing of this frame reaches the GL thread. A present that never comes must not freeze the picture.
+            if (clock_us() - frame_started_us_ > kSkipHoldLimitUs) skip_frame_ = false;
+            else return;
+        }
+    }
     post([this] { inner_->begin_display_list(); });
 }
 
@@ -219,6 +345,7 @@ void SplitRenderer::submit(const DrawCall &draw, const GuestMemory &memory) {
         warn_foreign_thread("submit");
         return;
     }
+    if (skip_frame_) return;
     DrawSlot &slot = claim_slot(memory);
     slot.call = draw;   // the vertex vector keeps its capacity: after a few frames this copies, it does not allocate
     post_draw();
@@ -233,6 +360,7 @@ void SplitRenderer::submit_taking(DrawCall &draw, const GuestMemory &memory) {
         warn_foreign_thread("submit");
         return;
     }
+    if (skip_frame_) return;   // frame skipping: the draw is dropped before any work is spent on it
     // The vertices and indices change hands instead of being copied (most of a draw's bytes; on the Vita the copy was
     // a measurable part of the walker's frame): the slot takes the draw's, the draw gets the slot's old ones (emptied,
     // with their capacity) for the walker's next draw. The rest of the call is copied.
@@ -284,11 +412,14 @@ void SplitRenderer::run_draw(std::uint64_t sequence) {
 }
 
 void SplitRenderer::write_back_frame(GuestMemory &memory) {
+    if (forwarding() && t_walker && skip_frame_) return;
     GuestMemory *target = &memory;
     post([this, target] { inner_->write_back_frame(*target); });
 }
 
 void SplitRenderer::read_back_framebuffer(std::uint32_t source, GuestMemory &memory) {
+    // A frame that is not drawn has nothing to read back, and waiting for the GL thread is what skipping avoids.
+    if (forwarding() && t_walker && skip_frame_) return;
     // Waits: the walker moves guest memory right after this (a block transfer), and every draw queued before it must
     // have read its textures first.
     call([&] { inner_->read_back_framebuffer(source, memory); });
@@ -301,6 +432,7 @@ void SplitRenderer::upload_frame(std::uint32_t display_address, const std::uint8
         return;
     }
     if (pixels == nullptr || width == 0u || height == 0u || stride < width) return;
+    if (t_walker && skip_frame_) return;
     // The caller's pixels are only valid during the call: copied.
     const std::size_t bytes = static_cast<std::size_t>(stride) * height * 4u;
     post([this, display_address, width, height, stride, copy = std::vector<std::uint8_t>(pixels, pixels + bytes)] {
@@ -314,6 +446,11 @@ bool SplitRenderer::present(std::uint32_t display_address, std::optional<std::ch
         warn_foreign_thread("present");
         return false;
     }
+    if (skip_frame_) {
+        // Frame skipping: no draw of this frame was queued, and showing it would show an empty picture. The display keeps the last one.
+        end_frame(true);
+        return true;
+    }
     const std::uint64_t mine = ++presents_posted_;
     if (mine - presents_done_.load(std::memory_order_acquire) > presents_ahead_ + 1u) {
         const phase::Scope wait(phase::SplitWait);
@@ -325,8 +462,11 @@ bool SplitRenderer::present(std::uint32_t display_address, std::optional<std::ch
             const phase::Scope present_scope(phase::Present);
             (void)inner_->present(display_address, moment);
         }
+        // A test aid: a GL thread that is slower than the game, to see what the guest does about it.
+        if (slow_gl_us_ != 0u) std::this_thread::sleep_for(std::chrono::microseconds(slow_gl_us_));
         presents_done_.fetch_add(1u, std::memory_order_release);
     });
+    end_frame(false);
     return true;
 }
 
diff --git a/host/gpu/split_renderer.hpp b/host/gpu/split_renderer.hpp
index ae4dfea..dd7d3ad 100644
--- a/host/gpu/split_renderer.hpp
+++ b/host/gpu/split_renderer.hpp
@@ -42,6 +42,21 @@ namespace portablekit::gpu {
 // for the drawing (read_back_framebuffer).
 [[nodiscard]] bool ge_split_early_sync_enabled();
 
+// <PREFIX>_FRAME_SKIP: off, auto, always; without it the port setting perf.frame_skip (auto or off). Auto: while the GL thread
+// is more than a few milliseconds behind the walker, GE jobs count as completed once the walker is through them (the guest
+// does not wait for the drawing, so it keeps its pace and so does its sound), and when the GL thread is more than about a frame
+// behind, the next frame's draws and present are left out (the picture holds for a frame). Always: the same without the wait
+// for the GL thread to fall behind (a test aid). Off: every frame is drawn and the guest waits for each, as before.
+enum class FrameSkipMode : std::uint8_t { Off, Auto, Always };
+[[nodiscard]] FrameSkipMode frame_skip_mode();
+
+struct FrameSkipStats {
+    std::uint64_t skipped_frames{};   // frames whose draws and present were left out
+    std::uint64_t catchup_frames{};   // frames run with early completion (drawn or not)
+    std::int32_t lag_us{};            // how far behind the walker the GL thread runs (smoothed)
+    bool catchup{};                   // the guest is not waiting for the GL thread now
+};
+
 class SplitRenderer final : public Renderer {
 public:
     explicit SplitRenderer(std::unique_ptr<Renderer> inner, std::uint32_t draw_slots = 1024u);
@@ -54,6 +69,11 @@ public:
     [[nodiscard]] bool forwarding() const noexcept { return forwarding_.load(std::memory_order_acquire); }
     // ge_split_early_sync_enabled() when the renderer was made: completion and interrupts at the walker.
     [[nodiscard]] bool early_sync() const noexcept { return early_sync_; }
+    // Frame skipping (see FrameSkipMode); the counters can be read from any thread.
+    [[nodiscard]] FrameSkipStats frame_skip_stats() const noexcept;
+    // The walker's loop calls this after every GE job it has walked (set_completion_forwarder): the job counts as completed when
+    // the GL thread reaches this point of its queue, or at once while the guest is let run ahead of it (frame skipping).
+    void forward_job_done(GeWorker &walker, std::uint64_t completed);
 
     // Runs `guest(arg)` on a new thread (guest_core), `walker` (the GE worker's loop) on another (walker_core) and the
     // GL queue on the calling thread, which owns the GL context. Returns when the guest has returned and both queues are
@@ -109,6 +129,11 @@ private:
     // Runs `fn` on the GL thread and waits for it (on the calling thread before start()).
     template <typename Fn> void call(Fn &&fn);
     void run_draw(std::uint64_t sequence);
+    // Frame skipping. All of it runs on the walker except note_lag(), which the GL thread runs.
+    void start_frame();                     // the first list after a present: picks the mode and whether this frame is drawn
+    void end_frame(bool skipped);
+    void note_lag(std::uint64_t posted_us); // GL thread: a marker the walker posted at `posted_us` has been reached
+
     DrawSlot &claim_slot(const GuestMemory &memory);  // the slot of the next draw, once the GL thread is done with it
     void post_draw();                                 // queues the draw in that slot
 
@@ -123,6 +148,17 @@ private:
     std::atomic<bool> forwarding_{false};
     std::uint32_t presents_ahead_{1u};
     bool early_sync_{false};
+    // Frame skipping.
+    std::atomic<std::int32_t> lag_us_{0};          // GL thread writes (smoothed), walker reads
+    bool catchup_{false};                          // walker only: GE jobs complete at the walker
+    bool frame_open_{false};                       // walker only: a frame has begun and its present has not come
+    bool skip_frame_{false};                       // walker only: this frame's draws and present are left out
+    std::uint32_t skip_streak_{0u};                // walker only: undrawn frames in a row
+    std::uint64_t frame_started_us_{0u};           // walker only
+    std::atomic<std::uint64_t> frames_skipped_{0u};
+    std::atomic<std::uint64_t> frames_catchup_{0u};
+    std::atomic<bool> catchup_visible_{false};
+    std::uint32_t slow_gl_us_{0u};                 // <PREFIX>_GE_SPLIT_SLOW_PRESENT_US: a test aid, the GL thread sleeps this long in each present
 };
 
