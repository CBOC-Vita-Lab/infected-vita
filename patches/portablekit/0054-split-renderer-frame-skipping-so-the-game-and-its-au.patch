diff --git a/host/gpu/split_renderer.cpp b/host/gpu/split_renderer.cpp
index 26eeb58..340143c 100644
--- a/host/gpu/split_renderer.cpp
+++ b/host/gpu/split_renderer.cpp
@@ -6,10 +6,12 @@
 
 #include <algorithm>
 #include <cctype>
+#include <chrono>
 #include <cstdlib>
 #include <cstring>
 #include <iostream>
 #include <string>
