From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 10 Oct 2026 09:16:17 +0000
Subject: [PATCH] Merge gameplay-tuning framework commits (profile frame_hook,
 interpreter watch, ge_replay --zstats) into all

Brings in:
* Profile frame_hook (once per guest flip); write watch reports the interpreter pc, ra, sp and a stack trace
* Interpreter watch: float regs and optional stack trace (PSPRECOMP_INTERPRETER_WATCH_STACK)
* ge_replay --zstats: view-space z range per transformed draw

diff --git a/host/hle/hle_media.cpp b/host/hle/hle_media.cpp
index 2f8b660..5ad569d 100644
--- a/host/hle/hle_media.cpp
+++ b/host/hle/hle_media.cpp
@@ -947,6 +947,7 @@ void register_display_ctrl(HleRegistrar &hle) {
         present_frame(rt);
 #endif
         bringup::on_flip(rt, media().display.framebuffer, media().display.pixel_format);
+        if (portablekit::game().frame_hook != nullptr) portablekit::game().frame_hook(rt, bringup::flip_count());
 #if defined(PORTABLEKIT_HAS_GL_RENDERER) && !defined(PORTABLEKIT_HAS_RENDERER)
         // At most kFramesInFlight flips are ahead of the GE thread: the guest waits (in host time, the kernel keeps
         // running) for the oldest one, which paces the game by the renderer when the renderer is the slower side.
diff --git a/host/profile.hpp b/host/profile.hpp
index 09322ed..ef5dec6 100644
--- a/host/profile.hpp
+++ b/host/profile.hpp
@@ -238,6 +238,10 @@ struct GameProfile {
     // Called once the executable is in memory and before it runs, for the
     // per-game patches that have no better home. Null means there are none.
     void (*patch_loaded_image)(psprecomp::Runtime &, const psprecomp::Elf32Image &) = nullptr;
+    // Called once per game frame from sceDisplaySetFrameBuf (the guest's flip), on the guest thread that flipped, after the
+    // frame has been presented and before the guest runs on: a place to apply settings that change while the game runs
+    // (poke guest memory) and to sample guest state. `flip` counts the guest's flips (1 for the first). Null: none.
+    void (*frame_hook)(psprecomp::Runtime &, std::uint64_t flip) = nullptr;
 
     // --- The game's camera and view ----------------------------------------
     // Drives the game's own camera from what the player asks of it
diff --git a/src/guest_memory.cpp b/src/guest_memory.cpp
index 20001d7..6b15d44 100644
--- a/src/guest_memory.cpp
+++ b/src/guest_memory.cpp
@@ -27,6 +27,7 @@ namespace psprecomp {
 std::int32_t runtime_thread_uid() noexcept;
 const char *runtime_thread_name() noexcept;
 std::uint32_t runtime_dispatch_pc() noexcept;
+void runtime_watch_context(std::uint32_t &pc, std::uint32_t &ra, std::uint32_t &sp) noexcept;
 
 namespace {
 struct WriteWatch {
@@ -67,17 +68,41 @@ bool overlaps_watch(std::uint32_t address, std::size_t length) {
            static_cast<std::uint64_t>(canonical_watch) < first_end;
 }
 
+const GuestMemory *g_watch_memory = nullptr;
+
+// Words on the guest stack that look like return addresses (the instruction two before is a jal/jalr into the code range).
+void print_stack_trace(std::uint32_t sp) {
+    if (g_watch_memory == nullptr) return;
+    std::cerr << "    stack:";
+    int printed = 0;
+    for (std::uint32_t off = 0; off < 0x600u && printed < 12; off += 4u) {
+        const std::uint32_t at = sp + off;
+        if (!g_watch_memory->contains(at, 4u)) break;
+        const std::uint32_t w = g_watch_memory->load32(at);
+        if (w < 0x08804000u || w >= 0x08B00000u || (w & 3u) != 0u || !g_watch_memory->contains(w - 8u, 4u)) continue;
+        const std::uint32_t insn = g_watch_memory->load32(w - 8u);
+        if ((insn >> 26) == 3u || (insn & 0xFC1FFFFFu) == 0x0000F809u) {
+            std::cerr << " " << hex32(w) << "(sp+0x" << std::hex << off << std::dec << ")";
+            ++printed;
+        }
+    }
+    std::cerr << "\n";
+}
+
 void log_write_watch(std::uint32_t address, std::size_t length, const char *operation,
                      std::uint64_t old_value, std::uint64_t new_value) {
     if (!overlaps_watch(address, length)) return;
+    std::uint32_t cur_pc = 0u, cur_ra = 0u, cur_sp = 0u;
+    runtime_watch_context(cur_pc, cur_ra, cur_sp);
     std::cerr << "[watch-write] uid=" << runtime_thread_uid()
               << " name=" << runtime_thread_name()
-              << " pc=" << hex32(runtime_dispatch_pc())
+              << " pc=" << hex32(runtime_dispatch_pc()) << " cpu.pc=" << hex32(cur_pc) << " ra=" << hex32(cur_ra) << " sp=" << hex32(cur_sp)
               << " op=" << operation
               << " address=" << hex32(address)
               << " size=" << length
               << " old=0x" << std::hex << old_value
               << " new=0x" << new_value << std::dec << "\n";
+    print_stack_trace(cur_sp);
 }
 }  // namespace
 
@@ -140,6 +165,7 @@ void set_arena_provider(const ArenaProvider &provider) noexcept { g_arena_provid
 
 GuestMemory::GuestMemory(std::uint32_t size_bytes)
     : write_watch_enabled_(std::getenv("PSPRECOMP_WATCH_WRITE") != nullptr) {
+    if (write_watch_enabled_) g_watch_memory = this;
     if (size_bytes != 32u * 1024u * 1024u && size_bytes != 64u * 1024u * 1024u) {
         throw Error("PSP RAM size must be 32 MiB or 64 MiB");
     }
