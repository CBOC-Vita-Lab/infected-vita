@@ -278,6 +281,19 @@ public:
                     call.viewport.scissor_y2, call.lighting_enabled ? 1 : 0, call.fog.enabled ? 1 : 0,
                     call.clear_mode ? 1 : 0, call.clear_flags, call.material_color);
         if (detail.count(draws) != 0u) print_detail(call, memory);
+        if (zstats && !call.through && !call.vertices.empty()) {
+            // View-space z (world * view, row vectors) over every decoded vertex: how far from the camera this draw reaches.
+            float zmin = 1e30f, zmax = -1e30f;
+            for (const gpu::Vertex &v : call.vertices) {
+                float q[3];
+                for (int col = 0; col < 3; ++col)
+                    q[col] = v.position[0] * call.world[col] + v.position[1] * call.world[4 + col] + v.position[2] * call.world[8 + col] + call.world[12 + col];
+                const float z = q[0] * call.view[2] + q[1] * call.view[6] + q[2] * call.view[10] + call.view[14];
+                zmin = std::min(zmin, z);
+                zmax = std::max(zmax, z);
+            }
+            std::printf("    zrange %.2f %.2f (n=%zu)\n", zmin, zmax, call.vertices.size());
+        }
     }
     void write_back_frame(gpu::GuestMemory &) override {}
