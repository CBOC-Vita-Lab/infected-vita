     if (const char *text = std::getenv("PSPRECOMP_INTERPRETER_WATCH")) load_watch_list(text);
+    g_watch_stack = std::getenv("PSPRECOMP_INTERPRETER_WATCH_STACK") != nullptr;
     if (const char *text = std::getenv("PSPRECOMP_INTERPRETER_WATCH_LIMIT")) {
         char *end = nullptr;
         const unsigned long long value = std::strtoull(text, &end, 0);
@@ -161,7 +163,25 @@ void report_watch(Runtime &runtime, const AllegrexContext &ctx, std::uint32_t pc
               << " a0=" << hex32(ctx.gpr[4]) << " a1=" << hex32(ctx.gpr[5])
               << " a2=" << hex32(ctx.gpr[6]) << " a3=" << hex32(ctx.gpr[7])
               << " s0=" << hex32(ctx.gpr[16]) << " s1=" << hex32(ctx.gpr[17])
-              << " s2=" << hex32(ctx.gpr[18]) << " ra=" << hex32(ctx.gpr[31]);
+              << " s2=" << hex32(ctx.gpr[18]) << " ra=" << hex32(ctx.gpr[31])
+              << " f12=" << ctx.fpr[12] << " f13=" << ctx.fpr[13] << " f14=" << ctx.fpr[14] << " sp=" << hex32(ctx.gpr[29]);
+    if (g_watch_stack) {
+        // Words on the guest stack that look like return addresses: the instruction two before is a jal/jalr.
+        std::cerr << "\n         stack:";
+        const GuestMemory &memory = runtime.memory();
+        int printed = 0;
+        for (std::uint32_t off = 0; off < 0x800u && printed < 14; off += 4u) {
+            const std::uint32_t at = ctx.gpr[29] + off;
+            if (!memory.contains(at, 4u)) break;
+            const std::uint32_t w = memory.load32(at);
+            if (w < 0x08804000u || w >= 0x08B00000u || (w & 3u) != 0u || !memory.contains(w - 8u, 4u)) continue;
+            const std::uint32_t insn = memory.load32(w - 8u);
+            if ((insn >> 26) == 3u || (insn & 0xFC1FFFFFu) == 0x0000F809u) {
+                std::cerr << " " << hex32(w);
+                ++printed;
+            }
+        }
+    }
     // What a0 points at, when it is a pointer to an object: the field that is
     // never what the game waits for is usually visible right here.
     if (g_watch_words != 0u && runtime.memory().contains(ctx.gpr[4], g_watch_words * 4u)) {
diff --git a/src/runtime.cpp b/src/runtime.cpp
