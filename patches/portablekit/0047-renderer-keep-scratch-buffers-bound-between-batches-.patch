+    // The viewport, flip, depth range, screen size and scissor of a draw (DrawState), from the GE's viewport registers
+    // and the target. Kept from the previous draw when those are the same (they change a few times a frame, and this
+    // was some 230 instructions a draw on the Vita's CPU).
+    struct ViewMemo {
+        ViewportState viewport{};
+        std::uint32_t target{}, scale_bits{}, width{}, height{}, psp_width{}, psp_height{}, through{};
+        std::int32_t viewport_px[4]{}, scissor_px[4]{};
+        float flip[2]{}, depth_range[2]{}, screen[2]{};
+        bool valid{};
+    } view_memo;
+
+    void place_view(const ViewportState &vp, bool through, const Target &target, DrawState &state) {
+        ViewMemo &m = view_memo;
+        std::uint32_t scale_bits{};
+        std::memcpy(&scale_bits, &target.scale, sizeof(scale_bits));
+        const std::uint32_t key[7] = {target.address, scale_bits, target.width, target.height,
+                                      target.psp_width, target.psp_height, through ? 1u : 0u};
+        static_assert(sizeof(ViewportState) % 4u == 0u);
+        if (!m.valid || !same_words(&m.viewport, &vp, sizeof(ViewportState) / 4u) || !same_words(&m.target, key, 7u)) {
+            // The GE maps ndc to the screen as ndc * scale + offset - region offset,
+            // with y pointing down on screen; the shader flips y so that GL's window rows are the PSP's.
+            const float scale = target.scale;
+            const float target_w = static_cast<float>(target.width), target_h = static_cast<float>(target.height);
+            float vx = 0.0f, vy = 0.0f, vw = target_w, vh = target_h;
+            m.flip[0] = 1.0f;
+            m.flip[1] = 1.0f;
+            m.depth_range[0] = 0.0f;
+            m.depth_range[1] = 1.0f;
+            if (!through && vp.x_scale != 0.0f && vp.y_scale != 0.0f) {
+                vx = (vp.x_offset - vp.offset_x - std::fabs(vp.x_scale)) * scale;
+                vy = (vp.y_offset - vp.offset_y - std::fabs(vp.y_scale)) * scale;
+                vw = 2.0f * std::fabs(vp.x_scale) * scale;
+                vh = 2.0f * std::fabs(vp.y_scale) * scale;
+                m.flip[0] = vp.x_scale < 0.0f ? -1.0f : 1.0f;
+                m.flip[1] = vp.y_scale < 0.0f ? -1.0f : 1.0f;
+                if (vp.z_scale != 0.0f) {
+                    m.depth_range[0] = std::clamp((vp.z_offset - vp.z_scale) / 65535.0f, 0.0f, 1.0f);
+                    m.depth_range[1] = std::clamp((vp.z_offset + vp.z_scale) / 65535.0f, 0.0f, 1.0f);
+                }
+            }
+            m.viewport_px[0] = round_away(vx);
+            m.viewport_px[1] = round_away(vy);
+            m.viewport_px[2] = std::max(1, round_away(vw));
+            m.viewport_px[3] = std::max(1, round_away(vh));
+            m.screen[0] = static_cast<float>(target.psp_width);
+            m.screen[1] = static_cast<float>(target.psp_height);
+            const std::uint32_t sx1 = std::min(vp.scissor_x1, target.psp_width - 1u);
+            const std::uint32_t sy1 = std::min(vp.scissor_y1, target.psp_height - 1u);
+            const std::uint32_t sx2 = std::min(std::max(vp.scissor_x2, sx1), target.psp_width - 1u);
+            const std::uint32_t sy2 = std::min(std::max(vp.scissor_y2, sy1), target.psp_height - 1u);
+            m.scissor_px[0] = round_away(static_cast<float>(sx1) * scale);
+            m.scissor_px[1] = round_away(static_cast<float>(sy1) * scale);
+            m.scissor_px[2] = round_away(static_cast<float>(sx2 + 1u) * scale) - m.scissor_px[0];
+            m.scissor_px[3] = round_away(static_cast<float>(sy2 + 1u) * scale) - m.scissor_px[1];
+            m.viewport = vp;
+            std::memcpy(&m.target, key, sizeof(key));
+            m.valid = true;
+        }
+        std::memcpy(state.viewport, m.viewport_px, sizeof(state.viewport));
+        std::memcpy(state.scissor, m.scissor_px, sizeof(state.scissor));
+        std::memcpy(state.flip, m.flip, sizeof(state.flip));
+        std::memcpy(state.depth_range, m.depth_range, sizeof(state.depth_range));
+        std::memcpy(state.screen, m.screen, sizeof(state.screen));
+    }
