     GLuint scratch_vbo{}, scratch_ibo{};   // buffer objects whose data is the batch's scratch copy (settings.scratch_buffers)
+    // The scratch buffer objects stay bound, with the batch's attribute pointers as offsets into them, from one batch to
+    // the next: a batch only points them at its own data (four GL calls a draw fewer, and vitaGL's vertex layout stays
