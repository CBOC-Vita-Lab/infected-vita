+void interpret_guest_call(Runtime &rt, AllegrexContext &ctx, std::uint32_t entry) {
+    load_settings();
+    GuestMemory &memory = rt.memory();
+    ExecStats &counters = exec_counters();
+    std::uint32_t pc = entry;
+    note_entry(entry);
+
+    constexpr std::uint64_t kSlice = 1024u;
+    std::uint64_t executed = 0u;
+
+    while (true) {
+        if (executed >= kSlice) {
+            ctx.pc = pc;
+            flush_interpreted(executed, pc);
+            if (rt.stopped()) return;
+        }
+        ctx.pc = pc;
+        if (!g_watch.empty() && std::binary_search(g_watch.begin(), g_watch.end(), pc))
+            report_watch(rt, ctx, pc);
+        const DecodedInstruction decoded = decode_allegrex(memory.aot_load32(pc));
+        ++executed;
+        if (g_pc_profile) count_pc(pc);
+
+        if (!decoded.has_delay_slot()) {
+            if (!execute_simple(rt, ctx, decoded, pc)) {
+                g_instructions += executed;
+                return;
+            }
+            pc += 4u;
+            continue;
+        }
+
+        const DecodedInstruction slot = decode_allegrex(memory.aot_load32(pc + 4u));
+        if (slot.is_control_flow()) {
+            ctx.pc = pc + 4u;
+            rt.unsupported(pc + 4u, slot.word, "control flow in delay slot");
+            g_instructions += executed;
+            return;
+        }
+
+        const std::uint32_t return_pc = pc + 8u;
+        std::uint32_t next = return_pc;
+        bool run_slot = true;
+        bool is_call = false;
+        bool is_jump = false;  // j/jal/jr/jalr: a transfer that may land on a function
+        switch (decoded.kind) {
+        case OpcodeKind::J:
+        case OpcodeKind::Jal:
+            if (decoded.kind == OpcodeKind::Jal) {
+                ctx.set_gpr(31u, return_pc);
+                is_call = true;
+            }
+            is_jump = true;
+            next = ((pc + 4u) & 0xF0000000u) | (decoded.target << 2u);
+            break;
+        case OpcodeKind::Jr:
+        case OpcodeKind::Jalr: {
+            // Both operands are read before the delay slot runs, so a slot that
+            // overwrites rs or the link register cannot change the transfer.
+            const std::uint32_t jump_target = ctx.gpr[decoded.rs];
+            if (decoded.kind == OpcodeKind::Jalr) {
+                ctx.set_gpr(decoded.rd == 0u ? 31u : decoded.rd, return_pc);
+                is_call = true;
+            }
+            is_jump = true;
+            next = jump_target;
+            break;
+        }
+        default: {
+            // The condition is evaluated before the link write, because a
+            // branch-and-link whose condition register is $ra must test the old
+            // value. A likely branch annuls its delay slot when not taken.
+            const bool taken = evaluate_branch(ctx, decoded);
+            if (is_link_branch(decoded.kind)) ctx.set_gpr(31u, return_pc);
+            if (taken) {
+                next = pc + 4u + static_cast<std::uint32_t>(
+                    static_cast<std::int32_t>(decoded.immediate) * 4);
+            }
+            run_slot = taken || !is_likely_branch(decoded.kind);
+            break;
+        }
+        }
+
+        if (run_slot) {
+            ++executed;
+            if (g_pc_profile) count_pc(pc + 4u);
+            ctx.pc = pc + 4u;
+            if (!execute_simple(rt, ctx, slot, pc + 4u)) {
+                g_instructions += executed;
+                return;
+            }
+        }
+        if (!is_jump) {
+            pc = next;
+            continue;
+        }
+
+        // A jump: the end of this callee, a call into a native hook or the system, a call into
+        // the lean corpus, or plain interpreted control flow.
+        if (!is_call && next == kGuestReturnSentinel) {
+            g_instructions += executed;
+            return;
+        }
+        const TargetKind kind = exec_classify(next);
+        if (kind == TargetKind::Interpret) {
+            pc = next;
+            continue;
+        }
+        g_instructions += executed;
+        executed = 0u;
+        ctx.pc = next;
+        if (kind == TargetKind::Native) {
+            ++counters.interpreter_to_native;
+            exec_note_system_call();
+            rt.call_native(next);
+        } else {
+            ++counters.interpreter_to_lean;
+            exec_lean_entry(next)();
+        }
+        if (rt.stopped()) return;
+        // A call returns to the instruction after its delay slot; a jump that was a tail call
+        // returns to where the interpreted function would have returned.
+        pc = is_call ? return_pc : ctx.gpr[31];
+        if (!is_call && pc == kGuestReturnSentinel) return;
+    }
+}
