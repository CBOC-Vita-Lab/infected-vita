+void note_access(std::uint32_t pc, std::uint32_t address, bool store) {
+    if (g_region_counts.empty()) g_region_counts.assign(4096u, RegionCounts{});
+    RegionCounts &counts = g_region_counts[address >> 20u];
+    if (store) ++counts.stores;
+    else ++counts.loads;
+    const int category = classify_access(address);
+    if (category < kFirstOddCategory) return;
+    const std::uint64_t key = (static_cast<std::uint64_t>(pc) << 8u) | (static_cast<std::uint64_t>(category) << 1u) |
+                              (store ? 1u : 0u);
+    auto found = g_odd_accesses.find(key);
+    if (found == g_odd_accesses.end()) {
+        if (g_odd_accesses.size() >= kMaxOddAccesses) return;
+        found = g_odd_accesses.emplace(key, OddAccess{pc, address, store, 0u, category}).first;
+    }
+    ++found->second.count;
+}
