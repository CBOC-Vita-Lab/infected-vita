+void report_interpreter_region_histogram(std::string &out) {
+    if (g_region_counts.empty()) return;
+    char line[256];
+    std::uint64_t per_category_loads[7]{};
+    std::uint64_t per_category_stores[7]{};
+    out += "[regions] guest loads and stores by 1 MiB region of the raw address (interpreter)\n";
+    for (std::uint32_t region = 0; region < g_region_counts.size(); ++region) {
+        const RegionCounts &counts = g_region_counts[region];
+        if (counts.loads == 0u && counts.stores == 0u) continue;
+        const int category = classify_access(region << 20u);
+        per_category_loads[category] += counts.loads;
+        per_category_stores[category] += counts.stores;
+        std::snprintf(line, sizeof line, "[regions]   0x%08X  loads %12llu  stores %12llu  %s\n", region << 20u,
+                      static_cast<unsigned long long>(counts.loads), static_cast<unsigned long long>(counts.stores),
+                      category < kFirstOddCategory ? "ok" : "ODD");
+        out += line;
+    }
+    for (int category = 0; category < 7; ++category) {
+        if (per_category_loads[category] == 0u && per_category_stores[category] == 0u) continue;
+        std::snprintf(line, sizeof line, "[regions] total %-26s loads %12llu  stores %12llu\n",
+                      kAccessCategories[category], static_cast<unsigned long long>(per_category_loads[category]),
+                      static_cast<unsigned long long>(per_category_stores[category]));
+        out += line;
+    }
+    std::vector<const OddAccess *> odd;
+    for (const auto &[key, access] : g_odd_accesses) odd.push_back(&access);
+    std::sort(odd.begin(), odd.end(), [](const OddAccess *a, const OddAccess *b) { return a->count > b->count; });
+    if (odd.empty()) {
+        out += "[regions] no access outside user RAM, VRAM and the scratchpad\n";
+        return;
+    }
+    out += "[regions] accesses outside user RAM / VRAM / scratchpad (pc, first address seen):\n";
+    for (const OddAccess *access : odd) {
+        std::snprintf(line, sizeof line, "[regions]   pc 0x%08X  %-5s 0x%08X  x%-10llu %s\n", access->pc,
+                      access->store ? "store" : "load", access->address,
+                      static_cast<unsigned long long>(access->count), kAccessCategories[access->category]);
+        out += line;
+    }
+}
