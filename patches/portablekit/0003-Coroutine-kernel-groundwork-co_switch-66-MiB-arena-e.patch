diff --git a/src/coroutine.cpp b/src/coroutine.cpp
new file mode 100644
index 0000000..912e19f
--- /dev/null
+++ b/src/coroutine.cpp
@@ -0,0 +1,278 @@
+#include "psprecomp/coroutine.hpp"
+
+#include <cstdint>
+#include <cstdlib>
+#include <stdlib.h>
+#include <cstring>
+
+#if defined(__linux__)
+#include <sys/mman.h>
+#include <unistd.h>
+#define PSPRECOMP_CO_HAVE_MMAP 1
+#endif
+
+// ---------------------------------------------------------------------------
+// The switch. One routine per architecture; both save exactly what the calling
+// convention makes the callee preserve, push it on the stack being left, store
+// that stack pointer through `save_sp`, adopt `new_sp` and pop the same set.
+//
+//   void pk_co_switch(void **save_sp, void *new_sp);
+//
+// A new coroutine's first "return" lands in pk_co_start, which calls
+// entry(argument) with both carried in callee-saved registers.
+
+extern "C" void pk_co_switch(void **save_sp, void *new_sp);
+extern "C" void pk_co_start();
+
+#if defined(__x86_64__) && defined(__ELF__)
+
+// Frame, lowest address first, as pk_co_switch pops it:
+//   [mxcsr:4 | x87 control word:4] r15 r14 r13 r12 rbx rbp [return address]
+asm(R"(
+    .text
+    .p2align 4
+    .globl pk_co_switch
+    .type pk_co_switch,@function
+pk_co_switch:
+    pushq %rbp
+    pushq %rbx
+    pushq %r12
+    pushq %r13
+    pushq %r14
+    pushq %r15
+    subq $8, %rsp
+    stmxcsr (%rsp)
+    fnstcw 4(%rsp)
+    movq %rsp, (%rdi)
+    movq %rsi, %rsp
+    ldmxcsr (%rsp)
+    fldcw 4(%rsp)
+    addq $8, %rsp
+    popq %r15
+    popq %r14
+    popq %r13
+    popq %r12
+    popq %rbx
+    popq %rbp
+    ret
+    .size pk_co_switch,.-pk_co_switch
+
+    .p2align 4
+    .globl pk_co_start
+    .type pk_co_start,@function
+pk_co_start:
+    movq %r13, %rdi
+    callq *%r12
+    ud2
+    .size pk_co_start,.-pk_co_start
+)");
+
+namespace psprecomp {
+namespace {
+constexpr std::size_t kFrameBytes = 8u * 8u;
+void *prepare_stack(std::uint8_t *top, CoroutineEntry entry, void *argument) {
+    // After pk_co_switch pops the frame and returns, rsp = frame + 64 must be
+    // 16-byte aligned so that pk_co_start's `call` leaves the callee with the
+    // ABI's rsp % 16 == 8.
+    auto *frame = reinterpret_cast<std::uint64_t *>(top - kFrameBytes - 16u);
+    std::uint32_t mxcsr = 0x1F80u;
+    std::uint16_t fpucw = 0x037Fu;
+    asm volatile("stmxcsr %0" : "=m"(mxcsr));
+    asm volatile("fnstcw %0" : "=m"(fpucw));
+    frame[0] = static_cast<std::uint64_t>(mxcsr) | (static_cast<std::uint64_t>(fpucw) << 32u);
+    frame[1] = 0u;                                                 // r15
+    frame[2] = 0u;                                                 // r14
+    frame[3] = reinterpret_cast<std::uint64_t>(argument);          // r13
+    frame[4] = reinterpret_cast<std::uint64_t>(entry);             // r12
+    frame[5] = 0u;                                                 // rbx
+    frame[6] = 0u;                                                 // rbp
+    frame[7] = reinterpret_cast<std::uint64_t>(&pk_co_start);      // return address
+    return frame;
+}
+} // namespace
+} // namespace psprecomp
+
+#elif defined(__arm__) && defined(__ELF__)
+
+#if defined(__thumb__)
+#define PK_CO_THUMB_FUNC ".thumb_func\n"
+#else
+#define PK_CO_THUMB_FUNC ""
+#endif
+#if defined(__VFP_FP__) && !defined(__SOFTFP__)
+#define PK_CO_VFP_SAVE "    vmrs r2, fpscr\n"
+#define PK_CO_VFP_PUSH "    vpush {d8-d15}\n"
+#define PK_CO_VFP_POP "    vpop {d8-d15}\n"
+#define PK_CO_VFP_RESTORE "    vmsr fpscr, r2\n"
+#define PK_CO_FRAME_VFP 1
+#else
+#define PK_CO_VFP_SAVE ""
+#define PK_CO_VFP_PUSH ""
+#define PK_CO_VFP_POP ""
+#define PK_CO_VFP_RESTORE ""
+#define PK_CO_FRAME_VFP 0
+#endif
+
+// Frame, lowest address first: d8-d15 (VFP only), then r2 (holds FPSCR),
+// r4-r11 and lr, as push/vpush leave them.
+asm(
+    ".syntax unified\n"
+    ".text\n"
+    ".align 2\n"
+    ".globl pk_co_switch\n"
+    ".type pk_co_switch,%function\n"
+    PK_CO_THUMB_FUNC
+    "pk_co_switch:\n"
+    PK_CO_VFP_SAVE
+    "    push {r2, r4-r11, lr}\n"
+    PK_CO_VFP_PUSH
+    "    str sp, [r0]\n"
+    "    mov sp, r1\n"
+    PK_CO_VFP_POP
+    "    pop {r2, r4-r11, lr}\n"
+    PK_CO_VFP_RESTORE
+    "    bx lr\n"
+    ".size pk_co_switch,.-pk_co_switch\n"
+    ".align 2\n"
+    ".globl pk_co_start\n"
+    ".type pk_co_start,%function\n"
+    PK_CO_THUMB_FUNC
+    "pk_co_start:\n"
+    "    mov r0, r5\n"
+    "    blx r4\n"
+    "    udf #0\n"
+    ".size pk_co_start,.-pk_co_start\n");
+
+namespace psprecomp {
+namespace {
+constexpr std::size_t kFrameBytes = (PK_CO_FRAME_VFP ? 64u : 0u) + 10u * 4u;
+void *prepare_stack(std::uint8_t *top, CoroutineEntry entry, void *argument) {
+    auto *frame = reinterpret_cast<std::uint32_t *>(top - kFrameBytes);
+    std::size_t index = 0;
+#if PK_CO_FRAME_VFP
+    for (; index < 16; ++index) frame[index] = 0u;                 // d8-d15
+#endif
+    std::uint32_t fpscr = 0u;
+#if PK_CO_FRAME_VFP
+    asm volatile("vmrs %0, fpscr" : "=r"(fpscr));
+#endif
+    frame[index++] = fpscr;                                          // r2
+    frame[index++] = reinterpret_cast<std::uintptr_t>(entry);        // r4
+    frame[index++] = reinterpret_cast<std::uintptr_t>(argument);     // r5
+    for (int reg = 6; reg <= 11; ++reg) frame[index++] = 0u;         // r6-r11
+    frame[index++] = reinterpret_cast<std::uintptr_t>(&pk_co_start); // lr
+    return frame;
+}
+} // namespace
+} // namespace psprecomp
+
+#else
+#error "psprecomp::Coroutine has no context switch for this architecture (x86-64 ELF and ARMv7 ELF are written)"
+#endif
+
+namespace psprecomp {
+namespace {
+
+constexpr std::size_t kCanaryWords = 16u;
+constexpr std::uint32_t kCanary = 0xC0FFEE05u;
+constexpr std::uint8_t kPaint = 0xA5u;
+
+std::size_t page_size() {
+#if defined(PSPRECOMP_CO_HAVE_MMAP)
+    static const std::size_t size = static_cast<std::size_t>(sysconf(_SC_PAGESIZE));
+    return size;
+#else
+    return 4096u;
+#endif
+}
+
+} // namespace
+
+bool Coroutine::stack_check_enabled() noexcept {
+    static const bool enabled = [] {
+#if !defined(NDEBUG)
+        return std::getenv("PORTABLEKIT_NO_STACK_CHECK") == nullptr;
+#else
+        const char *text = std::getenv("PORTABLEKIT_STACK_CHECK");
+        return text != nullptr && *text != '\0' && *text != '0';
+#endif
+    }();
+    return enabled;
+}
+
+Coroutine::~Coroutine() { release(); }
+
+bool Coroutine::create(std::size_t stack_bytes, CoroutineEntry entry, void *argument) {
+    release();
+    if (stack_bytes < kMinimumStackBytes) stack_bytes = kMinimumStackBytes;
+    const std::size_t page = page_size();
+    stack_bytes = (stack_bytes + page - 1u) & ~(page - 1u);
+#if defined(PSPRECOMP_CO_HAVE_MMAP)
+    // One PROT_NONE page below the stack turns an overflow into a fault at the
+    // overflowing instruction instead of silent corruption of a neighbour.
+    const std::size_t total = stack_bytes + page;
+    void *mapping = mmap(nullptr, total, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+    if (mapping == MAP_FAILED) return false;
+    (void)mprotect(mapping, page, PROT_NONE);
+    mapping_ = static_cast<std::uint8_t *>(mapping);
+    mapping_bytes_ = total;
+    stack_ = mapping_ + page;
+    mapped_ = true;
+#else
+    void *mapping = ::aligned_alloc(16u, stack_bytes);
+    if (mapping == nullptr) return false;
+    mapping_ = static_cast<std::uint8_t *>(mapping);
+    mapping_bytes_ = stack_bytes;
+    stack_ = mapping_;
+    mapped_ = false;
+#endif
+    usable_bytes_ = stack_bytes;
+    if (stack_check_enabled()) std::memset(stack_, kPaint, usable_bytes_);
+    auto *canary = reinterpret_cast<std::uint32_t *>(stack_);
+    for (std::size_t i = 0; i < kCanaryWords; ++i) canary[i] = kCanary;
+    sp_ = prepare_stack(stack_ + usable_bytes_, entry, argument);
+    return true;
+}
+
+void Coroutine::release() noexcept {
+    if (mapping_ == nullptr) return;
+#if defined(PSPRECOMP_CO_HAVE_MMAP)
+    if (mapped_) munmap(mapping_, mapping_bytes_);
+    else std::free(mapping_);
+#else
+    std::free(mapping_);
+#endif
+    mapping_ = nullptr;
+    stack_ = nullptr;
+    mapping_bytes_ = 0u;
+    usable_bytes_ = 0u;
+    sp_ = nullptr;
+    mapped_ = false;
+}
+
+void Coroutine::switch_to(Coroutine &from, Coroutine &to) noexcept {
+    pk_co_switch(&from.sp_, to.sp_);
+}
+
+bool Coroutine::canary_intact() const noexcept {
+    if (stack_ == nullptr) return true;
+    const auto *canary = reinterpret_cast<const std::uint32_t *>(stack_);
+    for (std::size_t i = 0; i < kCanaryWords; ++i)
+        if (canary[i] != kCanary) return false;
+    return true;
+}
+
+bool Coroutine::contains_stack_pointer(const void *sp) const noexcept {
+    if (stack_ == nullptr) return true;  // the program's own stack: not ours to check
+    const auto *p = static_cast<const std::uint8_t *>(sp);
+    return p >= stack_ + kCanaryWords * sizeof(std::uint32_t) && p <= stack_ + usable_bytes_;
+}
+
+std::size_t Coroutine::high_water_bytes() const noexcept {
+    if (stack_ == nullptr) return 0u;
+    std::size_t offset = kCanaryWords * sizeof(std::uint32_t);
+    while (offset < usable_bytes_ && stack_[offset] == kPaint) ++offset;
+    return usable_bytes_ - offset;
+}
+
+} // namespace psprecomp
