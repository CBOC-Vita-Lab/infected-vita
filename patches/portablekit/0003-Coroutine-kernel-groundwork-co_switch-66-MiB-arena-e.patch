+    if (c >= 0x08800000u && c < 0x0A000000u) return 0;
+    if (c >= 0x04000000u && c < 0x04200000u) return 1;
+    if (c >= 0x00010000u && c < 0x00014000u) return 2;
+    if (c >= 0x08000000u && c < 0x08800000u) return 3;
+    if (c >= 0x0A000000u && c < 0x0C000000u) return 4;
+    if (c >= 0x04200000u && c < 0x04800000u) return 5;
+    return 6;
+}
