new file mode 100644
index 0000000..fcf1fb7
--- /dev/null
+++ b/src/exec.cpp
@@ -0,0 +1,310 @@
+#include "psprecomp/exec.hpp"
+
+#include "psprecomp/common.hpp"
+#include "psprecomp/interpreter.hpp"
+#include "psprecomp/runtime.hpp"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <sstream>
+
+// The state of the one register file; the arena pointer g_ram is defined with the
+// memory it points into (guest_memory.cpp).
+extern "C" {
+psprecomp::AllegrexContext g_cpu{};
+
+// A corpus links its table in under these names (ARCHITECTURE.md 3). Weak, so the runtime
+// links with or without one; a corpus loaded at run time uses exec_set_lean_table().
+extern void (*const g_lean_entry[])() __attribute__((weak));
+extern const std::uint32_t g_lean_entry_count __attribute__((weak));
+}
+
+namespace psprecomp {
+namespace {
+
+constexpr std::uint32_t kWindowBase = 0x08000000u;
+constexpr std::uint32_t kWindowBytes = 32u * 1024u * 1024u;
+constexpr std::uint32_t kWindowWords = kWindowBytes / 4u;
+constexpr std::uint8_t kNativeBit = 1u;
+constexpr std::uint8_t kLeanBit = 2u;
+
+struct State {
+    Runtime *runtime{};
+    const LeanEntry *lean{};
+    std::uint32_t lean_count{};
+    std::uint32_t lean_base{kLeanDefaultBase};
+    bool all_interpreted{};
+    bool lean_only{};
+    std::vector<std::pair<std::uint32_t, std::uint32_t>> forced;
+    std::uint8_t *kinds{};
+    void (*abort_hook)(){};
+    ExecSpinHook spin_hook{};
+    std::uint64_t spin_interval{};
+    std::uint64_t since_system_call{};
+    ExecStats stats{};
+};
+
+State &state() {
+    static State value;
+    return value;
+}
+
+long kind_index(std::uint32_t pc) noexcept {
+    const std::uint32_t c = pc & 0x1FFFFFFFu;
+    if (c < kWindowBase || c >= kWindowBase + kWindowBytes || (c & 3u) != 0u) return -1;
+    return static_cast<long>((c - kWindowBase) >> 2u);
+}
+
+std::uint8_t *kinds_table(State &s) {
+    if (s.kinds == nullptr) s.kinds = static_cast<std::uint8_t *>(std::calloc(kWindowWords, 1u));
+    return s.kinds;
+}
+
+[[noreturn]] void give_up() {
+    State &s = state();
+    std::fflush(stdout);
+    std::fflush(stderr);
+    if (s.abort_hook != nullptr) s.abort_hook();
+    // Nothing to switch away to: the process cannot continue the guest call.
+    std::abort();
+}
+
+// Leaves the guest call when the runtime stopped. Without an abort hook the call returns and the
+// caller (a test) looks at Runtime::stopped().
+void leave_if_stopped() {
+    State &s = state();
+    if (s.runtime != nullptr && s.runtime->stopped() && s.abort_hook != nullptr) s.abort_hook();
+}
+
+bool parse_number(const std::string &text, std::uint32_t &value) {
+    if (text.empty()) return false;
+    char *end = nullptr;
+    const unsigned long parsed = std::strtoul(text.c_str(), &end, 0);
+    if (end == text.c_str() || *end != '\0') return false;
+    value = static_cast<std::uint32_t>(parsed);
+    return true;
+}
+
+} // namespace
+
+void exec_attach(Runtime &runtime) noexcept {
+    State &s = state();
+    s.runtime = &runtime;
+    // Clear the kind table for the new runtime and pick up a linked corpus.
+    if (s.kinds != nullptr) std::memset(s.kinds, 0, kWindowWords);
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Waddress"
+    if (g_lean_entry != nullptr && &g_lean_entry_count != nullptr) {
+        s.lean = g_lean_entry;
+        s.lean_count = g_lean_entry_count;
+        s.lean_base = kLeanDefaultBase;
+    }
+#pragma GCC diagnostic pop
+}
+
+void exec_set_lean_table(const LeanEntry *table, std::uint32_t count, std::uint32_t base) noexcept {
+    State &s = state();
+    s.lean = table;
+    s.lean_count = count;
+    s.lean_base = base;
+    exec_rebuild_kinds();
+}
+
+bool exec_have_lean_table() noexcept { return state().lean != nullptr && state().lean_count != 0u; }
+
+void exec_configure(const ExecOptions &options) {
+    State &s = state();
+    s.lean_only = options.lean_only;
+    s.all_interpreted = false;
+    s.forced.clear();
+    std::string token;
+    std::istringstream list(options.interp_only);
+    while (std::getline(list, token, ',')) {
+        token.erase(std::remove_if(token.begin(), token.end(), [](char c) { return c == ' ' || c == '\t'; }), token.end());
+        if (token.empty()) continue;
+        if (token == "all") {
+            s.all_interpreted = true;
+            continue;
+        }
+        const std::size_t dash = token.find('-');
+        std::uint32_t low = 0u, high = 0u;
+        if (dash == std::string::npos) {
+            if (!parse_number(token, low)) throw Error("INTERP_ONLY: not an address: " + token);
+            high = low;
+        } else if (!parse_number(token.substr(0, dash), low) || !parse_number(token.substr(dash + 1u), high)) {
+            throw Error("INTERP_ONLY: not an address range: " + token);
+        }
+        if (high < low) std::swap(low, high);
+        s.forced.emplace_back(low & 0x1FFFFFFFu, high & 0x1FFFFFFFu);
+    }
+    exec_rebuild_kinds();
+}
+
+void exec_rebuild_kinds() {
+    State &s = state();
+    std::uint8_t *table = kinds_table(s);
+    if (table == nullptr) return;
+    // The lean bit is rebuilt from the table; native bits stay as registered.
+    for (std::uint32_t i = 0; i < s.lean_count; ++i) {
+        const long index = kind_index(s.lean_base + i * 4u);
+        if (index < 0) continue;
+        table[index] = static_cast<std::uint8_t>(table[index] & ~kLeanBit);
+        if (s.lean == nullptr || s.lean[i] == nullptr || s.all_interpreted) continue;
+        const std::uint32_t address = (s.lean_base + i * 4u) & 0x1FFFFFFFu;
+        bool forced = false;
+        for (const auto &[low, high] : s.forced)
+            if (address >= low && address <= high) { forced = true; break; }
+        if (!forced) table[index] = static_cast<std::uint8_t>(table[index] | kLeanBit);
+    }
+}
+
+TargetKind exec_classify(std::uint32_t pc) noexcept {
+    const State &s = state();
+    if (s.kinds == nullptr) return TargetKind::Interpret;
+    const long index = kind_index(pc);
+    if (index < 0) return TargetKind::Interpret;
+    const std::uint8_t kind = s.kinds[index];
+    if ((kind & kNativeBit) != 0u) return TargetKind::Native;
+    if ((kind & kLeanBit) != 0u) return TargetKind::Lean;
+    return TargetKind::Interpret;
+}
+
+LeanEntry exec_lean_entry(std::uint32_t pc) noexcept {
+    const State &s = state();
+    const std::uint32_t index = (pc - s.lean_base) >> 2u;
+    return index < s.lean_count ? s.lean[index] : nullptr;
+}
+
+void exec_mark_native(std::uint32_t pc) noexcept {
+    State &s = state();
+    std::uint8_t *table = kinds_table(s);
+    const long index = kind_index(pc);
+    if (table != nullptr && index >= 0) table[index] = static_cast<std::uint8_t>(table[index] | kNativeBit);
+}
+
+void exec_clear_native(std::uint32_t pc) noexcept {
+    State &s = state();
+    const long index = kind_index(pc);
+    if (s.kinds != nullptr && index >= 0) s.kinds[index] = static_cast<std::uint8_t>(s.kinds[index] & ~kNativeBit);
+}
+
+void exec_set_abort_hook(void (*hook)()) noexcept { state().abort_hook = hook; }
+
+void exec_set_spin_hook(ExecSpinHook hook, std::uint64_t interval) noexcept {
+    State &s = state();
+    s.spin_hook = hook;
+    s.spin_interval = hook != nullptr ? interval : 0u;
+}
+
+void exec_note_system_call() noexcept { state().since_system_call = 0u; }
+
+void exec_account_instructions(std::uint64_t count, std::uint32_t pc) {
+    State &s = state();
+    s.since_system_call += count;
+    if (s.spin_interval != 0u && s.since_system_call >= s.spin_interval) {
+        s.since_system_call = 0u;
+        if (s.spin_hook != nullptr) s.spin_hook(pc);
+    }
+}
+
+ExecStats exec_stats() noexcept { return state().stats; }
+ExecStats &exec_counters() noexcept { return state().stats; }
+
+void exec_report(std::string &out) {
+    const ExecStats &st = state().stats;
+    char line[256];
+    std::snprintf(line, sizeof line,
+                  "[exec] pk_guest_call: %llu lean, %llu interpreted, %llu native; pk_hle_call: %llu; "
+                  "interpreter->lean %llu, interpreter->native %llu; lean table: %s (%u entries)\n",
+                  static_cast<unsigned long long>(st.lean_calls), static_cast<unsigned long long>(st.interpreted_calls),
+                  static_cast<unsigned long long>(st.native_calls), static_cast<unsigned long long>(st.hle_calls),
+                  static_cast<unsigned long long>(st.interpreter_to_lean),
+                  static_cast<unsigned long long>(st.interpreter_to_native),
+                  exec_have_lean_table() ? "linked" : "none", state().lean_count);
+    out += line;
+}
+
+} // namespace psprecomp
+
+// ---------------------------------------------------------------------------
+// The C entry points.
+
+using psprecomp::State;
+
+extern "C" void pk_guest_call(std::uint32_t pc) {
+    using namespace psprecomp;
+    State &s = state();
+    Runtime &rt = *s.runtime;
+    switch (exec_classify(pc)) {
+    case TargetKind::Native:
+        ++s.stats.native_calls;
+        exec_note_system_call();
+        try {
+            rt.call_native(pc);
+        } catch (const std::exception &e) {
+            rt.stop(std::string(e.what()) + " in native function " + hex32(pc));
+        }
+        break;
+    case TargetKind::Lean:
+        ++s.stats.lean_calls;
+        exec_lean_entry(pc)();
+        break;
+    case TargetKind::Interpret: {
+        if (s.lean_only) pk_fatal("lean-only mode: this function would run in the interpreter", pc);
+        ++s.stats.interpreted_calls;
+        const std::uint32_t saved_ra = g_cpu.gpr[31];
+        g_cpu.gpr[31] = kGuestReturnSentinel;
+        try {
+            interpret_guest_call(rt, g_cpu, pc);
+        } catch (const std::exception &e) {
+            // Name the guest code, as a fault in generated code is named.
+            std::ostringstream message;
+            message << e.what() << " while interpreting from " << hex32(pc) << " guest_pc=" << hex32(g_cpu.pc)
+                    << " (a0=" << hex32(g_cpu.gpr[4]) << ", a1=" << hex32(g_cpu.gpr[5]) << ", sp=" << hex32(g_cpu.gpr[29])
+                    << ", ra=" << hex32(g_cpu.gpr[31]) << ")";
+            rt.stop(message.str());
+        }
+        g_cpu.gpr[31] = saved_ra;
+        break;
+    }
+    }
+    leave_if_stopped();
+}
+
+extern "C" void pk_hle_call(std::uint32_t stub_pc) {
+    using namespace psprecomp;
+    State &s = state();
+    Runtime &rt = *s.runtime;
+    ++s.stats.hle_calls;
+    exec_note_system_call();
+    try {
+        rt.call_native(stub_pc);
+    } catch (const std::exception &e) {
+        rt.stop(std::string(e.what()) + " in the system call at " + hex32(stub_pc));
+    }
+    leave_if_stopped();
+}
+
+extern "C" [[noreturn]] void pk_fatal(const char *message, std::uint32_t pc) {
+    using namespace psprecomp;
+    State &s = state();
+    std::ostringstream text;
+    text << "guest fatal: " << message << " at pc " << hex32(pc) << " (a0=" << hex32(g_cpu.gpr[4])
+         << ", a1=" << hex32(g_cpu.gpr[5]) << ", sp=" << hex32(g_cpu.gpr[29]) << ", ra=" << hex32(g_cpu.gpr[31]) << ")";
+    std::fprintf(stderr, "[fatal] %s\n", text.str().c_str());
+    if (s.runtime != nullptr) s.runtime->stop(text.str());
+    give_up();
+}
+
+extern "C" void pk_yield(void) {
+    using namespace psprecomp;
+    State &s = state();
+    // A loop that waits for an event reaches here without having called the system.
+    if (s.spin_hook != nullptr) {
+        s.since_system_call = 0u;
+        s.spin_hook(g_cpu.pc);
+    }
+    leave_if_stopped();
+}
