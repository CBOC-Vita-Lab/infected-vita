+// Stackful coroutines: the context switch, argument passing, floating-point
+// state across switches, deep stacks, the canary and many short lives.
+// No kernel, no game.
+
+#include "psprecomp/coroutine.hpp"
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+namespace {
+
+using psprecomp::Coroutine;
+
+int g_failures = 0;
+
+void check(bool condition, const char *what) {
+    std::printf("%s %s\n", condition ? "ok  " : "FAIL", what);
+    if (!condition) ++g_failures;
+}
+
+Coroutine g_main;
+Coroutine g_a;
+Coroutine g_b;
+
+struct PingPong {
+    std::uint64_t counter = 0;
+    std::uint64_t limit = 0;
+    double accumulator_a = 1.0;
+    double accumulator_b = 2.0;
+};
+PingPong g_pp;
+
+void ping(void *argument) {
+    auto *state = static_cast<PingPong *>(argument);
+    // Values that live across the switch in callee-saved registers (VFP d8-d15
+    // on ARM, the GPRs everywhere).
+    double local = 1.5;
+    std::uint64_t mine = 0xA0A0A0A0u;
+    for (;;) {
+        ++state->counter;
+        local = local * 1.0000001 + 0.5;
+        state->accumulator_a = local;
+        if (state->counter >= state->limit || mine != 0xA0A0A0A0u) Coroutine::switch_to(g_a, g_main);
+        Coroutine::switch_to(g_a, g_b);
+    }
+}
+
+void pong(void *argument) {
+    auto *state = static_cast<PingPong *>(argument);
+    double local = 2.5;
+    std::uint64_t mine = 0xB0B0B0B0u;
+    for (;;) {
+        ++state->counter;
+        local = local * 0.9999999 + 0.25;
+        state->accumulator_b = local;
+        if (mine != 0xB0B0B0B0u) Coroutine::switch_to(g_b, g_main);
+        Coroutine::switch_to(g_b, g_a);
+    }
+}
+
+int g_entry_value = 0;
+void entry_with_argument(void *argument) {
+    g_entry_value = *static_cast<int *>(argument);
+    Coroutine::switch_to(g_a, g_main);
+}
+
+// Recursion that touches a lot of stack, and returns a checksum.
+std::uint64_t deep(int depth) {
+    volatile std::uint8_t pad[1024];
+    pad[0] = static_cast<std::uint8_t>(depth);
+    pad[1023] = static_cast<std::uint8_t>(depth * 3);
+    if (depth == 0) return pad[0] + pad[1023];
+    return deep(depth - 1) + pad[0] + pad[1023];
+}
+
+std::uint64_t g_deep_result = 0;
+void deep_entry(void *argument) {
+    g_deep_result = deep(*static_cast<int *>(argument));
+    Coroutine::switch_to(g_a, g_main);
+}
+
+int g_lifetimes = 0;
+void short_lived(void *) {
+    ++g_lifetimes;
+    Coroutine::switch_to(g_a, g_main);
+}
+
+} // namespace
+
+int main() {
+    // Argument and first entry.
+    {
+        int value = 4242;
+        check(g_a.create(Coroutine::kDefaultStackBytes, entry_with_argument, &value), "a stack is allocated");
+        Coroutine::switch_to(g_main, g_a);
+        check(g_entry_value == 4242, "the entry function receives its argument");
+        g_a.release();
+    }
+
+    // Ping-pong: a million switches each way, with floating-point and integer
+    // locals that must survive every one of them.
+    {
+        g_pp.limit = 400000;
+        check(g_a.create(Coroutine::kDefaultStackBytes, ping, &g_pp), "ping stack");
+        check(g_b.create(Coroutine::kDefaultStackBytes, pong, &g_pp), "pong stack");
+        Coroutine::switch_to(g_main, g_a);
+        check(g_pp.counter >= g_pp.limit, "400000 round trips complete");
+        // Recompute the expected recurrences.
+        double a = 1.5, b = 2.5;
+        const std::uint64_t half = (g_pp.counter + 1) / 2;
+        for (std::uint64_t i = 0; i < half; ++i) a = a * 1.0000001 + 0.5;
+        for (std::uint64_t i = 0; i < g_pp.counter / 2; ++i) b = b * 0.9999999 + 0.25;
+        check(std::fabs(g_pp.accumulator_a - a) < 1e-9 * std::fabs(a), "floating-point locals survive the switches (a)");
+        check(std::fabs(g_pp.accumulator_b - b) < 1e-9 * std::fabs(b), "floating-point locals survive the switches (b)");
+        g_a.release();
+        g_b.release();
+    }
+
+    // Deep stack use: 200 KiB of a 256 KiB stack.
+    {
+        int depth = 200;
+        check(g_a.create(Coroutine::kDefaultStackBytes, deep_entry, &depth), "deep stack");
+        Coroutine::switch_to(g_main, g_a);
+        std::uint64_t expected = 0;
+        for (int d = 0; d <= depth; ++d) expected += static_cast<std::uint8_t>(d) + static_cast<std::uint8_t>(d * 3);
+        check(g_deep_result == expected, "200 KiB of recursion on a 256 KiB stack");
+        check(g_a.canary_intact(), "the canary is intact after deep recursion");
+        check(g_a.contains_stack_pointer(g_a.saved_stack_pointer()), "the saved stack pointer lies inside the stack");
+        g_a.release();
+    }
+
+    // The canary notices a write below the stack.
+    {
+        int value = 1;
+        check(g_a.create(Coroutine::kMinimumStackBytes, entry_with_argument, &value), "small stack");
+        check(g_a.canary_intact(), "a new stack has its canary");
+        *static_cast<std::uint32_t *>(g_a.stack_base()) = 0u;
+        check(!g_a.canary_intact(), "a smashed canary is detected");
+        g_a.release();
+    }
+
+    // Many short lives.
+    {
+        for (int i = 0; i < 2000; ++i) {
+            Coroutine co;
+            if (!co.create(64u * 1024u, short_lived, nullptr)) { check(false, "create in a loop"); break; }
+            // Reuse g_a as the "from" slot so short_lived can come back.
+            g_a.release();
+            Coroutine::switch_to(g_main, co);  // short_lived switches to g_main from g_a: g_a's sp slot receives it
+            co.release();
+        }
+        check(g_lifetimes == 2000, "2000 coroutines are created, run and released");
+    }
+
+    std::printf("%s\n", g_failures == 0 ? "all coroutine checks passed" : "coroutine checks FAILED");
+    return g_failures == 0 ? 0 : 1;
+}
