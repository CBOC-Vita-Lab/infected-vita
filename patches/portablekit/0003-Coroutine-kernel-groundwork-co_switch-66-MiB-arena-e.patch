+// Accounts the instructions run since the last flush, hands them to the spin hook (which may
+// switch coroutines) and says whether the runtime stopped meanwhile.
+inline void flush_interpreted(std::uint64_t &executed, std::uint32_t pc) {
+    g_instructions += executed;
+    const std::uint64_t count = executed;
+    executed = 0u;
+    exec_account_instructions(count, pc);
+}
