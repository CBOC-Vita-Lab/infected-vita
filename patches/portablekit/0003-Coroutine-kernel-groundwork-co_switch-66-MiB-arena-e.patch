diff --git a/include/psprecomp/coroutine.hpp b/include/psprecomp/coroutine.hpp
new file mode 100644
index 0000000..ebb9b4d
--- /dev/null
+++ b/include/psprecomp/coroutine.hpp
@@ -0,0 +1,70 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+// Stackful coroutines for guest threads.
+//
+// Every PSP thread runs on a host stack of its own, so a blocking system call
+// is an ordinary C++ call that returns when the thread is scheduled again,
+// and nothing is ever unwound. The switch is hand-written per architecture
+// (x86-64 System V, ARMv7 AAPCS with hard-float VFP): no ucontext, no setjmp,
+// no host threads.
+//
+// A Coroutine is either a stack made by create() or a placeholder for the stack
+// the program started on (the default-constructed one), which gets its saved
+// stack pointer the first time something switches away from it.
+namespace psprecomp {
+
+using CoroutineEntry = void (*)(void *argument);
+
+class Coroutine {
+public:
+    static constexpr std::size_t kDefaultStackBytes = 256u * 1024u;
+    static constexpr std::size_t kMinimumStackBytes = 16u * 1024u;
+
+    Coroutine() = default;
+    ~Coroutine();
+    Coroutine(const Coroutine &) = delete;
+    Coroutine &operator=(const Coroutine &) = delete;
+
+    // Allocates a stack and prepares the first switch to land in
+    // entry(argument). `entry` must never return: when it is done it switches
+    // away for good, and whoever switched to it releases the stack.
+    // Returns false when the stack cannot be allocated.
+    [[nodiscard]] bool create(std::size_t stack_bytes, CoroutineEntry entry, void *argument);
+    // Frees the stack. Not valid on the running coroutine.
+    void release() noexcept;
+    [[nodiscard]] bool valid() const noexcept { return stack_ != nullptr; }
+
+    // Saves the running context in `from` and continues `to`; returns when
+    // something switches back to `from`.
+    static void switch_to(Coroutine &from, Coroutine &to) noexcept;
+
+    // Stack safety. The canary is a run of known words at the low end of the
+    // stack (and a PROT_NONE page below it where the host has mmap); both are
+    // always set up, the check itself costs a few loads and is made on every
+    // switch when enabled (debug builds, or PORTABLEKIT_STACK_CHECK=1).
+    [[nodiscard]] bool canary_intact() const noexcept;
+    // True when `sp` (the saved stack pointer of a coroutine that is not
+    // running) lies inside this coroutine's stack with the canary beneath it.
+    [[nodiscard]] bool contains_stack_pointer(const void *sp) const noexcept;
+    // Bytes of the stack that were ever written, found from a fill pattern.
+    // Only meaningful when the stack was painted (stack checking enabled).
+    [[nodiscard]] std::size_t high_water_bytes() const noexcept;
+
+    [[nodiscard]] std::size_t stack_bytes() const noexcept { return usable_bytes_; }
+    [[nodiscard]] const void *saved_stack_pointer() const noexcept { return sp_; }
+    [[nodiscard]] void *stack_base() const noexcept { return stack_; }
+    [[nodiscard]] static bool stack_check_enabled() noexcept;
+
+private:
+    void *sp_{};
+    std::uint8_t *stack_{};        // lowest usable byte (just above the guard page)
+    std::uint8_t *mapping_{};      // start of the host allocation
+    std::size_t mapping_bytes_{};
+    std::size_t usable_bytes_{};
+    bool mapped_{};
+};
+
+} // namespace psprecomp
diff --git a/include/psprecomp/exec.hpp b/include/psprecomp/exec.hpp
new file mode 100644
index 0000000..a1c331c
--- /dev/null
+++ b/include/psprecomp/exec.hpp
@@ -0,0 +1,104 @@
+#pragma once
+
+// The execution layer of the coroutine kernel: how guest code is entered, how it
+// reaches the system, and how the lean (function-granular) corpus and the
+// interpreter call each other. ARCHITECTURE.md sections 2-4 are the contract.
+//
+//   g_cpu          the one live AllegrexContext (== Runtime::cpu()).
+//   g_ram          the guest memory arena, 66 MiB; host(a) = g_ram + (a & 0x05FFFFFF).
+//   g_lean_entry   the corpus's table of regfile-convention entry thunks, index
+//                  (pc - lean base) >> 2, nullptr where no function starts. Optional:
+//                  the runtime links with or without a corpus (weak reference), and a
+//                  corpus loaded at run time hands its table to exec_set_lean_table().
+//   pk_guest_call  run the guest function at `pc` to its return, on the current
+//                  coroutine: its lean entry when there is one, else the interpreter.
+//   pk_hle_call    run the HLE function bound to an import stub; may switch coroutines
+//                  before returning.
+//   pk_fatal       the guest did something that cannot continue; never returns.
+//   pk_yield       PK_YIELD(): a point at which a guest loop that waits for an event
+//                  lets time pass and interrupts run.
+#include "psprecomp/allegrex_context.hpp"
+
+#include <cstdint>
+#include <string>
+#include <utility>
+#include <vector>
+
+extern "C" {
+extern psprecomp::AllegrexContext g_cpu;
+extern std::uint8_t *g_ram;
+void pk_guest_call(std::uint32_t pc);
+void pk_hle_call(std::uint32_t stub_pc);
+[[noreturn]] void pk_fatal(const char *message, std::uint32_t pc);
+void pk_yield(void);
+}
+
+// host(a) for generated code and for the host's own unchecked accesses.
+#define PK_GUEST_TO_HOST(a) (g_ram + (static_cast<std::uint32_t>(a) & 0x05FFFFFFu))
+
+namespace psprecomp {
+
+class Runtime;
+
+using LeanEntry = void (*)();
+
+inline constexpr std::uint32_t kLeanDefaultBase = 0x08804000u;
+// Where a guest call made by the host returns to. An interpreted callee has this
+// in $ra and the interpreter stops when control reaches it.
+inline constexpr std::uint32_t kGuestReturnSentinel = 0x0880000Cu;
+
+enum class TargetKind : std::uint8_t {
+    Interpret = 0,  // no native hook, no lean entry (or forced): the interpreter runs it
+    Native = 1,     // an import stub or a profile hook registered with Runtime::register_function
+    Lean = 2,       // a lean entry thunk exists and the function is not forced
+};
+
+struct ExecOptions {
+    // INFECTED_INTERP_ONLY: "all", or addresses and address ranges ("0x08935F54,0x089118B0-0x08911900").
+    // A forced function runs in the interpreter even when the corpus has a lean entry for it.
+    std::string interp_only;
+    // INFECTED_LEAN_ONLY: running the interpreter is a fatal error.
+    bool lean_only = false;
+};
+
+// Attaches the runtime the C entry points work on. Called by Runtime's constructor.
+void exec_attach(Runtime &runtime) noexcept;
+void exec_configure(const ExecOptions &options);
+// Gives the runtime the lean table of a corpus loaded at run time. A table linked in as
+// g_lean_entry is found without this.
+void exec_set_lean_table(const LeanEntry *table, std::uint32_t count, std::uint32_t base = kLeanDefaultBase) noexcept;
+[[nodiscard]] bool exec_have_lean_table() noexcept;
+// Rebuilds the per-address kind table after functions were registered or the options changed.
+void exec_rebuild_kinds();
+[[nodiscard]] TargetKind exec_classify(std::uint32_t pc) noexcept;
+[[nodiscard]] LeanEntry exec_lean_entry(std::uint32_t pc) noexcept;
+void exec_mark_native(std::uint32_t pc) noexcept;
+void exec_clear_native(std::uint32_t pc) noexcept;
+
+// Called when the runtime stopped (or pk_fatal ran) while a guest call is in flight. It
+// must not return: the kernel switches away from the coroutine for good. Without one, the
+// call returns to its caller with the runtime stopped.
+void exec_set_abort_hook(void (*hook)()) noexcept;
+// Called every `interval` interpreted instructions that ran without a system call
+// (interval 0 turns it off), with the pc of the instruction about to run. This is
+// where the old kernel's starvation preemption lives.
+using ExecSpinHook = void (*)(std::uint32_t pc);
+void exec_set_spin_hook(ExecSpinHook hook, std::uint64_t interval) noexcept;
+// The system was entered: resets the spin counter.
+void exec_note_system_call() noexcept;
+
+struct ExecStats {
+    std::uint64_t lean_calls{};         // pk_guest_call that ran a lean entry
+    std::uint64_t interpreted_calls{};  // pk_guest_call that ran the interpreter
+    std::uint64_t native_calls{};       // hooks and import stubs reached through pk_guest_call
+    std::uint64_t hle_calls{};          // pk_hle_call
+    std::uint64_t interpreter_to_lean{};
+    std::uint64_t interpreter_to_native{};
+};
+[[nodiscard]] ExecStats exec_stats() noexcept;
+[[nodiscard]] ExecStats &exec_counters() noexcept;
+// Interpreted instructions were run: feeds the spin hook.
+void exec_account_instructions(std::uint64_t count, std::uint32_t pc);
+void exec_report(std::string &out);
+
+} // namespace psprecomp
