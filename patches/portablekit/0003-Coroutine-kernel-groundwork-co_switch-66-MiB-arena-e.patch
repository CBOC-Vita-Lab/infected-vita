+#include <string>
 #include <utility>
 #include <vector>
 
@@ -44,6 +45,21 @@ struct InterpreterStats {
 InterpreterExit interpret_allegrex(Runtime &runtime, AllegrexContext &ctx,
                                    std::uint64_t instruction_budget = 0u);
 
+// The coroutine kernel's way in (exec.hpp): runs the callee at `entry` on `ctx`,
+// which the caller has given $ra = kGuestReturnSentinel, until it returns there.
+// `jal`/`jalr`/`j` to an address that has a native hook or a lean entry call it
+// directly, and an import stub runs its HLE function in place, which may switch
+// coroutines before it returns; every other call is interpreted without leaving
+// the loop. Stops early, with the runtime stopped, on an unsupported instruction.
+// May throw psprecomp::Error for a bad guest address.
+void interpret_guest_call(Runtime &runtime, AllegrexContext &ctx, std::uint32_t entry);
+
+// Guest loads and stores by 1 MiB region of the raw address, with the PC of every
