+#!/usr/bin/env python3
+"""CPU-side cost of each graphics option, from ge_replay --null-draw --stats (docs/GRAPHICS_OPTIONS.md).
+
+For every option value, the same recorded flip is replayed with GL draw calls nulled (so the numbers are what the host
+spends issuing the frame, not what a GPU spends drawing it) and the counters the renderer keeps are read back: GL draws,
+state changes, texture binds, extra passes, bytes uploaded. The wall time per flip is the best of several runs, on a
+machine other programs share, so read the milliseconds as a ratio to the baseline row, not as an absolute.
+
+  gfx_cost.py --replay build/bin/ge_replay --dump private/dumps/run9 --flip 2250 [--repeat 30] [--runs 3]
+              [--out private/compare/costs_run9_2250.md]
+"""
+import argparse
+import re
+import subprocess
+import sys
+
+# Every graphics option off, spelled out (a replay's "--port baseline" would switch the options off altogether, which is
+# the same picture but cannot be combined with a single option turned on).
+OFF = {"gfx.texture_filter": "original", "gfx.mipmaps": "off", "gfx.antialiasing": "off", "gfx.pixel_lighting": "off",
+       "gfx.effects_scale": "1", "gfx.movie_filter": "bilinear", "perf.show_fps": "off"}
+
+
+def with_on(**changes):
+    values = dict(OFF)
+    values.update({k.replace("__", "."): v for k, v in changes.items()})
+    return ["%s=%s" % item for item in values.items()]
+
+
+# (label, [--port arguments]); the first row is the reference every other row is compared with.
+ROWS = [
+    ("all options off (what the game asks for)", with_on()),
+    ("gfx.texture_filter=smooth", with_on(gfx__texture_filter="smooth")),
+    ("gfx.mipmaps=on", with_on(gfx__mipmaps="on")),
+    ("smooth + mipmaps (the defaults)", with_on(gfx__texture_filter="smooth", gfx__mipmaps="on")),
+    ("gfx.antialiasing=fxaa", with_on(gfx__antialiasing="fxaa")),
+    ("gfx.antialiasing=msaa2 (desktop preview)", with_on(gfx__antialiasing="msaa2")),
+    ("gfx.antialiasing=msaa4 (desktop preview)", with_on(gfx__antialiasing="msaa4")),
+    ("gfx.pixel_lighting=on", with_on(gfx__pixel_lighting="on")),
+    ("gfx.effects_scale=2", with_on(gfx__effects_scale="2")),
+    ("perf.show_fps=on", with_on(perf__show_fps="on")),
+    ("everything on (smooth, mips, fxaa, pixel lighting, scale 2)",
+     with_on(gfx__texture_filter="smooth", gfx__mipmaps="on", gfx__antialiasing="fxaa", gfx__pixel_lighting="on",
+             gfx__effects_scale="2")),
+]
+
+FIELDS = [
+    ("gl_draws", r"GL draws after merging\s+\d+\s+\[([\d.]+)\]"),
+    ("prog", r"program switches\s+\d+\s+\[([\d.]+)\]"),
+    ("texbind", r"texture binds\s+\d+\s+\[([\d.]+)\]"),
+    ("fbo", r"render target switches\s+\d+\s+\[([\d.]+)\]"),
+    ("uniform", r"uniform uploads\s+\d+\s+\[([\d.]+)\]"),
+    ("post", r"post passes \(fxaa/resolve/...\)\s+\d+\s+\[([\d.]+)\]"),
+    ("mipkb", r"mip bytes uploaded \(CPU\)\s+\d+\s+\[([\d.]+)\]"),
+    ("variants", r"shader variants (\d+),"),
+    ("gl_ms", r"GL submission ([\d.]+) ms"),
+    ("flip_ms", r"whole flip ([\d.]+) ms"),
+]
+
+
+def run(replay, dump, flip, repeat, ports):
+    cmd = [replay, dump, "--flips", str(flip), "--null-draw", "--cpu-time", "--repeat", str(repeat), "--stats"]
+    for p in ports:
+        cmd += ["--port", p]
+    out = subprocess.run(["nice", "-n", "10"] + cmd, capture_output=True, text=True, timeout=600,
+                         env={"EGL_PLATFORM": "surfaceless", "LIBGL_ALWAYS_SOFTWARE": "1", "PATH": "/usr/bin:/bin"}).stdout
+    row = {}
+    for name, pattern in FIELDS:
+        m = re.search(pattern, out)
+        row[name] = float(m.group(1)) if m else float("nan")
+    row["mipkb"] /= 1024.0
+    return row
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--replay", required=True)
+    ap.add_argument("--dump", required=True)
+    ap.add_argument("--flip", required=True, type=int)
+    ap.add_argument("--repeat", type=int, default=30)
+    ap.add_argument("--runs", type=int, default=3)
+    ap.add_argument("--out")
+    args = ap.parse_args()
+    lines = ["| option | GL draws | prog switches | tex binds | extra passes | mip KiB/flip | GL submit ms | whole flip ms | vs baseline |",
+             "|---|---:|---:|---:|---:|---:|---:|---:|---:|"]
+    base = None
+    for label, ports in ROWS:
+        best = None
+        for _ in range(args.runs):
+            row = run(args.replay, args.dump, args.flip, args.repeat, ports)
+            if best is None or row["flip_ms"] < best["flip_ms"]:
+                best = row
+        if base is None:
+            base = best
+        ratio = best["flip_ms"] / base["flip_ms"] if base["flip_ms"] else float("nan")
+        lines.append("| %s | %.0f | %.0f | %.0f | %.0f | %.1f | %.2f | %.2f | x%.2f |" %
+                     (label, best["gl_draws"], best["prog"], best["texbind"], best["post"], best["mipkb"], best["gl_ms"],
+                      best["flip_ms"], ratio))
+        print(lines[-1], flush=True)
+    text = "\n".join(lines) + "\n"
+    if args.out:
+        with open(args.out, "w") as f:
+            f.write("CPU cost per flip, %s flip %d, null draws, best of %d runs of %d replays\n\n" %
+                    (args.dump, args.flip, args.runs, args.repeat) + text)
+    return 0
+
