+#include "overlay/bitmap_font.hpp"
+
+namespace portablekit::overlay {
+namespace {
+
+const std::uint8_t kGlyphs[kGlyphCount][kGlyphHeight] = {
+#include "overlay/bitmap_font_data.inc"
+};
+
+} // namespace
+
+int glyph_index(char c) noexcept {
+    const auto code = static_cast<unsigned char>(c);
+    if (code >= 32u && code <= 126u) return static_cast<int>(code) - 32;
+    if (code == 1u) return 95;
+    if (code == 2u) return 96;
+    return '?' - 32;
+}
+
+const std::uint8_t *glyph_rows(int index) noexcept {
+    return kGlyphs[index >= 0 && index < kGlyphCount ? index : '?' - 32];
+}
+
+int text_width(std::string_view text, int scale) noexcept {
+    if (text.empty()) return 0;
+    return (static_cast<int>(text.size()) * kGlyphAdvance - 1) * scale;
+}
+
+} // namespace portablekit::overlay
