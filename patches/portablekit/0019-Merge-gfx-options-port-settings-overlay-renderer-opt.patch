@@ -0,0 +1,49 @@
+#include "overlay/canvas.hpp"
+
+#include "overlay/bitmap_font.hpp"
+
+#include <algorithm>
+
+namespace portablekit::overlay {
+
+SoftCanvas::SoftCanvas(int width, int height)
+    : width_(width), height_(height), pixels_(static_cast<std::size_t>(width) * static_cast<std::size_t>(height) * 4u, 0u) {}
+
+void SoftCanvas::clear(std::uint32_t color) {
+    for (std::size_t i = 0; i < pixels_.size(); i += 4u) {
+        pixels_[i] = static_cast<std::uint8_t>(color);
+        pixels_[i + 1] = static_cast<std::uint8_t>(color >> 8u);
+        pixels_[i + 2] = static_cast<std::uint8_t>(color >> 16u);
+        pixels_[i + 3] = static_cast<std::uint8_t>(color >> 24u);
+    }
+}
+
+void SoftCanvas::fill(int x, int y, int w, int h, std::uint32_t color) {
+    const int x0 = std::max(x, 0), y0 = std::max(y, 0);
+    const int x1 = std::min(x + w, width_), y1 = std::min(y + h, height_);
+    const std::uint32_t alpha = color >> 24u;
+    for (int row = y0; row < y1; ++row) {
+        std::uint8_t *at = pixels_.data() + (static_cast<std::size_t>(row) * static_cast<std::size_t>(width_) + static_cast<std::size_t>(x0)) * 4u;
+        for (int column = x0; column < x1; ++column, at += 4) {
+            for (int c = 0; c < 3; ++c) {
+                const std::uint32_t source = (color >> (8u * static_cast<std::uint32_t>(c))) & 0xFFu;
+                at[c] = static_cast<std::uint8_t>((source * alpha + at[c] * (255u - alpha) + 127u) / 255u);
+            }
+            at[3] = static_cast<std::uint8_t>(alpha + at[3] * (255u - alpha) / 255u);
+        }
+    }
+}
+
+void SoftCanvas::text(int x, int y, int scale, std::uint32_t color, std::string_view text) {
+    int pen = x;
+    for (const char c : text) {
+        const std::uint8_t *rows = glyph_rows(glyph_index(c));
+        for (int row = 0; row < kGlyphHeight; ++row)
+            for (int column = 0; column < kGlyphWidth; ++column)
+                if ((rows[row] >> (kGlyphWidth - 1 - column)) & 1u)
+                    fill(pen + column * scale, y + row * scale, scale, scale, color);
+        pen += kGlyphAdvance * scale;
+    }
+}
+
+} // namespace portablekit::overlay
diff --git a/host/overlay/canvas.hpp b/host/overlay/canvas.hpp
new file mode 100644
index 0000000..3b59940
--- /dev/null
+++ b/host/overlay/canvas.hpp
@@ -0,0 +1,47 @@
+#pragma once
+
+// What the overlay menu and the counters draw with: filled rectangles and text in a pixel grid of the display's
+// size (960x544 on the Vita). The GL renderer implements it over its own programs (gpu/gl/gl_overlay.cpp); the
+// software canvas below implements it over a byte buffer, for tests and for a preview that needs no GL.
+#include <cstdint>
+#include <string_view>
+#include <vector>
+
+namespace portablekit::overlay {
+
+// A colour as four bytes in memory order R, G, B, A (alpha 255 is opaque).
+[[nodiscard]] constexpr std::uint32_t rgba(std::uint32_t r, std::uint32_t g, std::uint32_t b, std::uint32_t a = 255u) {
+    return (r & 0xFFu) | (g & 0xFFu) << 8u | (b & 0xFFu) << 16u | (a & 0xFFu) << 24u;
+}
+
+class Canvas {
+public:
+    virtual ~Canvas() = default;
+    [[nodiscard]] virtual int width() const = 0;
+    [[nodiscard]] virtual int height() const = 0;
+    // A rectangle, alpha-blended over what is there. Rows grow downwards.
+    virtual void fill(int x, int y, int w, int h, std::uint32_t color) = 0;
+    // Text at an integer scale; (x, y) is the top left of the first glyph cell. Characters outside ASCII 32..126
+    // and the two arrow heads draw as '?'.
+    virtual void text(int x, int y, int scale, std::uint32_t color, std::string_view text) = 0;
+};
+
+// A canvas over an RGBA byte buffer (top row first).
+class SoftCanvas final : public Canvas {
+public:
+    SoftCanvas(int width, int height);
+    [[nodiscard]] int width() const override { return width_; }
+    [[nodiscard]] int height() const override { return height_; }
+    void fill(int x, int y, int w, int h, std::uint32_t color) override;
+    void text(int x, int y, int scale, std::uint32_t color, std::string_view text) override;
+    void clear(std::uint32_t color);
+    [[nodiscard]] const std::vector<std::uint8_t> &pixels() const noexcept { return pixels_; }
+    std::vector<std::uint8_t> &pixels() noexcept { return pixels_; }
+
+private:
+    int width_;
+    int height_;
+    std::vector<std::uint8_t> pixels_;
+};
+
+} // namespace portablekit::overlay
diff --git a/host/overlay/overlay_host.cpp b/host/overlay/overlay_host.cpp
new file mode 100644
index 0000000..aae0f21
--- /dev/null
+++ b/host/overlay/overlay_host.cpp
@@ -0,0 +1,143 @@
+#include "overlay/overlay_host.hpp"
+
+#include "profile.hpp"
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <optional>
+#include <thread>
+
+namespace portablekit::overlay_host {
+namespace {
+
+std::string g_data_root;
+std::optional<port::FileOps> g_file_ops;
+bool g_settings_ready = false;
+bool g_attached = false;
+std::atomic<bool> g_open_pending{false};
+
+// A display refresh, in microseconds: how often the open menu ticks.
+constexpr std::chrono::microseconds kTick{16'683};
+
+} // namespace
+
+void set_platform(std::string data_root, const port::FileOps *file_ops) {
+    g_data_root = std::move(data_root);
+    if (file_ops != nullptr) g_file_ops = *file_ops;
+}
+
+void init_settings() {
+    if (g_settings_ready) return;
+    g_settings_ready = true;
+    port::Settings &settings = port::settings();
+    if (g_file_ops) settings.set_file_ops(*g_file_ops);
+    port::InitOptions options;
+    options.data_root = g_data_root;
+    if (options.data_root.empty()) {
+        if (const char *dir = portablekit::env("DATA_DIR"); dir != nullptr && *dir != '\0') options.data_root = dir;
+    }
+    options.env = [](const char *name) { return portablekit::env(name); };
+    settings.init(options);
+}
+
+overlay::Menu &menu() {
+    static overlay::Menu instance(port::settings());
+    return instance;
+}
+
+void attach(gpu::Renderer &renderer) {
+    if (!renderer.has_overlay()) return;
+    g_attached = true;
+    renderer.set_overlay([] { return menu().is_open(); }, [](overlay::Canvas &canvas) { menu().draw(canvas); });
+}
+
+std::uint32_t pad_for_game(std::uint32_t buttons, std::uint64_t now_us) {
+    // <prefix>_TRACE_MENU: what the chord watcher sees, for a run whose menu does not open when it should.
+    static const bool trace = portablekit::env("TRACE_MENU") != nullptr;
+    if (!g_attached) {
+        if (trace) {
+            static bool said = false;
+            if (!said) std::fprintf(stderr, "[menu] the renderer has no overlay; the chord is not watched\n");
+            said = true;
+        }
+        return buttons;
+    }
+    constexpr std::uint32_t kChord = overlay::button::kSelect | overlay::button::kStart;
+    static std::uint32_t last = 0u;
+    if (trace && ((buttons ^ last) & kChord) != 0u) {
+        std::fprintf(stderr, "[menu] SELECT/START now %s at %llu us\n", (buttons & kChord) == kChord ? "both down" : "not both down",
+                     static_cast<unsigned long long>(now_us));
+    }
+    last = buttons;
+    if (menu().poll_chord(buttons, now_us)) {
+        if (trace) std::fprintf(stderr, "[menu] chord held long enough at %llu us; the menu opens at the next flip\n",
+                                static_cast<unsigned long long>(now_us));
+        g_open_pending.store(true, std::memory_order_release);
+    }
+    return menu().filter_for_game(buttons);
+}
+
+bool open_requested() {
+    if (!g_attached) return false;
+    if (menu().take_open_request()) g_open_pending.store(true, std::memory_order_release);
+    return g_open_pending.load(std::memory_order_acquire);
+}
+
+bool run_modal(gpu::Renderer &renderer, const ModalHost &host) {
+    g_open_pending.store(false, std::memory_order_release);
+    overlay::Menu &m = menu();
+    const auto device = [&host]() -> std::uint32_t { return host.device_buttons ? host.device_buttons() : 0u; };
+
+    static overlay::Script script;
+    static bool script_read = false;
+    if (!script_read) {
+        script_read = true;
+        if (const char *text = portablekit::env("OVERLAY_SCRIPT"); text != nullptr && *text != '\0') script.parse(text);
+    }
+    const bool scripted = !script.empty();
+    const char *shot_dir = portablekit::env("OVERLAY_SHOT_DIR");
+    if (shot_dir == nullptr || *shot_dir == '\0') shot_dir = portablekit::env("SCREENSHOT_DIR");
+
+    // A run nobody can close the menu in is closed for it: a scripted run that forgot to, or no input at all.
+    const std::uint64_t frame_limit = scripted ? 3600u : (host.has_device_input ? 0u : kHeadlessFrames);
+
+    std::fprintf(stderr, "[menu] open%s\n", scripted ? " (scripted)" : "");
+    m.open(device());
+    bool window_open = true;
+    std::uint64_t frame = 0;
+    auto next = std::chrono::steady_clock::now();
+    while (m.is_open()) {
+        const std::uint32_t buttons = scripted ? script.buttons_at(frame) : device();
+        m.update(buttons);
+        renderer.present_overlay();
+        if (scripted && shot_dir != nullptr && *shot_dir != '\0') {
+            const std::string name = script.shot_at(frame);
+            if (!name.empty()) {
+                const std::string path = std::string(shot_dir) + "/" + name + ".png";
+                if (renderer.capture_frame(path)) std::fprintf(stderr, "[menu] shot %s\n", path.c_str());
+                else std::fprintf(stderr, "[menu] cannot write %s\n", path.c_str());
+            }
+        }
+        if (!renderer.pump_events()) {
+            window_open = false;
+            m.close(0u);
+            break;
+        }
+        ++frame;
+        if (frame_limit != 0u && frame >= frame_limit && m.is_open()) {
+            std::fprintf(stderr, "[menu] nothing closed the menu in %llu frames; closing it\n",
+                         static_cast<unsigned long long>(frame));
+            m.close(0u);
+            break;
+        }
+        next += kTick;
+        const auto now = std::chrono::steady_clock::now();
+        if (next < now) next = now;   // a slow tick does not make the next ones run fast
+        else std::this_thread::sleep_until(next);
+    }
+    std::fprintf(stderr, "[menu] closed after %llu frames\n", static_cast<unsigned long long>(frame));
+    return window_open;
+}
+
+} // namespace portablekit::overlay_host
