--- /dev/null
+++ b/tests/mip_chain_tests.cpp
@@ -0,0 +1,124 @@
+// The mip chains of the world textures (host/gpu/mip_chain.hpp): sizes, the plain mean for an opaque texture, the
+// alpha-weighted colour, and the coverage kept for an alpha-tested cut-out. No GL, no game.
+
+#include "gpu/mip_chain.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <vector>
+
+namespace {
+
+using namespace portablekit::gpu;
+
+int g_failures = 0;
+
+void check(bool condition, const char *what) {
+    std::printf("%s %s\n", condition ? "ok  " : "FAIL", what);
+    if (!condition) ++g_failures;
+}
+
+std::uint32_t texel(std::uint32_t r, std::uint32_t g, std::uint32_t b, std::uint32_t a) {
+    return r | (g << 8u) | (b << 16u) | (a << 24u);
+}
+
+} // namespace
+
+int main() {
+    // Sizes: level counts, the halving of a non-square texture, the total length of the chain.
+    check(mip_level_count(256, 256) == 9u, "256x256 has 9 levels");
+    check(mip_level_count(64, 8) == 7u, "64x8 has 7 levels (down to 1x1)");
+    check(mip_level_count(1, 1) == 1u, "1x1 has one level");
+    {
+        std::vector<std::uint32_t> base(64u * 8u, texel(10, 20, 30, 255)), out;
+        const std::uint32_t built = build_mip_chain(base.data(), 64, 8, {}, out);
+        std::size_t expect = 0;
+        for (std::uint32_t level = 1; level < 7u; ++level) expect += static_cast<std::size_t>(mip_dimension(64, level)) * mip_dimension(8, level);
+        check(built == 6u && out.size() == expect, "64x8 builds 6 levels with the right total size");
+        bool same = true;
+        for (const std::uint32_t value : out) same = same && value == texel(10, 20, 30, 255);
+        check(same, "a flat opaque texture stays flat in every level");
+    }
+
+    // An opaque 2x2: the mean of four colours, rounded to nearest.
+    {
+        const std::uint32_t base[4] = {texel(0, 0, 0, 255), texel(255, 0, 0, 255), texel(0, 255, 0, 255), texel(0, 0, 255, 255)};
+        std::vector<std::uint32_t> out;
+        build_mip_chain(base, 2, 2, {}, out);
+        check(out.size() == 1u && out[0] == texel(64, 64, 64, 255), "opaque 2x2 averages to (64,64,64)");
+    }
+
+    // The colour under a transparent texel does not leak: a red opaque texel next to three transparent black ones
+    // comes out red, with a quarter of the alpha.
+    {
+        const std::uint32_t base[4] = {texel(255, 0, 0, 255), texel(0, 0, 0, 0), texel(0, 0, 0, 0), texel(0, 0, 0, 0)};
+        std::vector<std::uint32_t> plain, weighted;
+        build_mip_chain(base, 2, 2, {false, 0u}, plain);
+        MipOptions options;
+        options.alpha_weighted = true;
+        build_mip_chain(base, 2, 2, options, weighted);
+        check(plain[0] == texel(64, 0, 0, 64), "plain mean darkens the red with the transparent black (64,0,0)");
+        check(weighted[0] == texel(255, 0, 0, 64), "alpha-weighted mean keeps the red (255,0,0) at alpha 64");
+    }
+
+    // Texture traits: a cut-out has only 0 and 255, a soft sprite has the middle values too.
+    {
+        const std::uint32_t cut[4] = {texel(1, 1, 1, 0), texel(1, 1, 1, 255), texel(1, 1, 1, 255), texel(1, 1, 1, 0)};
+        const std::uint32_t soft[4] = {texel(1, 1, 1, 0), texel(1, 1, 1, 128), texel(1, 1, 1, 255), texel(1, 1, 1, 7)};
+        const std::uint32_t solid[4] = {texel(1, 1, 1, 255), texel(1, 1, 1, 255), texel(1, 1, 1, 255), texel(1, 1, 1, 255)};
+        const TextureTraits a = scan_texels(cut, 4), b = scan_texels(soft, 4), c = scan_texels(solid, 4);
+        check(a.cut_out() && a.has_alpha() && a.transparent == 2u && a.opaque == 2u, "scan: a 0/255 texture is a cut-out");
+        check(!b.cut_out() && b.has_alpha() && b.translucent == 2u, "scan: a texture with middle alpha is not a cut-out");
+        check(!c.has_alpha() && c.opaque == 4u, "scan: a solid texture has no alpha");
+    }
+
+    // Coverage: a disc cut out of a 64x64 texture (opaque inside, a hole outside, the edge one texel wide), the shape
+    // of a leaf or a sign. Without the fix the share of texels above the reference shrinks with every level; with it,
+    // it stays at the level 0 share (within what the integer alpha allows).
+    {
+        const std::uint32_t size = 64;
+        std::vector<std::uint32_t> base(size * size);
+        for (std::uint32_t y = 0; y < size; ++y)
+            for (std::uint32_t x = 0; x < size; ++x) {
+                const double dx = static_cast<double>(x) - 31.5, dy = static_cast<double>(y) - 31.5;
+                base[y * size + x] = dx * dx + dy * dy < 22.0 * 22.0 ? texel(40, 120, 40, 255) : texel(0, 0, 0, 0);
+            }
+        const double level0 = alpha_coverage(base.data(), base.size(), 127u);
+        check(level0 > 0.35 && level0 < 0.42, "level 0 coverage of the disc is about 0.37");
+
+        std::vector<std::uint32_t> plain, fixed;
+        MipOptions options;
+        options.alpha_weighted = true;
+        build_mip_chain(base.data(), size, size, options, plain);
+        options.coverage_reference = 127u;
+        build_mip_chain(base.data(), size, size, options, fixed);
+
+        std::size_t offset = 0;
+        double worst_without = 0.0, worst_with = 0.0;
+        bool without_thins = false;
+        for (std::uint32_t level = 1; level <= 5u; ++level) {
+            const std::uint32_t dimension = size >> level;
+            const std::size_t count = static_cast<std::size_t>(dimension) * dimension;
+            const double without = alpha_coverage(plain.data() + offset, count, 127u);
+            const double with = alpha_coverage(fixed.data() + offset, count, 127u);
+            if (without < level0 - 0.1) without_thins = true;
+            std::printf("     level %u (%ux%u): coverage without %.3f, with %.3f (level 0: %.3f)\n", level, dimension,
+                        dimension, without, with, level0);
+            // Down to 8x8 the share can be matched closely; below that a level has so few texels that a step in the scale
+            // moves the share by a quarter, so there the rule is only that the cut-out is never thinner than level 0.
+            if (level <= 3u) {
+                worst_without = std::max(worst_without, std::abs(without - level0));
+                worst_with = std::max(worst_with, std::abs(with - level0));
+            } else if (with < level0 - 0.04) {
+                worst_with = 1.0;
+            }
+            offset += count;
+        }
+        check(without_thins, "without the fix the cut-out thins out in the smallest levels");
+        check(worst_with < 0.04, "with the fix the coverage stays within 0.04 of level 0 (8x8 and up) and never thins below it");
+    }
+
+    std::printf("%s\n", g_failures == 0 ? "all passed" : "FAILURES");
+    return g_failures == 0 ? 0 : 1;
+}
