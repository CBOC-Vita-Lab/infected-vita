diff --git a/host/gpu/gl/gl_overlay.cpp b/host/gpu/gl/gl_overlay.cpp
new file mode 100644
index 0000000..6b308b8
--- /dev/null
+++ b/host/gpu/gl/gl_overlay.cpp
@@ -0,0 +1,206 @@
+#include "gpu/gl/gl_overlay.hpp"
+
+#include "gpu/gl/gl_platform.h"
+#include "gpu/gl/gl_shaders.hpp"
+#include "overlay/bitmap_font.hpp"
+
+#include <algorithm>
+#include <cstddef>
+#include <iostream>
+#include <vector>
+
+namespace portablekit::gpu {
+namespace {
+
+// The atlas: a grid of cells, each holding one glyph (5x9) with a blank texel round it, and one more cell whose
+// centre texel is opaque white for the fills. Sampled with NEAREST, so a glyph's pixels stay square at any scale.
+constexpr int kCellWidth = 8;
+constexpr int kCellHeight = 12;
+constexpr int kColumns = 16;
+constexpr int kRows = 7;                                   // 16 x 7 = 112 cells, 97 glyphs and the white one
+constexpr int kAtlasWidth = kColumns * kCellWidth;         // 128
+constexpr int kAtlasHeight = kRows * kCellHeight;          // 84
+constexpr int kWhiteCell = overlay::kGlyphCount;           // the cell after the last glyph
+static_assert(overlay::kGlyphCount + 1 <= kColumns * kRows);
+// The most vertices one glDrawArrays may carry (vitaGL's limit is 0xC000).
+constexpr std::size_t kMaxVertices = 0xC000u - 6u;
+
+GLuint compile(GLenum type, const std::string &source, const char *label) {
+    const GLuint shader = glCreateShader(type);
+    const char *text = source.c_str();
+    glShaderSource(shader, 1, &text, nullptr);
+    glCompileShader(shader);
+    GLint ok = 0;
+    glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+    if (ok == 0) {
+        char log[1024]{};
+        glGetShaderInfoLog(shader, sizeof(log) - 1u, nullptr, log);
+        std::cerr << "[gl] " << label << " does not compile:\n" << log << "\n";
+        glDeleteShader(shader);
+        return 0u;
+    }
+    return shader;
+}
+
+} // namespace
+
+GlCanvas::GlCanvas() = default;
+GlCanvas::~GlCanvas() = default;   // the context may be gone by now; destroy() is the explicit release
+
+bool GlCanvas::create(std::string &error) {
+    if (program_ != 0u) return true;
+    const GLuint vs = compile(GL_VERTEX_SHADER, glsl::ui_vertex_source(), "overlay vertex");
+    const GLuint fs = vs != 0u ? compile(GL_FRAGMENT_SHADER, glsl::ui_fragment_source(), "overlay fragment") : 0u;
+    if (vs == 0u || fs == 0u) {
+        if (vs != 0u) glDeleteShader(vs);
+        error = "the overlay shaders do not build";
+        return false;
+    }
+    const GLuint program = glCreateProgram();
+    glAttachShader(program, vs);
+    glAttachShader(program, fs);
+    glBindAttribLocation(program, 0u, "a_position");
+    glBindAttribLocation(program, 2u, "a_texcoord");
+    glBindAttribLocation(program, 3u, "a_color");
+    glLinkProgram(program);
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+    GLint ok = 0;
+    glGetProgramiv(program, GL_LINK_STATUS, &ok);
+    if (ok == 0) {
+        glDeleteProgram(program);
+        error = "the overlay program does not link";
+        return false;
+    }
+    program_ = program;
+    screen_location_ = glGetUniformLocation(program_, "u_screen");
+    flip_location_ = glGetUniformLocation(program_, "u_flip");
+    texture_location_ = glGetUniformLocation(program_, "u_texture");
+
+    std::vector<std::uint8_t> atlas(static_cast<std::size_t>(kAtlasWidth) * kAtlasHeight * 4u, 0u);
+    const auto set = [&](int x, int y) {
+        std::uint8_t *at = atlas.data() + (static_cast<std::size_t>(y) * kAtlasWidth + static_cast<std::size_t>(x)) * 4u;
+        at[0] = at[1] = at[2] = at[3] = 0xFFu;
+    };
+    for (int glyph = 0; glyph < overlay::kGlyphCount; ++glyph) {
+        const std::uint8_t *rows = overlay::glyph_rows(glyph);
+        const int cell_x = (glyph % kColumns) * kCellWidth, cell_y = (glyph / kColumns) * kCellHeight;
+        for (int row = 0; row < overlay::kGlyphHeight; ++row)
+            for (int column = 0; column < overlay::kGlyphWidth; ++column)
+                if (((rows[row] >> (overlay::kGlyphWidth - 1 - column)) & 1u) != 0u) set(cell_x + 1 + column, cell_y + 1 + row);
+    }
+    {
+        const int cell_x = (kWhiteCell % kColumns) * kCellWidth, cell_y = (kWhiteCell / kColumns) * kCellHeight;
+        for (int y = 0; y < 3; ++y)
+            for (int x = 0; x < 3; ++x) set(cell_x + 2 + x, cell_y + 2 + y);
+    }
+    glGenTextures(1, &atlas_);
+    glBindTexture(GL_TEXTURE_2D, atlas_);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, kAtlasWidth, kAtlasHeight, 0, GL_RGBA, GL_UNSIGNED_BYTE, atlas.data());
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    vertices_.reserve(4096);
+    return true;
+}
+
+void GlCanvas::destroy() {
+    if (program_ != 0u) glDeleteProgram(program_);
+    if (atlas_ != 0u) glDeleteTextures(1, &atlas_);
+    program_ = 0u;
+    atlas_ = 0u;
+}
+
+void GlCanvas::begin(int width, int height, bool top_is_clip_top) {
+    width_ = width;
+    height_ = height;
+    top_is_clip_top_ = top_is_clip_top;
+    quads_ = 0u;
+    draws_ = 0u;
+    vertices_.clear();
+    if (program_ == 0u) return;
+    glUseProgram(program_);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, atlas_);
+    glUniform1i(texture_location_, 0);
+    const float screen[2] = {static_cast<float>(width), static_cast<float>(height)};
+    const float flip[2] = {1.0f, top_is_clip_top ? 1.0f : -1.0f};
+    glUniform2fv(screen_location_, 1, screen);
+    glUniform2fv(flip_location_, 1, flip);
+    glViewport(0, 0, width, height);
+    glDisable(GL_SCISSOR_TEST);
+    glDisable(GL_DEPTH_TEST);
+    glDisable(GL_CULL_FACE);
+    glDepthMask(GL_FALSE);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glEnable(GL_BLEND);
+    glBlendEquationSeparate(GL_FUNC_ADD, GL_FUNC_ADD);
+    glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
+    // Position, texel and colour; the renderer keeps array 1 (the normal) enabled for its own draws.
+    glDisableVertexAttribArray(1u);
+}
+
+void GlCanvas::flush_quads() {
+    if (vertices_.empty() || program_ == 0u) {
+        vertices_.clear();
+        return;
+    }
+    const auto *base = reinterpret_cast<const std::uint8_t *>(vertices_.data());
+    glVertexAttribPointer(0u, 2, GL_FLOAT, GL_FALSE, sizeof(Vertex), base + offsetof(Vertex, x));
+    glVertexAttribPointer(2u, 2, GL_FLOAT, GL_FALSE, sizeof(Vertex), base + offsetof(Vertex, u));
+    glVertexAttribPointer(3u, 4, GL_UNSIGNED_BYTE, GL_TRUE, sizeof(Vertex), base + offsetof(Vertex, color));
+    glDrawArrays(GL_TRIANGLES, 0, static_cast<GLsizei>(vertices_.size()));
+    ++draws_;
+    vertices_.clear();
+}
+
+void GlCanvas::end() {
+    flush_quads();
+    if (program_ == 0u) return;
+    glDisable(GL_BLEND);
+    glDepthMask(GL_TRUE);
+    glEnable(GL_SCISSOR_TEST);
+    glEnableVertexAttribArray(1u);
+}
+
+void GlCanvas::quad(float x0, float y0, float x1, float y1, float u0, float v0, float u1, float v1, std::uint32_t color) {
+    if (vertices_.size() + 6u > kMaxVertices) flush_quads();
+    const Vertex a{x0, y0, u0, v0, color}, b{x1, y0, u1, v0, color}, c{x0, y1, u0, v1, color}, d{x1, y1, u1, v1, color};
+    vertices_.push_back(a);
+    vertices_.push_back(b);
+    vertices_.push_back(c);
+    vertices_.push_back(b);
+    vertices_.push_back(d);
+    vertices_.push_back(c);
+    ++quads_;
+}
+
+void GlCanvas::fill(int x, int y, int w, int h, std::uint32_t color) {
+    if (w <= 0 || h <= 0 || (color >> 24u) == 0u) return;
+    const int cell_x = (kWhiteCell % kColumns) * kCellWidth + 3, cell_y = (kWhiteCell / kColumns) * kCellHeight + 3;
+    const float u = (static_cast<float>(cell_x) + 0.5f) / static_cast<float>(kAtlasWidth);
+    const float v = (static_cast<float>(cell_y) + 0.5f) / static_cast<float>(kAtlasHeight);
+    quad(static_cast<float>(x), static_cast<float>(y), static_cast<float>(x + w), static_cast<float>(y + h), u, v, u, v, color);
+}
+
+void GlCanvas::text(int x, int y, int scale, std::uint32_t color, std::string_view text) {
+    if ((color >> 24u) == 0u) return;
+    int pen = x;
+    for (const char c : text) {
+        const int glyph = overlay::glyph_index(c);
+        if (glyph != 0) {   // a space draws nothing
+            const int cell_x = (glyph % kColumns) * kCellWidth + 1, cell_y = (glyph / kColumns) * kCellHeight + 1;
+            const float u0 = static_cast<float>(cell_x) / static_cast<float>(kAtlasWidth);
+            const float v0 = static_cast<float>(cell_y) / static_cast<float>(kAtlasHeight);
+            const float u1 = static_cast<float>(cell_x + overlay::kGlyphWidth) / static_cast<float>(kAtlasWidth);
+            const float v1 = static_cast<float>(cell_y + overlay::kGlyphHeight) / static_cast<float>(kAtlasHeight);
+            quad(static_cast<float>(pen), static_cast<float>(y), static_cast<float>(pen + overlay::kGlyphWidth * scale),
+                 static_cast<float>(y + overlay::kGlyphHeight * scale), u0, v0, u1, v1, color);
+        }
+        pen += overlay::kGlyphAdvance * scale;
+    }
+}
+
+} // namespace portablekit::gpu
diff --git a/host/gpu/gl/gl_overlay.hpp b/host/gpu/gl/gl_overlay.hpp
new file mode 100644
index 0000000..bdf27bb
--- /dev/null
+++ b/host/gpu/gl/gl_overlay.hpp
@@ -0,0 +1,66 @@
+#pragma once
+
+#include "overlay/canvas.hpp"
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace portablekit::gpu {
+
+// The overlay's canvas over OpenGL ES 2.0: rectangles and text become textured, coloured quads (the font's glyphs
+// sit in one small atlas, with one opaque texel for the plain fills), collected while the menu draws and sent as
+// one draw call (two, if a picture has more than 8000 quads). It owns its own program and texture and sets the GL
+// state it needs, so the renderer only has to forget what it believed was bound afterwards.
+//
+// Plain GLES 2 and GLSL ES 1.00, like the rest of host/gpu/gl: the same source runs on the desktop and on the Vita.
+class GlCanvas final : public overlay::Canvas {
+public:
+    GlCanvas();
+    ~GlCanvas() override;
+    GlCanvas(const GlCanvas &) = delete;
+    GlCanvas &operator=(const GlCanvas &) = delete;
+
+    // Builds the program and the atlas. Needs a current context. False (with a reason) if the program does not build.
+    bool create(std::string &error);
+    void destroy();
+    [[nodiscard]] bool ready() const noexcept { return program_ != 0u; }
+
+    // Starts a picture of width x height pixels on the framebuffer that is bound. `top_is_clip_top`: the first row of
+    // the picture is at the top of clip space (a window whose rows run bottom to top, as vitaGL's display does);
+    // otherwise it is at the bottom (the renderer's own targets, whose row 0 is the picture's top).
+    void begin(int width, int height, bool top_is_clip_top);
+    // Draws what was collected.
+    void end();
+
+    [[nodiscard]] int width() const override { return width_; }
+    [[nodiscard]] int height() const override { return height_; }
+    void fill(int x, int y, int w, int h, std::uint32_t color) override;
+    void text(int x, int y, int scale, std::uint32_t color, std::string_view text) override;
+
+    // Quads sent since begin() and GL draws issued, for the cost report.
+    [[nodiscard]] std::uint32_t quads() const noexcept { return quads_; }
+    [[nodiscard]] std::uint32_t draws() const noexcept { return draws_; }
+
+private:
+    struct Vertex {
+        float x, y, u, v;
+        std::uint32_t color;
+    };
+    void quad(float x0, float y0, float x1, float y1, float u0, float v0, float u1, float v1, std::uint32_t color);
+    void flush_quads();
+
+    unsigned program_{};
+    unsigned atlas_{};
+    int screen_location_{-1};
+    int flip_location_{-1};
+    int texture_location_{-1};
+    int width_{};
+    int height_{};
+    bool top_is_clip_top_{};
+    std::uint32_t quads_{};
+    std::uint32_t draws_{};
+    std::vector<Vertex> vertices_;
+};
+
+} // namespace portablekit::gpu
diff --git a/host/gpu/gl/gl_post.inc b/host/gpu/gl/gl_post.inc
new file mode 100644
index 0000000..fe7aac4
--- /dev/null
+++ b/host/gpu/gl/gl_post.inc
@@ -0,0 +1,482 @@
+// Members of GlRenderer::Impl for the port's graphics options (host/settings/port_settings.hpp), the post passes they
+// need and the picture the overlay and the counters are drawn on. This file is part of gl_renderer.cpp: it is included
+// inside the body of `struct GlRenderer::Impl` and is not a header. docs/GRAPHICS_OPTIONS.md explains each option.
+//
+//   gfx.texture_filter  note_3d_use / the filter choice in submit(): 3D draws only, never a render target.
+//   gfx.mipmaps         build_mips(): a chain per world texture, alpha-weighted where the texture has alpha.
+//   gfx.antialiasing    run_fxaa(): between the 3D picture and the HUD; msaa on the desktop is a supersampled preview.
+//   gfx.pixel_lighting  the kPixelLight program flag, set in submit().
+//   gfx.effects_scale   offscreen_scale, the scale of the targets the game renders glow and blur into.
+//   gfx.movie_filter    the kSharpen program variant (picture_draw() in submit()); resolve_picture() for a picture the CPU shows directly.
+//   perf.frame_cap, perf.show_fps   hold_frame_cap(), note_present() and the counter drawn by show().
+
+    // ---- the options as the frame in flight sees them --------------------------------------------------------------
+    struct Options {
+        bool smooth{};
+        bool mips{};
+        bool fxaa{};
+        bool pixel_light{};
+        bool movie_sharp{};
+        bool show_fps{};
+        std::uint64_t frame_cap_us{};
+    } opt;
+    std::uint32_t options_generation{};
+    std::uint32_t offscreen_scale{1u};   // gfx.effects_scale or the replayer's --offscreen-scale, whichever is larger
+    std::uint32_t ssaa_scale{};          // the desktop preview of MSAA: the scale the display is drawn at, 0 for none
+    std::uint32_t aux_programs{1u};      // the blit, then every post and overlay program built
+
+    [[nodiscard]] std::uint32_t display_scale() const { return ssaa_scale != 0u ? ssaa_scale : settings.display_scale; }
+
+    // Called when the renderer starts and at the end of every frame: the options change between frames, never inside one.
+    void refresh_options(bool force) {
+        if (!settings.use_port_options) {
+            opt = Options{};
+            offscreen_scale = settings.offscreen_scale;
+            return;
+        }
+        const std::uint32_t generation = port::settings().generation();
+        if (!force && generation == options_generation) return;
+        options_generation = generation;
+        Options next;
+        next.smooth = port::texture_filter_smooth();
+        next.mips = port::mipmaps();
+        next.fxaa = port::fxaa();
+        next.pixel_light = port::pixel_lighting();
+        next.movie_sharp = port::movie_filter() == port::MovieFilter::Sharp;
+        next.show_fps = port::show_fps();
+        next.frame_cap_us = settings.apply_frame_cap ? port::frame_cap_period_us() : 0u;
+        opt = next;
+        offscreen_scale = std::max(settings.offscreen_scale, port::effects_scale());
+    }
+
+    // ---- post programs and full-screen passes ----------------------------------------------------------------------
+    Program fxaa_program, bicubic_program, resolve_program;
+    bool fxaa_failed{}, bicubic_failed{}, resolve_failed{};
+
+    // `fragment` is a callable returning the program's fragment source; it runs only when the program is built.
+    template <typename Source>
+    bool ensure_post_program(Program &program, bool &failed, Source fragment, const char *label) {
+        if (program.id != 0u) return true;
+        if (failed) return false;
+        failed = !link(program, glsl::blit_vertex_source(), fragment(), label, true);
+        variant_names.push_back(std::string("post:") + label + (failed ? " (failed)" : ""));
+        if (failed) return false;
+        ++aux_programs;
+        use_program(program);
+        if (program.location[glsl::kUTexture] != -1) glUniform1i(program.location[glsl::kUTexture], 0);
+        return true;
+    }
+
+    // Draws `source` over the whole of the bound framebuffer, `width` x `height` pixels, through `program`. No depth,
+    // no blend, no scissor; the caller binds the destination. `inv_size`: one over the source size and the size.
+    void fullscreen_pass(Program &program, GLuint source, GLenum filter, std::int32_t width, std::int32_t height,
+                         const float *inv_size, bool flip_y) {
+        glDisableVertexAttribArray(1u);
+        glDisableVertexAttribArray(3u);
+        use_program(program);
+        bind_texture(source);
+        set_sampler(source, filter, filter, GL_CLAMP_TO_EDGE, GL_CLAMP_TO_EDGE);
+        glDisable(GL_DEPTH_TEST);
+        glDisable(GL_BLEND);
+        glDisable(GL_CULL_FACE);
+        glDisable(GL_SCISSOR_TEST);
+        cache.depth_test = 0;
+        cache.blend = 0;
+        cache.cull = 0;
+        glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+        cache.color_mask = 15;
+        glViewport(0, 0, width, height);
+        cache.viewport[0] = -1;
+        static const float quad[] = {-1.0f, -1.0f, 0.0f, 0.0f, 1.0f, -1.0f, 1.0f, 0.0f,
+                                     -1.0f, 1.0f,  0.0f, 1.0f, 1.0f, 1.0f,  1.0f, 1.0f};
+        static const float quad_flipped[] = {-1.0f, -1.0f, 0.0f, 1.0f, 1.0f, -1.0f, 1.0f, 1.0f,
+                                             -1.0f, 1.0f,  0.0f, 0.0f, 1.0f, 1.0f,  1.0f, 0.0f};
+        const float *vertices = flip_y ? quad_flipped : quad;
+        glVertexAttribPointer(0u, 2, GL_FLOAT, GL_FALSE, 16, vertices);
+        glVertexAttribPointer(2u, 2, GL_FLOAT, GL_FALSE, 16, vertices + 2);
+        if (program.location[glsl::kUTexture] != -1) glUniform1i(program.location[glsl::kUTexture], 0);
+        if (inv_size != nullptr) uniform(program, glsl::kUInvSize, inv_size);
+        if (!settings.null_draw) glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+        glEnableVertexAttribArray(1u);
+        glEnableVertexAttribArray(3u);
+        glEnable(GL_SCISSOR_TEST);
+        ++st().gl_draws;
+        ++st().post_passes;
+        check("post pass");
+    }
+
+    // ---- FXAA ------------------------------------------------------------------------------------------------------
+    // The 3D picture of a frame is finished when the HUD starts. A draw that samples a render target (the glow and blur
+    // composites) is still the picture; the first through-mode draw after that which does not is the HUD, and so is
+    // a 3D draw that comes after a composite (the minimap). A frame with fewer 3D draws than this is a menu with a model
+    // in it, which is not anti-aliased.
+    static constexpr std::uint32_t kFxaaMinDraws = 32u;
+    std::uint32_t scene_draws{};
+    bool composite_seen{};
+    bool fxaa_done{};
+
+    // Called for each draw on a display-sized target before it is batched.
+    void fxaa_scene_step(Target &target, bool through, bool samples_target) {
+        if (fxaa_done) return;
+        bool trigger = false;
+        if (through) {
+            if (scene_draws >= kFxaaMinDraws) {
+                if (samples_target) composite_seen = true;
+                else trigger = true;
+            }
+        } else if (composite_seen && scene_draws >= kFxaaMinDraws) {
+            trigger = true;
+        } else {
+            ++scene_draws;
+        }
+        if (trigger) run_fxaa(target);
+    }
+
+    // FXAA over the target's picture. The result is drawn into a second texture which then becomes the target's colour
+    // attachment, so nothing is copied; the old texture is the scratch one of the next pass.
+    void run_fxaa(Target &target) {
+        fxaa_done = true;
+        if (!ensure_post_program(fxaa_program, fxaa_failed, [] { return glsl::fxaa_fragment_source(); }, "fxaa")) return;
+        flush();
+        if (target.post == 0u) {
+            glGenTextures(1, &target.post);
+            bind_texture(target.post);
+            glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, static_cast<GLsizei>(target.width), static_cast<GLsizei>(target.height),
+                         0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+            samplers.erase(target.post);
+            set_sampler(target.post, GL_NEAREST, GL_NEAREST, GL_CLAMP_TO_EDGE, GL_CLAMP_TO_EDGE);
+        }
+        bind_target(target);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, target.post, 0);
+        const float inv[4] = {1.0f / static_cast<float>(target.width), 1.0f / static_cast<float>(target.height),
+                              static_cast<float>(target.width), static_cast<float>(target.height)};
+        fullscreen_pass(fxaa_program, target.color, GL_LINEAR, static_cast<std::int32_t>(target.width),
+                        static_cast<std::int32_t>(target.height), inv, false);
+        std::swap(target.color, target.post);
+        ++target.draw_serial;   // the picture changed under whoever copied it
+    }
+
+    // ---- the picture on show, the overlay and the counter --------------------------------------------------------
+    struct Composed {
+        GLuint fbo{};
+        GLuint color{};
+        std::uint32_t width{};
+        std::uint32_t height{};
+        bool valid{};   // this frame's picture is in here (read_presented reads it instead of the game's target)
+    } composed;
+    GlCanvas canvas;
+    OverlayActive overlay_active;
+    OverlayPaint overlay_paint;
+
+    bool ensure_composed(std::uint32_t width, std::uint32_t height) {
+        if (composed.fbo != 0u && composed.width == width && composed.height == height) return true;
+        if (composed.fbo == 0u) {
+            glGenFramebuffers(1, &composed.fbo);
+            glGenTextures(1, &composed.color);
+        }
+        bind_texture(composed.color);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, static_cast<GLsizei>(width), static_cast<GLsizei>(height), 0, GL_RGBA,
+                     GL_UNSIGNED_BYTE, nullptr);
+        samplers.erase(composed.color);
+        set_sampler(composed.color, GL_NEAREST, GL_NEAREST, GL_CLAMP_TO_EDGE, GL_CLAMP_TO_EDGE);
+        glBindFramebuffer(GL_FRAMEBUFFER, composed.fbo);
+        cache.fbo = composed.fbo;
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, composed.color, 0);
+        const GLenum status = glCheckFramebufferStatus(GL_FRAMEBUFFER);
+        if (status != GL_FRAMEBUFFER_COMPLETE) {
+            warn_once("composed", "the final picture's framebuffer is incomplete");
+            return false;
+        }
+        composed.width = width;
+        composed.height = height;
+        return true;
+    }
+
+    // The frame counter's numbers: fps and frame time averaged over half a second, the draws of the last frame.
+    struct Timing {
+        Clock::time_point last{};
+        bool have_last{};
+        double window_seconds{};
+        std::uint32_t window_frames{};
+        float fps{};
+        float frame_ms{};
+        std::uint32_t draws{};
+        std::uint32_t gl_draws{};
+        std::uint64_t gl_draws_seen{};
+        Clock::time_point cap_last{};
+        bool cap_valid{};
+    } timing;
+
+    [[nodiscard]] overlay::FrameInfo frame_info() const {
+        overlay::FrameInfo info;
+        info.fps = timing.fps;
+        info.frame_ms = timing.frame_ms;
+        info.draws = timing.draws;
+        info.gl_draws = timing.gl_draws;
+        return info;
+    }
+
+    void note_present(std::uint64_t ge_draws) {
+        const Clock::time_point now = Clock::now();
+        if (timing.have_last) {
+            const double dt = std::chrono::duration<double>(now - timing.last).count();
+            if (dt < 1.0) {   // a longer gap is a pause or a stall, not a frame time
+                timing.window_seconds += dt;
+                ++timing.window_frames;
+                if (timing.window_seconds >= 0.5) {
+                    timing.fps = static_cast<float>(timing.window_frames / timing.window_seconds);
+                    timing.frame_ms = static_cast<float>(timing.window_seconds * 1000.0 / timing.window_frames);
+                    timing.window_seconds = 0.0;
+                    timing.window_frames = 0u;
+                }
+            } else {
+                timing.window_seconds = 0.0;
+                timing.window_frames = 0u;
+            }
+        }
+        timing.last = now;
+        timing.have_last = true;
+        timing.draws = static_cast<std::uint32_t>(ge_draws);
+        const std::uint64_t gl_total = total_stats.gl_draws + frame_stats.gl_draws;
+        timing.gl_draws = static_cast<std::uint32_t>(gl_total - timing.gl_draws_seen);
+        timing.gl_draws_seen = gl_total;
+    }
+
+    // perf.frame_cap: the next frame is not shown before the cap's period has passed since the last one.
+    void hold_frame_cap() {
+        if (opt.frame_cap_us == 0u) {
+            timing.cap_valid = false;
+            return;
+        }
+        Clock::time_point now = Clock::now();
+        if (timing.cap_valid) {
+            const Clock::time_point due = timing.cap_last + std::chrono::microseconds(opt.frame_cap_us);
+            if (now < due) {
+                std::this_thread::sleep_until(due);
+                now = due;
+            }
+        }
+        timing.cap_last = now;
+        timing.cap_valid = true;
+    }
+
+    void forget_timing() {
+        timing.have_last = false;
+        timing.window_seconds = 0.0;
+        timing.window_frames = 0u;
+        timing.cap_valid = false;
+    }
+
+    [[nodiscard]] bool overlay_wanted() const { return overlay_active && overlay_active(); }
+
+    void draw_overlays(std::int32_t width, std::int32_t height, bool top_is_clip_top, bool counter, bool menu) {
+        if (!canvas.ready()) {
+            std::string error;
+            if (!canvas.create(error)) {
+                warn_once("overlay", error);
+                return;
+            }
+            ++aux_programs;
+            variant_names.push_back("overlay:ui");
+        }
+        canvas.begin(width, height, top_is_clip_top);
+        if (menu && overlay_paint) overlay_paint(canvas);
+        // The game is paused while the panel is open, so the counter would only show stale numbers under it.
+        else if (counter) overlay::Menu::draw_counter(canvas, frame_info());
+        canvas.end();
+        cache = Cache{};   // the canvas set its own program, texture, blending and viewport
+        ++st().post_passes;
+    }
+
+    // Puts a finished picture where it is seen: on the window if there is one (the Vita) and, for a picture that has
+    // something added to it (the counter, the overlay, a supersampled preview that needs averaging down), in the
+    // final picture that read_presented returns. Without any of those the game's target goes to the window as it is.
+    void show(Target &target) {
+        resolve_picture(target);
+        composed.valid = false;
+        const bool counter = opt.show_fps;
+        const bool menu = overlay_wanted();
+        const bool resolve = ssaa_scale != 0u && target.scale == ssaa_scale;
+        const bool window = glp::has_window();
+        const auto window_w = static_cast<std::int32_t>(glp::caps().window_width);
+        const auto window_h = static_cast<std::int32_t>(glp::caps().window_height);
+        if (!resolve && !counter && !menu) {
+            if (window) {
+                glBindFramebuffer(GL_FRAMEBUFFER, 0u);
+                cache.fbo = 0u;
+                blit(target.color, 0, 0, window_w, window_h, glp::caps().window_flip_y);
+                glp::swap_buffers();
+                // The platform may have drawn on top (other program and bindings): forget the cached state. Scissor is never cached (always on).
+                glEnable(GL_SCISSOR_TEST);
+                cache = Cache{};
+            }
+            return;
+        }
+        if (!resolve && window) {
+            // The overlay goes straight onto the window, over the blit: no copy of the picture.
+            glBindFramebuffer(GL_FRAMEBUFFER, 0u);
+            cache.fbo = 0u;
+            blit(target.color, 0, 0, window_w, window_h, glp::caps().window_flip_y);
+            draw_overlays(window_w, window_h, glp::caps().window_flip_y, counter, menu);
+            glp::swap_buffers();
+            // The platform may have drawn on top (other program and bindings): forget the cached state. Scissor is never cached (always on).
+            glEnable(GL_SCISSOR_TEST);
+            cache = Cache{};
+            return;
+        }
+        const std::uint32_t out_scale = resolve ? 2u : target.scale;
+        const std::uint32_t out_w = target.psp_width * out_scale, out_h = target.psp_height * out_scale;
+        if (!ensure_composed(out_w, out_h)) return;
+        glBindFramebuffer(GL_FRAMEBUFFER, composed.fbo);
+        cache.fbo = composed.fbo;
+        const float ratio = static_cast<float>(ssaa_scale) / 2.0f;
+        if (resolve && ensure_post_program(resolve_program, resolve_failed, [ratio] { return glsl::resolve_fragment_source(ratio); }, "resolve")) {
+            const float inv[4] = {1.0f / static_cast<float>(target.width), 1.0f / static_cast<float>(target.height),
+                                  static_cast<float>(target.width), static_cast<float>(target.height)};
+            fullscreen_pass(resolve_program, target.color, GL_NEAREST, static_cast<std::int32_t>(out_w),
+                            static_cast<std::int32_t>(out_h), inv, false);
+        } else {
+            blit(target.color, 0, 0, static_cast<std::int32_t>(out_w), static_cast<std::int32_t>(out_h));
+            ++st().post_passes;
+        }
+        if (counter || menu) draw_overlays(static_cast<std::int32_t>(out_w), static_cast<std::int32_t>(out_h), false, counter, menu);
+        composed.valid = true;
+        if (window) {
+            glBindFramebuffer(GL_FRAMEBUFFER, 0u);
+            cache.fbo = 0u;
+            blit(composed.color, 0, 0, window_w, window_h, glp::caps().window_flip_y);
+            glp::swap_buffers();
+            // The platform may have drawn on top (other program and bindings): forget the cached state. Scissor is never cached (always on).
+            glEnable(GL_SCISSOR_TEST);
+            cache = Cache{};
+        }
+    }
+
+    // ---- gfx.movie_filter ------------------------------------------------------------------------------------------
+    // Two paths take a low-resolution picture to the display.
+    //  * A game that draws it with the GE (a textured full-screen quad of a picture the CPU wrote, which is how Infected
+    //    shows a movie) gets the kSharpen program variant: picture_draw() in gl_renderer.cpp decides, the shader enlarges.
+    //  * A game that shows the CPU's picture as the display itself (upload_frame: a flip from main memory, or a picture
+    //    decoded into a VRAM framebuffer) gets the same enlargement as a pass over the target. The plain enlargement is
+    //    made at once; the bicubic pass waits until something looks at the target (a draw into it, a present, a draw
+    //    that samples it, a read-back), because a game that only draws the picture itself never looks at that target
+    //    and the pass would be wasted on every decoded frame.
+    Target *pending_picture{};   // the target whose bicubic enlargement is still to be made; its source is upload_texture
+
+    void movie_blit(const Target &target, std::uint32_t width, std::uint32_t height) {
+        blit(upload_texture, 0, 0, static_cast<std::int32_t>(target.width), static_cast<std::int32_t>(target.height));
+        pending_picture = opt.movie_sharp && target.width * 2u >= width * 3u ? const_cast<Target *>(&target) : nullptr;
+    }
+
+    // Makes the bicubic enlargement of a waiting picture; called wherever a target is about to be looked at.
+    void resolve_picture(Target &target) {
+        if (pending_picture != &target) return;
+        pending_picture = nullptr;
+        if (!opt.movie_sharp ||
+            !ensure_post_program(bicubic_program, bicubic_failed, [] { return glsl::bicubic_fragment_source(); }, "bicubic"))
+            return;
+        flush();
+        bind_target(target);
+        const float inv[4] = {1.0f / static_cast<float>(upload_width), 1.0f / static_cast<float>(upload_height),
+                              static_cast<float>(upload_width), static_cast<float>(upload_height)};
+        fullscreen_pass(bicubic_program, upload_texture, GL_LINEAR, static_cast<std::int32_t>(target.width),
+                        static_cast<std::int32_t>(target.height), inv, false);
+        ++target.draw_serial;
+    }
+
+    // ---- gfx.texture_filter and gfx.mipmaps: what a texture is, and its mip chain ---------------------------------
+    const TextureEntry *decoded_owner{};   // whose texels decode_buffer holds
+
+    // The texels of `entry` in decode_buffer (decoded again if something else was decoded since).
+    bool ensure_decoded(const TextureEntry &entry, const GuestMemory &memory) {
+        const std::size_t texels = static_cast<std::size_t>(entry.width) * entry.height;
+        if (decoded_owner == &entry && decode_buffer.size() == texels) return true;
+        decoded_owner = nullptr;
+        if (!decode_texture(memory, entry.state, decode_buffer) || decode_buffer.size() != texels) return false;
+        decoded_owner = &entry;
+        return true;
+    }
+
+    // Size classes and the alpha scan, once per texture (the texture's guest memory is read again only if it was not
+    // decoded a moment ago). A texture that cannot be scanned counts as one with holes: nothing is done to it.
+    void ensure_traits(TextureEntry &entry, const GuestMemory &memory) {
+        if (entry.traits_known) return;
+        entry.traits_known = true;
+        entry.power_of_two = (entry.width & (entry.width - 1u)) == 0u && (entry.height & (entry.height - 1u)) == 0u;
+        // Too small to filter or mip: a flat colour, a lookup ramp, a palette strip. Smoothing or averaging them changes
+        // what they mean (an entry between two entries is not a colour the artist chose).
+        entry.tiny = entry.width * entry.height <= 256u || std::min(entry.width, entry.height) < 8u;
+        if (ensure_decoded(entry, memory)) {
+            entry.traits = scan_texels(decode_buffer.data(), decode_buffer.size());
+        } else {
+            entry.traits = TextureTraits{};
+            entry.traits.transparent = 1u;
+        }
+    }
+
+    // A draw with clamped wrap that uses only part of the texture is taking a sprite from an atlas: its neighbours
+    // must not be filtered or mipped into it.
+    void check_uv_coverage(TextureEntry &entry, const DrawCall &call) {
+        const TextureState &texture = call.texture;
+        float u_min = 1.0e9f, u_max = -1.0e9f, v_min = 1.0e9f, v_max = -1.0e9f;
+        for (const Vertex &vertex : call.vertices) {
+            const float u = vertex.texcoord[0] * texture.scale_u + texture.offset_u;
+            const float v = vertex.texcoord[1] * texture.scale_v + texture.offset_v;
+            u_min = std::min(u_min, u);
+            u_max = std::max(u_max, u);
+            v_min = std::min(v_min, v);
+            v_max = std::max(v_max, v);
+        }
+        const bool whole_u = texture.wrap_s == 0u || u_max - u_min >= 0.9f;
+        const bool whole_v = texture.wrap_t == 0u || v_max - v_min >= 0.9f;
+        if (!(whole_u && whole_v)) entry.uv_verdict = 2u;
+        else if (entry.uv_verdict == 0u) entry.uv_verdict = 1u;
+    }
+
+    // The mip chain of a texture a 3D draw samples. Level 0 is on the GPU already. glGenerateMipmap creates the levels
+    // (on vitaGL that is the only way to allocate them: glTexImage2D above level 0 ignores its data); a texture with
+    // alpha then has its levels overwritten by the CPU's alpha-weighted chain, with the coverage of the alpha test kept.
+    void build_mips(TextureEntry &entry, const DrawCall &call, const GuestMemory &memory) {
+        entry.mips_tried = true;
+        if (entry.tiny || !entry.power_of_two || entry.uv_verdict == 2u || (entry.volatile_until != 0u && entry.volatile_until >= frames)) return;
+        bind_texture(entry.id);
+        glGenerateMipmap(GL_TEXTURE_2D);
+        const std::uint32_t levels = mip_level_count(entry.width, entry.height);
+        bool cpu = false;
+        if (settings.cpu_mips && entry.traits.has_alpha() && ensure_decoded(entry, memory)) {
+            MipOptions options;
+            options.alpha_weighted = true;
+            if (call.alpha_test.enabled && settings.alpha_test) {
+                const std::uint32_t reference = call.alpha_test.reference & 0xFFu;
+                if (call.alpha_test.function == 6u) options.coverage_reference = reference;                  // alpha > ref
+                else if (call.alpha_test.function == 7u && reference > 0u) options.coverage_reference = reference - 1u;  // >=
+            }
+            std::vector<std::uint32_t> chain;
+            const std::uint32_t built = build_mip_chain(decode_buffer.data(), entry.width, entry.height, options, chain);
+            std::size_t offset = 0;
+            for (std::uint32_t level = 1; level <= built; ++level) {
+                const std::uint32_t width = mip_dimension(entry.width, level), height = mip_dimension(entry.height, level);
+                glTexSubImage2D(GL_TEXTURE_2D, static_cast<GLint>(level), 0, 0, static_cast<GLsizei>(width),
+                                static_cast<GLsizei>(height), GL_RGBA, GL_UNSIGNED_BYTE, chain.data() + offset);
+                offset += static_cast<std::size_t>(width) * height;
+            }
+            st().mip_upload_bytes += chain.size() * 4u;
+            cpu = true;
+        }
+        entry.mip_levels = levels;
+        const std::uint64_t extra = static_cast<std::uint64_t>(entry.width) * entry.height * 4u / 3u;
+        entry.gpu_bytes += extra;
+        texture_bytes += extra;
+        ++st().mip_textures;
+        if (cpu) ++st().mip_cpu_textures;
+        if (settings.trace)
+            std::cerr << "[gl] mips " << entry.width << "x" << entry.height << " levels " << levels
+                      << (cpu ? " (alpha-weighted, cpu)" : " (glGenerateMipmap)") << "\n";
+    }
+
+    // A 3D draw is about to sample `entry`: classify it and, with gfx.mipmaps, give it its chain.
+    void note_3d_use(TextureEntry &entry, const DrawCall &call, const GuestMemory &memory) {
+        ensure_traits(entry, memory);
+        if (entry.uv_verdict != 2u && (call.texture.wrap_s != 0u || call.texture.wrap_t != 0u)) check_uv_coverage(entry, call);
+        if (opt.mips && !entry.mips_tried) build_mips(entry, call, memory);
+    }
