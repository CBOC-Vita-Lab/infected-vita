+    const std::regex declaration(R"(\b(?:float|int|bool|vec[234]|ivec[234]|bvec[234]|mat[234]|sampler2D)\s+([A-Za-z_][A-Za-z0-9_]*))");
+    const std::regex varying_line(R"(^\s*varying\s+(?:(?:lowp|mediump|highp)\s+)?(\w+)\s+(\w+)(?:\[(\d+)\])?\s*;)");
+    const auto slots_of = [](const std::string &type, int count) {
