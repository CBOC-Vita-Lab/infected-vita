@@ -0,0 +1,28 @@
+#pragma once
+
+// The built-in font of the port's overlay and counters: a 5x7 letter shape on a 5x9 grid (capitals and ascenders
+// on rows 0..6, lowercase bodies on rows 2..6, descenders on rows 7..8), ASCII 32..126 and two arrow heads. It is
+// drawn at an integer scale, so it stays crisp on any screen; at 3 a glyph is 15x27 pixels. Plain data, no
+// rendering API: the canvases (gpu/gl and the software one) draw it.
+#include <cstddef>
+#include <cstdint>
+#include <string_view>
+
+namespace portablekit::overlay {
+
+inline constexpr int kGlyphWidth = 5;
+inline constexpr int kGlyphHeight = 9;
+inline constexpr int kGlyphAdvance = 6;   // glyph plus one column of space
+inline constexpr int kGlyphLine = 11;     // one text line
+inline constexpr int kGlyphCount = 97;
+inline constexpr char kArrowLeft = '\x01';
+inline constexpr char kArrowRight = '\x02';
+
+// Index of a character in the glyph table: 0 for space .. 94 for '~', 95 and 96 for the arrows; '?' for the rest.
+[[nodiscard]] int glyph_index(char c) noexcept;
+// The nine rows of a glyph, five bits each, the leftmost pixel in bit 4.
+[[nodiscard]] const std::uint8_t *glyph_rows(int index) noexcept;
+// Width in pixels of a text at an integer scale (the last glyph has no trailing space).
+[[nodiscard]] int text_width(std::string_view text, int scale) noexcept;
+
+} // namespace portablekit::overlay
