+#!/usr/bin/env python3
+"""Labelled before/after comparison sheets for the port's graphics options.
+
+Replays recorded GE frames (tools/ge_replay) once per value of one option, with every other graphics option at its
+off/original value, and lays 100% crops of each result side by side with an amplified difference. Nothing here knows a
+game: the dump, the flip and the crop rectangles come from the command line.
+
+  gfx_compare.py --replay build/bin/ge_replay --dump DIR --flip N --option gfx.mipmaps --values off,on \
+      --crop "character:340,320" --crop "fire:410,130" --out sheet.png [--size 240x136] [--zoom 2]
+
+A crop is NAME:X,Y (the top left, in pixels of the 960x544 picture; --size is the crop's size). The first value is the
+reference; the last column of a row is |value - reference| multiplied by --gain.
+Needs Pillow and numpy. Environment: EGL_PLATFORM=surfaceless LIBGL_ALWAYS_SOFTWARE=1 is set for the replayer.
+"""
+import argparse
+import os
+import subprocess
+import sys
+import tempfile
+
+import numpy as np
+from PIL import Image, ImageDraw, ImageFont
+
+# Every graphics option at the value that does nothing: the base the option under test is varied from.
+OFF = {
+    "gfx.texture_filter": "original",
+    "gfx.mipmaps": "off",
+    "gfx.antialiasing": "off",
+    "gfx.pixel_lighting": "off",
+    "gfx.effects_scale": "1",
+    "gfx.movie_filter": "bilinear",
+    "perf.show_fps": "off",
+}
+
+
+def replay(binary, dump, flip, overrides, png_pattern, extra):
+    env = dict(os.environ, EGL_PLATFORM="surfaceless", LIBGL_ALWAYS_SOFTWARE="1")
+    cmd = ["nice", "-n", "10", "timeout", "-s", "KILL", "600", binary, dump, "--flips", str(flip), "--png", png_pattern]
+    for key, value in overrides.items():
+        cmd += ["--port", "%s=%s" % (key, value)]
+    cmd += extra
+    result = subprocess.run(cmd, env=env, capture_output=True, text=True)
+    if result.returncode != 0:
+        sys.exit("replay failed: %s\n%s" % (" ".join(cmd), result.stderr))
+    return result.stdout + result.stderr
+
+
+def label(draw, xy, text, fill=(255, 255, 255)):
+    x, y = xy
+    draw.rectangle([x - 2, y - 2, x + 7 * len(text) + 2, y + 12], fill=(0, 0, 0))
+    draw.text((x, y), text, fill=fill, font=ImageFont.load_default())
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--replay", required=True)
+    ap.add_argument("--dump", required=True)
+    ap.add_argument("--flip", required=True, type=int)
+    ap.add_argument("--option", required=True)
+    ap.add_argument("--values", required=True, help="comma separated; the first is the reference")
+    ap.add_argument("--crop", action="append", default=[], help="NAME:X,Y")
+    ap.add_argument("--size", default="240x136")
+    ap.add_argument("--zoom", type=int, default=2)
+    ap.add_argument("--gain", type=int, default=4)
+    ap.add_argument("--set", action="append", default=[], help="extra --port KEY=VALUE for every run")
+    ap.add_argument("--replay-arg", action="append", default=[], help="extra argument for ge_replay")
+    ap.add_argument("--title", default="")
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--full-out", help="also write the full pictures side by side (downscaled by half)")
+    args = ap.parse_args()
+
+    values = args.values.split(",")
+    width, height = (int(v) for v in args.size.split("x"))
+    crops = []
+    for text in args.crop:
+        name, rest = text.split(":")
+        x, y = (int(v) for v in rest.split(","))
+        crops.append((name, x, y))
+
+    base = dict(OFF)
+    for item in args.set:
+        key, value = item.split("=")
+        base[key] = value
+
+    images = []
+    with tempfile.TemporaryDirectory() as tmp:
+        for value in values:
+            overrides = dict(base)
+            overrides[args.option] = value
+            pattern = os.path.join(tmp, "v_%s.png" % value.replace("/", "_"))
+            replay(args.replay, args.dump, args.flip, overrides, pattern, args.replay_arg)
+            produced = [f for f in os.listdir(tmp) if f.startswith("v_%s_" % value.replace("/", "_"))]
+            if not produced:
+                sys.exit("no picture for %s=%s" % (args.option, value))
+            images.append(np.asarray(Image.open(os.path.join(tmp, produced[0])).convert("RGB")).astype(np.int16))
+
+    reference = images[0]
+    columns = len(values) + 1
+    cell_w, cell_h = width * args.zoom, height * args.zoom
+    pad = 4
+    top = 22
+    sheet = Image.new("RGB", (columns * (cell_w + pad) + pad, top + len(crops) * (cell_h + pad + 14) + pad), (30, 30, 30))
+    draw = ImageDraw.Draw(sheet)
+    title = args.title or "%s  dump %s flip %d" % (args.option, os.path.basename(os.path.normpath(args.dump)), args.flip)
+    label(draw, (pad, 4), title)
+    for row, (name, x, y) in enumerate(crops):
+        y0 = top + row * (cell_h + pad + 14)
+        for col in range(columns):
+            if col < len(values):
+                crop = images[col][y:y + height, x:x + width]
+                text = "%s=%s  [%s @%d,%d]" % (args.option.split(".")[-1], values[col], name, x, y)
+            else:
+                diff = np.abs(images[-1][y:y + height, x:x + width] - reference[y:y + height, x:x + width])
+                crop = np.clip(diff * args.gain, 0, 255)
+                text = "|%s - %s| x%d  max %d" % (values[-1], values[0], args.gain, int(diff.max()))
+            tile = Image.fromarray(crop.astype(np.uint8)).resize((cell_w, cell_h), Image.NEAREST)
+            x0 = pad + col * (cell_w + pad)
+            sheet.paste(tile, (x0, y0 + 14))
+            label(draw, (x0, y0), text)
+    sheet.save(args.out)
+    print("wrote", args.out, sheet.size)
+
+    if args.full_out:
+        h, w, _ = reference.shape
+        half = Image.new("RGB", (len(values) * (w // 2 + pad) + pad, h // 2 + 20), (30, 30, 30))
+        d = ImageDraw.Draw(half)
+        for col, img in enumerate(images):
+            tile = Image.fromarray(img.astype(np.uint8)).resize((w // 2, h // 2), Image.LANCZOS)
+            half.paste(tile, (pad + col * (w // 2 + pad), 18))
+            label(d, (pad + col * (w // 2 + pad), 3), "%s=%s" % (args.option, values[col]))
+        half.save(args.full_out)
+        print("wrote", args.full_out)
+
+
+if __name__ == "__main__":
+    main()
