+    sum += picture_tap(vec2(uv12.x, uv0.y)) * (w12.x * w0.y);
+    sum += picture_tap(vec2(uv3.x, uv0.y)) * (w3.x * w0.y);
+    sum += picture_tap(vec2(uv0.x, uv12.y)) * (w0.x * w12.y);
+    sum += picture_tap(vec2(uv12.x, uv12.y)) * (w12.x * w12.y);
