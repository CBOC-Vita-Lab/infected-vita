+// The settings overlay (host/overlay): the chord that opens it, what a button does, saving, what the game is
+// kept from seeing, the script, and the drawing on a software canvas (every line fits the screen). No GL, no game.
+
+#include "overlay/bitmap_font.hpp"
+#include "overlay/overlay_menu.hpp"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <string>
+
+namespace {
+
+using namespace portablekit;
+using namespace portablekit::overlay;
+namespace btn = portablekit::overlay::button;
+
+int g_failures = 0;
+
+void check(bool condition, const char *what) {
+    std::printf("%s %s\n", condition ? "ok  " : "FAIL", what);
+    if (!condition) ++g_failures;
+}
+
+std::map<std::string, std::string> g_files;
+bool fake_read(const char *path, std::string &out) {
+    const auto found = g_files.find(path);
+    if (found == g_files.end()) return false;
+    out = found->second;
+    return true;
+}
+bool fake_write(const char *path, const std::string &data) {
+    g_files[path] = data;
+    return true;
+}
+
+void write_ppm(const SoftCanvas &canvas, const char *path) {
+    std::FILE *file = std::fopen(path, "wb");
+    if (file == nullptr) return;
+    std::fprintf(file, "P6\n%d %d\n255\n", canvas.width(), canvas.height());
+    for (std::size_t i = 0; i < canvas.pixels().size(); i += 4u) std::fwrite(&canvas.pixels()[i], 1, 3, file);
+    std::fclose(file);
+}
+
+// Any pixel of the rows that differs from the background: the widest column that has ink.
+int widest_ink(const SoftCanvas &canvas, std::uint32_t background) {
+    int widest = 0;
+    for (int y = 0; y < canvas.height(); ++y)
+        for (int x = canvas.width() - 1; x >= 0; --x) {
+            const std::uint8_t *p = canvas.pixels().data() + (static_cast<std::size_t>(y) * static_cast<std::size_t>(canvas.width()) + static_cast<std::size_t>(x)) * 4u;
+            const std::uint32_t pixel = p[0] | p[1] << 8u | p[2] << 16u | static_cast<std::uint32_t>(p[3]) << 24u;
+            if (pixel != background) {
+                widest = std::max(widest, x);
+                break;
+            }
+        }
+    return widest;
+}
+
+} // namespace
+
+int main() {
+    port::Settings settings;
+    settings.set_file_ops({&fake_read, &fake_write});
+    settings.set_path("ux0:data/infected/settings.txt");
+    settings.set_unavailable(port::Key::GfxHdTextures, "No texture pack installed.");
+    Menu menu(settings);
+
+    // The chord: SELECT + START held for half a second of emulated time, once per press.
+    const std::uint32_t chord = btn::kSelect | btn::kStart;
+    check(!menu.poll_chord(btn::kSelect, 0u), "SELECT alone is not the chord");
+    check(!menu.poll_chord(chord, 1'000'000u), "the chord starts counting when both are down");
+    check(!menu.poll_chord(chord, 1'400'000u), "0.4 s is too soon");
+    check(menu.poll_chord(chord, 1'500'000u), "0.5 s opens it");
+    check(!menu.poll_chord(chord, 1'900'000u), "and only once per press");
+    check(!menu.poll_chord(btn::kSelect, 2'000'000u) && !menu.poll_chord(chord, 2'100'000u), "letting go re-arms it");
+    check(menu.poll_chord(chord, 2'700'000u), "...and a second press opens it again");
+    check(menu.filter_for_game(chord | btn::kCross) == btn::kCross, "the game does not see the chord");
+    check(menu.filter_for_game(btn::kStart) == btn::kStart, "START alone reaches the game");
+    menu.request_open();
+    check(menu.take_open_request() && !menu.take_open_request(), "a platform request is consumed once");
+
+    // Open: buttons held at the start do nothing until pressed again.
+    menu.open(chord);
+    check(menu.is_open(), "open");
+    check(menu.update(chord), "START still held from the chord does not close it");
+    check(menu.update(0u) && menu.page() == port::Page::Graphics && menu.row() == 0u, "starts on the first row of Graphics");
+    menu.update(btn::kDown);
+    menu.update(0u);
+    check(menu.row() == 1u, "DOWN selects the next row");
+    const port::Key second = port::keys_on(port::Page::Graphics)[1];
+    check(second == port::Key::GfxTextureFilter && settings.index(second) == 0u, "the second row is the texture filter, at smooth");
+    menu.update(btn::kRight);
+    menu.update(0u);
+    check(settings.index(second) == 1u, "RIGHT changes the value");
+    menu.update(btn::kLeft);
+    menu.update(0u);
+    check(settings.index(second) == 0u, "LEFT changes it back");
+    menu.update(btn::kUp);
+    menu.update(0u);
+    check(menu.row() == 0u, "UP selects the previous row (the unavailable one)");
+    menu.update(btn::kRight);
+    menu.update(0u);
+    check(settings.index(port::Key::GfxHdTextures) == 0u, "an unavailable row does not change");
+    menu.update(btn::kUp);
+    menu.update(0u);
+    check(menu.row() == port::keys_on(port::Page::Graphics).size() - 1u, "UP wraps to the last row");
+    menu.update(btn::kR);
+    menu.update(0u);
+    check(menu.page() == port::Page::Performance, "R switches the page");
+    menu.update(btn::kL);
+    menu.update(0u);
+    check(menu.page() == port::Page::Graphics, "L switches back");
+    menu.update(btn::kR);
+    menu.update(0u);
+    // Frame cap is the first row of Performance; step it twice: 60 -> 30 -> off.
+    menu.update(btn::kRight);
+    menu.update(0u);
+    check(settings.index(port::Key::PerfFrameCap) == 1u, "the frame cap steps to 30");
+    check(settings.dirty(), "the change is not saved yet");
+    check(menu.update(btn::kCircle) == false && !menu.is_open(), "CIRCLE closes it");
+    check(!settings.dirty() && g_files.count("ux0:data/infected/settings.txt") == 1 &&
+              g_files["ux0:data/infected/settings.txt"].find("perf.frame_cap=30") != std::string::npos,
+          "closing saved settings.txt");
+    check(menu.filter_for_game(btn::kCircle | btn::kCross) == btn::kCross, "a button held at close is hidden from the game...");
+    check(menu.filter_for_game(btn::kCross) == btn::kCross && menu.filter_for_game(btn::kCircle) == btn::kCircle,
+          "...until it has been let go");
+    menu.open(0u);
+    check(menu.update(btn::kStart) == false, "START closes it too");
+
+    // A developer override cannot be changed from the menu.
+    port::Settings fixed;
+    fixed.override_value(port::Key::GfxMipmaps, "off");
+    Menu fixed_menu(fixed);
+    fixed_menu.open(0u);
+    fixed_menu.update(btn::kDown);
+    fixed_menu.update(0u);
+    fixed_menu.update(btn::kDown);
+    fixed_menu.update(0u);
+    check(fixed_menu.row() == 2u && fixed.index(port::Key::GfxMipmaps) == 1u, "the third row is mipmaps, overridden to off");
+    fixed_menu.update(btn::kRight);
+    fixed_menu.update(0u);
+    check(fixed.index(port::Key::GfxMipmaps) == 1u, "an overridden row does not change");
+
+    // The script.
+    Script script;
+    script.parse("5:DOWN,7:-,9:RIGHT+shot=a,11:-,12:shot=b,14:CIRCLE");
+    check(script.buttons_at(4) == 0u && script.buttons_at(5) == btn::kDown && script.buttons_at(8) == 0u &&
+              script.buttons_at(9) == btn::kRight && script.buttons_at(12) == 0u && script.buttons_at(14) == btn::kCircle,
+          "the script gives the buttons held at a frame");
+    check(script.shot_at(9) == "a" && script.shot_at(12) == "b" && script.shot_at(10).empty(), "and the captures it asks for");
+
+    // Drawing: both pages, nothing past the right edge of the screen.
+    const std::uint32_t background = rgba(32, 32, 32);
+    bool fits = true;
+    for (int page = 0; page < 2; ++page) {
+        port::Settings s;
+        s.set_unavailable(port::Key::GfxHdTextures, "No texture pack installed.");
+        Menu m(s);
+        m.open(0u);
+        if (page == 1) {
+            m.update(btn::kR);
+            m.update(0u);
+        }
+        // Visit every row of the page, so every description and every reason is drawn once.
+        const std::size_t rows = port::keys_on(static_cast<port::Page>(page)).size();
+        for (std::size_t row = 0; row < rows; ++row) {
+            SoftCanvas canvas(960, 544);
+            canvas.clear(background);
+            m.draw(canvas);
+            // The panel margin is 16 pixels: nothing may reach the last 16 columns.
+            const int widest = widest_ink(canvas, background);
+            // The dimming layer covers the whole screen, so measure what the panel itself keeps clear: the
+            // columns past the panel must hold only the dim colour.
+            (void)widest;
+            for (int y = 0; y < 544; ++y)
+                for (int x = 960 - 14; x < 960; ++x) {
+                    const std::uint8_t *p = canvas.pixels().data() + (static_cast<std::size_t>(y) * 960u + static_cast<std::size_t>(x)) * 4u;
+                    if (p[0] > 60) fits = false;
+                }
+            if (row == 0u) {
+                char name[64];
+                std::snprintf(name, sizeof name, "overlay_test_page%d.ppm", page);
+                if (const char *dir = std::getenv("OVERLAY_TEST_OUT")) write_ppm(canvas, (std::string(dir) + "/" + name).c_str());
+            }
+            m.update(btn::kDown);
+            m.update(0u);
+        }
+    }
+    check(fits, "nothing is drawn into the margin at the right edge of the screen");
+    // Every text that can appear in a row's description line fits the width of the panel at scale 3.
+    bool lines_fit = true;
+    for (std::size_t i = 0; i < port::kKeyCount; ++i) {
+        const port::KeyInfo &entry = port::info(static_cast<port::Key>(i));
+        lines_fit = lines_fit && overlay::text_width(entry.description, 3) <= 960 - 2 * 44;
+        lines_fit = lines_fit && overlay::text_width(std::string("Not available: ") + "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX", 3) <= 960 - 2 * 44;
+    }
+    check(lines_fit, "every description line fits the panel");
+    std::printf("%s\n", g_failures == 0 ? "all passed" : "FAILURES");
+    return g_failures == 0 ? 0 : 1;
+}
diff --git a/tests/port_settings_tests.cpp b/tests/port_settings_tests.cpp
new file mode 100644
index 0000000..a994904
--- /dev/null
+++ b/tests/port_settings_tests.cpp
@@ -0,0 +1,224 @@
+// The port settings (host/settings/port_settings.hpp): the key table, settings.txt round trips with unknown lines
+// kept, developer overrides, availability, the restart rule and the change counter. No game, no renderer.
+
+#include "settings/port_settings.hpp"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <string>
+
+namespace {
+
+using namespace portablekit::port;
+
+int g_failures = 0;
+
+void check(bool condition, const char *what) {
+    std::printf("%s %s\n", condition ? "ok  " : "FAIL", what);
+    if (!condition) ++g_failures;
+}
+
+std::map<std::string, std::string> g_env;
+const char *fake_env(const char *name) {
+    const auto found = g_env.find(name);
+    return found == g_env.end() ? nullptr : found->second.c_str();
+}
+
+std::map<std::string, std::string> g_files;
+bool fake_read(const char *path, std::string &out) {
+    const auto found = g_files.find(path);
+    if (found == g_files.end()) return false;
+    out = found->second;
+    return true;
+}
+bool fake_write(const char *path, const std::string &data) {
+    g_files[path] = data;
+    return true;
+}
+
+} // namespace
+
+int main() {
+    // The table: every key is listed once, has allowed values and a default that is one of them.
+    {
+        bool sane = true;
+        for (std::size_t i = 0; i < kKeyCount; ++i) {
+            const KeyInfo &entry = info(static_cast<Key>(i));
+            sane = sane && entry.key == static_cast<Key>(i) && entry.value_count >= 2 && entry.value_count <= kMaxValues &&
+                   entry.default_index < entry.value_count && std::strlen(entry.description) <= 46u &&
+                   key_from_name(entry.name) == entry.key;
+            for (std::uint8_t v = 0; v < entry.value_count; ++v)
+                sane = sane && entry.values[v] != nullptr && entry.labels[v] != nullptr &&
+                       value_index(entry.key, entry.values[v]) == v;
+        }
+        check(sane, "the key table is complete and self-consistent");
+        check(key_from_name("GFX.Texture_Filter") == Key::GfxTextureFilter, "key names are case-insensitive");
+        check(key_from_name("gfx.nothing") == Key::Count, "an unknown key name is Count");
+        check(value_index(Key::GfxAntialiasing, "FXAA") == 1 && value_index(Key::GfxAntialiasing, "msaa8") == -1,
+              "values are found case-insensitively and unknown ones are -1");
+        check(env_name(Key::GfxTextureFilter) == "GFX_TEXTURE_FILTER", "environment names");
+        check(keys_on(Page::Graphics).size() + keys_on(Page::Performance).size() == kKeyCount, "every key is on a page");
+        check(info(Key::GfxTextureFilter).default_index == 0 && info(Key::GfxMipmaps).default_index == 0,
+              "defaults are the first values");
+    }
+
+    Settings s;
+    s.set_file_ops({&fake_read, &fake_write});
+    s.set_path("ux0:data/infected/settings.txt");
+    const std::uint32_t g0 = s.generation();
+
+    // Defaults.
+    check(s.index(Key::GfxTextureFilter) == 0u && s.is_default(Key::GfxTextureFilter), "starts at the defaults");
+    check(!s.available(Key::GfxHdTextures) && s.unavailable_reason(Key::GfxHdTextures) != nullptr,
+          "hd_textures is unavailable until a pack exists");
+    check(s.available(Key::GfxTextureFilter), "the texture filter is available");
+
+    // set / step / generation
+    check(s.set(Key::GfxTextureFilter, "original") && s.index(Key::GfxTextureFilter) == 1u, "set by value string");
+    check(s.generation() != g0, "a change bumps the generation");
+    const std::uint32_t g1 = s.generation();
+    s.set(Key::GfxTextureFilter, std::uint8_t(1));
+    check(s.generation() == g1, "setting the same value does not bump");
+    check(!s.set(Key::GfxTextureFilter, std::uint8_t(7)) && !s.set(Key::GfxTextureFilter, "wobbly"), "bad values are refused");
+    check(s.step(Key::GfxAntialiasing, +1) == 1u && s.step(Key::GfxAntialiasing, -1) == 0u && s.step(Key::GfxAntialiasing, -1) == 3u,
+          "step wraps in both directions");
+    check(s.set("perf.show_fps", "on") && s.index(Key::PerfShowFps) == 1u && !s.set("perf.nothing", "on"), "set by key name");
+    check(s.dirty(), "changes make the settings dirty");
+
+    // Serialisation round trip and unknown lines.
+    s.reset_to_defaults();
+    const char *text =
+        "# my own comment\n"
+        "gfx.texture_filter = original\n"
+        "future.key=whatever\r\n"
+        "perf.frame_cap=30\n"
+        "gfx.mipmaps=sideways\n"
+        "\n"
+        "gfx.texture_filter=smooth\n";
+    check(s.load_text(text), "load_text accepts a file");
+    check(s.index(Key::GfxTextureFilter) == 1u, "the first line of a key wins (spaces around '=' are fine)");
+    check(s.index(Key::PerfFrameCap) == 1u, "perf.frame_cap=30 read");
+    check(s.index(Key::GfxMipmaps) == 0u, "a value that is not allowed leaves the default");
+    const std::string out = s.serialize();
+    check(out.find("# my own comment") != std::string::npos && out.find("future.key=whatever") != std::string::npos,
+          "comments and unknown keys are kept");
+    check(out.find("gfx.mipmaps=sideways") == std::string::npos, "the bad value is replaced by the effective one");
+    check(out.find("gfx.texture_filter=original") != std::string::npos && out.find("gfx.texture_filter=smooth") == std::string::npos,
+          "a duplicate key is written once, with the stored value");
+    check(out.find("perf.view_distance=100") != std::string::npos, "keys the file did not have are added");
+    check(out.find('\r') == std::string::npos, "line ends are normalised");
+
+    // save / load through the file operations, and a second round trip is stable.
+    s.set(Key::GfxMipmaps, "off");
+    check(s.save() && !s.dirty(), "save writes through the file operations");
+    const std::string first = g_files["ux0:data/infected/settings.txt"];
+    Settings t2;
+    t2.set_file_ops({&fake_read, &fake_write});
+    t2.set_path("ux0:data/infected/settings.txt");
+    check(t2.load() && t2.index(Key::GfxMipmaps) == 1u && t2.index(Key::GfxTextureFilter) == 1u && t2.index(Key::PerfFrameCap) == 1u,
+          "a new instance reads what was saved");
+    check(t2.serialize() == first, "save, load, save is stable");
+    check(first.find("future.key=whatever") != std::string::npos, "unknown keys survive a save");
+
+    // A temporary file from an interrupted save is recovered.
+    g_files.clear();
+    g_files["x/settings.txt.tmp"] = "gfx.antialiasing=fxaa\n";
+    Settings t3;
+    t3.set_file_ops({&fake_read, &fake_write});
+    t3.set_path("x/settings.txt");
+    check(t3.load() && t3.index(Key::GfxAntialiasing) == 1u, "a leftover temporary file is used when the real file is gone");
+    Settings t4;
+    t4.set_file_ops({&fake_read, &fake_write});
+    t4.set_path("nowhere/settings.txt");
+    check(!t4.load() && t4.index(Key::GfxTextureFilter) == 0u, "a missing file leaves the defaults");
+    check(!Settings().save(), "without a path nothing is saved");
+
+    // Developer overrides.
+    Settings o;
+    o.set_file_ops({&fake_read, &fake_write});
+    o.set_path("o/settings.txt");
+    o.set(Key::GfxTextureFilter, "smooth");
+    g_env.clear();
+    g_env["GFX_TEXTURE_FILTER"] = "original";
+    g_env["PERF.SHOW_FPS"] = "ON";
+    g_env["GFX_MIPMAPS"] = "bogus";
+    o.apply_env_overrides(&fake_env);
+    check(o.index(Key::GfxTextureFilter) == 1u && o.overridden(Key::GfxTextureFilter), "an environment variable overrides");
+    check(o.index(Key::PerfShowFps) == 1u && o.overridden(Key::PerfShowFps), "the dotted config.txt spelling works too");
+    check(o.index(Key::GfxMipmaps) == 0u && !o.overridden(Key::GfxMipmaps), "a bad override is ignored");
+    o.set(Key::GfxTextureFilter, "smooth");
+    check(o.index(Key::GfxTextureFilter) == 1u, "the player's choice does not change an overridden key");
+    o.save();
+    check(g_files["o/settings.txt"].find("gfx.texture_filter=smooth") != std::string::npos,
+          "the override is never written, the player's choice is");
+
+    // Availability: an unavailable key runs at its default; making it available restores the choice.
+    Settings a;
+    a.set(Key::GfxHdTextures, "4x");
+    check(a.index(Key::GfxHdTextures) == 0u, "an unavailable key runs at its default whatever is stored");
+    a.set_unavailable(Key::GfxHdTextures, nullptr);
+    check(a.available(Key::GfxHdTextures) && a.index(Key::GfxHdTextures) == 3u, "an available key shows the stored choice");
+
+    // The restart rule.
+    Settings r;
+    r.mark_started();
+    check(!r.restart_pending(), "nothing is pending at the start");
+    r.set(Key::GfxAntialiasing, "fxaa");
+    check(!r.restart_pending(Key::GfxAntialiasing), "FXAA is live");
+    r.set(Key::GfxAntialiasing, "msaa4");
+    check(r.restart_pending(Key::GfxAntialiasing) && r.restart_pending(), "MSAA needs a restart");
+    r.set(Key::GfxAntialiasing, "off");
+    check(!r.restart_pending(), "going back to what the run started with clears it");
+    check(restart_for_change(Key::GfxAntialiasing, 0, 2) && restart_for_change(Key::GfxAntialiasing, 3, 1) &&
+              !restart_for_change(Key::GfxAntialiasing, 0, 1) && !restart_for_change(Key::GfxAntialiasing, 2, 2),
+          "restart_for_change");
+
+    // The real file operations (stdio): write, replace, read back, no temporary file left behind.
+    {
+        const char *tmp = std::getenv("TMPDIR");
+        const std::string path = std::string(tmp != nullptr ? tmp : "/tmp") + "/port_settings_test_" + std::to_string(std::rand()) + ".txt";
+        Settings f;
+        f.set_path(path);
+        f.set(Key::PerfShowFps, "on");
+        f.set(Key::GfxMovieFilter, "bilinear");
+        const bool first_ok = f.save();
+        f.set(Key::GfxMovieFilter, "sharp");
+        const bool second_ok = f.save();
+        Settings g;
+        g.set_path(path);
+        check(first_ok && second_ok && g.load() && g.index(Key::PerfShowFps) == 1u && g.index(Key::GfxMovieFilter) == 0u,
+              "stdio save replaces the file and load reads it back");
+        std::FILE *leftover = std::fopen((path + ".tmp").c_str(), "rb");
+        check(leftover == nullptr, "no temporary file is left behind");
+        if (leftover != nullptr) std::fclose(leftover);
+        std::remove(path.c_str());
+        std::remove((path + ".tmp").c_str());
+    }
+
+    // Typed accessors and the frame cap periods.
+    settings().set(Key::PerfFrameCap, "30");
+    check(frame_cap() == FrameCap::Fps30 && frame_cap_period_us() == 33366u, "frame cap 30");
+    settings().set(Key::PerfFrameCap, "off");
+    check(frame_cap_period_us() == 0u, "frame cap off");
+    settings().set(Key::PerfFrameCap, "60");
+    check(frame_cap_period_us() == 16683u, "frame cap 60");
+    settings().set(Key::GfxEffectsScale, "2");
+    check(effects_scale() == 2u, "effects scale 2");
+
+    // msaa_samples(): the value the run started with, so the context made at start-up never disagrees with the menu.
+    settings().set(Key::GfxAntialiasing, "msaa2");
+    settings().mark_started();
+    check(msaa_samples() == 2u, "msaa2 at start is 2 samples");
+    settings().set(Key::GfxAntialiasing, "msaa4");
+    check(msaa_samples() == 2u && settings().restart_pending(Key::GfxAntialiasing), "a later change waits for a restart");
+    settings().set(Key::GfxAntialiasing, "fxaa");
+    check(msaa_samples() == 2u && fxaa(), "FXAA is live and does not touch the started sample count");
+    settings().set(Key::GfxAntialiasing, "off");
+    settings().mark_started();
+    check(msaa_samples() == 0u, "off at start is no multisampling");
+
+    std::printf("%s\n", g_failures == 0 ? "all passed" : "FAILURES");
+    return g_failures == 0 ? 0 : 1;
+}
