new file mode 100644
index 0000000..cca1eda
--- /dev/null
+++ b/host/overlay/overlay_host.hpp
@@ -0,0 +1,58 @@
+#pragma once
+
+// The settings overlay as the runtime hosts it: the port settings and the one menu, the renderer hook, the pad filter
+// and the modal loop that runs while the menu is open (docs/GRAPHICS_OPTIONS.md, "The overlay at run time").
+//
+// It knows nothing of the guest. What it needs from the runtime is passed in: the buttons of the real pad (not the
+// scripted one: emulated time stands still while the menu is open), and the pause itself, which the runtime does with
+// Kernel::PauseScope around run_modal().
+#include "gpu/renderer.hpp"
+#include "overlay/overlay_menu.hpp"
+#include "settings/port_settings.hpp"
+
+#include <cstdint>
+#include <functional>
+#include <string>
+
+namespace portablekit::overlay_host {
+
+// A platform that keeps its files somewhere else than <prefix>_DATA_DIR (the Vita: ux0:data/infected) or reads and
+// writes them its own way says so before init_settings(). Optional.
+void set_platform(std::string data_root, const port::FileOps *file_ops = nullptr);
+
+// Loads settings.txt from the data root, applies the developer overrides (<prefix>_GFX_*, <prefix>_PERF_*), marks the
+// start for the restart rule. The first call does it; later calls do nothing. Call before the renderer exists: the
+// graphics context reads port::msaa_samples().
+void init_settings();
+
+// The one menu. A platform hook (the Vita's touch-corner tap) calls menu().request_open().
+[[nodiscard]] overlay::Menu &menu();
+
+// Gives the renderer what it needs to draw the panel and tells it when the menu is open. A renderer without an
+// overlay (has_overlay() false) is left alone and the chord does nothing.
+void attach(gpu::Renderer &renderer);
+
+// Per read of the real and scripted pad, with emulated time: watches for the chord. Returns what the game may see.
+[[nodiscard]] std::uint32_t pad_for_game(std::uint32_t buttons, std::uint64_t now_us);
+
+// Whether the menu is to open at the next flip (the chord was held, or a platform asked). Cleared by run_modal().
+[[nodiscard]] bool open_requested();
+
+// What the host provides to the modal loop.
+struct ModalHost {
+    // The buttons of the real pad now (window gamepad and keyboard, or the Vita's pad), never the scripted pad.
+    std::function<std::uint32_t()> device_buttons;
+    // Whether device_buttons can ever change (a window, a platform pad). Without input and without an
+    // <prefix>_OVERLAY_SCRIPT the menu closes by itself after kHeadlessFrames, so a headless run never hangs.
+    bool has_device_input{false};
+};
+
+inline constexpr std::uint32_t kHeadlessFrames = 180;
+
+// Runs the menu until it closes: one tick per display refresh draws the game's last picture with the panel and feeds
+// the buttons in. The caller has paused the guest. <prefix>_OVERLAY_SCRIPT drives it instead of the pad ("frame:
+// BUTTON+BUTTON,frame:-,frame:shot=name"; see overlay::Script) and <prefix>_OVERLAY_SHOT_DIR (else
+// <prefix>_SCREENSHOT_DIR) is where shot=name writes <name>.png. Returns false when the window was closed meanwhile.
+bool run_modal(gpu::Renderer &renderer, const ModalHost &host);
+
+} // namespace portablekit::overlay_host
diff --git a/host/overlay/overlay_menu.cpp b/host/overlay/overlay_menu.cpp
new file mode 100644
index 0000000..01b8091
--- /dev/null
+++ b/host/overlay/overlay_menu.cpp
@@ -0,0 +1,283 @@
+#include "overlay/overlay_menu.hpp"
+
+#include "overlay/bitmap_font.hpp"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <cstdlib>
+
+namespace portablekit::overlay {
+namespace button {
+
+std::uint32_t by_name(std::string_view name) noexcept {
+    std::string upper(name);
+    for (char &c : upper) c = static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+    static const struct {
+        const char *name;
+        std::uint32_t bit;
+    } table[] = {{"SELECT", kSelect},   {"START", kStart},     {"UP", kUp},           {"RIGHT", kRight},
+                 {"DOWN", kDown},       {"LEFT", kLeft},       {"L", kL},             {"LTRIGGER", kL},
+                 {"R", kR},             {"RTRIGGER", kR},      {"TRIANGLE", kTriangle}, {"CIRCLE", kCircle},
+                 {"CROSS", kCross},     {"SQUARE", kSquare}};
+    for (const auto &entry : table)
+        if (upper == entry.name) return entry.bit;
+    return 0u;
+}
+
+} // namespace button
+
+// ---- input ----------------------------------------------------------------------------------------------------------
+
+bool Menu::poll_chord(std::uint32_t held, std::uint64_t now_us) {
+    constexpr std::uint32_t kChord = button::kSelect | button::kStart;
+    if ((held & kChord) != kChord) {
+        chord_down_ = false;
+        chord_fired_ = false;
+        return false;
+    }
+    if (!chord_down_) {
+        chord_down_ = true;
+        chord_since_us_ = now_us;
+        return false;
+    }
+    if (chord_fired_ || now_us < chord_since_us_ + kChordHoldUs) return false;
+    chord_fired_ = true;
+    return true;
+}
+
+std::uint32_t Menu::filter_for_game(std::uint32_t held) {
+    constexpr std::uint32_t kChord = button::kSelect | button::kStart;
+    swallow_ &= held;
+    std::uint32_t visible = held & ~swallow_;
+    if ((visible & kChord) == kChord) visible &= ~kChord;
+    return visible;
+}
+
+void Menu::open(std::uint32_t held) {
+    std::lock_guard<std::mutex> guard(lock_);
+    previous_ = held;
+    chord_down_ = true;   // the chord that opened it is still down: it does not fire again until let go
+    chord_fired_ = true;
+    open_.store(true, std::memory_order_release);
+}
+
+void Menu::close(std::uint32_t held) {
+    {
+        std::lock_guard<std::mutex> guard(lock_);
+        if (!open_.load(std::memory_order_relaxed)) return;
+        open_.store(false, std::memory_order_release);
+        swallow_ = held;
+        previous_ = 0u;
+    }
+    if (settings_.dirty()) {
+        if (!settings_.save()) std::fprintf(stderr, "[settings] cannot write %s\n", settings_.path().c_str());
+    }
+}
+
+bool Menu::update(std::uint32_t held) {
+    if (!open_.load(std::memory_order_acquire)) return false;
+    std::uint32_t pressed = 0u;
+    {
+        std::lock_guard<std::mutex> guard(lock_);
+        pressed = held & ~previous_;
+        previous_ = held;
+        if ((pressed & (button::kCircle | button::kStart)) == 0u) act(pressed);
+    }
+    if ((pressed & (button::kCircle | button::kStart)) != 0u) {
+        close(held);
+        return false;
+    }
+    return true;
+}
+
+void Menu::act(std::uint32_t pressed) {
+    const std::vector<port::Key> list = keys();
+    std::size_t &row = row_[static_cast<std::size_t>(page_)];
+    if (list.empty()) return;
+    if ((pressed & button::kUp) != 0u) row = (row + list.size() - 1u) % list.size();
+    if ((pressed & button::kDown) != 0u) row = (row + 1u) % list.size();
+    if ((pressed & (button::kL | button::kR)) != 0u) {
+        const std::size_t next = (static_cast<std::size_t>(page_) + ((pressed & button::kR) != 0u ? 1u : port::kPageCount - 1u)) %
+                                 port::kPageCount;
+        page_ = static_cast<port::Page>(next);
+        return;
+    }
+    const int direction = ((pressed & button::kRight) != 0u ? 1 : 0) - ((pressed & button::kLeft) != 0u ? 1 : 0);
+    if (direction != 0) {
+        const port::Key key = list[std::min(row, list.size() - 1u)];
+        // A row that is greyed or fixed by a developer switch for this run does not change.
+        if (settings_.available(key) && !settings_.overridden(key)) settings_.step(key, direction);
+    }
+}
+
+// ---- drawing -----------------------------------------------------------------------------------------------------------
+
+namespace {
+
+constexpr std::uint32_t kPanel = rgba(10, 14, 28, 222);
+constexpr std::uint32_t kRowSelected = rgba(36, 92, 168, 240);
+constexpr std::uint32_t kWhite = rgba(244, 246, 250);
+constexpr std::uint32_t kDim = rgba(150, 156, 170);
+constexpr std::uint32_t kGrey = rgba(110, 114, 124);
+constexpr std::uint32_t kChanged = rgba(130, 214, 255);
+constexpr std::uint32_t kOrange = rgba(255, 150, 70);
+
+std::uint32_t cost_color(port::Cost cost) {
+    switch (cost) {
+    case port::Cost::None: return rgba(150, 156, 170);
+    case port::Cost::Low: return rgba(120, 224, 130);
+    case port::Cost::Medium: return rgba(244, 212, 90);
+    case port::Cost::High: return rgba(255, 140, 70);
+    }
+    return kDim;
+}
+
+} // namespace
+
+void Menu::draw(Canvas &canvas) const {
+    std::lock_guard<std::mutex> guard(lock_);
+    const int width = canvas.width(), height = canvas.height();
+    // The panel keeps a margin of 16 pixels (a screen edge may be hidden by the bezel) and scales with the display.
+    const int unit = std::max(1, std::min(width / 320, height / 181));  // 3 at 960x544
+    const int margin = 16 * unit / 3;
+    const int big = unit, small = std::max(1, unit * 2 / 3);
+    const int line = kGlyphHeight * big;
+    canvas.fill(0, 0, width, height, rgba(0, 0, 0, 96));  // dims the game behind the panel
+    canvas.fill(margin, margin, width - 2 * margin, height - 2 * margin, kPanel);
+
+    // Title and page tabs.
+    const int left = margin + 28 * unit / 3;
+    const int top = margin + 14 * unit / 3;
+    canvas.text(left, top, big, kWhite, "SETTINGS");
+    int tab_x = width - margin - 28 * unit / 3;
+    for (std::size_t i = port::kPageCount; i-- > 0;) {
+        const char *name = port::page_name(static_cast<port::Page>(i));
+        const int tab_width = overlay::text_width(name, big) + 20 * unit / 3;
+        tab_x -= tab_width;
+        const bool active = static_cast<port::Page>(i) == page_;
+        if (active) canvas.fill(tab_x, top - 6 * unit / 3, tab_width, line + 12 * unit / 3, kRowSelected);
+        canvas.text(tab_x + 10 * unit / 3, top, big, active ? kWhite : kDim, name);
+        tab_x -= 10 * unit / 3;
+    }
+    // Column heads.
+    const int head_y = top + line + 18 * unit / 3;
+    const int value_x = left + 366 * unit / 3, cost_x = left + 656 * unit / 3, tag_x = left + 780 * unit / 3;
+    canvas.text(left, head_y, small, kGrey, "OPTION");
+    canvas.text(value_x, head_y, small, kGrey, "VALUE");
+    canvas.text(cost_x, head_y, small, kGrey, "COST");
+
+    // Rows.
+    const std::vector<port::Key> list = keys();
+    const int row_height = 40 * unit / 3;
+    const int rows_y = head_y + kGlyphHeight * small + 10 * unit / 3;
+    const std::size_t selected = std::min(row_[static_cast<std::size_t>(page_)], list.empty() ? 0u : list.size() - 1u);
+    for (std::size_t i = 0; i < list.size(); ++i) {
+        const port::Key key = list[i];
+        const port::KeyInfo &info = port::info(key);
+        const int y = rows_y + static_cast<int>(i) * row_height;
+        const bool is_selected = i == selected;
+        const bool usable = settings_.available(key);
+        if (is_selected) canvas.fill(left - 12 * unit / 3, y - 2 * unit / 3, width - 2 * left + 24 * unit / 3, row_height - 2 * unit / 3, kRowSelected);
+        const std::uint32_t text_color = usable ? kWhite : kGrey;
+        const int text_y = y + (row_height - 2 * unit / 3 - line) / 2 - 1;
+        canvas.text(left, text_y, big, text_color, info.label);
+        const std::uint32_t value_color = !usable ? kGrey : (settings_.is_default(key) ? kWhite : kChanged);
+        if (is_selected && usable && !settings_.overridden(key)) {
+            canvas.text(value_x - kGlyphAdvance * big, text_y, big, kWhite, std::string(1, kArrowLeft));
+        }
+        const std::string label = settings_.label(key);
+        canvas.text(value_x, text_y, big, value_color, label);
+        if (is_selected && usable && !settings_.overridden(key))
+            canvas.text(value_x + overlay::text_width(label, big) + kGlyphAdvance * big / 2, text_y, big, kWhite,
+                        std::string(1, kArrowRight));
+        // Cost of the value shown; nothing for a row that cannot be used.
+        if (usable) canvas.text(cost_x, text_y, big, cost_color(settings_.cost(key)), port::cost_name(settings_.cost(key)));
+        // "restart needed": pending after a change, or always for a setting that is read once at start.
+        if (usable && (settings_.restart_pending(key) || info.restart_always)) {
+            const bool pending = settings_.restart_pending(key);
+            const std::uint32_t tag = pending ? kOrange : kDim;
+            canvas.text(tag_x, y + 1 * unit / 3, small, tag, "restart");
+            canvas.text(tag_x, y + 1 * unit / 3 + kGlyphHeight * small, small, tag, "needed");
+        }
+    }
+
+    // One line about the selected row, then the legend.
+    const int desc_y = rows_y + 8 * row_height + 6 * unit / 3;
+    canvas.fill(margin, desc_y - 8 * unit / 3, width - 2 * margin, line + 16 * unit / 3, rgba(0, 0, 0, 120));
+    std::string description;
+    std::uint32_t description_color = kWhite;
+    if (!list.empty()) {
+        const port::Key key = list[selected];
+        if (!settings_.available(key)) {
+            description = std::string("Not available: ") + settings_.unavailable_reason(key);
+            description_color = kOrange;
+        } else if (settings_.overridden(key)) {
+            description = "Fixed by a developer switch for this run.";
+            description_color = kOrange;
+        } else {
+            description = port::info(key).description;
+        }
+    }
+    canvas.text(left, desc_y, big, description_color, description);
+    const int legend_y = height - margin - kGlyphHeight * small - 10 * unit / 3;
+    canvas.text(left, legend_y, small, kDim, "UP/DOWN select   LEFT/RIGHT change   L/R page   CIRCLE close");
+}
+
+void Menu::draw_counter(Canvas &canvas, const FrameInfo &info) {
+    char text[96];
+    std::snprintf(text, sizeof text, "%.0f FPS  %.1f MS  %u DRAWS (%u GL)", static_cast<double>(info.fps),
+                  static_cast<double>(info.frame_ms), info.draws, info.gl_draws);
+    const int scale = std::max(1, canvas.width() / 480);
+    const int pad = 4 * scale;
+    const int width = overlay::text_width(text, scale);
+    canvas.fill(pad, pad, width + 2 * pad, kGlyphHeight * scale + 2 * pad, rgba(0, 0, 0, 170));
+    canvas.text(2 * pad, 2 * pad, scale, rgba(120, 255, 140), text);
+}
+
+// ---- script ------------------------------------------------------------------------------------------------------------
+
+void Script::parse(std::string_view text) {
+    steps_.clear();
+    std::size_t at = 0;
+    while (at < text.size()) {
+        std::size_t end = text.find(',', at);
+        if (end == std::string_view::npos) end = text.size();
+        const std::string_view entry = text.substr(at, end - at);
+        at = end + 1u;
+        const std::size_t colon = entry.find(':');
+        if (colon == std::string_view::npos) continue;
+        Step step;
+        step.frame = std::strtoull(std::string(entry.substr(0, colon)).c_str(), nullptr, 10);
+        std::string_view rest = entry.substr(colon + 1u);
+        std::size_t pos = 0;
+        while (pos <= rest.size()) {
+            std::size_t plus = rest.find('+', pos);
+            if (plus == std::string_view::npos) plus = rest.size();
+            const std::string_view word = rest.substr(pos, plus - pos);
+            pos = plus + 1u;
+            if (word.rfind("shot=", 0) == 0) {
+                step.shot = std::string(word.substr(5));
+            } else {
+                step.sets_buttons = true;
+                step.buttons |= button::by_name(word);
+            }
+        }
+        steps_.push_back(std::move(step));
+    }
+}
+
+std::uint32_t Script::buttons_at(std::uint64_t frame) const noexcept {
+    std::uint32_t buttons = 0u;
+    for (const Step &step : steps_)
+        if (step.sets_buttons && frame >= step.frame) buttons = step.buttons;
+    return buttons;
+}
+
+std::string Script::shot_at(std::uint64_t frame) const {
+    for (const Step &step : steps_)
+        if (!step.shot.empty() && step.frame == frame) return step.shot;
+    return {};
+}
+
+} // namespace portablekit::overlay
diff --git a/host/overlay/overlay_menu.hpp b/host/overlay/overlay_menu.hpp
new file mode 100644
index 0000000..16717ca
--- /dev/null
+++ b/host/overlay/overlay_menu.hpp
@@ -0,0 +1,126 @@
+#pragma once
+
+// The port's in-game settings menu: the model (pages, selection, what a button does) and its drawing, with no
+// renderer, no window and no clock of its own. Whoever owns the pad feeds it buttons; whoever owns GL draws it
+// through a Canvas after the game's frame (docs/GRAPHICS_OPTIONS.md, proj/docs/ARCHITECTURE.md section 7).
+//
+// Closed, the menu watches for the chord: SELECT and START held for half a second of emulated time, or a request
+// from a platform hook (the Vita's touch-corner tap calls request_open(), which any thread may do). Open, it
+// takes every button: UP/DOWN select a row, LEFT/RIGHT change its value, L/R switch the page, CIRCLE or START
+// close it and save settings.txt. The buttons it uses are the PSP pad's (sceCtrl) bits.
+//
+// Threads: open(), request_open() and is_open() may be called from any thread; update(), poll_chord() and the
+// filtering belong to the thread that reads the pad, draw() to the thread that owns GL. Draw takes a snapshot under
+// a lock, so the two may differ.
+#include "overlay/canvas.hpp"
+#include "settings/port_settings.hpp"
+
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace portablekit::overlay {
+
+namespace button {
+inline constexpr std::uint32_t kSelect = 0x000001u;
+inline constexpr std::uint32_t kStart = 0x000008u;
+inline constexpr std::uint32_t kUp = 0x000010u;
+inline constexpr std::uint32_t kRight = 0x000020u;
+inline constexpr std::uint32_t kDown = 0x000040u;
+inline constexpr std::uint32_t kLeft = 0x000080u;
+inline constexpr std::uint32_t kL = 0x000100u;
+inline constexpr std::uint32_t kR = 0x000200u;
+inline constexpr std::uint32_t kTriangle = 0x001000u;
+inline constexpr std::uint32_t kCircle = 0x002000u;
+inline constexpr std::uint32_t kCross = 0x004000u;
+inline constexpr std::uint32_t kSquare = 0x008000u;
+// A button by its name ("SELECT", "UP", "L", "CIRCLE", ...), 0 when unknown.
+[[nodiscard]] std::uint32_t by_name(std::string_view name) noexcept;
+} // namespace button
+
+// How long SELECT and START are held to open the menu, in microseconds of emulated time.
+inline constexpr std::uint64_t kChordHoldUs = 500'000u;
+
+// The numbers of the frame counter (perf.show_fps).
+struct FrameInfo {
+    float fps{};
+    float frame_ms{};
+    std::uint32_t draws{};      // draw calls the game made in a frame
+    std::uint32_t gl_draws{};   // GL draws after merging
+};
+
+class Menu {
+public:
+    explicit Menu(port::Settings &settings) : settings_(settings) {}
+
+    // ---- closed ----------------------------------------------------------------------------------------------------
+    // The held buttons once per game frame (or more often) with the emulated time; true when the chord has been
+    // held long enough, once per press. The caller then opens the menu.
+    bool poll_chord(std::uint32_t held, std::uint64_t now_us);
+    // What the game may see of `held`: SELECT and START while they are held together (the chord is not the game's),
+    // and any button that was held when the menu closed until it is let go.
+    [[nodiscard]] std::uint32_t filter_for_game(std::uint32_t held);
+    // From a platform hook (touch corner); consumed by take_open_request().
+    void request_open() noexcept { open_requested_.store(true, std::memory_order_release); }
+    [[nodiscard]] bool take_open_request() noexcept { return open_requested_.exchange(false, std::memory_order_acq_rel); }
+
+    // ---- open ------------------------------------------------------------------------------------------------------
+    // `held` is what is down as the menu opens: those buttons count only once let go and pressed again.
+    void open(std::uint32_t held);
+    [[nodiscard]] bool is_open() const noexcept { return open_.load(std::memory_order_acquire); }
+    // One frame of input while open. Returns whether the menu is still open. Closing saves settings.txt.
+    bool update(std::uint32_t held);
+    // Closes it from outside (the platform, a stop), saving.
+    void close(std::uint32_t held);
+
+    // ---- drawing -----------------------------------------------------------------------------------------------------
+    void draw(Canvas &canvas) const;
+    // The frame counter, top left.
+    static void draw_counter(Canvas &canvas, const FrameInfo &info);
+
+    // For tests: where the selection is.
+    [[nodiscard]] port::Page page() const noexcept { return page_; }
+    [[nodiscard]] std::size_t row() const noexcept { return row_[static_cast<std::size_t>(page_)]; }
+
+private:
+    void act(std::uint32_t pressed);
+    [[nodiscard]] std::vector<port::Key> keys() const { return port::keys_on(page_); }
+
+    port::Settings &settings_;
+    std::atomic<bool> open_{false};
+    std::atomic<bool> open_requested_{false};
+    mutable std::mutex lock_;      // page_, row_ and the settings' values as draw() reads them
+    port::Page page_{port::Page::Graphics};
+    std::size_t row_[port::kPageCount]{};
+    std::uint32_t previous_{};     // buttons held at the last update()
+    std::uint32_t swallow_{};      // buttons held at close, hidden from the game until released
+    std::uint64_t chord_since_us_{};
+    bool chord_down_{};
+    bool chord_fired_{};
+};
+
+// A scripted run of the menu for tests and screenshots (<prefix>_OVERLAY_SCRIPT): "frame:BUTTON+BUTTON,frame:-,
+// frame:shot=name", frames counted from the moment the menu opens (the game's own pad script cannot drive it: the
+// game's clock stands still while it is open). "-" lets every button go; shot=name asks for a capture.
+class Script {
+public:
+    void parse(std::string_view text);
+    [[nodiscard]] bool empty() const noexcept { return steps_.empty(); }
+    [[nodiscard]] std::uint32_t buttons_at(std::uint64_t frame) const noexcept;
+    // The capture name asked for at exactly this frame, or empty.
+    [[nodiscard]] std::string shot_at(std::uint64_t frame) const;
+
+private:
+    struct Step {
+        std::uint64_t frame{};
+        std::uint32_t buttons{};
+        bool sets_buttons{};  // a step that only asks for a capture leaves the buttons as they are
+        std::string shot;
+    };
+    std::vector<Step> steps_;
+};
+
+} // namespace portablekit::overlay
diff --git a/host/settings/port_settings.cpp b/host/settings/port_settings.cpp
new file mode 100644
index 0000000..07688cc
--- /dev/null
+++ b/host/settings/port_settings.cpp
@@ -0,0 +1,499 @@
+#include "settings/port_settings.hpp"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <utility>
+
+#if defined(_WIN32)
+#include <io.h>
+#elif !defined(__vita__)
+#include <unistd.h>
+#endif
+
+namespace portablekit::port {
+namespace {
+
+constexpr Cost N = Cost::None, L = Cost::Low, M = Cost::Medium, H = Cost::High;
+
+// The table. The order is the order of the Key enum, and within a page the order of the overlay's rows.
+// Descriptions are at most 46 characters: the overlay draws them at large size on one line, behind a 15 character
+// "Not available: " when the row is greyed (reasons are at most 31).
+const KeyInfo kTable[kKeyCount] = {
+    {Key::GfxHdTextures, "gfx.hd_textures", Page::Graphics, "HD textures",
+     "Sharper textures from an installed pack.", 4, 0,
+     {"auto", "off", "2x", "4x"}, {"Best available", "Off", "2x pack", "4x pack"}, {L, N, L, M}, 0, false},
+    {Key::GfxTextureFilter, "gfx.texture_filter", Page::Graphics, "Texture filter",
+     "Smooths 3D textures. HUD and text unchanged.", 2, 0,
+     {"smooth", "original"}, {"Smooth", "Original"}, {L, N}, 0, false},
+    {Key::GfxMipmaps, "gfx.mipmaps", Page::Graphics, "Mipmaps",
+     "Less shimmer on distant ground and walls.", 2, 0,
+     {"on", "off"}, {"On", "Off"}, {L, N}, 0, false},
+    {Key::GfxAntialiasing, "gfx.antialiasing", Page::Graphics, "Anti-aliasing",
+     "Smooths jagged edges. MSAA needs a restart.", 4, 0,
+     {"off", "fxaa", "msaa2", "msaa4"}, {"Off", "FXAA", "MSAA 2x", "MSAA 4x"}, {N, M, M, H}, 0x0C, false},
+    {Key::GfxPixelLighting, "gfx.pixel_lighting", Page::Graphics, "Pixel lighting",
+     "Lights characters per pixel, not per vertex.", 2, 0,
+     {"off", "on"}, {"Off", "On"}, {N, H}, 0, false},
+    {Key::GfxEffectsScale, "gfx.effects_scale", Page::Graphics, "Effects resolution",
+     "Resolution of the glow and blur passes.", 2, 0,
+     {"1", "2"}, {"Normal", "Double"}, {N, M}, 0, false},
+    {Key::GfxMovieFilter, "gfx.movie_filter", Page::Graphics, "Movie scaling",
+     "How 480x272 movies are enlarged to the screen.", 2, 0,
+     {"sharp", "bilinear"}, {"Sharp", "Bilinear"}, {L, N}, 0, false},
+    {Key::GfxHdMovies, "gfx.hd_movies", Page::Graphics, "HD movies",
+     "Replacement movies of higher quality.", 2, 0,
+     {"off", "on"}, {"Off", "On"}, {N, L}, 0, false},
+    {Key::PerfFrameCap, "perf.frame_cap", Page::Performance, "Frame limit",
+     "Most frames shown per second. 30 saves power.", 3, 0,
+     {"60", "30", "off"}, {"60 fps", "30 fps", "Off"}, {N, N, N}, 0, false},
+    {Key::PerfShowFps, "perf.show_fps", Page::Performance, "Show FPS",
+     "Frames per second, frame time and draw count.", 2, 0,
+     {"off", "on"}, {"Off", "On"}, {N, L}, 0, false},
+    {Key::PerfThreadedRenderer, "perf.threaded_renderer", Page::Performance, "Renderer thread",
+     "Draws on its own CPU core. Needs a restart.", 2, 0,
+     {"on", "off"}, {"On", "Off"}, {N, N}, 0, true},
+    {Key::PerfCpuClock, "perf.cpu_clock", Page::Performance, "CPU clock",
+     "Vita CPU speed in MHz. Higher runs hotter.", 2, 0,
+     {"444", "500"}, {"444 MHz", "500 MHz", }, {N, L}, 0, false},
+    {Key::PerfEnemyDensity, "perf.enemy_density", Page::Performance, "Enemy density",
+     "How many enemies a level spawns, in percent.", 4, 0,
+     {"100", "125", "150", "200"}, {"100%", "125%", "150%", "200%"}, {N, L, M, H}, 0, false},
+    {Key::PerfViewDistance, "perf.view_distance", Page::Performance, "View distance",
+     "How far the world is drawn, in percent.", 3, 0,
+     {"100", "150", "200"}, {"100%", "150%", "200%"}, {N, M, H}, 0, false},
+};
+
+// What the build or the device cannot do yet; set_unavailable() changes this at run time.
+// (The table above says what a key is; availability says whether this program can do it.)
+
+char lower(char c) { return static_cast<char>(std::tolower(static_cast<unsigned char>(c))); }
+char upper(char c) { return static_cast<char>(std::toupper(static_cast<unsigned char>(c))); }
+
+bool equal_ignore_case(std::string_view a, std::string_view b) noexcept {
+    if (a.size() != b.size()) return false;
+    for (std::size_t i = 0; i < a.size(); ++i)
+        if (lower(a[i]) != lower(b[i])) return false;
+    return true;
+}
+
+std::string_view trim(std::string_view text) noexcept {
+    while (!text.empty() && (text.front() == ' ' || text.front() == '\t')) text.remove_prefix(1);
+    while (!text.empty() && (text.back() == ' ' || text.back() == '\t' || text.back() == '\r')) text.remove_suffix(1);
+    return text;
+}
+
+// ---- files ----------------------------------------------------------------------------------------------------
+
+bool default_read_all(const char *path, std::string &out) {
+    std::FILE *file = std::fopen(path, "rb");
+    if (file == nullptr) return false;
+    out.clear();
+    char buffer[1024];
+    for (;;) {
+        const std::size_t got = std::fread(buffer, 1, sizeof buffer, file);
+        if (got != 0) out.append(buffer, got);
+        if (got < sizeof buffer) break;
+    }
+    const bool ok = std::ferror(file) == 0;
+    std::fclose(file);
+    return ok;
+}
+
+bool write_file(const char *path, const std::string &data) {
+    std::FILE *file = std::fopen(path, "wb");
+    if (file == nullptr) return false;
+    bool ok = data.empty() || std::fwrite(data.data(), 1, data.size(), file) == data.size();
+    ok = std::fflush(file) == 0 && ok;
+#if !defined(_WIN32) && !defined(__vita__)
+    if (ok) (void)::fsync(::fileno(file));
+#endif
+    ok = std::fclose(file) == 0 && ok;
+    return ok;
+}
+
+bool default_write_replace(const char *path, const std::string &data) {
+    const std::string temporary = std::string(path) + ".tmp";
+    // A temporary file left by an interrupted save is replaced, not appended to or truncated: removing it first
+    // is what works where O_TRUNC does not (the Vita emulator).
+    std::remove(temporary.c_str());
+    if (!write_file(temporary.c_str(), data)) {
+        std::remove(temporary.c_str());
+        return false;
+    }
+#if defined(_WIN32) || defined(__vita__)
+    // rename() does not replace an existing file here: the target goes first. A crash between the two calls leaves
+    // the complete temporary file, which load() recovers.
+    std::remove(path);
+#endif
+    if (std::rename(temporary.c_str(), path) != 0) {
+        std::remove(temporary.c_str());
+        return false;
+    }
+    return true;
+}
+
+std::string join_path(const std::string &root, const char *name) {
+    if (root.empty()) return name;
+    const char last = root.back();
+    if (last == '/' || last == '\\' || last == ':') return root + name;
+    return root + "/" + name;
+}
+
+} // namespace
+
+const KeyInfo &info(Key key) noexcept {
+    const auto index = static_cast<std::size_t>(key);
+    return kTable[index < kKeyCount ? index : 0u];
+}
+
+const char *cost_name(Cost cost) noexcept {
+    switch (cost) {
+    case Cost::None: return "None";
+    case Cost::Low: return "Low";
+    case Cost::Medium: return "Medium";
+    case Cost::High: return "High";
+    }
+    return "";
+}
+
+const char *page_name(Page page) noexcept { return page == Page::Graphics ? "Graphics" : "Performance"; }
+
+std::vector<Key> keys_on(Page page) {
+    std::vector<Key> keys;
+    for (const KeyInfo &entry : kTable)
+        if (entry.page == page) keys.push_back(entry.key);
+    return keys;
+}
+
+Key key_from_name(std::string_view name) noexcept {
+    for (const KeyInfo &entry : kTable)
+        if (equal_ignore_case(entry.name, name)) return entry.key;
+    return Key::Count;
+}
+
+int value_index(Key key, std::string_view value) noexcept {
+    if (key == Key::Count) return -1;
+    const KeyInfo &entry = info(key);
+    for (std::uint8_t i = 0; i < entry.value_count; ++i)
+        if (equal_ignore_case(entry.values[i], value)) return i;
+    return -1;
+}
+
+std::string env_name(Key key) {
+    std::string name = info(key).name;
+    for (char &c : name) c = c == '.' ? '_' : upper(c);
+    return name;
+}
+
+bool restart_for_change(Key key, std::uint8_t from, std::uint8_t to) noexcept {
+    if (key == Key::Count || from == to) return false;
+    const KeyInfo &entry = info(key);
+    if (entry.restart_always) return true;
+    return ((entry.restart_values >> from) & 1u) != 0u || ((entry.restart_values >> to) & 1u) != 0u;
+}
+
+// ---- Settings ----------------------------------------------------------------------------------------------------
+
+Settings::Settings() {
+    for (std::size_t i = 0; i < kKeyCount; ++i) {
+        const std::uint8_t def = kTable[i].default_index;
+        effective_[i].store(def, std::memory_order_relaxed);
+        stored_[i] = override_[i] = started_[i] = def;
+    }
+    // What this program cannot offer. A platform or a feature module changes these with set_unavailable().
+    unavailable_[static_cast<std::size_t>(Key::GfxHdTextures)] = "No texture pack installed.";
+    unavailable_[static_cast<std::size_t>(Key::GfxHdMovies)] = "No replacement movies yet.";
+    unavailable_[static_cast<std::size_t>(Key::PerfThreadedRenderer)] = "Renderer thread not built yet.";
+    unavailable_[static_cast<std::size_t>(Key::PerfEnemyDensity)] = "Not available yet.";
+    unavailable_[static_cast<std::size_t>(Key::PerfViewDistance)] = "Not available yet.";
+#if !defined(__vita__)
+    unavailable_[static_cast<std::size_t>(Key::PerfCpuClock)] = "Only on the Vita.";
+#endif
+    ops_.read_all = &default_read_all;
+    ops_.write_replace = &default_write_replace;
+}
+
+const char *Settings::value(Key key) const noexcept { return info(key).values[index(key)]; }
+const char *Settings::label(Key key) const noexcept { return info(key).labels[index(key)]; }
+Cost Settings::cost(Key key) const noexcept { return info(key).costs[index(key)]; }
+bool Settings::is_default(Key key) const noexcept { return index(key) == info(key).default_index; }
+
+void Settings::bump() noexcept { generation_.fetch_add(1u, std::memory_order_release); }
+
+// The effective value: the override, else the stored choice, else the default. A feature that is not
+// available runs at its default.
+void Settings::refresh(Key key) noexcept {
+    const auto i = static_cast<std::size_t>(key);
+    std::uint8_t wanted = overridden_[i] ? override_[i] : stored_[i];
+    if (unavailable_[i] != nullptr && !overridden_[i]) wanted = kTable[i].default_index;
+    if (effective_[i].load(std::memory_order_relaxed) == wanted) return;
+    effective_[i].store(wanted, std::memory_order_relaxed);
+    bump();
+}
+
+bool Settings::set(Key key, std::uint8_t new_index) {
+    if (key == Key::Count || new_index >= info(key).value_count) return false;
+    const auto i = static_cast<std::size_t>(key);
+    if (stored_[i] != new_index) {
+        stored_[i] = new_index;
+        dirty_ = true;
+    }
+    refresh(key);
+    return true;
+}
+
+bool Settings::set(Key key, std::string_view text) {
+    const int found = value_index(key, text);
+    return found >= 0 && set(key, static_cast<std::uint8_t>(found));
+}
+
+bool Settings::set(std::string_view name, std::string_view text) {
+    const Key key = key_from_name(name);
+    return key != Key::Count && set(key, text);
+}
+
+std::uint8_t Settings::step(Key key, int direction) {
+    if (key == Key::Count) return 0u;
+    const int count = info(key).value_count;
+    int next = static_cast<int>(stored_[static_cast<std::size_t>(key)]) + (direction < 0 ? -1 : 1);
+    next = ((next % count) + count) % count;
+    set(key, static_cast<std::uint8_t>(next));
+    return index(key);
+}
+
+void Settings::reset_to_defaults() {
+    for (std::size_t i = 0; i < kKeyCount; ++i) {
+        if (stored_[i] != kTable[i].default_index) dirty_ = true;
+        stored_[i] = kTable[i].default_index;
+        refresh(static_cast<Key>(i));
+    }
+}
+
+void Settings::apply_env_overrides(const char *(*env)(const char *name)) {
+    if (env == nullptr) return;
+    for (std::size_t i = 0; i < kKeyCount; ++i) {
+        const Key key = static_cast<Key>(i);
+        const std::string name = env_name(key);
+        const char *text = env(name.c_str());
+        if (text == nullptr || *text == '\0') {
+            // config.txt keeps the dotted spelling ("gfx.texture_filter=original"), which the environment then carries
+            // as <PREFIX>_GFX.TEXTURE_FILTER.
+            std::string dotted = info(key).name;
+            for (char &c : dotted) c = upper(c);
+            text = env(dotted.c_str());
+        }
+        if (text == nullptr || *text == '\0') continue;
+        if (!override_value(key, text))
+            std::fprintf(stderr, "[settings] %s=%s is not an allowed value of %s; ignored\n", name.c_str(), text, info(key).name);
+    }
+}
+
+bool Settings::override_value(Key key, std::string_view text) {
+    const int found = value_index(key, trim(text));
+    if (key == Key::Count || found < 0) return false;
+    const auto i = static_cast<std::size_t>(key);
+    override_[i] = static_cast<std::uint8_t>(found);
+    overridden_[i] = true;
+    refresh(key);
+    return true;
+}
+
+bool Settings::overridden(Key key) const noexcept { return key != Key::Count && overridden_[static_cast<std::size_t>(key)]; }
+
+void Settings::set_unavailable(Key key, const char *reason) noexcept {
+    if (key == Key::Count) return;
+    unavailable_[static_cast<std::size_t>(key)] = reason;
+    refresh(key);
+}
+
+const char *Settings::unavailable_reason(Key key) const noexcept {
+    return key == Key::Count ? nullptr : unavailable_[static_cast<std::size_t>(key)];
+}
+
+void Settings::mark_started() {
+    for (std::size_t i = 0; i < kKeyCount; ++i) started_[i] = effective_[i].load(std::memory_order_relaxed);
+}
+
+bool Settings::restart_pending(Key key) const noexcept {
+    if (key == Key::Count) return false;
+    // The pending choice is the stored one (what the next start will read); an override would apply again anyway.
+    const auto i = static_cast<std::size_t>(key);
+    const std::uint8_t pending = overridden_[i] ? override_[i] : (unavailable_[i] != nullptr ? kTable[i].default_index : stored_[i]);
+    return restart_for_change(key, started_[i], pending);
+}
+
+bool Settings::restart_pending() const noexcept {
+    for (std::size_t i = 0; i < kKeyCount; ++i)
+        if (restart_pending(static_cast<Key>(i))) return true;
+    return false;
+}
+
+// ---- files -----------------------------------------------------------------------------------------------------------
+
+bool Settings::init(const InitOptions &options) {
+    if (!options.data_root.empty()) path_ = join_path(options.data_root, "settings.txt");
+    bool loaded = false;
+    if (!path_.empty()) loaded = load();
+    if (options.env != nullptr) apply_env_overrides(options.env);
+    mark_started();
+    return loaded;
+}
+
+void Settings::set_file_ops(const FileOps &ops) noexcept {
+    if (ops.read_all != nullptr) ops_.read_all = ops.read_all;
+    if (ops.write_replace != nullptr) ops_.write_replace = ops.write_replace;
+}
+
+void Settings::set_path(std::string path) { path_ = std::move(path); }
+
+bool Settings::load() {
+    if (path_.empty()) return false;
+    try {
+        std::string text;
+        bool found = ops_.read_all(path_.c_str(), text);
+        if (!found) {
+            // An interrupted save on the Vita (the target removed, the rename not yet done) leaves the whole file
+            // beside it.
+            found = ops_.read_all((path_ + ".tmp").c_str(), text);
+        }
+        if (!found) return false;
+        return load_text(text);
+    } catch (...) {
+        return false;
+    }
+}
+
+bool Settings::load_text(std::string_view text) {
+    try {
+        lines_.clear();
+        in_file_.fill(false);
+        std::array<std::uint8_t, kKeyCount> values = stored_;
+        for (std::size_t i = 0; i < kKeyCount; ++i) values[i] = kTable[i].default_index;
+        std::size_t at = 0;
+        while (at <= text.size()) {
+            std::size_t end = text.find('\n', at);
+            if (end == std::string_view::npos) end = text.size();
+            std::string_view line = text.substr(at, end - at);
+            if (!line.empty() && line.back() == '\r') line.remove_suffix(1);
+            Line entry;
+            entry.text.assign(line);
+            const std::string_view body = trim(line);
+            if (!body.empty() && body.front() != '#' && body.front() != ';') {
+                const std::size_t equals = body.find('=');
+                if (equals != std::string_view::npos) {
+                    const Key key = key_from_name(trim(body.substr(0, equals)));
+                    if (key != Key::Count) {
+                        entry.key = key;
+                        const int found = value_index(key, trim(body.substr(equals + 1)));
+                        // A value that is not allowed leaves the default; the line is rewritten on the next save.
+                        // The first line of a key stands (serialize() drops the later ones).
+                        if (found >= 0 && !in_file_[static_cast<std::size_t>(key)])
+                            values[static_cast<std::size_t>(key)] = static_cast<std::uint8_t>(found);
+                        in_file_[static_cast<std::size_t>(key)] = true;
+                    }
+                }
+            }
+            if (!(end == text.size() && entry.text.empty())) lines_.push_back(std::move(entry));
+            at = end + 1u;
+        }
+        stored_ = values;
+        dirty_ = false;
+        for (std::size_t i = 0; i < kKeyCount; ++i) refresh(static_cast<Key>(i));
+        bump();
+        return true;
+    } catch (...) {
+        return false;
+    }
+}
+
+std::string Settings::serialize() const {
+    std::string out;
+    try {
+        std::array<bool, kKeyCount> written{};
+        const auto known_line = [&](Key key) {
+            const auto i = static_cast<std::size_t>(key);
+            std::string line = info(key).name;
+            line += '=';
+            line += kTable[i].values[stored_[i]];
+            return line;
+        };
+        if (lines_.empty()) {
+            out += "# Port settings. Edited by the in-game menu (SELECT + START held, half a second).\n";
+            out += "# Unknown lines are kept as they are.\n";
+        }
+        for (const Line &entry : lines_) {
+            if (entry.key != Key::Count) {
+                const auto i = static_cast<std::size_t>(entry.key);
+                if (written[i]) continue;  // a duplicate line of a key: the first one stands
+                written[i] = true;
+                out += known_line(entry.key);
+            } else {
+                out += entry.text;
+            }
+            out += '\n';
+        }
+        // Keys the file did not have yet: all of them, so the file shows what can be set.
+        for (std::size_t i = 0; i < kKeyCount; ++i) {
+            if (written[i]) continue;
+            out += known_line(static_cast<Key>(i));
+            out += '\n';
+        }
+    } catch (...) {
+        return std::string();
+    }
+    return out;
+}
+
+bool Settings::save() {
+    if (path_.empty()) return false;
+    const std::string text = serialize();
+    if (text.empty()) return false;
+    if (!ops_.write_replace(path_.c_str(), text)) return false;
+    // The file now has every known key and the lines the next save starts from.
+    try {
+        load_text(text);
+    } catch (...) {
+    }
+    dirty_ = false;
+    return true;
+}
+
+Settings &settings() {
+    static Settings instance;
+    return instance;
+}
+
+std::uint32_t msaa_samples() noexcept {
+    switch (static_cast<Antialiasing>(settings().started_index(Key::GfxAntialiasing))) {
+    case Antialiasing::Msaa2: return 2u;
+    case Antialiasing::Msaa4: return 4u;
+    default: break;
+    }
+    return 0u;
+}
+
+std::uint64_t frame_cap_period_us() noexcept {
+    switch (frame_cap()) {
+    case FrameCap::Fps60: return 16'683u;
+    case FrameCap::Fps30: return 33'366u;
+    case FrameCap::Off: break;
+    }
+    return 0u;
+}
+
+std::uint32_t cpu_clock_mhz() noexcept { return settings().index(Key::PerfCpuClock) == 0u ? 444u : 500u; }
+
+std::uint32_t enemy_density_percent() noexcept {
+    static const std::uint32_t values[] = {100u, 125u, 150u, 200u};
+    return values[std::min<std::size_t>(settings().index(Key::PerfEnemyDensity), 3u)];
+}
+
+std::uint32_t view_distance_percent() noexcept {
+    static const std::uint32_t values[] = {100u, 150u, 200u};
+    return values[std::min<std::size_t>(settings().index(Key::PerfViewDistance), 2u)];
+}
+
+} // namespace portablekit::port
