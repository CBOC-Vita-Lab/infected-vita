diff --git a/host/gpu/mip_chain.cpp b/host/gpu/mip_chain.cpp
new file mode 100644
index 0000000..54c9d99
--- /dev/null
+++ b/host/gpu/mip_chain.cpp
@@ -0,0 +1,149 @@
+#include "gpu/mip_chain.hpp"
+
+#include <algorithm>
+#include <cmath>
+
+namespace portablekit::gpu {
+namespace {
+
+inline std::uint32_t red(std::uint32_t texel) { return texel & 0xFFu; }
+inline std::uint32_t green(std::uint32_t texel) { return (texel >> 8u) & 0xFFu; }
+inline std::uint32_t blue(std::uint32_t texel) { return (texel >> 16u) & 0xFFu; }
+inline std::uint32_t alpha(std::uint32_t texel) { return texel >> 24u; }
+inline std::uint32_t pack(std::uint32_t r, std::uint32_t g, std::uint32_t b, std::uint32_t a) {
+    return r | (g << 8u) | (b << 16u) | (a << 24u);
+}
+
+// One level down. The source is (width x height); the destination is the halved size (at least 1 each way). A texel
+// past an odd edge is read as the edge texel again.
+void halve(const std::uint32_t *source, std::uint32_t width, std::uint32_t height, std::uint32_t *destination,
+           bool alpha_weighted) {
+    const std::uint32_t out_width = std::max(1u, width / 2u), out_height = std::max(1u, height / 2u);
+    for (std::uint32_t y = 0; y < out_height; ++y) {
+        const std::uint32_t y0 = std::min(y * 2u, height - 1u), y1 = std::min(y * 2u + 1u, height - 1u);
+        for (std::uint32_t x = 0; x < out_width; ++x) {
+            const std::uint32_t x0 = std::min(x * 2u, width - 1u), x1 = std::min(x * 2u + 1u, width - 1u);
+            const std::uint32_t t[4] = {source[y0 * width + x0], source[y0 * width + x1], source[y1 * width + x0],
+                                        source[y1 * width + x1]};
+            std::uint32_t a_sum = 0u;
+            for (const std::uint32_t texel : t) a_sum += alpha(texel);
+            std::uint32_t r = 0u, g = 0u, b = 0u;
+            if (alpha_weighted && a_sum != 0u) {
+                // The colour of the covered part only: sum(c * a) / sum(a), rounded to nearest.
+                std::uint32_t rr = 0u, gg = 0u, bb = 0u;
+                for (const std::uint32_t texel : t) {
+                    rr += red(texel) * alpha(texel);
+                    gg += green(texel) * alpha(texel);
+                    bb += blue(texel) * alpha(texel);
+                }
+                r = (rr + a_sum / 2u) / a_sum;
+                g = (gg + a_sum / 2u) / a_sum;
+                b = (bb + a_sum / 2u) / a_sum;
+            } else {
+                // Opaque, or nothing covered at all (the colour under a hole is whatever it is; average it).
+                for (const std::uint32_t texel : t) {
+                    r += red(texel);
+                    g += green(texel);
+                    b += blue(texel);
+                }
+                r = (r + 2u) / 4u;
+                g = (g + 2u) / 4u;
+                b = (b + 2u) / 4u;
+            }
+            destination[y * out_width + x] = pack(r, g, b, (a_sum + 2u) / 4u);
+        }
+    }
+}
+
+// Scales the alpha of a level so that the share of texels above `reference` is `wanted`; returns nothing, edits in place.
+void keep_coverage(std::uint32_t *texels, std::size_t count, std::uint32_t reference, double wanted) {
+    if (count == 0u || wanted <= 0.0 || wanted >= 1.0) return;
+    // The alpha a texel gets at a scale, rounded the way it is stored, so the search and the result agree.
+    const auto scaled_alpha = [](std::uint32_t a, double scale) {
+        return static_cast<std::uint32_t>(std::min(255.0, std::floor(static_cast<double>(a) * scale + 0.5)));
+    };
+    const auto coverage_with = [&](double scale) {
+        std::size_t above = 0;
+        for (std::size_t i = 0; i < count; ++i)
+            if (scaled_alpha(alpha(texels[i]), scale) > reference) ++above;
+        return static_cast<double>(above) / static_cast<double>(count);
+    };
+    if (coverage_with(1.0) >= wanted) return;   // the level has what it needs; never thin it out further
+    double low = 1.0, high = 16.0;
+    // Scales up to 16 (a 4-texel box with one opaque texel has a quarter of the alpha, so 4 is the usual need).
+    if (coverage_with(high) < wanted) {
+        low = high;
+    } else {
+        for (int step = 0; step < 12; ++step) {
+            const double middle = 0.5 * (low + high);
+            if (coverage_with(middle) < wanted) low = middle;
+            else high = middle;
+        }
+        low = high;
+    }
+    for (std::size_t i = 0; i < count; ++i)
+        texels[i] = (texels[i] & 0x00FFFFFFu) | (scaled_alpha(alpha(texels[i]), low) << 24u);
+}
+
+} // namespace
+
+TextureTraits scan_texels(const std::uint32_t *texels, std::size_t count) noexcept {
+    TextureTraits traits;
+    traits.texels = static_cast<std::uint32_t>(count);
+    for (std::size_t i = 0; i < count; ++i) {
+        const std::uint32_t a = alpha(texels[i]);
+        if (a == 0u) ++traits.transparent;
+        else if (a == 255u) ++traits.opaque;
+        else ++traits.translucent;
+    }
+    return traits;
+}
+
+double alpha_coverage(const std::uint32_t *texels, std::size_t count, std::uint32_t reference) noexcept {
+    if (count == 0u) return 0.0;
+    std::size_t above = 0;
+    for (std::size_t i = 0; i < count; ++i)
+        if (alpha(texels[i]) > reference) ++above;
+    return static_cast<double>(above) / static_cast<double>(count);
+}
+
+std::uint32_t mip_level_count(std::uint32_t width, std::uint32_t height) noexcept {
+    std::uint32_t levels = 1u;
+    std::uint32_t size = std::max(width, height);
+    while (size > 1u) {
+        size >>= 1u;
+        ++levels;
+    }
+    return levels;
+}
+
+std::uint32_t build_mip_chain(const std::uint32_t *base, std::uint32_t width, std::uint32_t height,
+                              const MipOptions &options, std::vector<std::uint32_t> &out) {
+    out.clear();
+    if (base == nullptr || width == 0u || height == 0u) return 0u;
+    const std::uint32_t levels = mip_level_count(width, height);
+    std::size_t total = 0;
+    for (std::uint32_t level = 1; level < levels; ++level)
+        total += static_cast<std::size_t>(mip_dimension(width, level)) * mip_dimension(height, level);
+    out.resize(total);
+    const double wanted = options.coverage_reference != 0u
+                              ? alpha_coverage(base, static_cast<std::size_t>(width) * height, options.coverage_reference)
+                              : 0.0;
+    const std::uint32_t *source = base;
+    std::uint32_t source_width = width, source_height = height;
+    std::size_t offset = 0;
+    for (std::uint32_t level = 1; level < levels; ++level) {
+        const std::uint32_t level_width = mip_dimension(width, level), level_height = mip_dimension(height, level);
+        std::uint32_t *destination = out.data() + offset;
+        halve(source, source_width, source_height, destination, options.alpha_weighted);
+        const std::size_t count = static_cast<std::size_t>(level_width) * level_height;
+        if (options.coverage_reference != 0u) keep_coverage(destination, count, options.coverage_reference, wanted);
+        source = destination;
+        source_width = level_width;
+        source_height = level_height;
+        offset += count;
+    }
+    return levels - 1u;
+}
+
+} // namespace portablekit::gpu
diff --git a/host/gpu/mip_chain.hpp b/host/gpu/mip_chain.hpp
new file mode 100644
index 0000000..119104a
--- /dev/null
+++ b/host/gpu/mip_chain.hpp
@@ -0,0 +1,59 @@
+#pragma once
+
+// Mip chains for the world textures (gfx.mipmaps), built on the CPU from the decoded RGBA texels.
+//
+// Why not just glGenerateMipmap: a plain box filter averages the colour of fully transparent texels (whatever the artist
+// left under the cut-out) into their neighbours, which shows as dark or bright fringes round fences, leaves and signs
+// once the texture is seen from far away, and it thins a cut-out out until the alpha test makes it vanish. This module
+// does the two things the hardware path cannot:
+//   - the colour of a level's texel is the alpha-weighted mean of the four texels below it, so a transparent texel
+//     contributes nothing to the colour;
+//   - for a texture the game alpha-tests against a reference, each level's alpha is scaled so that the share of texels
+//     passing the test stays what level 0 had (the "alpha-tested mipmaps" fix), so a fence is as dense at 8 pixels
+//     as it is at 256.
+//
+// Texels are 32-bit in memory order R, G, B, A (red is the lowest byte), rows top to bottom, tightly packed.
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace portablekit::gpu {
+
+// What a scan of a texture's alpha finds; it decides how the texture is filtered (see the renderer).
+struct TextureTraits {
+    std::uint32_t texels{};
+    std::uint32_t transparent{};   // alpha == 0: colour-keyed or cut out
+    std::uint32_t translucent{};   // 0 < alpha < 255
+    std::uint32_t opaque{};        // alpha == 255
+    // Distinct colours are not counted; this is the cheap part of the classification.
+    [[nodiscard]] bool has_alpha() const noexcept { return transparent + translucent != 0u; }
+    // Every texel is fully transparent or fully opaque: a cut-out (a fence, a leaf, a sprite with a colour key).
+    [[nodiscard]] bool cut_out() const noexcept { return transparent != 0u && translucent == 0u; }
+};
+
+[[nodiscard]] TextureTraits scan_texels(const std::uint32_t *texels, std::size_t count) noexcept;
+
+struct MipOptions {
+    // Weight the colour by alpha (needed whenever a texture has any alpha below 255).
+    bool alpha_weighted{false};
+    // The alpha-test threshold, 1..255, to keep the coverage of; 0 keeps the plain mean alpha.
+    // A test "alpha > reference" or "alpha >= reference" both count texels above `reference`.
+    std::uint32_t coverage_reference{0};
+};
+
+// How many levels a texture of this size has, including level 0, down to 1x1.
+[[nodiscard]] std::uint32_t mip_level_count(std::uint32_t width, std::uint32_t height) noexcept;
+[[nodiscard]] inline std::uint32_t mip_dimension(std::uint32_t base, std::uint32_t level) noexcept {
+    const std::uint32_t size = base >> level;
+    return size != 0u ? size : 1u;
+}
+
+// Builds levels 1 and up from level 0 (`base`, width x height). The levels are appended to `out` one after the other,
+// each tightly packed, level 1 first; `out` is cleared first. Returns the number of levels built (level 0 not counted).
+std::uint32_t build_mip_chain(const std::uint32_t *base, std::uint32_t width, std::uint32_t height,
+                              const MipOptions &options, std::vector<std::uint32_t> &out);
+
+// The share of texels of a level whose alpha is above `reference` (0..1); exposed for the tests.
+[[nodiscard]] double alpha_coverage(const std::uint32_t *texels, std::size_t count, std::uint32_t reference) noexcept;
+
+} // namespace portablekit::gpu
