+        const auto vertex_varyings = varyings_of(v.vertex), fragment_varyings = varyings_of(v.fragment);
+        int slots = 0;
+        for (const auto &entry : vertex_varyings) slots += entry.second;
+        if (slots > 10) rules = "MORE THAN 10 VARYING SLOTS";
+        for (const auto &entry : fragment_varyings)
+            if (vertex_varyings.find(entry.first) == vertex_varyings.end()) rules = "varying " + entry.first + " is not written by the vertex shader";
+        for (const std::string *source : {&v.vertex, &v.fragment}) {
+            for (std::sregex_iterator it(source->begin(), source->end(), declaration), end; it != end; ++it)
+                if (reserved.count((*it)[1].str()) != 0u) rules = "reserved name " + (*it)[1].str();
+        }
