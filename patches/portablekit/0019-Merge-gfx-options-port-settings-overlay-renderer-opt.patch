@@ -0,0 +1,231 @@
+#pragma once
+
+// The port's own settings: what the in-game overlay menu changes and settings.txt keeps.
+//
+// This header is the single source of truth for the keys (docs: proj/docs/ARCHITECTURE.md section 7):
+// their names, defaults, allowed values, labels, page, cost hints and the restart rule. The renderer, the
+// runtime and the overlay all read it; nothing else spells a key.
+//
+// Layers, from the strongest: a developer override (the environment variable <PREFIX>_GFX_TEXTURE_FILTER, or the
+// same line in config.txt, which the Vita app exports to the environment), then the player's settings.txt, then the
+// default. An override decides the value for the whole run: the overlay shows it and cannot change it, and it is
+// never written to settings.txt.
+//
+// Threads: the values and the generation counter are atomics, so the renderer thread may read while the thread that owns
+// the overlay writes. Loading, saving and set() belong to one thread (the one that runs the overlay).
+//
+// No exceptions leave this module. File access is plain stdio (no std::filesystem), so `ux0:data/infected/settings.txt`
+// works; on the Vita the file is removed before it is written, because SCE_O_TRUNC is unreliable in the emulator.
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace portablekit::port {
+
+enum class Page : std::uint8_t { Graphics, Performance };
+inline constexpr std::size_t kPageCount = 2;
+
+// What an option costs, as an estimate for the Vita (no GPU timing exists here, see docs/GRAPHICS_OPTIONS.md).
+enum class Cost : std::uint8_t { None, Low, Medium, High };
+
+enum class Key : std::uint8_t {
+    GfxHdTextures,
+    GfxTextureFilter,
+    GfxMipmaps,
+    GfxAntialiasing,
+    GfxPixelLighting,
+    GfxEffectsScale,
+    GfxMovieFilter,
+    GfxHdMovies,
+    PerfFrameCap,
+    PerfShowFps,
+    PerfThreadedRenderer,
+    PerfCpuClock,
+    PerfEnemyDensity,
+    PerfViewDistance,
+    Count
+};
+inline constexpr std::size_t kKeyCount = static_cast<std::size_t>(Key::Count);
+inline constexpr std::size_t kMaxValues = 4;
+
+// The typed views of the values, in the order of each key's allowed list (default first).
+// gfx.hd_textures: Auto is "the best pack that is present", the table's "default = best pack present".
+enum class HdTextures : std::uint8_t { Auto, Off, X2, X4 };
+enum class TextureFilter : std::uint8_t { Smooth, Original };
+enum class Antialiasing : std::uint8_t { Off, Fxaa, Msaa2, Msaa4 };
+enum class MovieFilter : std::uint8_t { Sharp, Bilinear };
+enum class FrameCap : std::uint8_t { Fps60, Fps30, Off };
+
+struct KeyInfo {
+    Key key;
+    const char *name;          // "gfx.texture_filter"
+    Page page;
+    const char *label;         // "Texture filtering"
+    const char *description;   // one line, at most 46 characters: the overlay shows it at large size under the list
+    std::uint8_t value_count;
+    std::uint8_t default_index;
+    const char *values[kMaxValues];      // the strings of the file, default first
+    const char *labels[kMaxValues];      // for the overlay
+    Cost costs[kMaxValues];              // per value: what choosing it costs on the Vita (an estimate)
+    // Choosing the value takes a restart: bit i for value i (the pending change is applied by the next start).
+    std::uint8_t restart_values;
+    // Every change takes a restart, whatever the values (a thread that is created once).
+    bool restart_always;
+};
+
+[[nodiscard]] const KeyInfo &info(Key key) noexcept;
+[[nodiscard]] const char *cost_name(Cost cost) noexcept;
+[[nodiscard]] const char *page_name(Page page) noexcept;
+// The keys of a page, in the order the overlay lists them.
+[[nodiscard]] std::vector<Key> keys_on(Page page);
+// Key by its file name ("perf.show_fps"); Key::Count when unknown.
+[[nodiscard]] Key key_from_name(std::string_view name) noexcept;
+// Index of a value string in a key's allowed list; -1 when it is not allowed. Case-insensitive.
+[[nodiscard]] int value_index(Key key, std::string_view value) noexcept;
+// The name an environment variable carries: "gfx.texture_filter" -> "GFX_TEXTURE_FILTER".
+[[nodiscard]] std::string env_name(Key key);
+
+// Whether a change from one value to another needs a restart.
+[[nodiscard]] bool restart_for_change(Key key, std::uint8_t from, std::uint8_t to) noexcept;
+
+// How a platform tells the settings where its files and its environment are.
+struct InitOptions {
+    // The port data root: `ux0:data/infected/` on the Vita, <PREFIX>_DATA_DIR on a desktop. Without one nothing is
+    // loaded or saved (the defaults and overrides still work). A trailing '/' or ':' is not needed.
+    std::string data_root;
+    // Reads a developer switch: name without the program's prefix ("GFX_TEXTURE_FILTER"), the value or nullptr.
+    // The runtime passes portablekit::env.
+    const char *(*env)(const char *name){nullptr};
+};
+
+// What a platform can replace: plain file access. The defaults use stdio; the Vita build may use sceIo directly.
+struct FileOps {
+    // Reads a whole file; false if it does not exist or cannot be read.
+    bool (*read_all)(const char *path, std::string &out){nullptr};
+    // Replaces `path` by `data` all at once: write a temporary file, then rename it over the target (desktop), or
+    // remove the target first and rename the temporary file (Vita, where O_TRUNC is unreliable).
+    bool (*write_replace)(const char *path, const std::string &data){nullptr};
+};
+
+class Settings {
+public:
+    Settings();
+
+    // ---- reading -------------------------------------------------------------------------------------------------
+    // The effective value index of a key: the developer override if there is one, else the player's choice.
+    [[nodiscard]] std::uint8_t index(Key key) const noexcept {
+        return effective_[static_cast<std::size_t>(key)].load(std::memory_order_relaxed);
+    }
+    [[nodiscard]] const char *value(Key key) const noexcept;       // "smooth"
+    [[nodiscard]] const char *label(Key key) const noexcept;       // "Smooth"
+    [[nodiscard]] Cost cost(Key key) const noexcept;               // of the effective value
+    [[nodiscard]] bool is_default(Key key) const noexcept;
+    // Bumped whenever an effective value changes (or a file is loaded). A reader that remembers the last number it saw
+    // knows when to look again. Never reused within a run.
+    [[nodiscard]] std::uint32_t generation() const noexcept { return generation_.load(std::memory_order_acquire); }
+
+    // ---- the player's choice ------------------------------------------------------------------------------------
+    // Sets the stored value (what settings.txt keeps). False for an index out of range. A key under a developer
+    // override stores the value but keeps showing the override.
+    bool set(Key key, std::uint8_t index);
+    bool set(Key key, std::string_view value);
+    // By the file's key name; false for an unknown key or a value that is not allowed.
+    bool set(std::string_view name, std::string_view value);
+    // Steps through the allowed values, skipping none, wrapping round; returns the new effective index.
+    std::uint8_t step(Key key, int direction);
+    void reset_to_defaults();
+
+    // ---- overrides and availability ----------------------------------------------------------------------------
+    // Developer overrides from the environment: <PREFIX>_GFX_TEXTURE_FILTER=original. Bad values are reported once on
+    // stderr and ignored.
+    void apply_env_overrides(const char *(*env)(const char *name));
+    // A fixed override from code (the replayer's --port KEY=VALUE): like an environment variable.
+    bool override_value(Key key, std::string_view value);
+    [[nodiscard]] bool overridden(Key key) const noexcept;
+    // A feature the build or the device cannot offer yet is shown greyed with the reason (the overlay will not change
+    // it, and its effective value is the default). nullptr reason: available.
+    void set_unavailable(Key key, const char *reason) noexcept;
+    [[nodiscard]] const char *unavailable_reason(Key key) const noexcept;
+    [[nodiscard]] bool available(Key key) const noexcept { return unavailable_reason(key) == nullptr; }
+
+    // ---- restart-needed ------------------------------------------------------------------------------------------
+    // The values the running program started with (call after loading and applying overrides, once). A change to a
+    // restart-needed key after that shows as pending.
+    void mark_started();
+    [[nodiscard]] std::uint8_t started_index(Key key) const noexcept { return started_[static_cast<std::size_t>(key)]; }
+    [[nodiscard]] bool restart_pending(Key key) const noexcept;
+    [[nodiscard]] bool restart_pending() const noexcept;
+
+    // ---- files -----------------------------------------------------------------------------------------------------
+    // Applies the platform's data root, loads settings.txt if there is one (a temporary file left by an interrupted save
+    // is recovered), applies the overrides and marks the start. Returns whether a file was read.
+    bool init(const InitOptions &options);
+    void set_file_ops(const FileOps &ops) noexcept;
+    void set_path(std::string path);
+    [[nodiscard]] const std::string &path() const noexcept { return path_; }
+    bool load();
+    bool save();
+    // The same on text, for tests and tools. Unknown lines and comments are kept as they are.
+    bool load_text(std::string_view text);
+    [[nodiscard]] std::string serialize() const;
+    // True when a value changed since the last load or save and was not written yet.
+    [[nodiscard]] bool dirty() const noexcept { return dirty_; }
+
+private:
+    struct Line {
+        std::string text;       // as read (without the line end); a known key's line is rebuilt on save
+        Key key{Key::Count};    // the known key this line holds, Count for anything else
+    };
+
+    void refresh(Key key) noexcept;
+    void bump() noexcept;
+
+    std::array<std::atomic<std::uint8_t>, kKeyCount> effective_{};
+    std::array<std::uint8_t, kKeyCount> stored_{};
+    std::array<std::uint8_t, kKeyCount> override_{};
+    std::array<std::uint8_t, kKeyCount> started_{};
+    std::array<const char *, kKeyCount> unavailable_{};
+    std::array<bool, kKeyCount> overridden_{};
+    std::array<bool, kKeyCount> in_file_{};
+    std::vector<Line> lines_;
+    std::string path_;
+    FileOps ops_;
+    std::atomic<std::uint32_t> generation_{1};
+    bool dirty_{};
+};
+
+// The one instance of the program.
+[[nodiscard]] Settings &settings();
+
+// ---- typed accessors: what the renderer and the runtime call ------------------------------------------------------
+[[nodiscard]] inline HdTextures hd_textures() { return static_cast<HdTextures>(settings().index(Key::GfxHdTextures)); }
+[[nodiscard]] inline bool texture_filter_smooth() {
+    return settings().index(Key::GfxTextureFilter) == static_cast<std::uint8_t>(TextureFilter::Smooth);
+}
+[[nodiscard]] inline bool mipmaps() { return settings().index(Key::GfxMipmaps) == 0u; }
+[[nodiscard]] inline Antialiasing antialiasing() { return static_cast<Antialiasing>(settings().index(Key::GfxAntialiasing)); }
+// FXAA is a post pass and changes live; MSAA is chosen when the graphics context is made (see msaa_samples()).
+[[nodiscard]] inline bool fxaa() { return antialiasing() == Antialiasing::Fxaa; }
+// The multisampling the program started with: 0, 2 or 4 samples. It comes from the value at mark_started(), because
+// vitaGL fixes it when it is initialised; a change in the overlay shows as "restart needed" and is applied by the next
+// start. A platform that creates the GL context early (the Vita's start-up screen) calls this after Settings::init().
+[[nodiscard]] std::uint32_t msaa_samples() noexcept;
+[[nodiscard]] inline bool pixel_lighting() { return settings().index(Key::GfxPixelLighting) != 0u; }
+// 1 or 2: the scale of the off-screen glow and blur targets.
+[[nodiscard]] inline std::uint32_t effects_scale() { return settings().index(Key::GfxEffectsScale) == 0u ? 1u : 2u; }
+[[nodiscard]] inline MovieFilter movie_filter() { return static_cast<MovieFilter>(settings().index(Key::GfxMovieFilter)); }
+[[nodiscard]] inline bool hd_movies() { return settings().index(Key::GfxHdMovies) != 0u; }
+[[nodiscard]] inline FrameCap frame_cap() { return static_cast<FrameCap>(settings().index(Key::PerfFrameCap)); }
+// Microseconds between two game flips the cap allows: 16683 (60), 33366 (30), 0 (off).
+[[nodiscard]] std::uint64_t frame_cap_period_us() noexcept;
+[[nodiscard]] inline bool show_fps() { return settings().index(Key::PerfShowFps) != 0u; }
+[[nodiscard]] inline bool threaded_renderer() { return settings().index(Key::PerfThreadedRenderer) == 0u; }
+[[nodiscard]] std::uint32_t cpu_clock_mhz() noexcept;       // 444 or 500
+[[nodiscard]] std::uint32_t enemy_density_percent() noexcept;  // 100, 125, 150, 200
+[[nodiscard]] std::uint32_t view_distance_percent() noexcept;  // 100, 150, 200
+
+} // namespace portablekit::port
