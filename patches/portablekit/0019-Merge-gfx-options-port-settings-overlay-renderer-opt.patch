+    // Flat areas keep their pixels: only an edge (contrast above a floor and a share of the brightest luma) is blurred.
+    bool is_edge = (l_max - l_min) >= max(FXAA_EDGE_MIN, l_max * FXAA_EDGE_SHARE);
+    gl_FragColor = vec4(is_edge ? blurred : centre.rgb, centre.a);
+}
+)GLSL";
+
+// A bicubic (Catmull-Rom) enlargement for low-resolution pictures, 9 bilinear taps, followed by an anti-ringing clamp
+// to the range of the four texels around the sample. The result is sharper than bilinear without the halos a plain
+// bicubic or Lanczos tail leaves beside a hard edge. The source must be sampled with linear filtering and clamp to
+// edge; u_inv_size is 1/size (xy) and size (zw) of the SOURCE.
+
+
+const char *const kBicubicPostHead = R"GLSL(
+varying vec2 v_texcoord;
+uniform sampler2D u_texture;
+uniform vec4 u_inv_size;
+
+vec4 picture_tap(vec2 uv) { return texture2D(u_texture, uv); }
+)GLSL";
+
+const char *const kBicubicPostMain = R"GLSL(
+void main() { gl_FragColor = bicubic_sample(v_texcoord); }
+)GLSL";
+
+// The overlay's quads: positions in pixels from the top left, a texel and a colour per vertex. The atlas is white with
+// the glyphs' coverage in alpha (and one opaque texel for plain fills), so colour * texel is the whole shader.
+const char *const kUiVertex = R"GLSL(
+precision highp float;
+attribute vec2 a_position;
+attribute vec2 a_texcoord;
+attribute vec4 a_color;
+uniform vec2 u_screen;
+uniform vec2 u_flip;
+varying vec2 v_texcoord;
+varying vec4 v_color;
+void main() {
+    v_texcoord = a_texcoord;
+    v_color = a_color;
+    gl_Position = vec4((a_position.x / u_screen.x * 2.0 - 1.0) * u_flip.x,
+                       (1.0 - a_position.y / u_screen.y * 2.0) * u_flip.y, 0.0, 1.0);
+}
+)GLSL";
+
+const char *const kUiFragment = R"GLSL(
+varying vec2 v_texcoord;
+varying vec4 v_color;
+uniform sampler2D u_texture;
+void main() { gl_FragColor = v_color * texture2D(u_texture, v_texcoord); }
+)GLSL";
+
+} // namespace
+
+std::string fxaa_fragment_source() {
+    return std::string("#version 100\n"
+                       "#define FXAA_SPAN_MAX 8.0\n"
+                       "#define FXAA_REDUCE_MIN (1.0 / 128.0)\n"
+                       "#define FXAA_REDUCE_MUL (1.0 / 8.0)\n"
+                       "#define FXAA_EDGE_MIN 0.0625\n"
+                       "#define FXAA_EDGE_SHARE 0.125\n") +
+           kPostPrecision + kFxaaBody;
+}
+
+std::string bicubic_fragment_source() {
+    return std::string("#version 100\n") + kPostPrecision + kBicubicPostHead + kBicubicFunction + kBicubicPostMain;
+}
+
+namespace {
+// An exact area average from a larger picture: output pixel p covers source texels [p * ratio, (p + 1) * ratio).
+const char *const kResolveBody = R"GLSL(
+uniform sampler2D u_texture;
+uniform vec4 u_inv_size;
+
+void main() {
+    vec2 start = floor(gl_FragCoord.xy) * RESOLVE_RATIO;
+    vec2 stop = start + vec2(RESOLVE_RATIO);
+    vec2 first = floor(start);
+    vec4 sum = vec4(0.0);
+    float total = 0.0;
+    for (int iy = 0; iy < 3; ++iy) {
+        for (int ix = 0; ix < 3; ++ix) {
+            vec2 texel = first + vec2(float(ix), float(iy));
+            vec2 overlap = clamp(min(stop, texel + 1.0) - max(start, texel), 0.0, 1.0);
+            float weight = overlap.x * overlap.y;
+            sum += texture2D(u_texture, (texel + 0.5) * u_inv_size.xy) * weight;
+            total += weight;
+        }
+    }
+    gl_FragColor = sum / total;
+}
+)GLSL";
+} // namespace
+
+std::string resolve_fragment_source(float ratio) {
+    char define[64];
+    std::snprintf(define, sizeof define, "#define RESOLVE_RATIO %.4f\n", static_cast<double>(ratio));
+    return std::string("#version 100\n") + define + kPostPrecision + kResolveBody;
+}
+
+std::string ui_vertex_source() { return std::string("#version 100\n") + kUiVertex; }
+
+std::string ui_fragment_source() { return std::string("#version 100\n") + kPostPrecision + kUiFragment; }
+
 } // namespace portablekit::gpu::glsl
