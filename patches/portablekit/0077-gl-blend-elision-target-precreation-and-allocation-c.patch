diff --git a/tests/blend_elide_tests.cpp b/tests/blend_elide_tests.cpp
new file mode 100644
index 0000000..e4154ea
--- /dev/null
+++ b/tests/blend_elide_tests.cpp
@@ -0,0 +1,78 @@
+// When a blend can be left out (host/gpu/gl/gl_blend_elide.hpp): the decision table checked against a brute-force evaluation of
+// every 8-bit alpha, source and destination channel. No GL, no game.
+
+#include "gpu/gl/gl_blend_elide.hpp"
+
+#include <cstdio>
+
+namespace {
+
+using namespace portablekit::gpu::blend_elide;
+
+int g_failures = 0;
+
+void check(bool condition, const char *what) {
+    std::printf("%s %s\n", condition ? "ok  " : "FAIL", what);
+    if (!condition) ++g_failures;
+}
+
+const Factor kFactors[] = {Factor::Zero, Factor::One, Factor::SrcAlpha, Factor::OneMinusSrcAlpha, Factor::Other};
+const Equation kEquations[] = {Equation::Add, Equation::Subtract, Equation::ReverseSubtract, Equation::Min, Equation::Max};
+
+// The blend gives the source channel, whatever the destination, for every alpha of the range (found by trying them all).
+// Other is a factor the table does not model: it is never the source.
+bool brute_force(Equation equation, Factor source, Factor destination, Range alpha) {
+    if (source == Factor::Other || destination == Factor::Other) return false;
+    for (std::uint32_t a = alpha.low; a <= alpha.high; ++a)
+        for (std::uint32_t s = 0; s < 256u; s += 5u)
+            for (std::uint32_t d = 0; d < 256u; d += 5u)
+                if (blend_value(equation, source, destination, a, s, d) != static_cast<std::int64_t>(s) * 255) return false;
+    return true;
+}
+
+} // namespace
+
+int main() {
+    // 1. Every equation and factor pair against every range that starts or ends at an extreme, plus interior ranges: the rule
+    //    says "drop" only where trying every alpha agrees, and drops everything such a brute force finds for those ranges.
+    {
+        bool sound = true, complete = true;
+        std::uint32_t rows = 0, dropped = 0;
+        const std::uint32_t edges[] = {0u, 1u, 2u, 127u, 128u, 253u, 254u, 255u};
+        for (Equation e : kEquations)
+            for (Factor s : kFactors)
+                for (Factor d : kFactors)
+                    for (std::uint32_t low : edges)
+                        for (std::uint32_t high : edges) {
+                            if (high < low) continue;
+                            const Range range{low, high};
+                            ++rows;
+                            const bool rule = yields_source(e, s, d, range), truth = brute_force(e, s, d, range);
+                            if (rule) ++dropped;
+                            if (rule && !truth) {
+                                sound = false;
+                                std::printf("     unsound: eq %d src %d dst %d alpha %u..%u\n", static_cast<int>(e), static_cast<int>(s), static_cast<int>(d), low, high);
+                            }
+                            if (!rule && truth) {
+                                complete = false;
+                                std::printf("     missed: eq %d src %d dst %d alpha %u..%u\n", static_cast<int>(e), static_cast<int>(s), static_cast<int>(d), low, high);
+                            }
+                        }
+        check(sound, "a blend is dropped only where every alpha, source and destination gives the source");
+        check(complete, "every blend that gives the source for the whole range is found");
+        std::printf("     (%u rows, %u dropped)\n", rows, dropped);
+    }
+    // 2. The rows Infected relies on.
+    check(yields_source(Equation::Add, Factor::SrcAlpha, Factor::OneMinusSrcAlpha, {255u, 255u}), "SRC_ALPHA / ONE_MINUS_SRC_ALPHA at alpha 255");
+    check(!yields_source(Equation::Add, Factor::SrcAlpha, Factor::OneMinusSrcAlpha, {254u, 255u}), "... not when alpha may be 254");
+    check(!yields_source(Equation::Add, Factor::SrcAlpha, Factor::OneMinusSrcAlpha, {0u, 255u}), "... not for the whole range");
+    check(!yields_source(Equation::Add, Factor::SrcAlpha, Factor::OneMinusSrcAlpha, {0u, 0u}), "... not at alpha 0 (that leaves the destination)");
+    check(yields_source(Equation::Add, Factor::One, Factor::Zero, {0u, 255u}), "ONE / ZERO whatever the alpha");
+    check(!yields_source(Equation::Add, Factor::One, Factor::One, {255u, 255u}), "ONE / ONE (additive) stays");
+    check(!yields_source(Equation::ReverseSubtract, Factor::One, Factor::Zero, {255u, 255u}), "reverse subtract stays");
+    check(!yields_source(Equation::Max, Factor::One, Factor::Zero, {255u, 255u}), "max stays");
+    check(yields_source(Equation::Add, Factor::OneMinusSrcAlpha, Factor::SrcAlpha, {0u, 0u}), "ONE_MINUS_SRC_ALPHA / SRC_ALPHA at alpha 0");
+    check(!yields_source(Equation::Add, Factor::One, Factor::Other, {255u, 255u}), "an unmodelled destination factor stays");
+    std::printf("%s\n", g_failures == 0 ? "all passed" : "FAILED");
+    return g_failures == 0 ? 0 : 1;
+}
