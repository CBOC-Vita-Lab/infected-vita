diff --git a/host/gpu/gl/gl_blend_elide.hpp b/host/gpu/gl/gl_blend_elide.hpp
new file mode 100644
index 0000000..5621d0d
--- /dev/null
+++ b/host/gpu/gl/gl_blend_elide.hpp
@@ -0,0 +1,94 @@
+#pragma once
+
+// A blend that cannot change the source colour does not need to run. The GE blends SRC_ALPHA / ONE_MINUS_SRC_ALPHA for most of
+// what Infected draws (smoke, glass, the HUD, and a great deal of plain geometry whose texture and vertex colours are opaque),
+// and with an alpha of exactly 1 the result is the source colour whatever lies behind it. On a tile-based GPU (the Vita's
+// PowerVR) a draw with blending on cannot take part in hidden-surface removal and reads the destination for every fragment, so
+// the same picture made with blending off costs less. This header is the decision, with no GL and no state in it, so that a test
+// can drive every row of the table; gl_renderer.cpp feeds it the blend plan and what it knows of the draw's alpha.
+//
+// The rule is exact. A blend is dropped only when, for every alpha in the range the draw's fragments can have, the source
+// factor is exactly 1 and the destination factor exactly 0 (the equation being ADD, or SUBTRACT, which with a zero destination
+// term is the source too). The alpha range comes from gl_alpha_test.hpp (the same facts the alpha test elision uses), and only
+// its two ends count: an alpha of exactly 255 (a float of exactly 1.0 in the shader: a clamped 1.0, a product of two 1.0s)
+// or of exactly 0. Nothing in between is ever rounded into either; there is no guard, because there is nothing to guard.
+#include "gl_alpha_test.hpp"
+
+#include <cstdint>
+
+namespace portablekit::gpu::blend_elide {
+
+// The blend factors that matter here; every other factor (a colour, the destination's alpha, a constant) is Other.
+enum class Factor : std::uint8_t {
+    Zero,
+    One,
+    SrcAlpha,
+    OneMinusSrcAlpha,
+    Other,
+};
+
+// The blend equation in effect (GL_FUNC_ADD ...).
+enum class Equation : std::uint8_t {
+    Add,
+    Subtract,
+    ReverseSubtract,
+    Min,
+    Max,
+};
+
+using alpha_test::Range;
+
+// The factor is exactly 1 for every alpha of the range.
+[[nodiscard]] constexpr bool always_one(Factor factor, Range alpha) noexcept {
+    switch (factor) {
+    case Factor::One: return true;
+    case Factor::SrcAlpha: return alpha.low == 255u;
+    case Factor::OneMinusSrcAlpha: return alpha.high == 0u;
+    default: return false;
+    }
+}
+
+// The factor is exactly 0 for every alpha of the range.
+[[nodiscard]] constexpr bool always_zero(Factor factor, Range alpha) noexcept {
+    switch (factor) {
+    case Factor::Zero: return true;
+    case Factor::SrcAlpha: return alpha.high == 0u;
+    case Factor::OneMinusSrcAlpha: return alpha.low == 255u;
+    default: return false;
+    }
+}
+
+// True when blending with these factors gives the source colour for every fragment: the draw can be made with blending off.
+// REVERSE_SUBTRACT is the destination term minus the source term, MIN and MAX compare the two: none of them is the source.
+[[nodiscard]] constexpr bool yields_source(Equation equation, Factor source, Factor destination, Range alpha) noexcept {
+    if (equation != Equation::Add && equation != Equation::Subtract) return false;
+    return always_one(source, alpha) && always_zero(destination, alpha);
+}
+
+// The value a blend gives for one 8-bit source and destination channel and one 8-bit alpha, in exact integer arithmetic
+// (scaled by 255 * 255). What the test compares against the source to check the table by brute force.
+[[nodiscard]] constexpr std::int64_t blend_value(Equation equation, Factor source, Factor destination, std::uint32_t alpha,
+                                                 std::uint32_t source_channel, std::uint32_t destination_channel) noexcept {
+    const auto factor = [alpha](Factor f) -> std::int64_t {   // scaled by 255
+        switch (f) {
+        case Factor::Zero: return 0;
+        case Factor::One: return 255;
+        case Factor::SrcAlpha: return static_cast<std::int64_t>(alpha);
+        case Factor::OneMinusSrcAlpha: return 255 - static_cast<std::int64_t>(alpha);
+        default: return -1;   // not a factor the table models
+        }
+    };
+    const std::int64_t s = factor(source) * static_cast<std::int64_t>(source_channel);
+    const std::int64_t d = factor(destination) * static_cast<std::int64_t>(destination_channel);
+    // GL's MIN and MAX ignore the factors: they compare the two colours themselves.
+    const std::int64_t sc = 255 * static_cast<std::int64_t>(source_channel), dc = 255 * static_cast<std::int64_t>(destination_channel);
+    switch (equation) {
+    case Equation::Add: return s + d;
+    case Equation::Subtract: return s - d;
+    case Equation::ReverseSubtract: return d - s;
+    case Equation::Min: return sc < dc ? sc : dc;
+    default: return sc > dc ? sc : dc;
+    }
+}
+
+} // namespace portablekit::gpu::blend_elide
