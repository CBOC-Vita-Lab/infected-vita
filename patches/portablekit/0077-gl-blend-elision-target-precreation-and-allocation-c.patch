+// What vitaGL (the port's patches 0005-0007) counts, read once a second by the status line and by the renderer's warm-up check.
+// Zeros, and `vitagl_stats` false, on a platform without them.
+struct VitaglStats {
+    std::uint32_t scene_begins_display{}, scene_begins_fbo{};   // scenes begun on the display, on a framebuffer object
+    std::uint32_t scene_begin_retries{}, scene_begin_failures{};   // sceGxmBeginScene refused (retried / given up)
+    std::uint32_t scene_begin_us{}, scene_begin_us_max{};        // time in the scene begin (the whole scene_reset), total and worst
+    std::uint32_t mask_quads_begin{}, mask_quads_scissor{};      // scissor mask-update draws: at a scene's begin, at a scissor change
+    std::uint32_t depth_buffers_made{};                          // depth surfaces allocated (one per framebuffer object, at its first scene)
+    std::uint32_t depth_loads{};                                 // scenes begun with the depth force-loaded (only a STORE_DEPTH_STENCIL build)
+    std::uint32_t depth_loads_trimmed{};                         // scenes the renderer's hint spared that (or that never had one to spare)
+    std::uint32_t mask_quads_skipped{};                          // mask-update draws left out (gl_scene_mask_skip)
+    std::uint32_t shader_cache_hits{}, shader_compiles{}, shader_compile_failures{};
+    std::uint32_t alloc_failures{};                              // GPU allocations that failed the first try
+    std::uint32_t gc_pauses{}, gc_pause_us{}, gc_pause_us_max{}; // waits for the garbage collector after a failed allocation
+};
+// The hints the renderer gives vitaGL for the scene that begins next (one use).
+constexpr std::uint32_t kSceneDepthCleared = 1u;   // the scene's first operation is a clear of the whole depth buffer
+
+inline bool vitagl_stats(VitaglStats &out, bool reset) {
+#if defined(__vita__) && defined(PORTABLEKIT_VITAGL_STATS)
+    vgl_stats raw;
+    vglGetStats(&raw, reset ? GL_TRUE : GL_FALSE);
+    static_assert(sizeof(raw) == sizeof(VitaglStats), "vgl_stats (vitaGL patch 0005) and glp::VitaglStats must match field for field");
+    std::memcpy(&out, &raw, sizeof(out));
+    return true;
+#else
+    (void)out;
+    (void)reset;
+    return false;
+#endif
+}
+
+// vitaGL's wait for its garbage collector after a failed GPU allocation (patch 0005): at most this many milliseconds (0: its own
+// one second). Returns true when the library has the hook.
+inline bool set_gc_pause_ms(std::uint32_t ms) {
+#if defined(__vita__) && defined(PORTABLEKIT_VITAGL_STATS)
+    vglSetGcPauseMs(ms);
+    return true;
+#else
+    (void)ms;
+    return false;
+#endif
+}
+
+// vitaGL's scene begin (patch 0007): `depth_trim` lets the renderer's hints spare the depth load of a scene that begins with a
+// full depth clear; `mask_skip` (an experiment) leaves out the full-target mask-update draw of a scene whose scissor is the whole
+// target. True when the library has them.
+inline bool set_scene_options(bool depth_trim, bool mask_skip) {
+#if defined(__vita__) && defined(PORTABLEKIT_VITAGL_SCENE)
+    vglSceneOptions(depth_trim ? GL_TRUE : GL_FALSE, mask_skip ? GL_TRUE : GL_FALSE);
+    return true;
+#else
+    (void)depth_trim;
+    (void)mask_skip;
+    return false;
+#endif
+}
+inline void scene_hint(std::uint32_t hints) {
+#if defined(__vita__) && defined(PORTABLEKIT_VITAGL_SCENE)
+    vglSceneHint(hints);
+#else
+    (void)hints;
+#endif
+}
+
 inline void disable_dither() {
 #if !defined(__vita__)
     glDisable(GL_DITHER);
