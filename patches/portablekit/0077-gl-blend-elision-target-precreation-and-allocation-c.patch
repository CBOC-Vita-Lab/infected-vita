+
+using namespace portablekit::gpu;
+
+int g_failures = 0;
+void check(bool condition, const char *what) {
+    std::printf("%s %s\n", condition ? "ok  " : "FAIL", what);
+    if (!condition) ++g_failures;
+}
+
+constexpr std::uint32_t kDisplay = 0x04000000u;
+
+// A through-mode rectangle (a sprite) on the display target.
+DrawCall rect(float x0, float y0, float x1, float y1, std::uint32_t colour, float depth, bool blend, bool depth_write, bool alpha_test = false) {
+    DrawCall call;
+    call.primitive = PrimitiveType::Sprites;
+    call.through = true;
+    call.vertices.resize(2);
+    call.vertices[0].position = {x0, y0, depth, 1.0f};
+    call.vertices[1].position = {x1, y1, depth, 1.0f};
+    call.vertices[0].color = call.vertices[1].color = colour;
+    call.has_vertex_color = true;
+    call.target.color_address = kDisplay;
+    call.target.color_stride = 512u;
+    call.target.color_format = 3u;
+    call.viewport.scissor_x1 = 0u;
+    call.viewport.scissor_y1 = 0u;
+    call.viewport.scissor_x2 = 479u;
+    call.viewport.scissor_y2 = 271u;
+    call.depth.test_enabled = true;
+    call.depth.write_enabled = depth_write;
+    call.depth.function = 7u;   // greater or equal, the PSP's usual
+    call.blend.enabled = blend;
+    call.blend.source_factor = 2u;       // SRC_ALPHA
+    call.blend.destination_factor = 3u;  // ONE_MINUS_SRC_ALPHA
+    call.alpha_test.enabled = alpha_test;
+    call.alpha_test.function = 6u;       // greater than
+    call.alpha_test.reference = 0u;
+    return call;
+}
+
+struct Result {
+    std::vector<std::uint8_t> picture;
+    GlStats stats;
+    bool ok{};
+};
+
+// One frame: opaque red background, a blended opaque green square (alpha 255), a blended half-transparent blue square, an
+// alpha-tested half-transparent square followed by an opaque one over it.
+Result run(bool blend_elide, bool precreate) {
+    Result result;
+    portablekit::port::settings().set(portablekit::port::Key::GfxAntialiasing, static_cast<std::uint8_t>(portablekit::port::Antialiasing::Fxaa));   // FXAA chosen: its texture is made with the display target
+    GlRenderer renderer;
+    GlSettings settings = renderer.settings();
+    settings.display_scale = 1u;
+    settings.blend_elide = blend_elide;
+    settings.target_precreate = precreate;
+    settings.through_depth = true;
+    renderer.set_settings(settings);
+    std::string error;
+    if (!renderer.initialize(RendererConfig{}, error)) {
+        std::printf("note: no GL driver (%s)\n", error.c_str());
+        return result;
+    }
+    GuestMemory memory;
+    renderer.begin_display_list();
+    renderer.reset_frame_stats();
+    renderer.submit(rect(0, 0, 480, 272, 0xFF0000FFu, 100.0f, false, true), memory);          // red (ABGR: R is the low byte)
+    renderer.submit(rect(20, 20, 200, 120, 0xFF00FF00u, 200.0f, true, true), memory);         // green, alpha 255, blended
+    renderer.submit(rect(220, 20, 400, 120, 0x80FF0000u, 300.0f, true, true), memory);        // blue, alpha 128, blended
+    DrawCall tested = rect(20, 150, 200, 250, 0xFFFFFFFFu, 400.0f, false, true, true);                 // white, alpha-tested:
+    tested.vertices[0].color = 0x20FFFFFFu;                                                              // the alphas run from 32 to 255,
+    tested.alpha_test.reference = 0x80u;                                                                 // so "greater than 128" can fail
+    renderer.submit(tested, memory);
+    renderer.submit(rect(60, 170, 160, 230, 0xFF00FFFFu, 500.0f, false, true), memory);       // yellow, opaque, over it
+    renderer.flush();
+    result.stats = renderer.frame_stats();
+    renderer.present(kDisplay);
+    std::uint32_t width = 0, height = 0;
+    result.ok = renderer.read_presented(result.picture, width, height);
+    return result;
+}
+
+// A target the driver cannot make (a texture far over its size limit stands in for "no memory"): the draw is skipped, the
+// failure counted and logged, nothing crashes, and nothing is presented.
+bool failing_target_is_skipped(GlStats &stats) {
+    GlRenderer renderer;
+    GlSettings settings = renderer.settings();
+    settings.display_scale = 1000u;
+    renderer.set_settings(settings);
+    std::string error;
+    if (!renderer.initialize(RendererConfig{}, error)) return false;
+    GuestMemory memory;
+    renderer.begin_display_list();
+    renderer.reset_frame_stats();
+    renderer.submit(rect(0, 0, 480, 272, 0xFF0000FFu, 100.0f, false, true), memory);
+    renderer.submit(rect(0, 0, 480, 272, 0xFF00FF00u, 200.0f, false, true), memory);
+    renderer.flush();
+    stats = renderer.frame_stats();
+    return !renderer.present(kDisplay);
+}
+
+} // namespace
+
+int main() {
+    const Result with = run(true, true);
+    if (!with.ok) {
+        std::printf("skipped: the renderer could not start or present\n");
+        return 0;
+    }
+    const Result without = run(false, false);
+    check(without.ok, "second renderer runs");
+    check(with.picture == without.picture, "blend elision and precreation: the presented picture is byte-identical");
+    check(with.stats.blend_draws == 2u, "two draws reached the renderer with blending on");
+    check(with.stats.blend_elided == 1u, "the one with alpha 255 was drawn with blending off");
+    check(without.stats.blend_elided == 0u, "gl_blend_elide=0 keeps every blend");
+    check(with.stats.blend_elided_px >= 180u * 100u - 1u && with.stats.blend_elided_px <= 180u * 100u + 1u, "its area is counted (180 x 100 pixels)");
+    check(with.stats.alpha_early == 1u, "census: the alpha-tested draw before an opaque one over it is counted once");
+    check(with.stats.alpha_early_px == 100u * 60u, "census: the shared area is the opaque square (100 x 60)");
+    check(with.stats.late_targets == 0u && with.stats.target_failures == 0u, "no target was made late and none failed");
+    std::printf("     post textures made at target creation: %llu (without precreate: %llu)\n",
+                static_cast<unsigned long long>(with.stats.post_textures), static_cast<unsigned long long>(without.stats.post_textures));
+    check(with.stats.post_textures == 1u, "FXAA chosen: its second texture was made when the display target was");
+    check(with.stats.late_targets == 0u, "... and nothing was made late");
+    GlStats failed;
+    check(failing_target_is_skipped(failed), "a target that cannot be made: nothing is presented, nothing crashes");
+    check(failed.target_failures >= 1u && failed.skipped_draws >= 2u, "... the failure is counted and both draws are skipped");
+    std::printf("%s\n", g_failures == 0 ? "all passed" : "FAILED");
+    return g_failures == 0 ? 0 : 1;
+}
