+        set_sampler(target.post, GL_NEAREST, GL_NEAREST, GL_CLAMP_TO_EDGE, GL_CLAMP_TO_EDGE);
+        ++st().post_textures;
+        note_late_creation("FXAA texture", target.address);
+        return true;
+    }
+
+    // With a display-sized target made, or the options just asking for FXAA (or Auto, which may), make FXAA's second texture now.
