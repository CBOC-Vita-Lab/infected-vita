+    bool post_unavailable{};
+    bool ensure_post_texture(Target &target) {
+        if (target.post != 0u) return true;
+        if (post_unavailable) return false;
+        drain_gl_errors();
+        glGenTextures(1, &target.post);
+        bool ok = target.post != 0u;
+        if (ok) {
+            bind_texture(target.post);
+            glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, static_cast<GLsizei>(target.width), static_cast<GLsizei>(target.height), 0, GL_RGBA,
+                         GL_UNSIGNED_BYTE, nullptr);
+            ok = drain_gl_errors();
+        }
+        if (!ok) {
+            if (target.post != 0u) glDeleteTextures(1, &target.post);
+            target.post = 0u;
+            post_unavailable = true;
+            ++st().target_failures;
+            std::cerr << "[gl] the second texture for FXAA (" << target.width << "x" << target.height
