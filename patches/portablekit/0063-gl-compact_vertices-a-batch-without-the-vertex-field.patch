+// The compact layouts of settings.compact_vertices, for a transformed (not a through-mode) draw, whose vertex shader reads the
+// position's x, y and z, the texture coordinates and the colour, and the normal only when the draw is lit (it never reads
+// the position's w: gl_shaders.cpp uses it only for a through draw's texture rectangle). A lit vertex leaves out that w
+// (36 bytes in place of 40); an unlit one leaves out the normal as well (24). The normal, texture coordinates and colour
+// are adjacent in Vertex, so a vertex is two copies.
+constexpr std::uint32_t kUnlitStride = 24u;   // position (3 floats), texture coordinates (2), colour (4 bytes)
+constexpr std::uint32_t kLitStride = 36u;     // position (3 floats), normal (3), texture coordinates (2), colour (4 bytes)
+constexpr std::uint32_t kUnlitTexcoordOffset = 12u;
+constexpr std::uint32_t kLitNormalOffset = 12u;
+constexpr std::uint32_t kLitTexcoordOffset = 24u;
+static_assert(offsetof(Vertex, texcoord) == offsetof(Vertex, normal) + sizeof(Vertex::normal) &&
+                  offsetof(Vertex, color) == offsetof(Vertex, texcoord) + sizeof(Vertex::texcoord) &&
+                  sizeof(Vertex) == offsetof(Vertex, color) + sizeof(std::uint32_t),
+              "the compact vertices copy the normal, the texture coordinates and the colour in one piece");
+
 Matrix multiply(const Matrix &a, const Matrix &b) {
     Matrix result{};
     for (std::uint32_t column = 0; column < 4u; ++column) {
@@ -468,8 +483,12 @@ struct GlRenderer::Impl {
     bool has_presented{};
 
     // ---- the batch ---------------------------------------------------------------------------
-    BatchBuffer<Vertex> batch_vertices{16384u, 2u};          // 640 KiB chunks; batches at multiples of 80 bytes
+    // The vertices are bytes: a batch is 40-byte Vertex records, or compact ones of 36 or 24 bytes (vertex_stride_for()), as its
+    // program reads them. batch_vertex_count counts them; the stride of the batch in flight is batch_stride.
+    BatchBuffer<std::uint8_t> batch_vertices{16384u * sizeof(Vertex), 16u};   // 640 KiB chunks; batches at multiples of 16 bytes
     BatchBuffer<std::uint16_t> batch_indices{65536u, 8u};    // 128 KiB chunks; batches at multiples of 16 bytes
+    std::size_t batch_vertex_count{};
+    std::uint32_t batch_stride{sizeof(Vertex)};
     DrawState batch_state{};
     bool batch_open{};
     std::vector<std::uint16_t> index_scratch;
@@ -1622,7 +1641,7 @@ struct GlRenderer::Impl {
         const Span timing_flush(*this, &GlTimes::flush_us);
         batch_open = false;
         if (batch_indices.empty()) {
-            batch_vertices.clear();
+            clear_vertices();
             return;
         }
         const DrawState &state = batch_state;
@@ -1630,7 +1649,7 @@ struct GlRenderer::Impl {
         Target *target = find_target(state.target);
         if (program == nullptr || target == nullptr) {
             ++st().skipped_draws;
-            batch_vertices.clear();
+            clear_vertices();
             batch_indices.clear();
             return;
         }
@@ -1677,10 +1696,55 @@ struct GlRenderer::Impl {
         }
         upload_uniforms(*program, state);
