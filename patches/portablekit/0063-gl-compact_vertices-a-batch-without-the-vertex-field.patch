     // the same). Every other draw (blits, post passes, the overlay) draws from client arrays and calls client_arrays().
     bool scratch_bound{false};
+    std::uint32_t scratch_stride{0};   // the vertex stride the bound scratch attributes were set for
 
     void client_arrays() {
