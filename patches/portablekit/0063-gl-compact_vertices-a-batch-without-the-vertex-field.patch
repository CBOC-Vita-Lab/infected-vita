@@ -1802,14 +1867,26 @@ struct GlRenderer::Impl {
         const bool scratch = batch_vertices.in_scratch() && batch_indices.in_scratch() && !settings.null_draw;
         const std::uint8_t *base = reinterpret_cast<const std::uint8_t *>(batch_vertices.data());
         const void *indices = batch_indices.data();
-        const auto attributes = [](const std::uint8_t *at) {
+        const bool compact = batch_stride != sizeof(Vertex);
+        const auto attributes = [compact, stride = batch_stride](const std::uint8_t *at) {
             const auto field = [at](std::size_t offset) -> const void * {
                 return at != nullptr ? static_cast<const void *>(at + offset) : reinterpret_cast<const void *>(offset);
             };
-            glVertexAttribPointer(0u, 4, GL_FLOAT, GL_FALSE, sizeof(Vertex), field(offsetof(Vertex, position)));
-            glVertexAttribPointer(1u, 3, GL_FLOAT, GL_FALSE, sizeof(Vertex), field(offsetof(Vertex, normal)));
-            glVertexAttribPointer(2u, 2, GL_FLOAT, GL_FALSE, sizeof(Vertex), field(offsetof(Vertex, texcoord)));
-            glVertexAttribPointer(3u, 4, GL_UNSIGNED_BYTE, GL_TRUE, sizeof(Vertex), field(offsetof(Vertex, color)));
+            if (!compact) {
+                glVertexAttribPointer(0u, 4, GL_FLOAT, GL_FALSE, sizeof(Vertex), field(offsetof(Vertex, position)));
+                glVertexAttribPointer(1u, 3, GL_FLOAT, GL_FALSE, sizeof(Vertex), field(offsetof(Vertex, normal)));
+                glVertexAttribPointer(2u, 2, GL_FLOAT, GL_FALSE, sizeof(Vertex), field(offsetof(Vertex, texcoord)));
+                glVertexAttribPointer(3u, 4, GL_UNSIGNED_BYTE, GL_TRUE, sizeof(Vertex), field(offsetof(Vertex, color)));
+            } else {
+                // The position is three floats (the shader reads x, y and z). An unlit vertex has no normal, which its
+                // program does not read: the attribute points at bytes inside the vertex, so that nothing it could fetch
+                // is outside the batch.
+                const bool lit = stride == kLitStride;
+                glVertexAttribPointer(0u, 3, GL_FLOAT, GL_FALSE, stride, field(0u));
+                glVertexAttribPointer(1u, 3, GL_FLOAT, GL_FALSE, stride, field(lit ? kLitNormalOffset : kUnlitTexcoordOffset));
+                glVertexAttribPointer(2u, 2, GL_FLOAT, GL_FALSE, stride, field(lit ? kLitTexcoordOffset : kUnlitTexcoordOffset));
+                glVertexAttribPointer(3u, 4, GL_UNSIGNED_BYTE, GL_TRUE, stride, field(stride - sizeof(std::uint32_t)));
+            }
         };
         if (scratch) {
             if (!scratch_bound) {
@@ -1819,9 +1896,15 @@ struct GlRenderer::Impl {
                 }
                 glBindBuffer(GL_ARRAY_BUFFER, scratch_vbo);
                 glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, scratch_ibo);
-                attributes(nullptr);  // offsets into the bound buffer
+                scratch_stride = 0u;
                 scratch_bound = true;
             }
+            // Offsets into the bound buffer, set again only when the batch's layout is not the one they were set for (vitaGL
+            // starts a new vertex layout whenever an attribute pointer changes).
+            if (scratch_stride != batch_stride) {
+                attributes(nullptr);
+                scratch_stride = batch_stride;
+            }
             glp::buffer_use_mapped(GL_ARRAY_BUFFER, batch_vertices.data());
             glp::buffer_use_mapped(GL_ELEMENT_ARRAY_BUFFER, batch_indices.data());
             indices = nullptr;
@@ -1835,8 +1918,12 @@ struct GlRenderer::Impl {
                 glDrawElements(state.mode, static_cast<GLsizei>(batch_indices.size()), GL_UNSIGNED_SHORT, indices);
