-        batch_vertices.clear();
+        clear_vertices();
         batch_indices.clear();
     }
 
+    // The batch's vertices are done with (drawn, or dropped); the next batch starts after them.
+    void clear_vertices() {
+        batch_vertices.clear();
+        batch_vertex_count = 0u;
+    }
+
+    // The bytes a vertex takes in a batch whose program has these flags (see kUnlitStride): the decoder's 40 unless
+    // settings.compact_vertices and a transformed draw. A through draw keeps the whole vertex: its quads carry the texture
+    // rectangle in the normal and w.
+    [[nodiscard]] std::uint32_t vertex_stride_for(std::uint32_t flags) const {
+        if (!settings.compact_vertices || (flags & glsl::kThrough) != 0u) return static_cast<std::uint32_t>(sizeof(Vertex));
+        return (flags & glsl::kLight) != 0u ? kLitStride : kUnlitStride;
+    }
+
+    // Appends vertices to the batch in flight, in its layout.
+    void add_vertices(const Vertex *source, std::size_t n) {
+        if (n == 0u) return;
+        if (batch_stride == sizeof(Vertex)) {
+            batch_vertices.append(reinterpret_cast<const std::uint8_t *>(source), n * sizeof(Vertex));
+        } else {
+            // Every address here is a multiple of four (a batch starts 16-byte aligned, the strides are multiples of four, a
+            // Vertex is four-aligned), which the copies are told so that the compiler moves whole words with ldm/stm: a
+            // byte-aligned 12-byte copy was 23 instructions a vertex on the Vita's CPU, the 40-byte memcpy it replaces 19.
+            std::uint8_t *out = batch_vertices.extend(n * batch_stride);
+            const auto *in = reinterpret_cast<const std::uint8_t *>(source);
+            if (batch_stride == kLitStride) {
+                for (std::size_t i = 0; i < n; ++i, in += sizeof(Vertex), out += kLitStride) {
+                    std::uint8_t *to = static_cast<std::uint8_t *>(std::assume_aligned<4>(static_cast<void *>(out)));
+                    std::memcpy(to, std::assume_aligned<4>(in + offsetof(Vertex, position)), 3u * sizeof(float));
+                    std::memcpy(to + kLitNormalOffset, std::assume_aligned<4>(in + offsetof(Vertex, normal)),
+                                sizeof(Vertex) - offsetof(Vertex, normal));
+                }
+            } else {
+                for (std::size_t i = 0; i < n; ++i, in += sizeof(Vertex), out += kUnlitStride) {
+                    std::uint8_t *to = static_cast<std::uint8_t *>(std::assume_aligned<4>(static_cast<void *>(out)));
+                    std::memcpy(to, std::assume_aligned<4>(in + offsetof(Vertex, position)), 3u * sizeof(float));
+                    std::memcpy(to + kUnlitTexcoordOffset, std::assume_aligned<4>(in + offsetof(Vertex, texcoord)),
+                                sizeof(Vertex) - offsetof(Vertex, texcoord));
+                }
+            }
+        }
+        batch_vertex_count += n;
+    }
+    void add_vertex(const Vertex &vertex) { add_vertices(&vertex, 1u); }
+
     void apply_depth(const DrawState &state) {
         if (cache.depth_test != static_cast<int>(state.depth_test)) {
             if (state.depth_test != 0u) glEnable(GL_DEPTH_TEST);
@@ -1788,6 +1852,7 @@ struct GlRenderer::Impl {
