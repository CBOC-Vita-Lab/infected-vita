new file mode 100644
index 0000000..acbf008
--- /dev/null
+++ b/host/gpu/ge_worker.cpp
@@ -0,0 +1,235 @@
+#include "gpu/ge_worker.hpp"
+
+#include "kernel/kernel_platform.hpp"
+#include "profile.hpp"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+#if !defined(PORTABLEKIT_PLATFORM_CUSTOM)
+#include <chrono>
+#include <condition_variable>
+#include <mutex>
+#include <thread>
+#endif
+
+namespace portablekit::gpu {
+namespace {
+
+GeWorkerPlatform g_platform{};
+
+#if !defined(PORTABLEKIT_PLATFORM_CUSTOM)
+struct DefaultEvent {
+    std::mutex mutex;
+    std::condition_variable wake;
+    bool signalled = false;
+};
+
+void *default_event_create() { return new DefaultEvent(); }
+void default_event_destroy(void *event) { delete static_cast<DefaultEvent *>(event); }
+
+void default_event_wait(void *event, std::uint64_t timeout_us) {
+    auto *e = static_cast<DefaultEvent *>(event);
+    std::unique_lock<std::mutex> lock(e->mutex);
+    if (!e->signalled) e->wake.wait_for(lock, std::chrono::microseconds(timeout_us));
+    e->signalled = false;
+}
+
+void default_event_signal(void *event) {
+    auto *e = static_cast<DefaultEvent *>(event);
+    {
+        std::lock_guard<std::mutex> lock(e->mutex);
+        e->signalled = true;
+    }
+    e->wake.notify_all();
+}
+
+struct DefaultThread {
+    std::thread thread;
+};
+
+void *default_thread_start(void (*fn)(void *), void *arg, const char *, int, std::size_t) {
+    auto *t = new DefaultThread();
+    t->thread = std::thread([fn, arg] { fn(arg); });
+    return t;
+}
+
+void default_thread_join(void *handle) {
+    auto *t = static_cast<DefaultThread *>(handle);
+    if (t->thread.joinable()) t->thread.join();
+    delete t;
+}
+
+std::uint64_t default_monotonic_us() {
+    return static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(
+                                          std::chrono::steady_clock::now().time_since_epoch())
+                                          .count());
+}
+
+const bool g_default_installed = [] {
+    g_platform.event_create = &default_event_create;
+    g_platform.event_destroy = &default_event_destroy;
+    g_platform.event_wait = &default_event_wait;
+    g_platform.event_signal = &default_event_signal;
+    g_platform.thread_start = &default_thread_start;
+    g_platform.thread_join = &default_thread_join;
+    g_platform.monotonic_us = &default_monotonic_us;
+    return true;
+}();
+#endif
+
+// How long a sleeping side waits before it looks again even if nobody signalled: the signals are only an
+// optimisation, never the correctness of the ring.
+constexpr std::uint64_t kSleepUs = 2'000u;
+
+std::string lower(std::string text) {
+    for (char &c : text) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+    return text;
+}
+
+bool parse_flag(const std::string &text, bool fallback) {
+    const std::string value = lower(text);
+    if (value == "1" || value == "on" || value == "true" || value == "yes") return true;
+    if (value == "0" || value == "off" || value == "false" || value == "no") return false;
+    return fallback;
+}
+
+} // namespace
+
+void set_ge_worker_platform(const GeWorkerPlatform &platform) noexcept { g_platform = platform; }
+const GeWorkerPlatform &ge_worker_platform() noexcept { return g_platform; }
+
+bool ge_worker_setting_enabled() {
+    if (const char *value = portablekit::env("THREADED_RENDERER")) return parse_flag(value, true);
+    const char *dir = portablekit::env("DATA_DIR");
+    if (dir == nullptr || *dir == '\0') return true;
+    std::string path = dir;
+    if (path.back() != '/') path += '/';
+    path += "settings.txt";
+    std::FILE *file = std::fopen(path.c_str(), "rb");
+    if (file == nullptr) return true;
+    bool enabled = true;
+    char line[256];
+    while (std::fgets(line, sizeof(line), file) != nullptr) {
+        std::string text = line;
+        while (!text.empty() && (text.back() == '\n' || text.back() == '\r' || text.back() == ' ')) text.pop_back();
+        const std::size_t equals = text.find('=');
+        if (equals == std::string::npos) continue;
+        std::string key = text.substr(0, equals);
+        while (!key.empty() && key.back() == ' ') key.pop_back();
+        if (key != "perf.threaded_renderer") continue;
+        std::size_t begin = equals + 1u;
+        while (begin < text.size() && text[begin] == ' ') ++begin;
+        enabled = parse_flag(text.substr(begin), true);
+    }
+    std::fclose(file);
+    return enabled;
+}
+
+GeWorker::GeWorker(std::uint32_t capacity)
+    : capacity_(std::max(capacity, 16u)), slots_(std::make_unique<Slot[]>(std::max(capacity, 16u))) {
+    if (g_platform.event_create != nullptr) {
+        work_event_ = g_platform.event_create();
+        space_event_ = g_platform.event_create();
+    }
+}
+
+GeWorker::~GeWorker() {
+    if (g_platform.event_destroy != nullptr) {
+        if (work_event_ != nullptr) g_platform.event_destroy(work_event_);
+        if (space_event_ != nullptr) g_platform.event_destroy(space_event_);
+    }
+}
+
+void GeWorker::post(Job job) {
+    const std::uint64_t tail = tail_.load(std::memory_order_relaxed);
+    while (tail - head_.load(std::memory_order_acquire) >= capacity_) {
+        // Full: the GE thread is behind by a whole ring. Wait for it in host time.
+        if (g_platform.event_wait != nullptr && space_event_ != nullptr) g_platform.event_wait(space_event_, kSleepUs);
+    }
+    slots_[tail % capacity_].job = std::move(job);
+    tail_.store(tail + 1u, std::memory_order_release);
+    posted_.store(tail + 1u, std::memory_order_release);
+    if (g_platform.event_signal != nullptr && work_event_ != nullptr) g_platform.event_signal(work_event_);
+}
+
+void GeWorker::wait_completed(std::uint64_t target) {
+    while (completed() < target) {
+        if (g_platform.event_wait != nullptr && space_event_ != nullptr)
+            g_platform.event_wait(space_event_, kSleepUs);
+    }
+}
+
+void GeWorker::nap_on_ge_thread(std::uint64_t us) {
+    if (g_platform.event_wait != nullptr && work_event_ != nullptr) g_platform.event_wait(work_event_, us);
+}
+
+void GeWorker::request_stop() noexcept {
+    stop_.store(true, std::memory_order_release);
+    if (g_platform.event_signal != nullptr && work_event_ != nullptr) g_platform.event_signal(work_event_);
+}
+
+void GeWorker::run_loop() {
+    for (;;) {
+        const std::uint64_t head = head_.load(std::memory_order_relaxed);
+        if (head == tail_.load(std::memory_order_acquire)) {
+            if (stop_.load(std::memory_order_acquire) && head == tail_.load(std::memory_order_acquire)) return;
+            if (g_platform.event_wait != nullptr && work_event_ != nullptr) g_platform.event_wait(work_event_, kSleepUs);
+            continue;
+        }
+        Slot &slot = slots_[head % capacity_];
+        const std::uint64_t start = g_platform.monotonic_us != nullptr ? g_platform.monotonic_us() : 0u;
+        if (slot.job) slot.job();
+        slot.job = nullptr;
+        if (g_platform.monotonic_us != nullptr)
+            busy_us_.fetch_add(g_platform.monotonic_us() - start, std::memory_order_relaxed);
+        head_.store(head + 1u, std::memory_order_release);
+        completed_.store(head + 1u, std::memory_order_release);
+        // The guest may be waiting for this job (sceGeDrawSync, a full ring, a frame in flight): wake it.
+        if (g_platform.event_signal != nullptr && space_event_ != nullptr) g_platform.event_signal(space_event_);
+        if (wake_hook_ != nullptr) wake_hook_();
+    }
+}
+
+namespace {
+struct GuestThreadArgs {
+    void (*fn)(void *);
+    void *arg;
+    GeWorker *worker;
+};
+
+void guest_thread_main(void *pointer) {
+    auto *args = static_cast<GuestThreadArgs *>(pointer);
+    args->fn(args->arg);
+    args->worker->request_stop();
+}
+} // namespace
+
+bool GeWorker::run_with_guest_thread(void (*guest)(void *), void *arg, int guest_core, std::size_t guest_stack_bytes,
+                                     int ge_core) {
+    if (g_platform.thread_start == nullptr || g_platform.thread_join == nullptr || work_event_ == nullptr) return false;
+    stop_.store(false, std::memory_order_release);
+    GuestThreadArgs args{guest, arg, this};
+    if (g_platform.pin_current_thread != nullptr) g_platform.pin_current_thread(ge_core);
+    active_.store(true, std::memory_order_release);
+    void *thread = g_platform.thread_start(&guest_thread_main, &args, "infected-guest", guest_core, guest_stack_bytes);
+    if (thread == nullptr) {
+        active_.store(false, std::memory_order_release);
+        return false;
+    }
+    run_loop();
+    g_platform.thread_join(thread);
+    active_.store(false, std::memory_order_release);
+    return true;
+}
+
+GeWorker &ge_worker() {
+    static GeWorker worker;
+    return worker;
+}
+
+} // namespace portablekit::gpu
diff --git a/host/gpu/ge_worker.hpp b/host/gpu/ge_worker.hpp
new file mode 100644
index 0000000..ce4a51a
--- /dev/null
+++ b/host/gpu/ge_worker.hpp
@@ -0,0 +1,119 @@
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <memory>
+
+// The GE thread: display lists are walked and drawn on a thread of their own, fed by a single-producer ring, while the
+// guest runs on another one. The guest side posts closures (a list run, a present, a CPU-written picture); the GE thread
+// runs them in order, so it is the only thread that ever touches the GeState and the renderer (and so the GL context).
+//
+//   guest executor (core 0)                         GE thread (core 1, the thread that created the GL context)
+//   post(job) -----------------------------------> run job, job, job ...
+//   kernel waits (sceGeDrawSync, a full queue)  <-- completed() counter, kernel_signal_event(), host interrupts
+//
+// Ordering is the whole contract: jobs run in the order they were posted, one at a time. What the guest may rely on is the
+// counters: completed() reaches the value posted() had when the guest asked. The guest must not change what a posted job
+// reads (display lists, vertex data, textures) before it has synchronised, exactly as on the PSP; sceGeDrawSync / ListSync
+// and the finish callback are the synchronisation points.
+//
+// Nothing here uses a mutex: the ring is wait-free for the one producer and the one consumer, the sleeping is on a host
+// event the platform provides (a condition variable by default, a SceKernelEventFlag on the Vita), and the guest thread is
+// started through the same seam.
+namespace portablekit::gpu {
+
+// What the worker needs from the machine. A platform layer that has its own primitives (the Vita's) defines
+// PORTABLEKIT_PLATFORM_CUSTOM when it compiles pk_runtime, so the default (std::thread, a condition variable) is left
+// out, and calls set_ge_worker_platform() before the first use.
+struct GeWorkerPlatform {
+    void *(*event_create)() = nullptr;                         // auto-reset event
+    void (*event_destroy)(void *event) = nullptr;
+    // Sleeps for at most timeout_us; returns early once signalled since the last return (a signal that came before the
+    // sleep is not lost).
+    void (*event_wait)(void *event, std::uint64_t timeout_us) = nullptr;
+    void (*event_signal)(void *event) = nullptr;               // any thread
+    // Runs fn(arg) on a new thread pinned to `core` (-1: any) with a stack of `stack_bytes`; returns a handle or nullptr.
+    void *(*thread_start)(void (*fn)(void *), void *arg, const char *name, int core, std::size_t stack_bytes) = nullptr;
+    void (*thread_join)(void *handle) = nullptr;
+    // Pins the calling thread to `core` (the GE thread: core 1 on the Vita). Optional.
+    void (*pin_current_thread)(int core) = nullptr;
+    // Microseconds on a monotonic clock, for the statistics. Optional.
+    std::uint64_t (*monotonic_us)() = nullptr;
+};
+
+void set_ge_worker_platform(const GeWorkerPlatform &platform) noexcept;
+[[nodiscard]] const GeWorkerPlatform &ge_worker_platform() noexcept;
+
+// The setting: <PREFIX>_THREADED_RENDERER (0/1/on/off) if set, else `perf.threaded_renderer` in settings.txt in the data
+// root (<PREFIX>_DATA_DIR; the file's `key=value` lines, unknown keys ignored), else on.
+[[nodiscard]] bool ge_worker_setting_enabled();
+
+class GeWorker {
+public:
+    using Job = std::function<void()>;
+
+    explicit GeWorker(std::uint32_t capacity = 1024u);
+    ~GeWorker();
+    GeWorker(const GeWorker &) = delete;
+    GeWorker &operator=(const GeWorker &) = delete;
+
+    // Runs `guest(arg)` on a new thread (guest_core, guest_stack_bytes) and this worker's loop on the calling thread
+    // (pinned to ge_core), which has to be the thread that owns the GL context. Returns when `guest` has returned and the
+    // jobs it posted have run. False if the thread could not be started (nothing ran, active() stays false).
+    bool run_with_guest_thread(void (*guest)(void *), void *arg, int guest_core, std::size_t guest_stack_bytes,
+                               int ge_core);
+
+    // True while run_with_guest_thread() is running: the HLE posts jobs instead of running them where it stands.
+    [[nodiscard]] bool active() const noexcept { return active_.load(std::memory_order_acquire); }
+
+    // ---- producer: the guest thread ------------------------------------------------------------------------------
+    // Queues a job. Sleeps (host time) while the ring is full.
+    void post(Job job);
+    [[nodiscard]] std::uint64_t posted() const noexcept { return posted_.load(std::memory_order_acquire); }
+    [[nodiscard]] std::uint64_t completed() const noexcept { return completed_.load(std::memory_order_acquire); }
+    // Blocks the calling (guest) thread in host time until completed() >= target. For shutdown and tests; the kernel's
+    // waits poll completed() instead (Kernel::wait_host).
+    void wait_completed(std::uint64_t target);
+
+    // ---- statistics ----------------------------------------------------------------------------------------------
+    // Microseconds the GE thread spent running jobs (with set_clock, else 0).
+    [[nodiscard]] std::uint64_t busy_us() const noexcept { return busy_us_.load(std::memory_order_relaxed); }
+    // Called by the GE thread after a job posted with `wake` set has run: wakes an idle kernel (kernel_signal_event).
+    void set_wake_hook(void (*hook)()) noexcept { wake_hook_ = hook; }
+
+    // ---- consumer: the GE thread ---------------------------------------------------------------------------------
+    // The loop of run_with_guest_thread(), for a caller that starts the guest thread itself (the replay test): runs
+    // jobs until request_stop() was called and the ring is empty.
+    void run_loop();
+    void request_stop() noexcept;
+    // The GE thread sleeps for up to `us` (a post wakes it early): for a wait that is not on the ring, such as a host
+    // mailbox that is full.
+    void nap_on_ge_thread(std::uint64_t us);
+    // Marks the worker active for a caller that runs run_loop() itself.
+    void set_active(bool active) noexcept { active_.store(active, std::memory_order_release); }
+
+private:
+    struct Slot {
+        Job job;
+    };
+
+    std::uint32_t capacity_;
+    std::unique_ptr<Slot[]> slots_;
+    std::atomic<std::uint64_t> head_{0u};      // consumer: next to run
+    std::atomic<std::uint64_t> tail_{0u};      // producer: next to fill
+    std::atomic<std::uint64_t> posted_{0u};
+    std::atomic<std::uint64_t> completed_{0u};
+    std::atomic<bool> active_{false};
+    std::atomic<bool> stop_{false};
+    std::atomic<std::uint64_t> busy_us_{0u};
+    void *work_event_ = nullptr;      // the consumer sleeps here when the ring is empty
+    void *space_event_ = nullptr;     // the producer sleeps here when the ring is full
+    void (*wake_hook_)() = nullptr;
+};
+
+// The one worker of the process.
+[[nodiscard]] GeWorker &ge_worker();
+
+} // namespace portablekit::gpu
