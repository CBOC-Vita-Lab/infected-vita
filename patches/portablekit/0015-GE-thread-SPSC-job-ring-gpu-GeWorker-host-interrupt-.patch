+bool Kernel::post_interrupt_from_host(std::uint32_t function, const GuestCallArguments &arguments,
+                                      std::uint32_t argument_count) noexcept {
+    const std::uint32_t tail = host_interrupt_tail_.load(std::memory_order_relaxed);
