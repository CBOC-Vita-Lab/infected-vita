 }
 
+// The synchronous path: the list runs where the guest asked for it.
+void run_ge_list(Runtime &rt, std::uint32_t id) {
+    auto found = media().ge_lists.find(id);
+    if (found == media().ge_lists.end()) return;
+    GeList &list = found->second;
+    const GeCallback *callback = nullptr;
+    if (const auto cb = media().ge_callbacks.find(list.callback); cb != media().ge_callbacks.end())
+        callback = &cb->second;
+    execute_list(rt, id, list, callback);
+}
+
+// The threaded path: what the guest knows now (the list, its callback) goes to the GE thread, which runs it in order with
+// everything else it was given. `stall_only` is an update of the stall address of a list it already has.
+void post_ge_list(Runtime &rt, std::uint32_t id, const GeList &list, bool stall_only) {
+    GeCallback callback{};
