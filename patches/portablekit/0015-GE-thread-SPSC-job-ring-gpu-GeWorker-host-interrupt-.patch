+
+void Kernel::drain_host_interrupts() {
+    std::uint32_t head = host_interrupt_head_.load(std::memory_order_relaxed);
+    const std::uint32_t tail = host_interrupt_tail_.load(std::memory_order_acquire);
+    if (head == tail) return;
+    for (; head != tail; ++head) {
+        const HostInterrupt &slot = host_interrupts_[head % kHostInterruptSlots];
+        InterruptCall call{};
+        call.function = slot.function;
+        call.arguments = slot.arguments;
+        call.argument_count = slot.argument_count;
+        pending_interrupts_.push_back(std::move(call));
+    }
+    host_interrupt_head_.store(head, std::memory_order_release);
