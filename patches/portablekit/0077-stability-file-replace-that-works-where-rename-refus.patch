diff --git a/host/audio/underrun_fade.hpp b/host/audio/underrun_fade.hpp
new file mode 100644
index 0000000..41856d8
--- /dev/null
+++ b/host/audio/underrun_fade.hpp
@@ -0,0 +1,124 @@
+#pragma once
+
+// What happens at a gap in the stream the device is playing, and how much margin the stream keeps ahead of the device.
+//
+// UnderrunFader: when the device asks for more frames than the producers have written, the rest used to be zeros, a step from
+// the last sample to silence, which clicks. The fader holds the last sample and runs it down to zero over ~2 ms, and brings the
+// next audio in from zero over the same time. A gap that ends within 250 ms of audio counts as an underrun (a longer one is a
+// pause, a menu, the end of a track).
+//
+// Cushion: the margin a restarted producer starts ahead of the device. It starts at the base, grows 20 ms with each underrun up to a
+// cap, and goes back down 20 ms after every 30 s without one.
+//
+// Header only, no platform calls: the sink uses it and tests/audio_underrun_tests.cpp runs the same code.
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+
+namespace portablekit::audio {
+
+class UnderrunFader {
+public:
+    static constexpr std::uint32_t kRampFrames = 88;          // 2 ms at 44100 Hz
+    static constexpr std::uint64_t kMaxGapFrames = 11025;     // 250 ms: a longer gap is a pause, not an underrun
+
+    // out[0 .. valid) holds audio, out[valid .. frames) is zero. Interleaved stereo s16.
+    void process(std::int16_t *out, std::size_t frames, std::size_t valid) {
+        valid = std::min(valid, frames);
+        if (valid > 0) {
+            if (in_gap_) {
+                if (had_audio_ && gap_frames_ > 0 && gap_frames_ < kMaxGapFrames) {
+                    ++underruns_;
+                    underrun_frames_ += gap_frames_;
+                    ++pending_underruns_;
+                }
+                // Fade in from the silence the device was left with.
+                const std::size_t n = apply_ ? std::min<std::size_t>(valid, kRampFrames) : 0u;
+                for (std::size_t i = 0; i < n; ++i) {
+                    const std::int32_t gain = static_cast<std::int32_t>(i + 1);   // 1..ramp
+                    out[2 * i] = static_cast<std::int16_t>((out[2 * i] * gain) / static_cast<std::int32_t>(kRampFrames + 1));
+                    out[2 * i + 1] = static_cast<std::int16_t>((out[2 * i + 1] * gain) / static_cast<std::int32_t>(kRampFrames + 1));
+                }
+                in_gap_ = false;
+                gap_frames_ = 0;
+            }
+            for (std::size_t i = 0; i < valid && !had_audio_; ++i)
+                if (out[2 * i] != 0 || out[2 * i + 1] != 0) had_audio_ = true;
+            last_[0] = out[2 * (valid - 1)];
+            last_[1] = out[2 * (valid - 1) + 1];
+        }
+        if (valid < frames) {
+            const std::size_t gap = frames - valid;
+            if (!in_gap_) {
+                // The gap starts here: hold the last sample and run it to zero.
+                const std::size_t n = apply_ ? std::min<std::size_t>(gap, kRampFrames) : 0u;
+                for (std::size_t i = 0; i < n; ++i) {
+                    const std::int32_t gain = static_cast<std::int32_t>(kRampFrames - i);   // ramp..1
+                    out[2 * (valid + i)] = static_cast<std::int16_t>((last_[0] * gain) / static_cast<std::int32_t>(kRampFrames + 1));
+                    out[2 * (valid + i) + 1] = static_cast<std::int16_t>((last_[1] * gain) / static_cast<std::int32_t>(kRampFrames + 1));
+                }
+                in_gap_ = true;
+                gap_frames_ = 0;
+            }
+            gap_frames_ += gap;
+            if (gap_frames_ >= kMaxGapFrames) had_audio_ = false;   // a pause: the audio that follows starts a new stretch
+        }
+    }
+
+    // false: only count (the fade is switched off), the samples are left as they are.
+    void set_apply(bool apply) noexcept { apply_ = apply; }
+    [[nodiscard]] bool apply_enabled() const noexcept { return apply_; }
+    [[nodiscard]] std::uint64_t underruns() const noexcept { return underruns_; }
+    [[nodiscard]] std::uint64_t underrun_frames() const noexcept { return underrun_frames_; }
+    // The underruns found since the last call (for the cushion).
+    std::uint32_t take_new_underruns() noexcept {
+        const std::uint32_t n = pending_underruns_;
+        pending_underruns_ = 0;
+        return n;
+    }
+
+private:
+    std::int16_t last_[2]{0, 0};
+    bool apply_{true};
+    bool in_gap_{false};
+    bool had_audio_{false};
+    std::uint64_t gap_frames_{0};
+    std::uint64_t underruns_{0};
+    std::uint64_t underrun_frames_{0};
+    std::uint32_t pending_underruns_{0};
+};
+
+class Cushion {
+public:
+    static constexpr std::uint64_t kCalmFrames = 30ull * 44100ull;   // 30 s
+
+    Cushion() = default;
+    Cushion(std::uint32_t base, std::uint32_t step, std::uint32_t cap) : base_(base), current_(base), step_(step), cap_(cap) {}
+
+    void on_underrun() {
+        current_ = std::min(cap_, current_ + step_);
+        calm_ = 0;
+    }
+    // `frames` of audio went by (any number of them).
+    void advance(std::uint64_t frames) {
+        calm_ += frames;
+        while (calm_ >= kCalmFrames && current_ > base_) {
+            current_ = std::max(base_, current_ - std::min(step_, current_ - base_));
+            calm_ -= kCalmFrames;
+        }
+        if (current_ == base_ && calm_ > kCalmFrames) calm_ = kCalmFrames;
+    }
+    [[nodiscard]] std::uint32_t frames() const noexcept { return current_; }
+    [[nodiscard]] std::uint32_t base() const noexcept { return base_; }
+
+private:
+    std::uint32_t base_{3072};
+    std::uint32_t current_{3072};
+    std::uint32_t step_{882};   // 20 ms
+    std::uint32_t cap_{5632};   // 128 ms; the sink's ring holds 8192 frames
+    std::uint64_t calm_{0};
+};
+
+} // namespace portablekit::audio
diff --git a/host/file_replace.hpp b/host/file_replace.hpp
new file mode 100644
index 0000000..28ed4f1
--- /dev/null
+++ b/host/file_replace.hpp
@@ -0,0 +1,81 @@
+#pragma once
+
+// Replacing a file that already exists, where rename() may refuse to.
+//
+// A writer puts the new contents in `<target>.tmp` and renames that over the target, so an interrupted write never leaves a half
+// file in place of a good one. POSIX rename() replaces the target in one step, but sceIoRename on the PS Vita (and rename() on
+// Windows) refuses when the target exists, and the old fix (remove the target, then rename) leaves a window with no file at all.
+//
+// replace() therefore does:
+//   1. rename(temp, target). Done when it works.
+//   2. When it fails and the target exists: rename(target, target.bak), rename(temp, target), remove(target.bak).
+//      A failure after the first of those puts the old file back.
+// recover() is for the start of the next run: when the target is missing and `target.bak` is there (the run was killed between the
+// two renames), the old file is put back, so the player has the last good save instead of none.
+//
+// The file system calls go through Ops so a test can make rename() refuse an existing target, or fail at a chosen step.
+
+#include <cstdio>
+#include <filesystem>
+#include <string>
+#include <system_error>
+
+namespace portablekit::filereplace {
+
+struct Ops {
+    bool (*rename)(const char *from, const char *to){nullptr};   // true when `from` is now `to`
+    bool (*remove)(const char *path){nullptr};
+    bool (*exists)(const char *path){nullptr};
+};
+
+inline bool default_rename(const char *from, const char *to) { return std::rename(from, to) == 0; }
+inline bool default_remove(const char *path) { return std::remove(path) == 0; }
+inline bool default_exists(const char *path) {
+    std::error_code ec;
+    return std::filesystem::exists(path, ec);
+}
+
+inline const Ops &system_ops() {
+    static const Ops ops{&default_rename, &default_remove, &default_exists};
+    return ops;
+}
+
+// The ops in use: the system's unless a test installed its own (nullptr puts the system's back).
+inline const Ops *&override_slot() {
+    static const Ops *slot = nullptr;
+    return slot;
+}
+inline void set_ops_for_test(const Ops *ops) { override_slot() = ops; }
+inline const Ops &ops() { return override_slot() != nullptr ? *override_slot() : system_ops(); }
+
+enum class Result {
+    Renamed,            // the plain rename worked
+    ReplacedViaBackup,  // the rename refused an existing target; the old file went to .bak, the new one in, the .bak was deleted
+    Failed,             // the target is as it was; the temporary file is still there (the caller removes it)
+};
+
+inline Result replace(const Ops &o, const std::string &temp, const std::string &target) {
+    if (o.rename(temp.c_str(), target.c_str())) return Result::Renamed;
+    if (!o.exists(target.c_str())) return Result::Failed;   // not "the target is in the way": nothing more to try
+    const std::string backup = target + ".bak";
+    if (o.exists(backup.c_str())) o.remove(backup.c_str());   // a leftover of an earlier run
+    if (!o.rename(target.c_str(), backup.c_str())) return Result::Failed;
+    if (!o.rename(temp.c_str(), target.c_str())) {
+        (void)o.rename(backup.c_str(), target.c_str());       // put the old one back
+        return Result::Failed;
+    }
+    o.remove(backup.c_str());
+    return Result::ReplacedViaBackup;
+}
+inline Result replace(const std::string &temp, const std::string &target) { return replace(ops(), temp, target); }
+
+// True when the target was missing and `target.bak` has been put back in its place.
+inline bool recover(const Ops &o, const std::string &target) {
+    if (o.exists(target.c_str())) return false;
+    const std::string backup = target + ".bak";
+    if (!o.exists(backup.c_str())) return false;
+    return o.rename(backup.c_str(), target.c_str());
+}
+inline bool recover(const std::string &target) { return recover(ops(), target); }
+
+} // namespace portablekit::filereplace
