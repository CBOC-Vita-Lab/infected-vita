+    // Suspend and resume. After the console slept the handle of a file on the memory card can be stale: a read fails (or, worse,
+    // answers wrongly). read() reopens the file and retries once when a read comes up short, and notify_resumed() makes the
+    // next read reopen it first. reopen_total() counts both kinds for the status line.
+    static void notify_resumed() noexcept { resume_pending_.store(true, std::memory_order_relaxed); }
+    [[nodiscard]] static std::uint64_t reopen_total() noexcept { return reopen_total_.load(std::memory_order_relaxed); }
+    [[nodiscard]] static std::uint64_t reopen_failed_total() noexcept { return reopen_failed_.load(std::memory_order_relaxed); }
+    // Closes the handle as a stale one would be (for tests): the next read has to heal it.
+    void close_handle_for_test() { file_.close(); }
+
 private:
     void scan_directory(std::uint32_t lba, std::uint32_t size, const std::string &prefix, int depth);
     [[nodiscard]] static std::string normalize(std::string path);
 
+    bool reopen();
+    std::size_t read_once(std::uint64_t offset, std::uint8_t *output, std::size_t count);
+
+    std::filesystem::path path_;
     std::ifstream file_;
+    static inline std::atomic<bool> resume_pending_{false};
+    static inline std::atomic<std::uint64_t> reopen_total_{0};
+    static inline std::atomic<std::uint64_t> reopen_failed_{0};
     std::uint64_t size_bytes_{};
     std::map<std::string, Entry> entries_;
 };
