+
+// A rename that refuses an existing target (the Vita's sceIoRename), and one that dies after the old file went to .bak.
+namespace refuse {
+int renames_until_fail = -1;   // -1: never
+bool exists(const char *p) { return std::filesystem::exists(p); }
+bool remove(const char *p) { return std::remove(p) == 0; }
+bool rename_no_replace(const char *from, const char *to) {
+    if (renames_until_fail == 0) return false;
+    if (renames_until_fail > 0) --renames_until_fail;
+    if (std::filesystem::exists(to)) return false;
+    return std::rename(from, to) == 0;
+}
+const portablekit::filereplace::Ops ops{&rename_no_replace, &remove, &exists};
+} // namespace refuse
+
+void test_save_replace_when_rename_refuses() {
