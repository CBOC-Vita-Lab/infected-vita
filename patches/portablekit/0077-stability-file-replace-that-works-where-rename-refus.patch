diff --git a/tests/audio_underrun_tests.cpp b/tests/audio_underrun_tests.cpp
new file mode 100644
index 0000000..bb16d0b
--- /dev/null
+++ b/tests/audio_underrun_tests.cpp
@@ -0,0 +1,115 @@
+// The underrun fade and the adaptive cushion (host/audio/underrun_fade.hpp): no step at a gap, counted only when a gap is short,
+// and the cushion grows after real underruns and comes back down when it is calm.
+#include "audio/underrun_fade.hpp"
+
+#include <cmath>
+#include <cstdio>
+#include <vector>
+
+namespace {
+int g_failures = 0;
+void check(bool c, const char *what) {
+    std::printf("%s %s\n", c ? "ok  " : "FAIL", what);
+    if (!c) ++g_failures;
+}
+using namespace portablekit::audio;
+
+// A loud tone of `frames` frames, starting at phase `at`.
+std::vector<std::int16_t> tone(std::size_t frames, std::size_t at) {
+    std::vector<std::int16_t> v(frames * 2);
+    for (std::size_t i = 0; i < frames; ++i)
+        v[2 * i] = v[2 * i + 1] = static_cast<std::int16_t>(20000.0 * std::sin(0.05 * static_cast<double>(at + i)));
+    return v;
+}
+int max_step(const std::vector<std::int16_t> &v) {
+    int worst = 0;
+    for (std::size_t i = 1; i < v.size() / 2; ++i) worst = std::max(worst, std::abs(v[2 * i] - v[2 * (i - 1)]));
+    return worst;
+}
+} // namespace
+
+int main() {
+    // A continuous stream is left alone.
+    {
+        UnderrunFader f;
+        auto a = tone(1024, 0);
+        const auto ref = a;
+        f.process(a.data(), 1024, 1024);
+        check(a == ref && f.underruns() == 0, "a full buffer passes unchanged");
+    }
+    // A 300-frame hole in the middle of the stream (device wanted 1024, 724 written; the next buffer is complete again).
+    {
+        UnderrunFader f;
+        std::vector<std::int16_t> stream;
+        auto a = tone(1024, 0);
+        f.process(a.data(), 1024, 1024);
+        stream.insert(stream.end(), a.begin(), a.end());
+        auto b = tone(1024, 1024);
+        std::fill(b.begin() + 2 * 724, b.end(), 0);   // only 724 frames were there
+        f.process(b.data(), 1024, 724);
+        stream.insert(stream.end(), b.begin(), b.end());
+        auto c = tone(1024, 2048);
+        f.process(c.data(), 1024, 1024);
+        stream.insert(stream.end(), c.begin(), c.end());
+        // Without the fade the step at 724 is the tone's own value (up to 20000).
+        check(max_step(stream) < 2000, "no sample-to-sample step at the gap or after it is larger than the tone's own slope plus the ramp");
+        check(std::abs(b[2 * (724 + 87)]) < 400 && b[2 * 900] == 0 && std::abs(b[2 * 724]) > std::abs(b[2 * 790]) / 2, "the held sample runs down to zero inside the gap");
+        check(f.underruns() == 1 && f.underrun_frames() == 300, "a gap of 300 frames that ended is one underrun of 300 frames");
+        check(c[0] == 0 || std::abs(c[0]) < 400, "the audio after the gap fades in from silence");
+    }
+    // A pause (one second of nothing) is not an underrun.
+    {
+        UnderrunFader f;
+        auto a = tone(1024, 0);
+        f.process(a.data(), 1024, 1024);
+        for (int i = 0; i < 44; ++i) {
+            std::vector<std::int16_t> z(2048, 0);
+            f.process(z.data(), 1024, 0);
+        }
+        auto b = tone(1024, 0);
+        f.process(b.data(), 1024, 1024);
+        check(f.underruns() == 0, "a gap of a second is a pause, not an underrun");
+    }
+    // Silence before any audio is not an underrun either.
+    {
+        UnderrunFader f;
+        std::vector<std::int16_t> z(2048, 0);
+        f.process(z.data(), 1024, 0);
+        auto b = tone(1024, 0);
+        f.process(b.data(), 1024, 1024);
+        check(f.underruns() == 0, "silence before the first sound is not an underrun");
+    }
+    // A gap longer than one ramp, over several buffers.
+    {
+        UnderrunFader f;
+        auto a = tone(1024, 0);
+        f.process(a.data(), 1024, 1024);
+        std::vector<std::int16_t> z(2048, 0);
+        f.process(z.data(), 1024, 0);
+        f.process(z.data(), 1024, 0);
+        auto b = tone(1024, 0);
+        f.process(b.data(), 1024, 1024);
+        check(f.underruns() == 1 && f.underrun_frames() == 2048, "a two-buffer gap counts once, with its length");
+        check(f.take_new_underruns() == 1 && f.take_new_underruns() == 0, "take_new_underruns reports each underrun once");
+    }
+    // The cushion.
+    {
+        Cushion c(3072, 882, 5632);
+        check(c.frames() == 3072, "the cushion starts at its base");
+        c.on_underrun();
+        check(c.frames() == 3954, "one underrun adds 20 ms");
+        for (int i = 0; i < 10; ++i) c.on_underrun();
+        check(c.frames() == 5632, "the cushion stops at its cap");
+        c.advance(29ull * 44100);
+        check(c.frames() == 5632, "29 s of calm change nothing");
+        c.advance(2ull * 44100);
+        check(c.frames() == 5632 - 882, "30 s of calm take one step off");
+        c.on_underrun();
+        c.advance(29ull * 44100);
+        check(c.frames() == 5632, "an underrun restarts the calm period");
+        c.advance(30ull * 44100 * 10);
+        check(c.frames() == 3072, "enough calm brings it back to the base, not below");
+    }
+    std::printf("%d failure(s)\n", g_failures);
+    return g_failures == 0 ? 0 : 1;
+}
diff --git a/tests/iso_image_tests.cpp b/tests/iso_image_tests.cpp
new file mode 100644
index 0000000..fea5fca
--- /dev/null
+++ b/tests/iso_image_tests.cpp
@@ -0,0 +1,70 @@
+// IsoImage on a tiny synthetic ISO9660 image (made here, no game data): reads, and the self-healing of a stale handle after a
+// suspend (a failed read reopens the file once and retries; notify_resumed() reopens before the next read).
+
+#include "kernel/iso_image.hpp"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <vector>
+
+namespace {
+int g_failures = 0;
+void check(bool condition, const char *what) {
+    std::printf("%s %s\n", condition ? "ok  " : "FAIL", what);
+    if (!condition) ++g_failures;
+}
+void put32(std::vector<std::uint8_t> &image, std::size_t at, std::uint32_t v) {
+    for (int i = 0; i < 4; ++i) image[at + i] = static_cast<std::uint8_t>(v >> (8 * i));
+}
+} // namespace
+
+int main() {
+    using portablekit::IsoImage;
+    constexpr std::size_t S = IsoImage::kSectorSize;
+    std::vector<std::uint8_t> image(20 * S, 0);
+    std::uint8_t *pvd = image.data() + 16 * S;
+    pvd[0] = 1;
+    std::memcpy(pvd + 1, "CD001", 5);
+    put32(image, 16 * S + 156 + 2, 17);      // root directory: sector 17
+    put32(image, 16 * S + 156 + 10, S);
+    std::uint8_t *dir = image.data() + 17 * S;
+    const char name[] = "A.BIN;1";
+    dir[0] = 33 + 7;                          // record length
+    put32(image, 17 * S + 2, 18);             // the file: sector 18, 100 bytes
+    put32(image, 17 * S + 10, 100);
+    dir[32] = 7;
+    std::memcpy(dir + 33, name, 7);
+    for (int i = 0; i < 100; ++i) image[18 * S + i] = static_cast<std::uint8_t>(i + 1);
+
+    const auto path = std::filesystem::temp_directory_path() / "portablekit_iso_image_test.iso";
+    { std::ofstream(path, std::ios::binary).write(reinterpret_cast<const char *>(image.data()), static_cast<std::streamsize>(image.size())); }
+
+    IsoImage iso(path);
+    const auto entry = iso.find("a.bin");
+    check(entry.has_value() && entry->lba == 18 && entry->size == 100, "the synthetic image lists A.BIN");
+    std::vector<std::uint8_t> out(100);
+    check(iso.read(18 * S, out) == 100 && out[0] == 1 && out[99] == 100, "a plain read returns the file");
+    const auto base = IsoImage::reopen_total();
+
+    iso.close_handle_for_test();   // a stale handle
+    std::vector<std::uint8_t> again(100);
+    check(iso.read(18 * S, again) == 100 && again == out, "a read on a stale handle reopens the file and returns the same bytes");
+    check(IsoImage::reopen_total() == base + 1 && IsoImage::reopen_failed_total() == 0, "... and counts one reopen, no failure");
+    check(iso.read(18 * S + 10, again) == 100 && again[0] == 11, "later reads work on the new handle without another reopen");
+    check(IsoImage::reopen_total() == base + 1, "... still one reopen");
+
+    IsoImage::notify_resumed();
+    check(iso.read(18 * S, again) == 100 && again == out, "after notify_resumed the next read works");
+    check(IsoImage::reopen_total() == base + 2, "... through one proactive reopen");
+
+    std::filesystem::remove(path);
+    // The file is gone: the retry cannot succeed, and the failure is counted, not thrown.
+    iso.close_handle_for_test();
+    check(iso.read(18 * S, again) < 100 && IsoImage::reopen_failed_total() == 1, "a read that cannot be healed reports the short count and counts a failure");
+
+    std::printf("%d failure(s)\n", g_failures);
+    return g_failures == 0 ? EXIT_SUCCESS : EXIT_FAILURE;
+}
