+    first.data = std::vector<std::uint8_t>(512u, 0x11u);
+    second.data = std::vector<std::uint8_t>(700u, 0x22u);
+    first.title = second.title = "T";
+    std::string error;
+    portablekit::filereplace::set_ops_for_test(&refuse::ops);
+    check(write_save(root, files, first, error), "refusing rename: the first save is written");
+    check(write_save(root, files, second, error), "refusing rename: the second save replaces the first");
+    LoadResult loaded = load_save(root, files);
+    check(loaded.status == LoadStatus::Ok && loaded.contents.data == second.data, "refusing rename: the new save loads");
+    const auto folder = save_folder(root, files);
+    check(!std::filesystem::exists(folder / "DATA.BIN.bak") && !std::filesystem::exists(folder / "DATA.BIN.tmp") &&
+              !std::filesystem::exists(folder / "PARAM.SFO.bak"),
