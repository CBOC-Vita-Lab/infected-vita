@@ -0,0 +1,217 @@
+// gfx.antialiasing=auto: the state machine of host/gpu/auto_aa.hpp, driven with made-up frame timings (no GL, no clock, no threads).
+
+#include "gpu/auto_aa.hpp"
+
+#include <cstdio>
+
+namespace {
+
+using namespace portablekit::gpu;
+
+int g_failures = 0;
+void check(bool condition, const char *what) {
+    std::printf("%s %s\n", condition ? "ok  " : "FAIL", what);
+    if (!condition) ++g_failures;
+}
+
+// A simulated run of presented frames at 30 Hz. `late_us` makes a frame's interval longer.
+struct Run {
+    AutoAa aa;
+    std::uint64_t now_us{1'000'000u};
+    int offs_seen{0}, ons_seen{0};
+    explicit Run(const AutoAaConfig &config = {}) : aa(config) { aa.reset(now_us); }
+
+    AutoAa::Event frame(std::uint32_t interval_us = 33'333u, bool scene = true, std::uint32_t swap_us = 1'700u, std::int32_t lag_us = 8'000,
+                        std::int32_t idle_us = 4'000, std::uint32_t skipped = 0u) {
+        now_us += interval_us;
+        AutoAaFrame f;
+        f.now_us = now_us;
+        f.interval_us = interval_us;
+        f.swap_us = swap_us;
+        f.lag_us = lag_us;
+        f.idle_us = idle_us;
+        f.skipped = skipped;
+        f.scene = scene;
+        const AutoAa::Event event = aa.update(f);
+        offs_seen += event == AutoAa::Event::TurnedOff;
+        ons_seen += event == AutoAa::Event::TurnedOn;
+        return event;
+    }
+    void healthy_seconds(double seconds, std::int32_t idle_us = 4'000) {
+        for (int i = 0, n = static_cast<int>(seconds * 30.0); i < n; ++i) frame(33'333u, true, 1'700u, 8'000, idle_us);
+    }
+    // A frame the GPU made late: 50 ms, a present that waited, the GL thread far behind.
+    AutoAa::Event gpu_late() { return frame(50'000u, true, 12'000u, 20'000, 0); }
+};
+
+} // namespace
+
+int main() {
+    {
+        Run r;
+        check(r.aa.on(), "starts with FXAA on");
+        r.healthy_seconds(30);
+        check(r.aa.on() && r.aa.changes() == 0u, "a healthy run never changes anything");
+    }
+    {
+        Run r;
+        r.healthy_seconds(2);
+        check(r.gpu_late() == AutoAa::Event::None && r.aa.on(), "one late frame does not turn FXAA off");
+        r.frame();
+        check(r.gpu_late() == AutoAa::Event::None && r.aa.on(), "a late frame, a good one, a late one: not consecutive, still on");
+        check(r.gpu_late() == AutoAa::Event::TurnedOff && !r.aa.on(), "two late frames in a row turn it off at the second");
+        check(r.aa.offs() == 1u && r.aa.changes() == 1u, "the change is counted");
+    }
+    {
+        // The game's own code being slow is not FXAA's doing: late frames with a sleeping GL thread and a quick present.
+        Run r;
+        r.healthy_seconds(2);
+        for (int i = 0; i < 20; ++i) r.frame(55'000u, true, 1'700u, 1'000, 15'000);
+        check(r.aa.on(), "late frames the GL thread was not the cause of leave FXAA on");
+        // The same with no measure of the GL thread (no split renderer): a late frame is the renderer's.
+        Run q;
+        q.healthy_seconds(2);
+        q.frame(55'000u, true, 1'700u, -1, -1);
+        check(q.frame(55'000u, true, 1'700u, -1, -1) == AutoAa::Event::TurnedOff, "without a GL-thread measure two late frames count");
+    }
+    {
+        // A skipped frame is enough on its own.
+        Run r;
+        r.healthy_seconds(2);
+        check(r.frame(66'000u, true, 1'700u, 8'000, 4'000, 1u) == AutoAa::Event::TurnedOff, "a frame skip turns FXAA off at once");
+    }
+    {
+        // Menus, movies and loads change nothing.
+        Run r;
+        r.healthy_seconds(2);
+        for (int i = 0; i < 30; ++i) r.frame(60'000u, false, 12'000u, 20'000, 0);
+        check(r.aa.on(), "late frames without a 3D scene (a menu, a movie) are not counted");
+        r.gpu_late();
+        r.frame(60'000u, false, 12'000u, 20'000, 0);
+        check(r.aa.on() && r.gpu_late() == AutoAa::Event::TurnedOff, "a 2D frame between two late 3D frames does not break the run");
+        Run l;
+        l.healthy_seconds(2);
+        l.frame(3'000'000u);   // a load
+        l.frame(3'000'000u);
+        check(l.aa.on(), "an interval over 200 ms is a pause, not a late frame");
+    }
+    {
+        // The grace after coming on: the first frames make the pass's target and may be long.
+        Run r;
+        r.aa.reset(r.now_us);
+        check(r.gpu_late() == AutoAa::Event::None && r.gpu_late() == AutoAa::Event::None && r.aa.on(), "the first two 3D frames after coming on are not counted");
+        r.gpu_late();
+        check(r.gpu_late() == AutoAa::Event::TurnedOff, "then the rule applies");
+    }
+    {
+        // Back on: after 10 quiet seconds, not before.
+        Run r;
+        r.healthy_seconds(2);
+        r.gpu_late();
+        r.gpu_late();
+        check(!r.aa.on(), "off");
+        r.healthy_seconds(9);
+        check(!r.aa.on(), "still off after 9 quiet seconds");
+        r.healthy_seconds(1.5);
+        check(r.aa.on() && r.ons_seen == 1, "back on after 10 quiet seconds");
+    }
+    {
+        // A late frame while off restarts the quiet time.
+        Run r;
+        r.healthy_seconds(2);
+        r.gpu_late();
+        r.gpu_late();
+        r.healthy_seconds(8);
+        r.gpu_late();
+        r.healthy_seconds(8);
+        check(!r.aa.on(), "a late frame while off starts the 10 seconds again");
+        r.healthy_seconds(3);
+        check(r.aa.on(), "and it comes back 10 seconds after that");
+    }
+    {
+        // A menu or a movie is no room: the quiet time needs 3D frames.
+        Run r;
+        r.healthy_seconds(2);
+        r.gpu_late();
+        r.gpu_late();
+        for (int i = 0; i < 30 * 20; ++i) r.frame(33'333u, false);
+        check(!r.aa.on(), "20 seconds of menu do not bring it back");
+        r.healthy_seconds(6);
+        check(r.aa.on(), "5 seconds of 3D frames after that do");
+    }
+    {
+        // Not enough room: the GL thread sleeps less than FXAA is assumed to need.
+        Run r;
+        r.healthy_seconds(2);
+        r.gpu_late();
+        r.gpu_late();
+        for (int i = 0; i < 30 * 30; ++i) r.frame(33'333u, true, 1'700u, 8'000, 800);
+        check(!r.aa.on(), "no room (the GL thread sleeps 0.8 ms a frame): stays off for 30 seconds");
+        for (int i = 0; i < 30 * 12; ++i) r.frame(33'333u, true, 1'700u, 8'000, 5'000);
+        check(r.aa.on(), "room again: back on");
+        // Without idle-time information the other conditions decide.
+        Run q;
+        q.healthy_seconds(2);
+        q.frame(55'000u, true, 1'700u, -1, -1);
+        q.frame(55'000u, true, 1'700u, -1, -1);
+        for (int i = 0; i < 30 * 11; ++i) q.frame(33'333u, true, 1'700u, -1, -1);
+        check(q.aa.on(), "idle time unknown: 10 quiet seconds are enough");
+    }
+    {
+        // A scene the GPU cannot afford: every try fails within a few frames; the tries get rarer and ask for more room.
+        Run r;
+        r.healthy_seconds(2);
+        std::uint64_t first_retry = r.aa.retry_us();
+        int tries = 0;
+        std::uint64_t t_start = r.now_us;
+        std::uint64_t last_on = 0, longest_wait = 0;
+        for (int step = 0; step < 30 * 600; ++step) {     // ten minutes
+            if (r.aa.on()) {
+                if (last_on == 0u) last_on = r.now_us;
+                r.gpu_late();
+            } else {
+                const std::uint64_t off_at = r.now_us;
+                r.frame(33'333u, true, 1'700u, 8'000, 8'000);
+                if (r.aa.on()) { ++tries; longest_wait = r.now_us - off_at > longest_wait ? r.now_us - off_at : longest_wait; }
+            }
+        }
+        (void)t_start;
+        check(tries >= 3 && tries <= 12, "a scene FXAA never fits is tried a handful of times in ten minutes, not a hundred");
+        check(r.aa.retry_us() > first_retry && r.aa.retry_us() <= r.aa.config().max_retry_us, "the wait grows, up to its limit");
+        check(r.aa.need_idle_us() > r.aa.config().need_idle_us && r.aa.need_idle_us() <= r.aa.config().max_need_idle_us, "and so does the room asked for, up to its limit");
+    }
+    {
+        // A try that fails doubles the wait; one that holds for a minute is forgiven.
+        Run r;
+        r.healthy_seconds(2);
+        r.gpu_late();
+        r.gpu_late();
+        check(!r.aa.on() && r.aa.retry_us() == 10'000'000u, "the first off (from the start) does not count as a failed try");
+        r.healthy_seconds(11);
+        check(r.aa.on(), "tried again");
+        for (int i = 0; i < 4; ++i) r.gpu_late();   // two frames of grace, then two late ones
+        check(!r.aa.on() && r.aa.retry_us() == 20'000'000u, "a try that fails within seconds doubles the wait");
+        r.healthy_seconds(21, 3'000);
+        check(!r.aa.on(), "after a failed try more room is asked for: 3 ms of sleep is no longer enough");
+        r.healthy_seconds(21, 6'000);
+        check(r.aa.on(), "tried after 20 seconds with 6 ms of room");
+        r.healthy_seconds(70);
+        for (int i = 0; i < 2; ++i) r.gpu_late();
+        check(!r.aa.on(), "off after a long stretch on");
+        check(r.aa.retry_us() == r.aa.config().retry_us && r.aa.need_idle_us() == r.aa.config().need_idle_us,
+              "a try that held for a minute is forgiven: back to 10 seconds");
+    }
+    {
+        // Counting and reset.
+        Run r;
+        r.healthy_seconds(1);
+        r.gpu_late();
+        r.gpu_late();
+        r.healthy_seconds(12);
+        check(r.aa.changes() == 2u && r.aa.offs() == 1u && r.aa.ons() == 1u, "offs and ons are counted");
+        r.aa.reset(r.now_us);
+        check(r.aa.on(), "reset (Auto chosen again) starts with FXAA on");
+    }
+    std::printf("%s\n", g_failures == 0 ? "all passed" : "FAILURES");
+    return g_failures == 0 ? 0 : 1;
+}
