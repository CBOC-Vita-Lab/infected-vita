+    // ---- gfx.antialiasing=auto ------------------------------------------------------------------------------------
+    // One sample per presented frame goes to the controller (gpu/auto_aa.hpp); its answer is applied to the next frame. Everything here runs on
+    // the GL thread; the counters are atomics because the status line reads them from another.
+    AutoAa auto_aa;
+    Renderer::LoadProbe load_probe;
+    Renderer::LoadReading aa_last_load{};
+    Clock::time_point aa_last_present{};
+    bool aa_have_last{};
+    bool aa_state_known{};
+    bool aa_load_primed{};   // aa_last_load holds a reading (the probe is installed after the renderer is made)
+    bool fxaa_warm_done{};
+    std::atomic<std::uint32_t> aa_offs{0u}, aa_ons{0u};
+    std::atomic<int> aa_on_now{-1};   // -1 Auto is not adaptive now, 0 off, 1 on
+
+    [[nodiscard]] static std::uint64_t clock_us(Clock::time_point t) {
+        return static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(t.time_since_epoch()).count());
+    }
+
+    void auto_aa_start() {
+        AutoAaConfig config;
+        if (settings.aa_auto_retry_s != 0u) config.retry_us = static_cast<std::uint64_t>(settings.aa_auto_retry_s) * 1'000'000u;
+        if (settings.aa_auto_need_idle_us != 0u) config.need_idle_us = settings.aa_auto_need_idle_us;
+        if (settings.aa_auto_budget_ms != 0u) {
+            config.budget_us = settings.aa_auto_budget_ms * 1000u;
+            config.pause_us = std::max(config.pause_us, config.budget_us * 6u);
+        }
+        if (settings.aa_auto_min_frames != 0u) config.min_scene_frames = settings.aa_auto_min_frames;
+        auto_aa = AutoAa(config);
+        auto_aa.reset(clock_us(Clock::now()));
+        aa_have_last = false;
+        aa_state_known = false;
+        aa_load_primed = false;
+    }
+
+    // Called at the end of present(), before the options are refreshed. `scene`: this frame had a 3D picture for FXAA to work on.
+    void note_auto_aa(Clock::time_point present_start, Clock::time_point after_show, bool scene) {
+        if (!opt.aa_auto) {
+            aa_on_now.store(-1, std::memory_order_relaxed);
+            return;
+        }
+        AutoAaFrame sample;
+        sample.now_us = clock_us(after_show);
+        sample.swap_us = static_cast<std::uint32_t>(std::min<std::uint64_t>(clock_us(after_show) - clock_us(present_start), 0xFFFFFFFFu));
+        if (aa_have_last)
+            sample.interval_us = static_cast<std::uint32_t>(std::min<std::uint64_t>(clock_us(present_start) - clock_us(aa_last_present), 0xFFFFFFFFu));
+        aa_last_present = present_start;
+        aa_have_last = true;
+        sample.scene = scene;
+        if (load_probe) {
+            const Renderer::LoadReading now = load_probe();
+            if (!aa_load_primed) {
+                aa_last_load = now;
+                aa_load_primed = true;
+            }
+            sample.lag_us = now.lag_us;
+            if (now.idle_us >= 0 && aa_last_load.idle_us >= 0)
+                sample.idle_us = static_cast<std::int32_t>(std::min<std::uint32_t>(static_cast<std::uint32_t>(now.idle_us - aa_last_load.idle_us), 0x7FFFFFFFu));
+            sample.skipped = static_cast<std::uint32_t>(now.skipped - aa_last_load.skipped);
+            aa_last_load = now;
+        }
+        aa_state_known = true;
+        const AutoAa::Event event = auto_aa.update(sample);
+        opt.fxaa = auto_aa.on();
+        aa_on_now.store(auto_aa.on() ? 1 : 0, std::memory_order_relaxed);
+        port::set_auto_antialiasing_state(auto_aa.on() ? 1 : 0);
+        if (event == AutoAa::Event::None) return;
