diff --git a/host/gpu/auto_aa.hpp b/host/gpu/auto_aa.hpp
new file mode 100644
index 0000000..054efca
--- /dev/null
+++ b/host/gpu/auto_aa.hpp
@@ -0,0 +1,186 @@
+#pragma once
+
+// gfx.antialiasing=auto: FXAA while the renderer has room for it, off while it does not.
+//
+// The controller is a plain state machine fed one sample per presented frame (no GL, no clock of its own, no threads), so a
+// test can drive it with made-up timings. The renderer (gl_renderer.cpp, present()) measures the samples on the GL thread and
+// applies the answer to the next frame.
+//
+//   * Late: a presented 3D frame whose interval since the previous present is over `late_factor` times the 30 Hz budget
+//     (33.3 ms * 1.25 = 41.7 ms), and that the renderer side is to blame for: the walker was kept waiting by the GL thread
+//     (a lag over `lag_blame_us`), the present itself waited for the GPU (`swap_blame_us`) or a frame was skipped. A frame that
+//     was late because the game's own code was slow, with the GL thread asleep for work, is not FXAA's doing.
+//   * FXAA goes off after `late_frames_off` late 3D frames in a row (2). Menus, movies and loading screens (frames without a 3D
+//     scene) change nothing, and an interval over `pause_us` (a pause, a load) is not a frame time at all.
+//   * FXAA comes back after `retry_us` (10 s) in which no frame was late or skipped, at least `min_scene_frames` of them were 3D
+//     frames, and the GL thread slept on average at least `need_idle_us` per frame (room for the pass; unknown idle time skips
+//     this test). A try that fails within `trial_us` (6 s) doubles the wait (up to `max_retry_us`) and raises the room asked for,
+//     so a scene the GPU cannot afford is tried a few times a minute at most; a try that lasts `settle_us` (60 s) forgives it.
+//   * The first `grace_frames` 3D frames after FXAA comes on are not counted: the pass makes its target the first time.
+//
+// All times are microseconds. Values: docs/GRAPHICS_OPTIONS.md, README-VITA.md (gl_aa_auto*).
+#include <algorithm>
+#include <cstdint>
+
+namespace portablekit::gpu {
+
+struct AutoAaConfig {
+    std::uint32_t budget_us{33'333};        // the game's frame time (30 Hz)
+    std::uint32_t late_percent{125};        // late = interval over budget * this / 100
+    std::uint32_t pause_us{200'000};        // an interval over this is a pause or a load: ignored, and it restarts the wait
+    std::uint32_t late_frames_off{2};
+    std::int32_t lag_blame_us{12'000};      // the GL thread this far behind the walker: the renderer is the slow side
+    std::uint32_t swap_blame_us{6'000};     // the present took this long: it waited for the GPU
+    std::uint64_t retry_us{10'000'000};     // quiet time before FXAA is tried again
+    std::uint64_t max_retry_us{80'000'000};
+    std::uint64_t trial_us{6'000'000};      // an off within this long of coming on is a failed try
+    std::uint64_t settle_us{60'000'000};    // on for this long: the earlier failures are forgotten
+    std::uint32_t grace_frames{2};
+    std::uint32_t min_scene_frames{150};    // 3D frames in the quiet time (5 s of play): a menu does not count as room
+    std::uint32_t need_idle_us{3'000};      // GL-thread sleep per frame that FXAA's pass is assumed to need
+    std::uint32_t max_need_idle_us{9'000};
+};
+
+struct AutoAaFrame {
+    std::uint64_t now_us{};          // the frame's present, on a monotonic clock
+    std::uint32_t interval_us{};     // since the previous present (0: unknown, first frame)
+    std::uint32_t swap_us{};         // the time the present itself took
+    std::int32_t lag_us{-1};         // how far behind the walker the GL thread was (smoothed); -1 unknown (no split renderer)
+    std::int32_t idle_us{-1};        // the GL thread's sleep since the previous present; -1 unknown
+    std::uint32_t skipped{};         // frames the frame-skip left out since the previous present
+    bool scene{};                    // a 3D frame (FXAA has something to work on)
+};
+
+class AutoAa {
+public:
+    enum class Event : std::uint8_t { None, TurnedOff, TurnedOn };
+
+    explicit AutoAa(const AutoAaConfig &config = {}) : config_(config) { reset(0u); }
+
+    [[nodiscard]] bool on() const noexcept { return on_; }
+    [[nodiscard]] const AutoAaConfig &config() const noexcept { return config_; }
+    [[nodiscard]] std::uint32_t changes() const noexcept { return offs_ + ons_; }
+    [[nodiscard]] std::uint32_t offs() const noexcept { return offs_; }
+    [[nodiscard]] std::uint32_t ons() const noexcept { return ons_; }
+    [[nodiscard]] std::uint64_t retry_us() const noexcept { return retry_us_; }
+    [[nodiscard]] std::uint32_t need_idle_us() const noexcept { return need_idle_us_; }
+
+    // Starts over with FXAA on (the player chose Auto, or the game began).
+    void reset(std::uint64_t now_us) noexcept {
+        on_ = true;
+        late_run_ = 0u;
+        grace_ = config_.grace_frames;
+        retry_us_ = config_.retry_us;
+        need_idle_us_ = config_.need_idle_us;
+        since_change_us_ = now_us;
+        trial_ = false;
+        restart_quiet(now_us);
+    }
+
+    // True for a frame the renderer side is to blame for being late.
+    [[nodiscard]] bool renderer_to_blame(const AutoAaFrame &f) const noexcept {
+        if (f.skipped != 0u) return true;
+        if (f.swap_us >= config_.swap_blame_us) return true;
+        if (f.lag_us >= config_.lag_blame_us) return true;
+        // No measure of the GL thread's queue (one renderer thread, or none): a late frame is the renderer's.
+        return f.lag_us < 0 && f.idle_us < 0;
+    }
+
+    [[nodiscard]] bool late(const AutoAaFrame &f) const noexcept {
+        return f.interval_us != 0u &&
+               static_cast<std::uint64_t>(f.interval_us) * 100u > static_cast<std::uint64_t>(config_.budget_us) * config_.late_percent;
+    }
+
+    Event update(const AutoAaFrame &f) noexcept {
+        if (f.interval_us > config_.pause_us) {   // a pause, a load, the settings menu: no information, and the quiet time starts again
+            late_run_ = 0u;
+            restart_quiet(f.now_us);
+            return Event::None;
+        }
+        const bool blame = (late(f) || f.skipped != 0u) && renderer_to_blame(f);
+        if (on_) return update_on(f, blame);
+        return update_off(f, blame);
+    }
+
+private:
+    Event update_on(const AutoAaFrame &f, bool blame) noexcept {
+        if (trial_ && f.now_us - since_change_us_ >= config_.settle_us) {   // it held: the earlier failures are forgotten
+            trial_ = false;
+            retry_us_ = config_.retry_us;
+            need_idle_us_ = config_.need_idle_us;
+        }
+        if (!f.scene) return Event::None;
+        if (grace_ != 0u) {
+            --grace_;
+            return Event::None;
+        }
+        if (!blame) {
+            late_run_ = 0u;
+            return Event::None;
+        }
+        // A skipped frame is as bad as two late ones: the renderer already fell a whole frame behind.
+        if (++late_run_ < config_.late_frames_off && f.skipped == 0u) return Event::None;
+        on_ = false;
+        ++offs_;
+        late_run_ = 0u;
+        const std::uint64_t on_for = f.now_us - since_change_us_;
+        if (trial_ && on_for < config_.trial_us) {   // a failed try: wait longer next time, and ask for more room
+            retry_us_ = std::min(retry_us_ * 2u, config_.max_retry_us);
+            need_idle_us_ = std::min(need_idle_us_ + need_idle_us_ / 2u, config_.max_need_idle_us);
+        }
+        since_change_us_ = f.now_us;
+        restart_quiet(f.now_us);
+        trial_ = false;
+        return Event::TurnedOff;
+    }
+
+    Event update_off(const AutoAaFrame &f, bool blame) noexcept {
+        if (blame) {   // not FXAA's doing now, but the renderer has no room: the quiet time starts again
+            restart_quiet(f.now_us);
+            return Event::None;
+        }
+        if (f.scene) {
+            ++scene_frames_;
+            if (f.idle_us >= 0) {
+                idle_sum_ += static_cast<std::uint64_t>(f.idle_us);
+                ++idle_frames_;
+            }
+        }
+        if (f.now_us - quiet_since_us_ < retry_us_ || scene_frames_ < config_.min_scene_frames) return Event::None;
+        if (idle_frames_ != 0u && idle_sum_ / idle_frames_ < need_idle_us_) {
+            restart_quiet(f.now_us);   // measured the quiet time and found no room: look again from here
+            return Event::None;
+        }
+        on_ = true;
+        ++ons_;
+        late_run_ = 0u;
+        grace_ = config_.grace_frames;
+        since_change_us_ = f.now_us;
+        trial_ = true;
+        return Event::TurnedOn;
+    }
+
+    void restart_quiet(std::uint64_t now_us) noexcept {
+        quiet_since_us_ = now_us;
+        scene_frames_ = 0u;
+        idle_sum_ = 0u;
+        idle_frames_ = 0u;
+    }
+
+    AutoAaConfig config_;
+    bool on_{true};
+    bool trial_{false};   // FXAA is on again after an off (a try), not from the start
+    std::uint32_t late_run_{0};
+    std::uint32_t grace_{0};
+    std::uint32_t offs_{0};
+    std::uint32_t ons_{0};
+    std::uint64_t retry_us_{0};
+    std::uint32_t need_idle_us_{0};
+    std::uint64_t since_change_us_{0};
+    std::uint64_t quiet_since_us_{0};
+    std::uint32_t scene_frames_{0};
+    std::uint64_t idle_sum_{0};
+    std::uint32_t idle_frames_{0};
+};
+
+} // namespace portablekit::gpu
