diff --git a/host/perf/bench.cpp b/host/perf/bench.cpp
new file mode 100644
index 0000000..0925c8a
--- /dev/null
+++ b/host/perf/bench.cpp
@@ -0,0 +1,144 @@
+#include "perf/bench.hpp"
+
+#include "profile.hpp"
+
+#include <cstdarg>
+#include <cstdio>
+
+#include <chrono>
+#include <deque>
+#include <map>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace portablekit::bench {
+
+bool g_on = false;
+
+namespace {
+
+struct State {
+    std::uint32_t cur{Guest};
+    std::uint64_t last_ns{};
+    std::array<std::uint64_t, kMaxCats> ns{};
+    std::array<std::uint64_t, kMaxCats> calls{};
+    std::uint32_t used{kFixedCats};
+    std::deque<std::string> names;                       // library names, stable storage
+    std::map<std::string_view, std::uint32_t> by_name;
+    std::uint64_t draws{}, lists{};
+};
+
+State &state() noexcept {
+    static State s;
+    return s;
+}
+
+std::uint64_t clock_ns() noexcept {
+    return static_cast<std::uint64_t>(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+} // namespace
+
+void enable() noexcept {
+    State &s = state();
+    s.last_ns = clock_ns();
+    s.cur = Guest;
+    g_on = true;
+}
+
+std::uint32_t current() noexcept { return state().cur; }
+
+void set_slow(std::uint32_t cat) noexcept {
+    State &s = state();
+    const std::uint64_t now = clock_ns();
+    s.ns[s.cur] += now - s.last_ns;
+    s.last_ns = now;
+    s.cur = cat;
+}
+
+std::uint32_t library_category(std::string_view library) noexcept {
+    State &s = state();
+    const auto found = s.by_name.find(library);
+    std::uint32_t cat;
+    if (found != s.by_name.end()) {
+        cat = found->second;
+    } else if (s.used < kMaxCats) {
+        s.names.emplace_back(library);
+        cat = s.used++;
+        s.by_name.emplace(std::string_view(s.names.back()), cat);
+    } else {
+        cat = Kernel;  // more libraries than categories: counted with the kernel
+    }
+    ++s.calls[cat];
+    return cat;
+}
+
+namespace {
+std::vector<std::pair<WindowBegin, WindowEnd>> &window_hooks() {
+    static std::vector<std::pair<WindowBegin, WindowEnd>> hooks;
+    return hooks;
+}
+} // namespace
+
+void add_window_hooks(WindowBegin begin, WindowEnd end) { window_hooks().emplace_back(begin, end); }
+void window_begin() {
+    for (const auto &hook : window_hooks())
+        if (hook.first != nullptr) hook.first();
+}
+void window_end(std::uint64_t flips) {
+    for (const auto &hook : window_hooks())
+        if (hook.second != nullptr) hook.second(flips);
+}
+
+namespace {
+ReportSink g_sink = nullptr;
+}
+void set_report_sink(ReportSink sink) noexcept { g_sink = sink; }
+ReportSink report_sink() noexcept { return g_sink; }
+
+void out(const char *format, ...) {
+    char text[512];
+    va_list args;
+    va_start(args, format);
+    std::vsnprintf(text, sizeof text, format, args);
+    va_end(args);
+    std::fputs(text, stdout);
+    if (const char *path = portablekit::env("BENCH_OUT"); path != nullptr && *path != '\0') {
+        if (std::FILE *file = std::fopen(path, "a")) {
+            std::fputs(text, file);
+            std::fclose(file);
+        }
+    }
+    if (g_sink != nullptr) g_sink(text);
+}
+
+void count_draw() noexcept { ++state().draws; }
+void count_list() noexcept { ++state().lists; }
+
+Totals totals() noexcept {
+    State &s = state();
+    Totals t;
+    if (g_on) set_slow(s.cur);  // close the open interval
+    t.ns = s.ns;
+    t.calls = s.calls;
+    t.used = s.used;
+    t.draws = s.draws;
+    t.lists = s.lists;
+    t.now_ns = s.last_ns;
+    return t;
+}
+
+const char *category_name(std::uint32_t cat) noexcept {
+    static const char *const fixed[] = {"guest code", "GE list walk", "vertex decode", "GL submission", "present/upload",
+                                        "idle", "kernel scheduler", "SAS render", "ATRAC decode",
+                                        "movie decode"};
+    if (cat < kFixedCats) return fixed[cat];
+    State &s = state();
+    const std::uint32_t index = cat - kFixedCats;
+    if (index < s.names.size()) return s.names[index].c_str();
+    return "?";
+}
+
+} // namespace portablekit::bench
