+    // No device (dump only, or <prefix>_NO_AUDIO): the game's clock plays the stream. The frames up to the emulated time are
+    // retired, written or not, so a silent stretch is silent in the dump and its length is the emulated time. Draining by what
+    // was written instead (the old rule) made two channels that snap forward in turn push the stream ahead of the clock:
+    // a 190 s stretch of play came out as 400 s of audio.
+    void drain_without_device() {
+        std::uint64_t target;
+        if (time_source != nullptr) {
+            target = time_source() * kSampleRate / 1'000'000u;
+        } else {
+            target = write_end > kPrebufferFrames ? write_end - kPrebufferFrames : 0u;
+        }
+        // Never past the ring's reach of written frames, and in steps the ring can hold.
+        while (target > read_position) {
+            const auto step = static_cast<std::size_t>(std::min<std::uint64_t>(target - read_position, 4096u));
+            scratch.resize(step * kChannels);
+            retire(step, scratch.data(), true);
+            // A platform device takes what was retired; what its queue has no room for is lost, as on a device that falls behind.
+            if (output_open) {
+                const std::size_t taken = g_output.write(scratch.data(), step);
+                if (taken < step) {
+                    window_dropped += step - taken;
+                    total_dropped += step - taken;
+                }
+            }
+        }
+    }
+
     void report() {
