+    if (impl.dump.active()) {
+        // The frames written ahead of the clock still belong to the dump.
+        if (impl.write_end > impl.read_position) {
+            impl.scratch.resize(static_cast<std::size_t>(impl.write_end - impl.read_position) * kChannels);
+            impl.retire(static_cast<std::size_t>(impl.write_end - impl.read_position), impl.scratch.data(), true);
+        }
+        impl.dump.close();
+    }
     if (impl.trace) {
         std::printf("[audio] total frames=%llu silent=%llu dropped=%llu\n",
                     static_cast<unsigned long long>(impl.total_frames),
@@ -283,6 +319,8 @@ void AudioSink::shutdown() {
