new file mode 100644
index 0000000..8198619
--- /dev/null
+++ b/host/perf/bench.hpp
@@ -0,0 +1,100 @@
+#pragma once
+
+#include <array>
+#include <cstdarg>
+#include <cstdint>
+#include <string_view>
+
+// Where the wall time of a run goes, by category: the guest's own code (recompiled or interpreted),
+// each HLE library, the GE list walk, vertex decoding, the renderer's draw submission, presenting, and
+// time spent idle. One category is current at any moment; switching adds the time since the last switch
+// to the category that was current, so nested scopes (a draw inside the GE walk inside an HLE call)
+// are exclusive of each other and the categories add up to the run's wall time.
+//
+// It is for measurement: <prefix>_BENCH=flips:N[,from:F] switches it on (see bringup_stats.hpp). Off, a
+// scope costs one test of a flag.
+namespace portablekit::bench {
+
+enum Cat : std::uint32_t {
+    Guest = 0,    // guest code, lean or interpreted, and the glue around it
+    Ge,           // walking display lists (GeState::execute), draws and decode excluded
+    Decode,       // reading a draw's indices and decoding its vertices
+    Gl,           // the renderer's handling of a draw (Renderer::submit)
+    Present,      // upload, write-back and present at the flip
+    Idle,         // the kernel waiting: realtime sleeps and frame pacing
+    Kernel,       // the scheduler between threads (timers, interrupts' bookkeeping)
+    SasRender,    // SAS voice mixing (sceSasCore core render), taken out of the HLE library it runs in
+    AtracDecode,  // ATRAC3/ATRAC3plus frame decoding (libavcodec), taken out of the HLE library it runs in
+    MovieDecode,  // H.264 picture decoding of the movie player, taken out of the HLE library it runs in
+    kFixedCats,   // HLE libraries follow
+    kMaxCats = 48,
+};
+
+extern bool g_on;
+void set_slow(std::uint32_t cat) noexcept;
+[[nodiscard]] std::uint32_t current() noexcept;
+
+[[nodiscard]] inline bool on() noexcept { return g_on; }
+inline void set(std::uint32_t cat) noexcept {
+    if (g_on) set_slow(cat);
+}
+
+class Scope {
+public:
+    explicit Scope(std::uint32_t cat) noexcept : on_(g_on) {
+        if (on_) {
+            previous_ = current();
+            set_slow(cat);
+        }
+    }
+    ~Scope() {
+        if (on_) set_slow(previous_);
+    }
+    Scope(const Scope &) = delete;
+    Scope &operator=(const Scope &) = delete;
+
+private:
+    std::uint32_t previous_{};
+    bool on_;
+};
+
+// The category of an HLE library, made on first use.
+[[nodiscard]] std::uint32_t library_category(std::string_view library) noexcept;
+// An HLE call began: the library's time starts.
+inline void enter_library(std::string_view library) noexcept {
+    if (g_on) set_slow(library_category(library));
+}
+
+// Extra counters of the game's port for the bench window (the lean call counter of the Infected port
+// prints its own lines): `begin` runs when the window opens, `end` when it closes, with the flips in it.
+using WindowBegin = void (*)();
+using WindowEnd = void (*)(std::uint64_t flips);
+void add_window_hooks(WindowBegin begin, WindowEnd end);
+void window_begin();
+void window_end(std::uint64_t flips);
+
+// Where the report lines also go (one call per line, newline included), besides stdout and <prefix>_BENCH_OUT.
+using ReportSink = void (*)(const char *line);
+void set_report_sink(ReportSink sink) noexcept;
+[[nodiscard]] ReportSink report_sink() noexcept;
+
+// printf-style report line: stdout, the file named by <prefix>_BENCH_OUT (appended), and the sink.
+void out(const char *format, ...) __attribute__((format(printf, 1, 2)));
+
+void enable() noexcept;
+void count_draw() noexcept;
+void count_list() noexcept;
+
+struct Totals {
+    std::array<std::uint64_t, kMaxCats> ns{};     // wall time per category
+    std::array<std::uint64_t, kMaxCats> calls{};  // HLE calls per library category
+    std::uint32_t used{};                         // categories in use
+    std::uint64_t draws{};
+    std::uint64_t lists{};
+    std::uint64_t now_ns{};                       // the clock these were read at
+};
+// Closes the open interval and copies the totals.
+[[nodiscard]] Totals totals() noexcept;
+[[nodiscard]] const char *category_name(std::uint32_t cat) noexcept;
+
+} // namespace portablekit::bench
