@@ -433,6 +433,7 @@ bool GlHdTextures::upload(std::uint32_t texture, const GuestMemory &memory, cons
         info.gpu_bytes = 0u;
         info.mips = 0u;
     }
+    info.opaque = false;
     info.key = 0u;
     if (!active()) {
         info.respecify = was_replaced;
@@ -493,6 +494,7 @@ bool GlHdTextures::upload(std::uint32_t texture, const GuestMemory &memory, cons
                     stats_.blob_bytes += record.size;
                     ++stats_.hits;
                     info.replaced = replaced = true;
+                    info.opaque = record.format == HdFormat::Dxt1;
                     info.gpu_bytes = gpu_bytes;
                     info.width = record.width;
                     info.height = record.height;
diff --git a/host/gpu/gl/gl_hd_textures.hpp b/host/gpu/gl/gl_hd_textures.hpp
index 5d60d59..1f8dbf0 100644
--- a/host/gpu/gl/gl_hd_textures.hpp
