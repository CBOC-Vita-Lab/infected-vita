@@ -22,6 +22,7 @@ struct HdTextureInfo {
     std::uint16_t width{}, height{};
     std::uint8_t mips{};        // mip levels uploaded
     bool replaced{};
+    bool opaque{};              // the replacement has no alpha (a DXT1 record, uploaded as RGB): every texel's alpha is 1
