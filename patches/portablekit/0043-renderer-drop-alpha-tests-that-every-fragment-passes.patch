 };
diff --git a/host/gpu/gl/gl_renderer.cpp b/host/gpu/gl/gl_renderer.cpp
index 30721e3..ad027e6 100644
--- a/host/gpu/gl/gl_renderer.cpp
+++ b/host/gpu/gl/gl_renderer.cpp
@@ -1693,6 +1693,47 @@ struct GlRenderer::Impl {
         return true;
     }
 
+    // ---- alpha tests that decide nothing (settings.alpha_elide) ---------------------------------------------------
+
+    // The GE's comparison (the shader's: the 8-bit alpha against the reference) for an alpha of 255.
+    static bool alpha_test_passes_at_255(std::uint32_t function, std::uint32_t reference) {
+        switch (function) {
+        case 1u: return true;                   // always
+        case 2u: return reference == 255u;      // equal
+        case 3u: return reference != 255u;      // not equal
+        case 5u: return reference >= 255u;      // less or equal
+        case 6u: return reference < 255u;       // greater
+        case 7u: return true;                   // greater or equal
+        default: return false;                  // never, less
+        }
+    }
+
+    static bool vertices_opaque(const DrawCall &call) {
+        for (const Vertex &vertex : call.vertices)
+            if ((vertex.color >> 24u) != 0xFFu) return false;
+        return true;
+    }
+
+    // Every fragment of the draw has alpha 1.0 when it reaches the alpha test: the shader's alpha is the vertex colour's
+    // (the material's without vertex colours; with lighting, the ambient alpha times the vertex's or the material's), times
+    // the texel's when the texture function uses it. Conservative: anything not known to be opaque is not.
+    bool fragment_alpha_is_255(const DrawCall &call, const TextureBinding &binding, bool textured, bool lit) const {
+        if (lit) {
+            if (call.lighting.ambient_alpha != 0xFFu) return false;
+            const bool from_vertex = call.has_vertex_color && (call.lighting.material_update & 1u) != 0u;
+            if (from_vertex ? !vertices_opaque(call) : (call.material_color >> 24u) != 0xFFu) return false;
+        } else {
+            const bool use_material = !call.has_vertex_color && !call.lighting_enabled;
+            if (use_material ? (call.material_color >> 24u) != 0xFFu : !vertices_opaque(call)) return false;
+        }
+        if (!textured || !call.texture.alpha_from_texture || call.texture.function == 1u) return true;  // decal keeps the colour's
+        if (binding.opaque) return true;   // the shader sets the texel's alpha to 1
+        if (binding.from_target || binding.hd_movie || binding.entry == nullptr) return false;
+        const TextureEntry &entry = *binding.entry;
+        if (entry.hd.replaced) return entry.hd.opaque;
+        return entry.traits_known && entry.traits.transparent == 0u && entry.traits.translucent == 0u;
+    }
+
     void refresh_environment(const DrawCall &call) {
         const LightingState &state = call.lighting;
         const auto ambient = unpack_color(state.ambient_color, static_cast<float>(state.ambient_alpha) / 255.0f);
@@ -1959,7 +2000,7 @@ struct GlRenderer::Impl {
             ++st().skipped_draws;  // never passes
             return;
         }
-        const bool alpha_test = alpha_enabled && call.alpha_test.function != 1u;
+        bool alpha_test = alpha_enabled && call.alpha_test.function != 1u;
         const bool lit = call.lighting_enabled && settings.lighting && !through;
         const bool fogged = call.fog.enabled && settings.fog && !through;
 
@@ -1972,6 +2013,11 @@ struct GlRenderer::Impl {
                 return;
             }
         }
+        if (alpha_test && settings.alpha_elide && alpha_test_passes_at_255(call.alpha_test.function, call.alpha_test.reference) &&
+            fragment_alpha_is_255(call, binding, textured, lit)) {
+            alpha_test = false;
+            ++st().alpha_elided;
+        }
         const bool rect_clamp = through && textured && settings.rect_clamp;
         float picture_rect[4] = {};
         const bool sharpen = opt.movie_sharp && rect_clamp && !binding.from_target && !binding.hd_movie && picture_draw(call, target, picture_rect);
@@ -2431,6 +2477,7 @@ bool apply_gl_setting(GlSettings &settings, const std::string &name, const std::
     else if (name == "null_draw") settings.null_draw = flag;
     else if (name == "fill_test") settings.fill_test = flag;
     else if (name == "specialize") settings.specialize = flag;
+    else if (name == "alpha_elide") settings.alpha_elide = flag;
     else if (name == "depth_bits") settings.depth_bits = u32;
     else if (name == "target_textures") settings.target_textures = flag;
     else if (name == "use_glclear") settings.use_glclear = flag;
@@ -2453,7 +2500,7 @@ bool apply_gl_setting(GlSettings &settings, const std::string &name, const std::
 const std::vector<std::string> &gl_setting_names() {
     static const std::vector<std::string> names = {
         "display_scale", "display_scale_percent", "offscreen_scale", "no_blend_color", "through_depth", "texture_check_interval",
-        "writeback", "texture_budget_mb", "stats_every", "timing", "gpu_timing", "scratch_buffers", "texture_always_validate", "merge", "null_draw", "fill_test", "specialize", "depth_bits", "target_textures",
+        "writeback", "texture_budget_mb", "stats_every", "timing", "gpu_timing", "scratch_buffers", "texture_always_validate", "merge", "null_draw", "fill_test", "specialize", "alpha_elide", "depth_bits", "target_textures",
         "use_glclear", "quad_clear", "rect_clamp", "cull", "lighting", "fog", "alpha_test", "blend", "depth_test", "flip_winding",
         "trace", "draw_first", "draw_last"};
     return names;
diff --git a/host/gpu/gl/gl_renderer.hpp b/host/gpu/gl/gl_renderer.hpp
index 78cbc73..dbfd52f 100644
--- a/host/gpu/gl/gl_renderer.hpp
+++ b/host/gpu/gl/gl_renderer.hpp
@@ -63,6 +63,9 @@ struct GlSettings {
     // Compile each draw's texture function, alpha comparison and blend fix-up into its fragment program (more programs,
     // far shorter ones); off, one program per flag set chooses them per fragment from uniforms.
     bool specialize{true};
+    // An alpha test that a draw's fragments cannot fail (every alpha is 255: opaque vertices or material, an opaque
+    // texture) is dropped, so the program has no discard. The picture is the same.
+    bool alpha_elide{true};
     // Depth buffer precision of every render target: 16 is what ES 2.0 guarantees
     // (and what the PSP has), 24 needs OES_depth24.
     std::uint32_t depth_bits{16};
@@ -163,6 +166,7 @@ struct GlStats {
     std::uint64_t sharp_draws{};        // full-screen pictures enlarged bicubically (gfx.movie_filter=sharp)
     std::uint64_t mip_draws{};          // 3D draws sampled with mips
     std::uint64_t pixel_lit_draws{};    // draws lit per fragment
+    std::uint64_t alpha_elided{};       // alpha-tested draws whose every fragment has alpha 255: drawn without the test
     std::uint64_t texture_evicted{};
     std::uint64_t clut_hash_bytes{};
     std::uint64_t shader_compile_us{};
