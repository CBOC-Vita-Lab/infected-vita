diff --git a/host/gpu/gl/gl_renderer.cpp b/host/gpu/gl/gl_renderer.cpp
index 9c6baf7..79a17f4 100644
--- a/host/gpu/gl/gl_renderer.cpp
+++ b/host/gpu/gl/gl_renderer.cpp
@@ -2334,6 +2334,39 @@ bool GlRenderer::capture_frame(const std::string &path) {
 std::uint64_t GlRenderer::frames_presented() const noexcept { return impl_->frames; }
 std::uint64_t GlRenderer::draws_submitted() const noexcept { return impl_->draws; }
 
+std::size_t GlRenderer::prewarm_shaders() {
+    Impl &impl = *impl_;
+    if (!impl.ready) return 0;
+    std::size_t built = 0, failed = 0;
+    const auto start = std::chrono::steady_clock::now();
+    for (const std::uint32_t flags : glsl::valid_program_flags()) {
+        if (impl.program_for(flags) != nullptr) ++built;
+        else ++failed;
+    }
+    // The post passes: FXAA and the bicubic enlargement (the multisample resolve is a desktop preview and is not built here).
+    if (impl.ensure_post_program(impl.fxaa_program, impl.fxaa_failed, [] { return glsl::fxaa_fragment_source(); }, "fxaa")) ++built;
+    else ++failed;
+    if (impl.ensure_post_program(impl.bicubic_program, impl.bicubic_failed, [] { return glsl::bicubic_fragment_source(); }, "bicubic")) ++built;
+    else ++failed;
+    // The overlay's own program (the fps counter and the settings menu).
+    if (impl.canvas.ready()) {
+        ++built;
+    } else {
+        std::string error;
+        if (impl.canvas.create(error)) {
+            ++impl.aux_programs;
+            impl.variant_names.push_back("overlay:ui");
+            ++built;
+        } else {
+            std::cerr << "[gl] prewarm: " << error << "\n";
+            ++failed;
+        }
+    }
+    std::cerr << "[gl] prewarm: " << built << " programs ready, " << failed << " failed, "
+              << std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start).count() << " ms\n";
+    return built;
+}
+
 void GlRenderer::flush() {
     if (impl_->ready) impl_->flush();
 }
diff --git a/host/gpu/gl/gl_renderer.hpp b/host/gpu/gl/gl_renderer.hpp
index 5bc273f..ccc9bba 100644
--- a/host/gpu/gl/gl_renderer.hpp
