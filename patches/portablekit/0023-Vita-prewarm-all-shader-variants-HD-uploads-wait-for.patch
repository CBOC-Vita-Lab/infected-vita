From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 10 Oct 2026 06:26:05 +0000
Subject: [PATCH] Vita: prewarm all shader variants, HD uploads wait for the
 GXM transfer, scripted overlay shots per opening

- GlRenderer::prewarm_shaders() builds every valid world program (glsl::valid_program_flags(): 32), the fxaa and bicubic post
  programs and the overlay canvas (PREWARM_SHADERS=1); ge_replay lints the same list.
- HD textures on the Vita: vitaGL swizzles a compressed level with an asynchronous sceGxmTransferCopy and grows the buffer for the next
  mip level with a realloc that can move it; the transfer then landed in freed memory and broke the mspace (Vita3K crashed in
  mspace_malloc a few textures into the game). sceGxmTransferFinish() after every DXT level fixes it. RGBA8 records upload level 0 and
  let vitaGL build the chain (glGenerateMipmap).
- GlCanvas::quad renamed put_quad (newlib's sys/types.h defines a macro named quad).
- HD_TRACE=1 logs every level uploaded; scripted overlay screenshots from the second opening are named <name>_<N>.png.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>

diff --git a/host/gpu/gl/gl_hd_textures.cpp b/host/gpu/gl/gl_hd_textures.cpp
index 7fb34bb..9b3c87d 100644
--- a/host/gpu/gl/gl_hd_textures.cpp
+++ b/host/gpu/gl/gl_hd_textures.cpp
@@ -17,6 +17,10 @@
 #define GL_COMPRESSED_RGBA_S3TC_DXT5_EXT 0x83F3
 #endif
 
+#if defined(__vita__)
+extern "C" int sceGxmTransferFinish(void);   // libSceGxm: waits for every pending sceGxmTransferCopy
+#endif
+
 namespace portablekit::gpu {
 namespace {
 
@@ -182,6 +186,16 @@ bool GlHdTextures::upload_blob(std::uint32_t texture, const HdRecord &record, co
         if (record.format != HdFormat::Rgba8 && (width < 4u || height < 4u)) break;
 #endif
         const std::uint8_t *data = blob.data() + offset;
+        if (config_.trace) {
+            std::cerr << "[hdtex] upload key " << std::hex << record.key << std::dec << " " << record.width << "x" << record.height << " fmt "
+                      << static_cast<int>(record.format) << " level " << level << " (" << width << "x" << height << ", " << bytes
+                      << " bytes of " << blob.size() << ")" << std::endl;
+        }
+#if defined(__vita__)
+        // vitaGL ignores the data of glTexImage2D above level 0 (it builds the chain itself from level 0): an RGBA8 record is
+        // uploaded as level 0 and the chain is generated once.
+        if (record.format == HdFormat::Rgba8 && level > 0) break;
+#endif
         if (record.format == HdFormat::Rgba8) {
             glTexImage2D(GL_TEXTURE_2D, static_cast<GLint>(level), GL_RGBA, static_cast<GLsizei>(width),
                          static_cast<GLsizei>(height), 0, GL_RGBA, GL_UNSIGNED_BYTE, data);
@@ -198,11 +212,24 @@ bool GlHdTextures::upload_blob(std::uint32_t texture, const HdRecord &record, co
                          static_cast<GLsizei>(height), 0, GL_RGBA, GL_UNSIGNED_BYTE, decode_.data());
             gpu_bytes += static_cast<std::uint64_t>(width) * height * 4u;
         }
+#if defined(__vita__)
+        // vitaGL swizzles a compressed level with an asynchronous sceGxmTransferCopy and grows the buffer for the next level with a
+        // realloc that may move (and free) it: wait for the transfer first, or it lands in freed memory.
+        if (record.format != HdFormat::Rgba8) (void)sceGxmTransferFinish();
+#endif
         offset += bytes;
         ++uploaded;
         width = std::max(width / 2u, 1u);
         height = std::max(height / 2u, 1u);
     }
+#if defined(__vita__)
+    if (record.format == HdFormat::Rgba8 && record.mip_count > 1u && uploaded != 0u) {
+        glGenerateMipmap(GL_TEXTURE_2D);
+        // The chain vitaGL builds runs down to 1x1; the pack's memory estimate is the pack's own chain.
+        uploaded = record.mip_count;
+        gpu_bytes = hd_chain_bytes(record.format, record.width, record.height, record.mip_count);
+    }
+#endif
     levels = static_cast<std::uint8_t>(uploaded);
     return uploaded != 0u;
 }
