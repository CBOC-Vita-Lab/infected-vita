     [[nodiscard]] std::size_t shader_variants() const noexcept;
+    // Compiles and links every program the renderer can ask for (the world programs of glsl::valid_program_flags() and the
+    // post passes the options switch on) now instead of at the first draw that needs one. On the Vita this fills vitaGL's
+    // shader cache with every variant (<prefix>_PREWARM_SHADERS=1 once, in the emulator or on the console); a later run
+    // finds them all compiled. Returns the number of programs built (or found already built); failures are logged.
+    std::size_t prewarm_shaders();
     [[nodiscard]] std::vector<std::string> shader_variant_names() const;
     [[nodiscard]] std::string gl_description() const;
     // Texture cache: entries and bytes held.
diff --git a/host/gpu/gl/gl_shaders.cpp b/host/gpu/gl/gl_shaders.cpp
index 61828f9..cb11341 100644
--- a/host/gpu/gl/gl_shaders.cpp
+++ b/host/gpu/gl/gl_shaders.cpp
@@ -397,6 +397,20 @@ std::string fragment_source(std::uint32_t flags) {
     return out;
 }
 
+std::vector<std::uint32_t> valid_program_flags() {
+    std::vector<std::uint32_t> out;
+    for (std::uint32_t flags = 0; flags < (1u << kProgramFlagBits); ++flags) {
+        const bool through = (flags & kThrough) != 0u;
+        if (through && (flags & (kLight | kFog | kPixelLight)) != 0u) continue;
+        if (!through && (flags & kRectClamp) != 0u) continue;
+        if ((flags & kRectClamp) != 0u && (flags & kTexture) == 0u) continue;
+        if ((flags & kPixelLight) != 0u && (flags & kLight) == 0u) continue;
+        if ((flags & kSharpen) != 0u && (!through || (flags & kTexture) == 0u || (flags & kRectClamp) == 0u)) continue;
+        out.push_back(flags);
+    }
+    return out;
+}
+
 std::string describe(std::uint32_t flags) {
     std::string out = (flags & kThrough) != 0u ? "through" : "transform";
     if ((flags & kLight) != 0u) out += (flags & kPixelLight) != 0u ? "+light(pixel)" : "+light";
