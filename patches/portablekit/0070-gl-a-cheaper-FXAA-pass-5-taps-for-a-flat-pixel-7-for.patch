diff --git a/host/gpu/gl/gl_shaders.cpp b/host/gpu/gl/gl_shaders.cpp
index 6e0f91f..83abf43 100644
--- a/host/gpu/gl/gl_shaders.cpp
+++ b/host/gpu/gl/gl_shaders.cpp
@@ -724,6 +724,71 @@ void main() {
 }
 )GLSL";
 
+// The "fast" FXAA (gfx.antialiasing=fxaa, gl_fxaa_quality=fast, the default). Same decision as the one above, written for a
+// tile-based GPU's texture units:
+//  * the five taps that find the edge take their coordinates straight from the vertex stage (the centre and the four diagonal
+//    neighbours as varyings), so none of them is a dependent read;
+//  * the edge test is made before anything else is fetched, and a pixel that is not on an edge (nearly all of them) is done after
+//    those five reads and writes them back unchanged, exactly as the full version does;
+//  * an edge pixel takes two more taps along the edge, not four, then keeps the result inside the colours around it (a
+//    per-channel clamp to the five taps) instead of choosing between two blur widths by a third luma test;
+//  * the colour arithmetic is medium precision (the coordinates stay full precision).
+// 5 fetches for a flat pixel, 7 for an edge pixel (the full version always makes 9, four of them dependent).
+const char *const kFxaaFastVertex = R"GLSL(
+precision highp float;
+attribute vec2 a_position;
+attribute vec2 a_texcoord;
+uniform vec4 u_inv_size;
+varying vec2 v_texcoord;
+varying vec4 v_north;
+varying vec4 v_south;
+void main() {
+    v_texcoord = a_texcoord;
+    v_north = a_texcoord.xyxy + vec4(-1.0, -1.0, 1.0, -1.0) * u_inv_size.xyxy;
+    v_south = a_texcoord.xyxy + vec4(-1.0, 1.0, 1.0, 1.0) * u_inv_size.xyxy;
+    gl_Position = vec4(a_position, 0.0, 1.0);
+}
+)GLSL";
+
+const char *const kFxaaFastBody = R"GLSL(
+varying vec2 v_texcoord;
+varying vec4 v_north;
+varying vec4 v_south;
+uniform sampler2D u_texture;
+
+mediump float luma_of(mediump vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }
+
+void main() {
+    mediump vec4 centre = texture2D(u_texture, v_texcoord);
+    mediump vec3 rgb_nw = texture2D(u_texture, v_north.xy).rgb;
+    mediump vec3 rgb_ne = texture2D(u_texture, v_north.zw).rgb;
+    mediump vec3 rgb_sw = texture2D(u_texture, v_south.xy).rgb;
+    mediump vec3 rgb_se = texture2D(u_texture, v_south.zw).rgb;
+    mediump float l_m = luma_of(centre.rgb);
+    mediump float l_nw = luma_of(rgb_nw);
+    mediump float l_ne = luma_of(rgb_ne);
+    mediump float l_sw = luma_of(rgb_sw);
+    mediump float l_se = luma_of(rgb_se);
+    mediump float l_min = min(l_m, min(min(l_nw, l_ne), min(l_sw, l_se)));
+    mediump float l_max = max(l_m, max(max(l_nw, l_ne), max(l_sw, l_se)));
+    if ((l_max - l_min) < max(FXAA_EDGE_MIN, l_max * FXAA_EDGE_SHARE)) {
+        gl_FragColor = centre;
+    } else {
+        // One texel in uv units, from the neighbours' own coordinates.
+        vec2 px = vec2(v_north.z - v_north.x, v_south.y - v_north.y) * 0.5;
+        mediump vec2 direction = vec2(-((l_nw + l_ne) - (l_sw + l_se)), (l_nw + l_sw) - (l_ne + l_se));
+        mediump float dir_reduce = max((l_nw + l_ne + l_sw + l_se) * (0.25 * FXAA_REDUCE_MUL), FXAA_REDUCE_MIN);
+        mediump float scale = 1.0 / (min(abs(direction.x), abs(direction.y)) + dir_reduce);
+        vec2 step_uv = clamp(direction * scale, vec2(-FXAA_SPAN_MAX), vec2(FXAA_SPAN_MAX)) * px * FXAA_TAP;
+        mediump vec3 blurred = 0.5 * (texture2D(u_texture, v_texcoord + step_uv).rgb +
+                                      texture2D(u_texture, v_texcoord - step_uv).rgb);
+        mediump vec3 lowest = min(centre.rgb, min(min(rgb_nw, rgb_ne), min(rgb_sw, rgb_se)));
+        mediump vec3 highest = max(centre.rgb, max(max(rgb_nw, rgb_ne), max(rgb_sw, rgb_se)));
+        gl_FragColor = vec4(clamp(blurred, lowest, highest), centre.a);
+    }
+}
+)GLSL";
+
 // A bicubic (Catmull-Rom) enlargement for low-resolution pictures, 9 bilinear taps, followed by an anti-ringing clamp
 // to the range of the four texels around the sample. The result is sharper than bilinear without the halos a plain
 // bicubic or Lanczos tail leaves beside a hard edge. The source must be sampled with linear filtering and clamp to
@@ -770,6 +835,19 @@ void main() { gl_FragColor = v_color * texture2D(u_texture, v_texcoord); }
 
 } // namespace
 
+std::string fxaa_fast_vertex_source() { return std::string("#version 100\n") + kFxaaFastVertex; }
+
+std::string fxaa_fast_fragment_source() {
+    return std::string("#version 100\n"
+                       "#define FXAA_SPAN_MAX 8.0\n"
+                       "#define FXAA_REDUCE_MIN (1.0 / 128.0)\n"
+                       "#define FXAA_REDUCE_MUL (1.0 / 8.0)\n"
+                       "#define FXAA_EDGE_MIN 0.0625\n"
+                       "#define FXAA_EDGE_SHARE 0.125\n"
+                       "#define FXAA_TAP 0.33\n") +
+           kPostPrecision + kFxaaFastBody;
+}
+
 std::string fxaa_fragment_source() {
     return std::string("#version 100\n"
                        "#define FXAA_SPAN_MAX 8.0\n"
