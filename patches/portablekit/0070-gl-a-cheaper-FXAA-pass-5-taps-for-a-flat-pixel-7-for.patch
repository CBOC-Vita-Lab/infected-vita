--- a/tools/ge_replay/ge_replay.cpp
+++ b/tools/ge_replay/ge_replay.cpp
@@ -421,7 +421,8 @@ int run_shader_lint(const Options &options) {
         variants.push_back({glsl::describe(flags), glsl::vertex_source(flags), glsl::fragment_source(flags)});
     const std::size_t world = variants.size();
     variants.push_back({"post:blit", glsl::blit_vertex_source(), glsl::blit_fragment_source()});
-    variants.push_back({"post:fxaa", glsl::blit_vertex_source(), glsl::fxaa_fragment_source()});
+    variants.push_back({"post:fxaa (gl_fxaa_quality=high)", glsl::blit_vertex_source(), glsl::fxaa_fragment_source()});
