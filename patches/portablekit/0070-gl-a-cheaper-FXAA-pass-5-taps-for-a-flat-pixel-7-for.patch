     variants.push_back({"post:resolve (desktop preview only)", glsl::blit_vertex_source(), glsl::resolve_fragment_source(2.0f)});
     variants.push_back({"overlay:ui", glsl::ui_vertex_source(), glsl::ui_fragment_source()});
