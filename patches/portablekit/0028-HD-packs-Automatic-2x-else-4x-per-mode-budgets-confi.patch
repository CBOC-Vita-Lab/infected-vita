-    struct Thrash {
-        std::uint64_t window_start{};
-        std::uint32_t count{};
-        std::uint64_t refuse_until{};
+    // Palette animation guard (see try_recolour). One record per palette slot: the texels and the palette memory a recolourable
+    // texture is drawn from. The minimap is ONE slot whose palette the game rewrites every few frames; the characters of a wave
+    // share the texels but each has its own palette memory, so each is a slot of its own and a crowd is not an animation.
+    struct PaletteSlot {
+        bool seen{};                  // a palette change has been seen in this slot
+        std::uint64_t last_event{};   // frame of the last palette change seen in this slot
+        std::uint32_t run{};          // changes in a row, each within kRecolourQuickGap frames of the one before
+        std::uint64_t hold_until{};   // while the frame is before this the slot keeps its original (each change extends it)
         bool logged{};
     };
-    std::unordered_map<std::uint64_t, Thrash> thrash_;   // image key -> recolours in the current window
+    std::unordered_map<std::uint64_t, PaletteSlot> palette_slots_;
     std::vector<std::uint8_t> blob_;
     std::vector<std::uint32_t> decode_;
     std::vector<std::uint32_t> recolour_base_, recolour_level_, recolour_mip_;
