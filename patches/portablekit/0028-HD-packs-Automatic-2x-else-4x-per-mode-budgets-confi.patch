@@ -291,39 +301,57 @@ void halve(const std::vector<std::uint32_t> &in, std::uint32_t w, std::uint32_t
         }
 }
 
-constexpr std::uint64_t kRecolourWindowFrames = 120u;   // a texture whose palette changes this often is left alone
-constexpr std::uint32_t kRecoloursPerWindow = 6u;
-constexpr std::uint64_t kRecolourPenaltyFrames = 1800u;
+// A recolourable texture whose palette the game rewrites again and again (the minimap) would be rebuilt at every change: 4-6 ms at 2x
+// and 19-43 ms at 4x on a desktop core, far more on a Vita, and every rebuild leaves a new GPU texture (the renderer's cache key
+// includes the palette) that holds replacement budget until it is evicted. A palette slot may change kRecolourFree times in a row,
+// each within kRecolourQuickGap frames of the one before (the first look at a character, a hit flash); the next change makes it an
+// animation, and from then on it keeps its original (the renderer's own palette path, which costs a decode and an upload of the
+// original size) for as long as its palette keeps changing: it is rebuilt again only after kRecolourHoldFrames without a change.
+constexpr std::uint64_t kRecolourQuickGap = 24u;
+constexpr std::uint32_t kRecolourFree = 3u;
+constexpr std::uint64_t kRecolourHoldFrames = 600u;
+constexpr std::size_t kMaxPaletteSlots = 4096u;
+
+std::uint64_t palette_slot_key(const TextureState &state) {
+    std::uint64_t h = 0x9E3779B97F4A7C15ull;
+    for (const std::uint64_t part : {static_cast<std::uint64_t>(GuestMemory::canonical(state.address)),
+                                     static_cast<std::uint64_t>(GuestMemory::canonical(state.clut_address)),
+                                     static_cast<std::uint64_t>(state.width) << 16u | state.height})
+        h = (h ^ part) * 0x100000001B3ull + (h >> 29u);
+    return h;
+}
 
 } // namespace
 
 bool GlHdTextures::try_recolour(std::uint32_t texture, const GuestMemory &memory, const TextureState &state,
                                 HdTextureInfo &info) {
-    const std::uint64_t image_key = texture_image_key(memory, state);
-    if (image_key == 0u) return false;
-    HdRecord record;
-    if (!pack_.find(image_key, record) || (record.flags & kHdFlagRecolour) == 0u) return false;
-    // A palette that changes every few frames (a colour animation of a recolourable image) would cost a rebuild
-    // each time: such a texture keeps its original.
-    Thrash &thrash = thrash_[image_key];
-    if (frame_ < thrash.refuse_until) {
+    // The animation guard comes first: a slot that is held costs neither the image hash nor a read of the pack.
+    if (palette_slots_.size() >= kMaxPaletteSlots) palette_slots_.clear();
+    PaletteSlot guard_off;
+    PaletteSlot &slot = config_.recolour_guard ? palette_slots_[palette_slot_key(state)] : guard_off;
+    if (frame_ < slot.hold_until) {
+        slot.hold_until = frame_ + kRecolourHoldFrames;   // the palette changed again: the hold goes on
+        slot.last_event = frame_;
         ++stats_.recolour_refused;
         return false;
     }
-    if (frame_ >= thrash.window_start + kRecolourWindowFrames || frame_ < thrash.window_start) {
-        thrash.window_start = frame_;
-        thrash.count = 0u;
-    }
-    if (++thrash.count > kRecoloursPerWindow) {
-        thrash.refuse_until = frame_ + kRecolourPenaltyFrames;
+    slot.run = (slot.seen && frame_ >= slot.last_event && frame_ - slot.last_event <= kRecolourQuickGap) ? slot.run + 1u : 1u;
+    slot.seen = true;
+    slot.last_event = frame_;
+    if (slot.run > kRecolourFree) {
+        slot.hold_until = frame_ + kRecolourHoldFrames;
         ++stats_.recolour_refused;
-        if (!thrash.logged && config_.log) {
-            thrash.logged = true;
-            std::cerr << "[hdtex] the palette of image " << std::hex << image_key << std::dec
-                      << " changes too often to recolour: its original is used for a while (logged once per image)\n";
+        if (!slot.logged && config_.log) {
+            slot.logged = true;
+            std::cerr << "[hdtex] the palette of the texture at " << std::hex << state.address << " (palette memory " << state.clut_address
+                      << std::dec << ") changes every few frames: its original is used while it does (logged once per texture)\n";
         }
         return false;
     }
+    const std::uint64_t image_key = texture_image_key(memory, state);
+    if (image_key == 0u) return false;
+    HdRecord record;
+    if (!pack_.find(image_key, record) || (record.flags & kHdFlagRecolour) == 0u) return false;
     const std::uint64_t needed = static_cast<std::uint64_t>(record.width) * record.height * 4u * 4u / 3u;
     if (!admit(needed)) return false;
 
@@ -384,7 +412,15 @@ bool GlHdTextures::try_recolour(std::uint32_t texture, const GuestMemory &memory
     ++stats_.resident_textures;
     stats_.resident_bytes += gpu_bytes;
     stats_.peak_bytes = std::max(stats_.peak_bytes, stats_.resident_bytes);
-    stats_.recolour_ns += nanoseconds_since(start);
+    const std::uint64_t spent = nanoseconds_since(start);
+    stats_.recolour_ns += spent;
+    if (config_.trace) {
+        char text[200];
+        std::snprintf(text, sizeof text, "[hdtex] recolour frame %llu image %016llx %ux%u texels@%08x clut@%08x %u entries, %.2f ms\n",
+                      static_cast<unsigned long long>(frame_), static_cast<unsigned long long>(image_key), width, height, state.address,
+                      state.clut_address, recolour.palette_entries, static_cast<double>(spent) / 1.0e6);
+        std::cerr << text;
+    }
     return true;
 }
 
