diff --git a/host/gpu/gl/gl_renderer.hpp b/host/gpu/gl/gl_renderer.hpp
index 273c0b4..bc8687c 100644
--- a/host/gpu/gl/gl_renderer.hpp
+++ b/host/gpu/gl/gl_renderer.hpp
@@ -48,6 +48,9 @@ struct GlSettings {
     // uploads and the swap. `gpu_timing` adds a glFinish before the picture goes to the window and reports its wait, which
     // is the GPU's backlog for the frame; it changes the pacing, so it is for measuring only.
     std::uint32_t timing{0};
+    // Where the platform has a per-frame scratch pool (the Vita): each batch's vertices and indices are copied into it
+    // once and drawn from buffer objects, instead of client arrays the driver copies and scans per draw. 0 turns it off.
+    bool scratch_buffers{true};
     bool gpu_timing{false};
