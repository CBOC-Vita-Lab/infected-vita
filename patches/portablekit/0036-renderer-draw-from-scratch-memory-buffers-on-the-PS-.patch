     else if (name == "merge") settings.merge_draws = flag;
@@ -2377,7 +2428,7 @@ bool apply_gl_setting(GlSettings &settings, const std::string &name, const std::
 const std::vector<std::string> &gl_setting_names() {
     static const std::vector<std::string> names = {
         "display_scale", "display_scale_percent", "offscreen_scale", "no_blend_color", "through_depth", "texture_check_interval",
-        "writeback", "texture_budget_mb", "stats_every", "timing", "gpu_timing", "texture_always_validate", "merge", "null_draw", "depth_bits", "target_textures",
+        "writeback", "texture_budget_mb", "stats_every", "timing", "gpu_timing", "scratch_buffers", "texture_always_validate", "merge", "null_draw", "depth_bits", "target_textures",
         "use_glclear", "quad_clear", "rect_clamp", "cull", "lighting", "fog", "alpha_test", "blend", "depth_test", "flip_winding",
         "trace", "draw_first", "draw_last"};
