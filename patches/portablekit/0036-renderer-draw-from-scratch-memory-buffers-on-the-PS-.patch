     bool texture_always_validate{false};
@@ -148,6 +151,7 @@ struct GlStats {
     std::uint64_t mip_textures{};       // textures given a mip chain
     std::uint64_t mip_cpu_textures{};   // ... of which built on the CPU (alpha-weighted)
     std::uint64_t mip_upload_bytes{};
+    std::uint64_t scratch_batches{};   // batches drawn from the platform's scratch pool (settings.scratch_buffers)
     std::uint64_t post_passes{};        // full-screen passes: FXAA, resolve, bicubic, copy to the final picture
     std::uint64_t post_copies{};        // copies of a framebuffer made for a pass to read
     std::uint64_t smooth_draws{};       // 3D draws whose nearest filter was made linear
