+# zlib packs the pages of a GE dump (host/gpu/ge_dump.cpp); without it the
+# recorder stores them raw and a dump of packed pages cannot be read.
+function(_portablekit_use_zlib target)
+    # Looked for where it is used: imported targets belong to the directory
+    # that found them, and the ports' directories are not the framework's.
+    find_package(ZLIB QUIET)
+    if(ZLIB_FOUND)
+        target_compile_definitions(${target} PRIVATE PORTABLEKIT_HAS_ZLIB=1)
