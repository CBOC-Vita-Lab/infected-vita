+
+namespace portablekit::gpu {
+
+bool write_png_rgba(const std::string &path, const std::uint8_t *rgba, std::uint32_t width, std::uint32_t height) {
+    if (rgba == nullptr || width == 0u || height == 0u) return false;
+    // The host names its captures .bmp; write what the name says.
+    if (path.size() > 4u && path.compare(path.size() - 4u, 4u, ".bmp") == 0)
+        return stbi_write_bmp(path.c_str(), static_cast<int>(width), static_cast<int>(height), 4, rgba) != 0;
+    return stbi_write_png(path.c_str(), static_cast<int>(width), static_cast<int>(height), 4, rgba,
+                          static_cast<int>(width) * 4) != 0;
+}
