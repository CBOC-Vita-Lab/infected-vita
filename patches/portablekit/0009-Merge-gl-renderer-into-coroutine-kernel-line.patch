+# The OpenGL ES 2.0 renderer (host/gpu/gl), an alternative to the Vulkan one
+# with no window of its own: EGL without a surface on a desktop, vitaGL on the
+# PS Vita (docs/GL_RENDERER.md). renderer.cpp is shared by every GE backend.
+set(PORTABLEKIT_GL_RENDERER_SOURCES
+    host/gpu/gl/gl_renderer.cpp
+    host/gpu/gl/gl_shaders.cpp
+    host/gpu/gl/gl_png.cpp
+    host/gpu/gl/gl_platform_egl.cpp
+    CACHE INTERNAL "PortableKit GLES2 renderer sources, relative to PORTABLEKIT_ROOT")
+
+# Finds the EGL and GLESv2 headers and libraries, or takes them from
+# PORTABLEKIT_GL_INCLUDE_DIR and PORTABLEKIT_GL_LIBRARIES for a machine with
+# only the runtime libraries (Khronos's headers are enough).
+set(PORTABLEKIT_GL_INCLUDE_DIR "" CACHE PATH "Directory holding GLES2/gl2.h and EGL/egl.h, when the system has no development files")
+set(PORTABLEKIT_GL_LIBRARIES "" CACHE STRING "EGL and GLESv2 libraries (full paths or names), when find_library does not find them")
+function(_portablekit_find_gl)
+    if(NOT PORTABLEKIT_GL_LIBRARIES)
+        find_library(_portablekit_egl NAMES EGL libEGL.so.1)
+        find_library(_portablekit_gles NAMES GLESv2 libGLESv2.so.2)
+        if(_portablekit_egl AND _portablekit_gles)
+            set(PORTABLEKIT_GL_LIBRARIES "${_portablekit_egl};${_portablekit_gles}" CACHE STRING "" FORCE)
+        else()
+            message(FATAL_ERROR "PORTABLEKIT_GL_RENDERER needs libEGL and libGLESv2; set PORTABLEKIT_GL_LIBRARIES")
+        endif()
+    endif()
+    if(NOT PORTABLEKIT_GL_INCLUDE_DIR)
+        find_path(_portablekit_gl_include NAMES GLES2/gl2.h)
+        if(NOT _portablekit_gl_include)
+            message(FATAL_ERROR "PORTABLEKIT_GL_RENDERER needs GLES2/gl2.h and EGL/egl.h; set PORTABLEKIT_GL_INCLUDE_DIR")
+        endif()
+        set(PORTABLEKIT_GL_INCLUDE_DIR "${_portablekit_gl_include}" CACHE PATH "" FORCE)
+    endif()
+endfunction()
+function(_portablekit_use_gl target)
+    target_include_directories(${target} PRIVATE "${PORTABLEKIT_GL_INCLUDE_DIR}")
+    target_link_libraries(${target} PRIVATE ${PORTABLEKIT_GL_LIBRARIES})
+endfunction()
