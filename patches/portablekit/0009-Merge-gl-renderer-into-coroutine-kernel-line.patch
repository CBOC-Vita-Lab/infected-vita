+struct Options {
+    std::string dump;
+    std::string flips;
+    std::string upload_test;
+    std::string png;
+    std::string targets;
+    std::uint32_t scale{2};
+    std::uint32_t offscreen_scale{1};
+    bool stats{};
+    bool analyze{};
+    bool regs{};
+    std::set<std::uint64_t> detail;
+    bool null_draw{};
+    bool no_submit{};
+    std::uint32_t repeat{1};
+    std::vector<std::pair<std::string, std::string>> settings;
+};
+
+bool parse_flips(const std::string &text, std::vector<std::uint64_t> &out) {
+    const char *at = text.c_str();
+    while (*at != '\0') {
+        char *end = nullptr;
+        const std::uint64_t first = std::strtoull(at, &end, 10);
+        if (end == at) return false;
+        std::uint64_t last = first, step = 1;
+        at = end;
+        if (*at == '-') {
+            last = std::strtoull(at + 1, &end, 10);
+            if (end == at + 1) return false;
+            at = end;
+        }
+        if (*at == '/') {
+            step = std::max<std::uint64_t>(std::strtoull(at + 1, &end, 10), 1u);
+            at = end;
+        }
+        for (std::uint64_t flip = first; flip <= last; flip += step) out.push_back(flip);
+        if (*at == ',') ++at;
+        else if (*at != '\0') return false;
+    }
+    return true;
+}
+
+std::string with_flip(const std::string &pattern, std::uint64_t flip, const char *suffix = "") {
+    char number[32];
+    std::snprintf(number, sizeof number, "%06llu", static_cast<unsigned long long>(flip));
+    std::string out = pattern;
+    if (const std::size_t at = out.find("{flip}"); at != std::string::npos) {
+        out.replace(at, 6, number);
+    } else {
+        const std::size_t dot = out.rfind('.');
+        const std::string tail = dot == std::string::npos ? std::string(".png") : out.substr(dot);
+        out = (dot == std::string::npos ? out : out.substr(0, dot)) + "_" + number + tail;
+    }
+    if (*suffix != '\0') {
+        const std::size_t dot = out.rfind('.');
+        out = out.substr(0, dot) + suffix + out.substr(dot);
+    }
+    return out;
+}
+
+// A renderer that renders nothing and writes down what the draws ask for.
+class AnalyzeRenderer final : public gpu::Renderer {
+public:
+    std::set<std::uint64_t> detail;
+    static void print_matrix(const char *name, const std::array<float, 16> &m) {
+        std::printf("    %s:", name);
+        for (int row = 0; row < 4; ++row) {
+            std::printf("  [");
+            for (int col = 0; col < 4; ++col) std::printf("%s%.3f", col != 0 ? " " : "", m[row * 4 + col]);
+            std::printf("]");
+        }
+        std::printf("\n");
+    }
+    void print_detail(const gpu::DrawCall &call, const gpu::GuestMemory &memory) const {
+        print_matrix("world", call.world);
+        print_matrix("view ", call.view);
+        print_matrix("proj ", call.projection);
+        std::printf("    fog %d end %.3f scale %.5f color %06X; light amb %08X alpha %02X emissive %08X mat_d %08X update %X\n",
+                    call.fog.enabled ? 1 : 0, call.fog.end, call.fog.scale, call.fog.color & 0xFFFFFFu,
+                    call.lighting.ambient_color, call.lighting.ambient_alpha, call.lighting.material_emissive,
+                    call.lighting.material_diffuse, call.lighting.material_update);
+        for (int i = 0; i < 4; ++i) {
+            const gpu::LightState &l = call.lighting.lights[i];
+            if (l.enabled)
+                std::printf("    light %d type %u kind %u pos %.2f %.2f %.2f diff %08X amb %08X\n", i, l.type, l.kind,
+                            l.position[0], l.position[1], l.position[2], l.diffuse, l.ambient);
+        }
+        if (call.texture.enabled && call.texture.width * call.texture.height > 16u) {
+            // Larger textures: how many decoded texels are not black, to tell a blank picture from a wrong one.
+            std::vector<std::uint32_t> texels;
+            if (gpu::decode_texture(memory, call.texture, texels)) {
+                std::size_t lit = 0;
+                std::uint32_t first = 0, brightest = 0;
+                for (const std::uint32_t texel : texels) {
+                    if ((texel & 0x00FFFFFFu) == 0u) continue;
+                    if (lit == 0u) first = texel;
+                    ++lit;
+                    brightest = std::max(brightest, std::max({texel & 0xFFu, (texel >> 8u) & 0xFFu, (texel >> 16u) & 0xFFu}));
+                }
+                std::printf("    texture decoded from guest memory: %zu of %zu texels not black (brightest channel %u), first %08X\n",
+                            lit, texels.size(), brightest, first);
+            }
+        }
+        if (call.texture.enabled && call.texture.width * call.texture.height <= 16u) {
+            // A texture this small is a flat colour or a gradient: print its decoded texels (RGBA, red lowest).
+            std::vector<std::uint32_t> texels;
+            if (gpu::decode_texture(memory, call.texture, texels)) {
+                std::printf("    texels:");
+                for (const std::uint32_t texel : texels) std::printf(" %08X", texel);
+                std::printf("\n    raw texture bytes:");
+                for (std::uint32_t i = 0; i < 32u; ++i) std::printf(" %02X", memory.load8(call.texture.address + i));
+                std::printf("\n    palette:");
+                for (std::uint32_t i = 0; i < 8u; ++i) std::printf(" %08X", memory.load32(call.texture.clut_address + i * 4u));
+                std::printf("\n");
+            }
+        }
+        const std::size_t count = call.vertices.empty() ? 0u : std::min<std::size_t>(call.vertices.size(), 6u);
+        for (std::size_t i = 0; i < count; ++i) {
+            const gpu::Vertex &v = call.vertices[i];
+            std::printf("    v%zu pos %.3f %.3f %.3f n %.2f %.2f %.2f uv %.3f %.3f col %08X", i, v.position[0],
+                        v.position[1], v.position[2], v.normal[0], v.normal[1], v.normal[2], v.texcoord[0],
+                        v.texcoord[1], v.color);
+            if (!call.through) {
+                // world * view * projection with the row-vector convention the GE uses, row-major here.
+                float p[4] = {v.position[0], v.position[1], v.position[2], 1.0f}, q[4], r[4], c[4];
+                for (int col = 0; col < 4; ++col) {
+                    q[col] = p[0] * call.world[col] + p[1] * call.world[4 + col] + p[2] * call.world[8 + col] + call.world[12 + col];
+                }
+                for (int col = 0; col < 4; ++col) {
+                    r[col] = q[0] * call.view[col] + q[1] * call.view[4 + col] + q[2] * call.view[8 + col] + q[3] * call.view[12 + col];
+                }
+                for (int col = 0; col < 4; ++col) {
+                    c[col] = r[0] * call.projection[col] + r[1] * call.projection[4 + col] + r[2] * call.projection[8 + col] + r[3] * call.projection[12 + col];
+                }
+                std::printf(" | view %.2f %.2f %.2f clip %.3f %.3f %.3f %.3f", r[0], r[1], r[2], c[0], c[1], c[2], c[3]);
+            }
+            std::printf("\n");
+        }
+    }
+    bool initialize(const gpu::RendererConfig &, std::string &) override { return true; }
+    void shutdown() override {}
+    [[nodiscard]] bool available() const noexcept override { return true; }
+    void begin_display_list() override { std::printf("-- display list run begins after draw %llu\n", static_cast<unsigned long long>(draws)); }
+    void submit(const gpu::DrawCall &call, const gpu::GuestMemory &memory) override {
+        ++draws;
+        std::printf("draw %3llu prim=%d %s vtype=0x%X n=%zu%s target=0x%08X stride=%u fmt=%u tex=%d",
+                    static_cast<unsigned long long>(draws), static_cast<int>(call.primitive),
+                    call.through ? "through" : "xform  ", call.vertex_type,
+                    call.vertices.empty() ? std::size_t{call.raw_count} : call.vertices.size(),
+                    call.indices.empty() ? "" : "i", call.target.color_address, call.target.color_stride,
+                    call.target.color_format, call.texture.enabled ? 1 : 0);
+        if (call.texture.enabled)
+            std::printf("[0x%08X %ux%u bw=%u f=%u sw=%d clut=0x%08X/%u fn=%u tcc=%d flt=%u/%u wrap=%u/%u]",
+                        call.texture.address, call.texture.width, call.texture.height, call.texture.buffer_width,
+                        static_cast<unsigned>(call.texture.format), call.texture.swizzled ? 1 : 0,
+                        call.texture.clut_address, call.texture.clut_format, call.texture.function,
+                        call.texture.alpha_from_texture ? 1 : 0, call.texture.min_filter, call.texture.mag_filter,
+                        call.texture.wrap_s, call.texture.wrap_t);
+        std::printf(" blend=%d[%u,%u,eq%u,fix %06X/%06X] depth=%d/%d f%u rng[%u,%u] alpha=%d[f%u r%u m%X] cull=%d/%d",
+                    call.blend.enabled ? 1 : 0, call.blend.source_factor, call.blend.destination_factor,
+                    call.blend.equation, call.blend.fixed_source & 0xFFFFFFu, call.blend.fixed_destination & 0xFFFFFFu,
+                    call.depth.test_enabled ? 1 : 0, call.depth.write_enabled ? 1 : 0, call.depth.function,
+                    call.depth.range_near, call.depth.range_far, call.alpha_test.enabled ? 1 : 0,
+                    call.alpha_test.function, call.alpha_test.reference, call.alpha_test.mask,
+                    call.culling_enabled ? 1 : 0, call.cull_clockwise ? 1 : 0);
+        std::printf(" vp[s %.1f %.1f %.1f o %.1f %.1f %.1f r %.1f %.1f] sc[%u,%u-%u,%u] light=%d fog=%d clear=%d/%u mat=%08X\n",
+                    call.viewport.x_scale, call.viewport.y_scale, call.viewport.z_scale, call.viewport.x_offset,
+                    call.viewport.y_offset, call.viewport.z_offset, call.viewport.offset_x, call.viewport.offset_y,
+                    call.viewport.scissor_x1, call.viewport.scissor_y1, call.viewport.scissor_x2,
+                    call.viewport.scissor_y2, call.lighting_enabled ? 1 : 0, call.fog.enabled ? 1 : 0,
+                    call.clear_mode ? 1 : 0, call.clear_flags, call.material_color);
+        if (detail.count(draws) != 0u) print_detail(call, memory);
+    }
+    void write_back_frame(gpu::GuestMemory &) override {}
+    void read_back_framebuffer(std::uint32_t, gpu::GuestMemory &) override {}
+    void upload_frame(std::uint32_t address, const std::uint8_t *, std::uint32_t width, std::uint32_t height,
+                      std::uint32_t stride) override {
+        std::printf("upload_frame 0x%08X %ux%u stride %u\n", address, width, height, stride);
+    }
+    bool present(std::uint32_t address, std::optional<Clock::time_point>) override {
+        std::printf("present 0x%08X (%llu draws)\n", address, static_cast<unsigned long long>(draws));
+        ++frames;
+        return true;
+    }
+    bool capture_frame(const std::string &) override { return false; }
+    [[nodiscard]] std::uint64_t frames_presented() const noexcept override { return frames; }
+    [[nodiscard]] std::uint64_t draws_submitted() const noexcept override { return draws; }
+    std::uint64_t draws{}, frames{};
+};
+
+constexpr std::uint32_t kEdramBase = 0x04000000u;
+
+} // namespace
+
+#if defined(GE_REPLAY_HAS_GL)
+// --upload-test PATH: the path a movie takes (the CPU writes a picture into memory, the host hands it to
+// upload_frame and presents it) with a picture whose four quadrants and centre are known: checks that the
+// presented image is upright and its colours are in the right channels, and writes it to PATH.
+int run_upload_test(const Options &options) {
+    gpu::GlRenderer renderer;
+    gpu::GlSettings settings = renderer.settings();
+    settings.display_scale = options.scale;
+    renderer.set_settings(settings);
+    std::string error;
+    if (!renderer.initialize(gpu::RendererConfig{}, error)) {
+        std::cerr << "renderer: " << error << "\n";
+        return 1;
+    }
+    constexpr std::uint32_t kWidth = 480u, kHeight = 272u, kStride = 512u;
+    std::vector<std::uint8_t> picture(static_cast<std::size_t>(kStride) * kHeight * 4u, 0u);
+    const auto put = [&](std::uint32_t x, std::uint32_t y, std::uint8_t r, std::uint8_t g, std::uint8_t b) {
+        std::uint8_t *at = picture.data() + (static_cast<std::size_t>(y) * kStride + x) * 4u;
+        at[0] = r, at[1] = g, at[2] = b, at[3] = 0xFFu;  // PSP 8888: R, G, B, A in memory order
+    };
+    for (std::uint32_t y = 0; y < kHeight; ++y)
+        for (std::uint32_t x = 0; x < kWidth; ++x) {
+            if (y < kHeight / 2) {
+                if (x < kWidth / 2) put(x, y, 255, 0, 0);       // top left: red
+                else put(x, y, 0, 255, 0);                       // top right: green
+            } else {
+                if (x < kWidth / 2) put(x, y, 0, 0, 255);       // bottom left: blue
+                else put(x, y, 255, 255, 255);                   // bottom right: white
+            }
+        }
+    for (std::uint32_t y = 130; y < 142; ++y)
+        for (std::uint32_t x = 234; x < 246; ++x) put(x, y, 255, 255, 0);  // a yellow square in the middle
+    constexpr std::uint32_t kAddress = 0x0A000000u;  // main memory, as a CPU-written frame is
+    renderer.begin_display_list();
+    renderer.upload_frame(kAddress, picture.data(), kWidth, kHeight, kStride);
+    renderer.present(kAddress);
+    std::vector<std::uint8_t> rgba;
+    std::uint32_t width = 0, height = 0;
+    if (!renderer.read_presented(rgba, width, height)) {
+        std::cerr << "nothing presented\n";
+        return 1;
+    }
+    const std::uint32_t scale = width / kWidth;
+    const auto pixel = [&](std::uint32_t x, std::uint32_t y) {
+        const std::uint8_t *at = rgba.data() + (static_cast<std::size_t>(y * scale + scale / 2u) * width + x * scale + scale / 2u) * 4u;
+        return std::array<int, 3>{at[0], at[1], at[2]};
+    };
+    struct Check { const char *name; std::uint32_t x, y; std::array<int, 3> expected; };
+    const Check checks[] = {{"top left red", 60, 40, {255, 0, 0}},     {"top right green", 420, 40, {0, 255, 0}},
+                            {"bottom left blue", 60, 230, {0, 0, 255}}, {"bottom right white", 420, 230, {255, 255, 255}},
+                            {"centre yellow", 240, 136, {255, 255, 0}}};
+    int failures = 0;
+    for (const Check &check : checks) {
+        const auto got = pixel(check.x, check.y);
+        int worst = 0;
+        for (int c = 0; c < 3; ++c) worst = std::max(worst, std::abs(got[c] - check.expected[c]));
+        const bool ok = worst <= 2;
+        std::printf("  %-20s expected %3d %3d %3d, got %3d %3d %3d  %s\n", check.name, check.expected[0], check.expected[1],
+                    check.expected[2], got[0], got[1], got[2], ok ? "ok" : "WRONG");
+        if (!ok) ++failures;
+    }
+    gpu::write_png_rgba(options.upload_test, rgba.data(), width, height);
+    std::printf("upload test: %s (%ux%u -> %s)\n", failures == 0 ? "PASS" : "FAIL", width, height, options.upload_test.c_str());
+    return failures == 0 ? 0 : 1;
+}
+#endif
+
+int main(int argc, char **argv) {
+    Options options;
+    for (int i = 1; i < argc; ++i) {
+        const std::string arg = argv[i];
+        const auto value = [&]() -> std::string { return i + 1 < argc ? argv[++i] : std::string(); };
+        if (arg == "--flips") options.flips = value();
+        else if (arg == "--upload-test") options.upload_test = value();
+        else if (arg == "--png") options.png = value();
+        else if (arg == "--targets") options.targets = value();
+        else if (arg == "--scale") options.scale = static_cast<std::uint32_t>(std::atoi(value().c_str()));
+        else if (arg == "--offscreen-scale") options.offscreen_scale = static_cast<std::uint32_t>(std::atoi(value().c_str()));
+        else if (arg == "--stats") options.stats = true;
+        else if (arg == "--analyze") options.analyze = true;
+        else if (arg == "--regs") options.regs = true;
+        else if (arg == "--detail") {
+            std::vector<std::uint64_t> list;
+            if (!parse_flips(value(), list)) return 2;
+            options.detail.insert(list.begin(), list.end());
+        } else if (arg == "--null-draw") options.null_draw = true;
+        else if (arg == "--no-submit") options.no_submit = true;
+        else if (arg == "--repeat") options.repeat = static_cast<std::uint32_t>(std::max(1, std::atoi(value().c_str())));
+        else if (arg == "--set") {
+            const std::string pair = value();
+            const std::size_t eq = pair.find('=');
+            if (eq == std::string::npos) {
+                std::cerr << "--set wants KEY=VALUE\n";
+                return 2;
+            }
+            options.settings.emplace_back(pair.substr(0, eq), pair.substr(eq + 1));
+        } else if (!arg.empty() && arg[0] != '-' && options.dump.empty()) options.dump = arg;
+        else {
+            std::cerr << "unknown argument " << arg << "\n";
+            return 2;
+        }
+    }
+#if defined(GE_REPLAY_HAS_GL)
+    if (!options.upload_test.empty()) return run_upload_test(options);
+#endif
+    if (options.dump.empty()) {
+        std::cerr << "usage: ge_replay <dump dir> [--flips LIST] [--png PATH] [--targets DIR] [--scale N] [--stats] ...\n";
+        return 2;
+    }
+
+    std::vector<std::uint64_t> flips;
+    if (options.flips.empty()) flips = gpu::gedump::list_flips(options.dump);
+    else if (!parse_flips(options.flips, flips)) {
+        std::cerr << "cannot read --flips " << options.flips << "\n";
+        return 2;
+    }
+    if (flips.empty()) {
+        std::cerr << "no flips in " << options.dump << "\n";
+        return 1;
+    }
+
+    std::unique_ptr<gpu::Renderer> renderer;
+#if defined(GE_REPLAY_HAS_GL)
+    gpu::GlRenderer *gl = nullptr;
+#endif
+    AnalyzeRenderer *analyze = nullptr;
+    if (options.analyze) {
+        auto made = std::make_unique<AnalyzeRenderer>();
+        analyze = made.get();
+        made->detail = options.detail;
+        renderer = std::move(made);
+    } else {
+#if defined(GE_REPLAY_HAS_GL)
+        auto made = std::make_unique<gpu::GlRenderer>();
+        gpu::GlSettings settings = made->settings();
+        settings.display_scale = options.scale;
+        settings.offscreen_scale = options.offscreen_scale;
+        settings.null_draw = options.null_draw;
+        for (const auto &[key, text] : options.settings) {
+            if (!gpu::apply_gl_setting(settings, key, text)) {
+                std::cerr << "unknown setting " << key << " (known:";
+                for (const std::string &name : gpu::gl_setting_names()) std::cerr << ' ' << name;
+                std::cerr << ")\n";
+                return 2;
+            }
+        }
+        made->set_settings(settings);
+        gl = made.get();
+        renderer = std::move(made);
+#else
+        std::cerr << "this build has no GL renderer; use --analyze\n";
+        return 1;
+#endif
+    }
+    std::string error;
+    if (!renderer->initialize(gpu::RendererConfig{}, error)) {
+        std::cerr << "renderer: " << error << "\n";
+        return 1;
+    }
+#if defined(GE_REPLAY_HAS_GL)
+    if (gl != nullptr) std::cerr << "renderer: " << gl->gl_description() << "\n";
+#endif
+
+    gpu::gedump::Pack pack;
+    if (!pack.open(std::filesystem::path(options.dump) / "pages.pack", error)) {
+        std::cerr << error << "\n";
+        return 1;
+    }
+
+    std::unique_ptr<gpu::GuestMemory> memory;
+    gpu::GeState ge;
+    std::map<std::uint64_t, std::uint64_t> register_values;
+    std::map<std::uint32_t, std::uint64_t> mask_draws;
+    double total_walk_ms = 0, total_flip_ms = 0, total_submit_ms = 0, total_present_ms = 0;
+    std::uint64_t replayed = 0;
+    std::uint64_t transfers = 0;
+    std::uint64_t picture_uploads = 0, memory_flips = 0;  // movie frames: CPU-written pictures and flips shown from main memory
+    for (std::uint32_t pass = 0; pass < options.repeat; ++pass) {
+        for (const std::uint64_t flip : flips) {
+            gpu::gedump::FlipDump dump;
+            if (!gpu::gedump::load_flip(options.dump, flip, dump, error)) {
+                std::cerr << error << "\n";
+                return 1;
+            }
+            if (!memory) memory = std::make_unique<gpu::GuestMemory>(dump.ram_size);
+            if (!gpu::gedump::restore_base(pack, dump, *memory)) {
+                std::cerr << "cannot restore the memory of flip " << flip << "\n";
+                return 1;
+            }
+            if (!dump.ge_state.empty() && !ge.load_state(dump.ge_state.data(), dump.ge_state.size())) {
+                std::cerr << "cannot load the GE state of flip " << flip << "\n";
+                return 1;
+            }
+            if (analyze != nullptr) std::printf("== flip %llu\n", static_cast<unsigned long long>(flip));
+            const Clock::time_point flip_start = Clock::now();
+            double walk_ms = 0, submit_ms = 0, present_ms = 0;
+            bool first_event = true;
+            for (const gpu::gedump::Event &event : dump.events) {
+                if (!first_event && !gpu::gedump::apply_event_memory(pack, event, dump, *memory)) {
+                    std::cerr << "cannot apply memory changes in flip " << flip << "\n";
+                    return 1;
+                }
+                first_event = false;
+                switch (event.kind) {
+                case gpu::gedump::EventKind::ListRun: {
+                    renderer->begin_display_list();
+                    if (options.no_submit) ge.set_draw_sink([](const gpu::DrawCall &) {});
+                    else
+                        ge.set_draw_sink([&](const gpu::DrawCall &call) {
+                            if (options.regs) {
+                                static const std::uint32_t watched[] = {0x1Cu, 0x20u, 0x24u, 0x25u, 0x26u, 0x27u, 0x28u,
+                                                                       0xD8u, 0xD9u, 0xDAu, 0xDBu, 0xDCu, 0xDDu, 0xE2u,
+                                                                       0xE3u, 0xE4u, 0xE5u, 0xE6u, 0xE8u, 0xE9u};
+                                for (const std::uint32_t reg : watched) {
+                                    const std::uint32_t value = ge.registers()[reg];
+                                    if (value != 0u) ++register_values[(static_cast<std::uint64_t>(reg) << 32u) | value];
+                                }
+                                std::uint32_t masks = ge.registers()[0xE8u] | (ge.registers()[0xE9u] << 24u);
+                                ++mask_draws[masks];
+                            }
+                            const Clock::time_point submit_start = Clock::now();
+                            renderer->submit(call, *memory);
+                            submit_ms += std::chrono::duration<double, std::milli>(Clock::now() - submit_start).count();
+                        });
+                    // A GE block transfer, as the host does it (hle_media.cpp): what the renderer drew at the source
+                    // goes back to guest memory first, the rows are copied, and textures looked up in this list
+                    // may have changed.
+                    ge.set_transfer_sink([&](const gpu::BlockTransfer &transfer) {
+                        renderer->read_back_framebuffer(transfer.source, *memory);
+                        const std::size_t row_bytes = static_cast<std::size_t>(transfer.width) * transfer.bytes_per_pixel;
+                        for (std::uint32_t row = 0; row < transfer.height; ++row) {
+                            const std::uint32_t from = transfer.source + ((transfer.source_y + row) * transfer.source_stride +
+                                                                          transfer.source_x) * transfer.bytes_per_pixel;
+                            const std::uint32_t to = transfer.destination +
+                                                     ((transfer.destination_y + row) * transfer.destination_stride +
+                                                      transfer.destination_x) * transfer.bytes_per_pixel;
+                            const std::uint8_t *source = memory->raw_pointer(from, row_bytes);
+                            std::uint8_t *destination = memory->raw_pointer(to, row_bytes);
+                            if (source == nullptr || destination == nullptr) return;
+                            std::memmove(destination, source, row_bytes);
+                        }
+                        ++transfers;
+                        renderer->begin_display_list();
+                    });
+                    const Clock::time_point walk_start = Clock::now();
+                    bool finished = false;
+                    try {
+                        ge.execute(*memory, event.b, event.c, finished);
+                    } catch (const std::exception &failure) {
+                        std::cerr << "flip " << flip << ": list aborted: " << failure.what() << "\n";
+                    }
+                    walk_ms += std::chrono::duration<double, std::milli>(Clock::now() - walk_start).count();
+                    ge.set_draw_sink(nullptr);
+                    break;
+                }
+                case gpu::gedump::EventKind::Picture: {
+                    if (event.e != 3u || (event.a & 0x1F000000u) != kEdramBase) break;
+                    const std::size_t bytes = static_cast<std::size_t>(event.d) * event.c * 4u;
+                    renderer->upload_frame(event.a | kEdramBase, memory->raw_pointer(event.a, bytes), event.b, event.c,
+                                           event.d);
+                    ++picture_uploads;
+                    break;
+                }
+                case gpu::gedump::EventKind::Flip: {
+                    const gpu::gedump::DisplayInfo &d = dump.display;
+                    const std::uint32_t address =
+                        (d.framebuffer & 0xFF000000u) == 0u ? (d.framebuffer | 0x04000000u) : d.framebuffer;
+                    if ((address & 0x1F000000u) != kEdramBase && d.pixel_format == 3u) {
+                        const std::size_t bytes = static_cast<std::size_t>(d.buffer_width) * d.height * 4u;
+                        renderer->upload_frame(address, memory->raw_pointer(address, bytes), d.width, d.height,
+                                               d.buffer_width);
+                        ++memory_flips;
+                    }
+                    const Clock::time_point present_start = Clock::now();
+                    renderer->write_back_frame(*memory);
+                    renderer->present(address);
+                    present_ms += std::chrono::duration<double, std::milli>(Clock::now() - present_start).count();
+                    break;
+                }
+                }
+            }
+            const double flip_ms = std::chrono::duration<double, std::milli>(Clock::now() - flip_start).count();
+            total_walk_ms += walk_ms;
+            total_submit_ms += submit_ms;
+            total_present_ms += present_ms;
+            total_flip_ms += flip_ms;
+            ++replayed;
+#if defined(GE_REPLAY_HAS_GL)
+            if (gl != nullptr) {
+                gl->flush();
+                if (!options.png.empty() && pass + 1 == options.repeat) {
+                    std::vector<std::uint8_t> rgba;
+                    std::uint32_t w = 0, h = 0;
+                    if (gl->read_presented(rgba, w, h)) {
+                        const std::string path = with_flip(options.png, flip);
+                        if (!gpu::write_png_rgba(path, rgba.data(), w, h)) std::cerr << "cannot write " << path << "\n";
+                    } else {
+                        std::cerr << "flip " << flip << ": nothing was presented\n";
+                    }
+                }
+                if (!options.targets.empty() && pass + 1 == options.repeat) {
+                    std::error_code ignored;
+                    std::filesystem::create_directories(options.targets, ignored);
+                    for (const std::uint32_t address : gl->target_addresses()) {
+                        std::vector<std::uint8_t> rgba;
+                        std::uint32_t w = 0, h = 0;
+                        if (!gl->read_target(address, rgba, w, h)) continue;
+                        char name[64];
+                        std::snprintf(name, sizeof name, "{flip}_t%08X.png", address);
+                        const std::string path = (std::filesystem::path(options.targets) / with_flip(name, flip)).string();
+                        gpu::write_png_rgba(path, rgba.data(), w, h);
+                    }
+                }
+                if (options.stats && pass + 1 == options.repeat) {
+                    const gpu::GlStats &s = gl->frame_stats();
+                    const auto n = [](std::uint64_t v) { return static_cast<unsigned long long>(v); };
+                    std::printf("flip %llu: submits %llu gl_draws %llu verts_in %llu up %llu idx %llu fbo %llu prog %llu "
+                                "texbind %llu blend %llu depth %llu cull %llu scissor %llu viewport %llu mask %llu "
+                                "uniforms %llu(-%llu) tex hit/miss %llu/%llu chk %llu stale %llu hash %lluB/%llu "
+                                "tgt %llu fb %llu clear %llu | decode %.2f submit %.2f present %.2f flip %.2f ms\n",
+                                n(flip), n(s.submits), n(s.gl_draws), n(s.vertices_in), n(s.vertices_uploaded),
+                                n(s.indices_uploaded), n(s.target_switches), n(s.program_switches), n(s.texture_binds),
+                                n(s.blend_changes), n(s.depth_changes), n(s.cull_changes), n(s.scissor_changes),
+                                n(s.viewport_changes), n(s.mask_changes), n(s.uniform_uploads), n(s.uniform_skipped),
+                                n(s.texture_hits), n(s.texture_misses), n(s.texture_checks), n(s.texture_stale),
+                                n(s.hash_bytes), n(s.hash_calls), n(s.target_samples), n(s.feedback_copies), n(s.clears),
+                                walk_ms - submit_ms, submit_ms, present_ms, flip_ms);
+                }
+                gl->reset_frame_stats();
+            }
+#endif
+        }
+    }
+    if (options.regs) {
+        for (const auto &[key, count] : register_values)
+            std::printf("reg 0x%02X = 0x%06X : %llu draws\n", static_cast<unsigned>(key >> 32u),
+                        static_cast<unsigned>(key & 0xFFFFFFFFu), static_cast<unsigned long long>(count));
+        for (const auto &[value, count] : mask_draws)
+            std::printf("pixel mask rgb 0x%06X alpha 0x%02X : %llu draws\n", value & 0xFFFFFFu, value >> 24u,
+                        static_cast<unsigned long long>(count));
+    }
+#if defined(GE_REPLAY_HAS_GL)
+    if (gl != nullptr && options.stats) {
+        const gpu::GlStats &t = gl->total_stats();
+        const auto n = [](std::uint64_t v) { return static_cast<unsigned long long>(v); };
+        const double flips_n = replayed != 0u ? static_cast<double>(replayed) : 1.0;
+        std::printf("total over %llu flips (per flip in brackets):\n", n(replayed));
+        std::printf("  movie frames: %llu CPU-written pictures in VRAM, %llu flips shown from main memory; %llu GE block transfers\n",
+                    n(picture_uploads), n(memory_flips), n(transfers));
+        const auto line = [&](const char *name, std::uint64_t v) {
+            std::printf("  %-28s %12llu  [%.1f]\n", name, n(v), static_cast<double>(v) / flips_n);
+        };
+        line("draw calls from the GE", t.submits);
+        line("GL draws after merging", t.gl_draws);
+        line("submits merged into one", t.merged);
+        line("vertices decoded", t.vertices_in);
+        line("vertices uploaded", t.vertices_uploaded);
+        line("indices uploaded", t.indices_uploaded);
+        line("bytes uploaded", t.bytes_uploaded);
+        line("triangles/lines sent", t.triangles);
+        line("render target switches", t.target_switches);
+        line("program switches", t.program_switches);
+        line("texture binds", t.texture_binds);
+        line("texture param changes", t.texture_param_changes);
+        line("blend state changes", t.blend_changes);
+        line("depth state changes", t.depth_changes);
+        line("cull state changes", t.cull_changes);
+        line("scissor changes", t.scissor_changes);
+        line("viewport changes", t.viewport_changes);
+        line("colour mask changes", t.mask_changes);
+        line("uniform uploads", t.uniform_uploads);
+        line("uniform uploads avoided", t.uniform_skipped);
+        line("texture cache hits", t.texture_hits);
+        line("texture decodes/uploads", t.texture_misses);
+        line("texture revalidations", t.texture_checks);
+        line("revalidations that changed", t.texture_stale);
+        line("texture upload bytes", t.texture_upload_bytes);
+        line("hash bytes (textures)", t.hash_bytes);
+        line("hash bytes (CLUTs)", t.clut_hash_bytes);
+        line("hash calls", t.hash_calls);
+        line("full hashes", t.texture_hash_full);
+        line("sampled hashes", t.texture_hash_sample);
+        line("render target samples", t.target_samples);
+        line("feedback copies", t.feedback_copies);
+        line("glClear calls", t.clears);
+        line("textures evicted", t.texture_evicted);
+        line("approximated blends", t.unsupported_blend);
+        {
+            static const char *const names[gpu::GlStats::kBreakCount] = {
+                "program", "target/viewport/scissor", "depth state", "cull/colour mask", "blend", "texture/sampler",
+                "texture env/uv/alpha", "transform/fog", "lighting/material", "other"};
+            std::printf("  why a draw did not join the batch (first differing group):\n");
+            for (std::size_t i = 0; i < gpu::GlStats::kBreakCount; ++i)
+                std::printf("    %-26s %10llu  [%.1f]\n", names[i], n(t.merge_breaks[i]),
+                            static_cast<double>(t.merge_breaks[i]) / flips_n);
+        }
+        std::printf("  shader variants %zu, shader compile+link %.1f ms, %zu cached textures (%llu KiB)\n",
+                    gl->shader_variants(), static_cast<double>(t.shader_compile_us) / 1000.0, gl->cached_textures(),
+                    n(gl->cached_texture_bytes() / 1024u));
+        std::printf("time per flip: GE walk + vertex decode %.2f ms, GL submission %.2f ms (draw submit %.2f + "
+                    "present/flush %.2f), whole flip %.2f ms\n",
+                    (total_walk_ms - total_submit_ms) / flips_n, (total_submit_ms + total_present_ms) / flips_n,
+                    total_submit_ms / flips_n, total_present_ms / flips_n, total_flip_ms / flips_n);
+        for (const std::string &name : gl->shader_variant_names()) std::printf("  shader %s\n", name.c_str());
+    }
+#endif
+    return 0;
+}
