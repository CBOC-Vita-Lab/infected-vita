@@ -0,0 +1,53 @@
+#pragma once
+
+// The one place the GLES2 renderer differs between its platforms.
+//
+// Everything else in host/gpu/gl is plain OpenGL ES 2.0 and GLSL ES 1.00, so
+// the same source runs on desktop Mesa (llvmpipe, headless) and on the PS Vita
+// through vitaGL. A platform provides:
+//   - the GL headers (here),
+//   - a context (glp::create_context / destroy_context),
+//   - what the driver lacks (glp::Caps, which a port to a new platform fills
+//     in and the desktop build can also force, to test the narrower path).
+#if defined(__vita__)
+#include <vitaGL.h>
+#else
+#define GL_GLEXT_PROTOTYPES 1
+#include <GLES2/gl2.h>
+#include <GLES2/gl2ext.h>
+#endif
+
+#include <cstdint>
+#include <string>
+
+namespace portablekit::gpu::glp {
+
+// The renderer assumes framebuffer objects are GL-conformant: a texture attached to one is sampled
+// the way it was drawn. That is vitaGL's default; one built with HAVE_UNFLIPPED_FBOS is not, and the
+// renderer does not compensate (docs/GL_RENDERER.md).
+struct Caps {
+    // glBlendColor and the CONSTANT_COLOR blend factors. vitaGL has neither
+    // (GXM has no constant blend colour), so a blend that needs one is built
+    // in the fragment shader instead.
+    bool blend_color{true};
+    // GL_MIN / GL_MAX blend equations (EXT_blend_minmax).
+    bool blend_minmax{true};
+    std::uint32_t max_texture_size{2048};
+    // The size of the window (the Vita's screen) the finished frame is drawn into.
+    std::uint32_t window_width{960};
+    std::uint32_t window_height{544};
+    // Strings for logs.
+    std::string vendor, renderer, version;
+};
+
+// Creates a context and makes it current. On desktop that is EGL with no
+// window (a pbuffer, or EGL_KHR_surfaceless_context); on the Vita, vglInit.
+bool create_context(std::string &error);
+void destroy_context();
+// Whether the platform has a window the finished frame should be drawn into.
+[[nodiscard]] bool has_window();
+// Ends a frame on the window; nothing without one.
+void swap_buffers();
+[[nodiscard]] Caps &caps();
+
+} // namespace portablekit::gpu::glp
