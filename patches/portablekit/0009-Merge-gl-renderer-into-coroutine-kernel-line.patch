+}
+
+void GeState::save_state(std::vector<std::uint8_t> &out) const {
+    out.clear();
+    const auto put = [&out](const void *data, std::size_t size) {
+        const auto *bytes = static_cast<const std::uint8_t *>(data);
+        out.insert(out.end(), bytes, bytes + size);
+    };
+    const std::uint32_t magic = kStateMagic;
+    put(&magic, sizeof magic);
+    std::apply(
+        [&put](const auto &...field) {
+            static_assert((std::is_trivially_copyable_v<std::remove_cvref_t<decltype(field)>> && ...));
+            (put(&field, sizeof field), ...);
+        },
+        state_fields(*this));
+    const std::uint32_t depth = static_cast<std::uint32_t>(call_stack_.size());
+    put(&depth, sizeof depth);
+    put(call_stack_.data(), call_stack_.size() * sizeof(std::uint32_t));
+}
+
+bool GeState::load_state(const std::uint8_t *data, std::size_t size) {
+    std::size_t at = 0;
+    bool ok = true;
+    const auto take = [&](void *to, std::size_t bytes) {
+        if (!ok || at + bytes > size) {
+            ok = false;
+            return;
+        }
+        std::memcpy(to, data + at, bytes);
+        at += bytes;
+    };
+    std::uint32_t magic = 0;
+    take(&magic, sizeof magic);
+    if (!ok || magic != kStateMagic) return false;
+    // Parsed into copies first, so that a short or foreign blob changes nothing.
+    GeState loaded;
+    std::apply([&take](auto &...field) { (take(&field, sizeof field), ...); }, state_fields(loaded));
+    std::uint32_t depth = 0;
+    take(&depth, sizeof depth);
+    if (!ok || depth > (size - at) / sizeof(std::uint32_t)) return false;
+    loaded.call_stack_.resize(depth);
+    take(loaded.call_stack_.data(), depth * sizeof(std::uint32_t));
+    if (!ok) return false;
+    auto destination = state_fields(*this);
+    auto source = state_fields(loaded);
+    [&]<std::size_t... I>(std::index_sequence<I...>) {
+        ((std::get<I>(destination) = std::get<I>(source)), ...);
+    }(std::make_index_sequence<std::tuple_size_v<decltype(destination)>>{});
+    call_stack_ = std::move(loaded.call_stack_);
+    return true;
+}
