diff --git a/host/gpu/renderer.hpp b/host/gpu/renderer.hpp
new file mode 100644
index 0000000..140e1d6
--- /dev/null
+++ b/host/gpu/renderer.hpp
@@ -0,0 +1,137 @@
+#pragma once
+
+#include "ge_state.hpp"
+
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <optional>
+#include <string>
+
+namespace portablekit::gpu {
+
+// PSP pad state gathered from the keyboard, the mouse's buttons and the gamepad.
+struct PadState {
+    std::uint32_t buttons{};
+    std::uint8_t analog_x{0x80u};
+    std::uint8_t analog_y{0x80u};
+    // The HD release reads a second stick from the two SceCtrlData bytes after
+    // Ly, which the PSP itself left reserved. 0x80 is its centre: the guest
+    // skips its camera path entirely only when both bytes are exactly centred.
+    std::uint8_t right_x{0x80u};
+    std::uint8_t right_y{0x80u};
+};
+
+// Relative mouse motion, in counts, while the pointer is captured for the game.
+struct MouseMotion {
+    float x{};
+    float y{};
+};
+
+// The camera the game itself set, read back from the view matrix it uploads.
+// Only filled while <prefix>_TRACE_CAMERA or <prefix>_FIND_CAMERA is on.
+struct CameraReading {
+    bool valid{};
+    float yaw{};    // degrees, from the direction the camera looks along
+    float pitch{};  // degrees
+    float turn{};   // degrees of yaw since the previous traced frame
+    std::array<float, 3> position{};
+    // The matrix itself, in the layout the game holds it in: the GE's twelve
+    // uploaded floats expanded to a 4x4, which is byte for byte the matrix the
+    // game passed to the GE.
+    std::array<float, 16> view{};
+};
+
+// The program's name, followed by the build label (PORTABLEKIT_BUILD_LABEL)
+// when there is one.
+[[nodiscard]] std::string default_window_title();
+
+struct RendererConfig {
+    std::string title{default_window_title()};
+};
+
+// What a GE backend does for the host: it turns the draw calls GeState makes
+// into pictures, one render target per guest framebuffer address, and shows
+// the framebuffer the guest flips to. The Vulkan backend (VulkanRenderer) also
+// owns a window, the pad and the interface; a backend without one leaves the
+// window-side members at their defaults, which say "no window, no input".
+class Renderer {
+public:
+    Renderer() = default;
+    virtual ~Renderer() = default;
+    Renderer(const Renderer &) = delete;
+    Renderer &operator=(const Renderer &) = delete;
+
+    // Returns false and fills `error` when the device cannot be created.
+    virtual bool initialize(const RendererConfig &config, std::string &error) = 0;
+    virtual void shutdown() = 0;
+    [[nodiscard]] virtual bool available() const noexcept = 0;
+
+    // ---- drawing -------------------------------------------------------
+
+    // Call before walking each display list. Guest memory cannot change while a
+    // list is walked, so texture contents are looked up once per list, not per draw.
+    virtual void begin_display_list() = 0;
+    // GPU vertex decode (<prefix>_GPU_DECODE): whether the display list about
+    // to run should hand transformed triangle draws over undecoded
+    // (GeState::set_raw_vertices), and whether it should also decode them
+    // for <prefix>_CHECK_GPU_DECODE.
+    [[nodiscard]] virtual bool gpu_decode() const { return false; }
+    [[nodiscard]] virtual bool check_gpu_decode() const { return false; }
+    virtual void submit(const DrawCall &call, const GuestMemory &memory) = 0;
+    // Writes the framebuffer shown a frame or two ago back to guest VRAM, in
+    // the guest's pixel format at 480x272, so game code that copies a frame
+    // out of VRAM with the CPU or DMA finds the picture instead of stale
+    // bytes. Call once per frame before present().
+    virtual void write_back_frame(GuestMemory &memory) = 0;
+    // Before a GE block transfer reads guest memory: when `source` lies in a
+    // framebuffer the renderer drew, finishes the work queued so far and
+    // writes that framebuffer back to guest memory, so the copy gets the picture.
+    virtual void read_back_framebuffer(std::uint32_t source, GuestMemory &memory) = 0;
+    // Shows a frame the game wrote to memory itself instead of drawing it
+    // with the GE, as the movie player does: the next present of
+    // `display_address` shows these `width` x `height` pixels (R, G, B, A in
+    // memory order, rows `stride` pixels apart), scaled to the target. Call
+    // it at most once per presented frame.
+    virtual void upload_frame(std::uint32_t display_address, const std::uint8_t *pixels, std::uint32_t width,
+                              std::uint32_t height, std::uint32_t stride) = 0;
+
+    // ---- presenting ----------------------------------------------------
+
+    // Ends the frame and shows the target the guest just flipped to. `moment`
+    // is the real time the flip's emulated time stands for (Kernel::real_time_of);
+    // returns whether the flip itself presented the frame.
+    virtual bool present(std::uint32_t display_address,
+                         std::optional<std::chrono::steady_clock::time_point> moment = std::nullopt) = 0;
+    // Writes the last presented frame to a file (a BMP, or a PNG when the
+    // name ends in .png); returns false if it could not be read back.
+    virtual bool capture_frame(const std::string &path) = 0;
+
+    // Frame interpolation and pacing, for a backend that has them.
+    virtual void present_due() {}
+    virtual void present_until(std::chrono::steady_clock::time_point) {}
+    virtual void pause_interpolation() {}
+    // A load running faster than real time flips several times per refresh of
+    // the display; see kernel/fast_loading.hpp.
+    virtual void set_fast_forward(bool) {}
+
+    // ---- window and input, for a backend that has them ---------------------
+
