+++ b/host/gpu/ge_dump.cpp
@@ -0,0 +1,481 @@
+#include "../profile.hpp"
+#include "ge_dump.hpp"
+
+#if defined(PORTABLEKIT_HAS_ZLIB)
+#include <zlib.h>
+#endif
+
+#define XXH_INLINE_ALL
+#include "xxhash/xxhash.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <iostream>
+#include <memory>
+#include <unordered_map>
+
+namespace portablekit::gpu::gedump {
+namespace {
+
+constexpr char kMagic[8] = {'G', 'E', 'D', 'U', 'M', 'P', '0', '3'};
+
+struct Key {
+    std::uint64_t low{}, high{};
+    bool operator==(const Key &other) const noexcept { return low == other.low && high == other.high; }
+};
+struct KeyHash {
+    std::size_t operator()(const Key &key) const noexcept { return static_cast<std::size_t>(key.low); }
+};
+
+struct Range {
+    std::uint64_t first{}, last{}, step{1};
+};
+
+struct Recorder {
+    bool initialised{};
+    bool on{};
+    std::filesystem::path dir;
+    std::vector<Range> ranges;
+    std::uint64_t flip{};  // flips completed so far
+    bool recording{};
+    FlipDump current;
+    // The memory as of the previous event, and where each page of it lies in the pack.
+    std::vector<std::uint8_t> shadow;
+    std::vector<PageRef> refs;
+    std::uint32_t ram_pages{}, vram_pages{};
+    std::FILE *pack{};
+    std::uint64_t pack_size{};
+    std::unordered_map<Key, PageRef, KeyHash> known;
+    std::vector<std::uint8_t> compressed;
+    // Measurements, logged per flip.
+    std::uint64_t flip_new_bytes{};
+    std::uint64_t flip_new_pages{};
+    std::uint64_t total_bytes{};
+};
+
+Recorder &recorder() {
+    static Recorder r;
+    return r;
+}
+
+bool parse_ranges(const char *text, std::vector<Range> &out) {
+    while (*text != '\0') {
+        char *end = nullptr;
+        Range range;
+        range.first = std::strtoull(text, &end, 10);
+        if (end == text) return false;
+        range.last = range.first;
+        text = end;
+        if (*text == '-') {
+            range.last = std::strtoull(text + 1, &end, 10);
+            if (end == text + 1) return false;
+            text = end;
+        }
+        if (*text == '/') {
+            range.step = std::max<std::uint64_t>(std::strtoull(text + 1, &end, 10), 1u);
+            text = end;
+        }
+        out.push_back(range);
+        if (*text == ',') ++text;
+        else if (*text != '\0') return false;
+    }
+    return true;
+}
+
+bool selected(const Recorder &r, std::uint64_t flip) {
+    for (const Range &range : r.ranges)
+        if (flip >= range.first && flip <= range.last && (flip - range.first) % range.step == 0u) return true;
+    return false;
+}
+
+void init(Recorder &r) {
+    if (r.initialised) return;
+    r.initialised = true;
+    const char *dir = portablekit::env("GE_DUMP");
+    if (dir == nullptr || *dir == '\0') return;
+    const char *flips = portablekit::env("GE_DUMP_FLIPS");
+    if (flips == nullptr || !parse_ranges(flips, r.ranges) || r.ranges.empty()) {
+        std::cerr << "[ge-dump] " << portablekit::env_name("GE_DUMP_FLIPS")
+                  << " must list the flips to record (N, A-B or A-B/STEP, separated by commas); recording is off\n";
+        return;
+    }
+    r.dir = dir;
+    std::error_code error;
+    std::filesystem::create_directories(r.dir, error);
+    r.pack = std::fopen((r.dir / "pages.pack").string().c_str(), "ab");
+    if (r.pack == nullptr) {
+        std::cerr << "[ge-dump] cannot open " << (r.dir / "pages.pack").string() << "; recording is off\n";
+        return;
+    }
+    std::fseek(r.pack, 0, SEEK_END);
+    r.pack_size = static_cast<std::uint64_t>(std::ftell(r.pack));
+    r.on = true;
+    std::cerr << "[ge-dump] recording into " << r.dir.string() << "\n";
+}
+
+bool all_zero(const std::uint8_t *page) {
+    static const std::uint8_t zeros[kPageSize] = {};
+    return std::memcmp(page, zeros, kPageSize) == 0;
+}
+
+PageRef store_page(Recorder &r, const std::uint8_t *page) {
+    if (all_zero(page)) return PageRef{};
+    const XXH128_hash_t hash = XXH3_128bits(page, kPageSize);
+    const Key key{hash.low64, hash.high64};
+    if (const auto found = r.known.find(key); found != r.known.end()) return found->second;
+    // Pages are stored compressed when zlib is built in and they shrink, raw otherwise.
+    bool packed = false;
+    std::uint32_t packed_size = 0;
+#if defined(PORTABLEKIT_HAS_ZLIB)
+    uLongf size = compressBound(kPageSize);
+    r.compressed.resize(size);
+    packed = compress2(r.compressed.data(), &size, page, kPageSize, 1) == Z_OK && size < kPageSize;
+    packed_size = static_cast<std::uint32_t>(size);
+#endif
+    const std::uint8_t *data = packed ? r.compressed.data() : page;
+    const std::uint32_t stored = packed ? packed_size : kPageSize;
+    PageRef ref;
+    ref.offset = r.pack_size;
+    ref.size = stored;
+    std::fwrite(data, 1, stored, r.pack);
+    r.pack_size += stored;
+    r.flip_new_bytes += stored;
+    ++r.flip_new_pages;
+    r.known.emplace(key, ref);
+    return ref;
+}
+
+const std::uint8_t *memory_page(const GuestMemory &memory, std::uint32_t page) {
+    const std::uint32_t ram_pages = static_cast<std::uint32_t>(memory.bytes().size() / kPageSize);
+    if (page < ram_pages) return memory.bytes().data() + static_cast<std::size_t>(page) * kPageSize;
+    return memory.vram_bytes().data() + static_cast<std::size_t>(page - ram_pages) * kPageSize;
+}
+
+// Brings the shadow up to the memory's present state; `out` gets the pages that changed.
+void diff_memory(Recorder &r, const GuestMemory &memory, std::vector<PageChange> &out) {
+    const std::uint32_t pages = r.ram_pages + r.vram_pages;
+    for (std::uint32_t page = 0; page < pages; ++page) {
+        const std::uint8_t *now = memory_page(memory, page);
+        std::uint8_t *before = r.shadow.data() + static_cast<std::size_t>(page) * kPageSize;
+        if (std::memcmp(now, before, kPageSize) == 0) continue;
+        std::memcpy(before, now, kPageSize);
+        const PageRef ref = store_page(r, now);
+        r.refs[page] = ref;
+        out.push_back({page, ref});
+    }
+}
+
+void begin_flip(Recorder &r, const GuestMemory &memory) {
+    r.recording = true;
+    r.current = FlipDump{};
+    r.current.flip = r.flip + 1u;
+    r.flip_new_bytes = 0;
+    r.flip_new_pages = 0;
+    r.ram_pages = static_cast<std::uint32_t>(memory.bytes().size() / kPageSize);
+    r.vram_pages = static_cast<std::uint32_t>(memory.vram_bytes().size() / kPageSize);
+    r.current.ram_size = static_cast<std::uint32_t>(memory.bytes().size());
+    r.current.vram_size = static_cast<std::uint32_t>(memory.vram_bytes().size());
+    const std::uint32_t pages = r.ram_pages + r.vram_pages;
+    r.shadow.assign(static_cast<std::size_t>(pages) * kPageSize, 0u);
+    r.refs.assign(pages, PageRef{});
+    // Every page against a zero shadow: the pages that are not zero are the base.
+    std::vector<PageChange> changes;
+    diff_memory(r, memory, changes);
+    r.current.base = r.refs;
+}
+
+void put32(std::vector<std::uint8_t> &out, std::uint32_t value) {
+    for (int i = 0; i < 4; ++i) out.push_back(static_cast<std::uint8_t>(value >> (8 * i)));
+}
+void put64(std::vector<std::uint8_t> &out, std::uint64_t value) {
+    for (int i = 0; i < 8; ++i) out.push_back(static_cast<std::uint8_t>(value >> (8 * i)));
+}
+void put_ref(std::vector<std::uint8_t> &out, const PageRef &ref) {
+    put64(out, ref.offset);
+    put32(out, ref.size);
+}
+
+struct Reader {
+    const std::uint8_t *data;
+    std::size_t size;
+    std::size_t at{};
+    bool ok{true};
+    std::uint32_t u32() {
+        if (at + 4 > size) {
+            ok = false;
+            return 0;
+        }
+        std::uint32_t value = 0;
+        for (int i = 0; i < 4; ++i) value |= static_cast<std::uint32_t>(data[at + i]) << (8 * i);
+        at += 4;
+        return value;
+    }
+    std::uint64_t u64() {
+        const std::uint64_t low = u32();
+        return low | (static_cast<std::uint64_t>(u32()) << 32);
+    }
+    PageRef ref() {
+        PageRef r;
+        r.offset = u64();
+        r.size = u32();
+        return r;
+    }
+    void bytes(std::vector<std::uint8_t> &out, std::size_t count) {
+        if (at + count > size) {
+            ok = false;
+            return;
+        }
+        out.assign(data + at, data + at + count);
+        at += count;
+    }
+};
+
+std::string flip_name(std::uint64_t flip) {
+    char name[32];
+    std::snprintf(name, sizeof name, "flip_%06llu.ge", static_cast<unsigned long long>(flip));
+    return name;
+}
+
+void write_flip(Recorder &r) {
+    const FlipDump &dump = r.current;
+    std::vector<std::uint8_t> out;
+    out.insert(out.end(), kMagic, kMagic + 8);
+    put64(out, dump.flip);
+    put32(out, dump.display.framebuffer);
+    put32(out, dump.display.buffer_width);
+    put32(out, dump.display.pixel_format);
+    put32(out, dump.display.width);
+    put32(out, dump.display.height);
+    put32(out, dump.ram_size);
+    put32(out, dump.vram_size);
+    put32(out, static_cast<std::uint32_t>(dump.ge_state.size()));
+    out.insert(out.end(), dump.ge_state.begin(), dump.ge_state.end());
+    put32(out, static_cast<std::uint32_t>(dump.base.size()));
+    for (const PageRef &ref : dump.base) put_ref(out, ref);
+    put32(out, static_cast<std::uint32_t>(dump.events.size()));
+    for (const Event &event : dump.events) {
+        put32(out, static_cast<std::uint32_t>(event.kind));
+        put32(out, event.a), put32(out, event.b), put32(out, event.c), put32(out, event.d), put32(out, event.e);
+        put32(out, static_cast<std::uint32_t>(event.changes.size()));
+        for (const PageChange &change : event.changes) {
+            put32(out, change.page);
+            put_ref(out, change.ref);
+        }
+    }
+    std::fflush(r.pack);
+    const std::filesystem::path path = r.dir / flip_name(dump.flip);
+    if (std::FILE *file = std::fopen(path.string().c_str(), "wb")) {
+        std::fwrite(out.data(), 1, out.size(), file);
+        std::fclose(file);
+    } else {
+        std::cerr << "[ge-dump] cannot write " << path.string() << "\n";
+    }
+    std::uint64_t nonzero = 0;
+    for (const PageRef &ref : dump.base) nonzero += ref.zero() ? 0u : 1u;
+    std::uint64_t changed = 0;
+    for (const Event &event : dump.events) changed += event.changes.size();
+    r.total_bytes += r.flip_new_bytes;
+    std::cerr << "[ge-dump] flip " << dump.flip << ": " << dump.events.size() << " events, base " << nonzero
+              << " non-zero pages, " << changed << " pages changed between events, " << r.flip_new_pages
+              << " new pages (" << r.flip_new_bytes / 1024u << " KiB packed, " << r.total_bytes / (1024u * 1024u)
+              << " MiB in all) -> " << path.filename().string() << "\n";
+}
+
+} // namespace
+
+bool enabled() {
+    Recorder &r = recorder();
+    init(r);
+    return r.on;
+}
+
+std::uint64_t current_flip() { return recorder().flip + 1u; }
+
+void on_list_run(const GuestMemory &memory, const GeState &ge, std::uint32_t list_id, std::uint32_t pc,
+                 std::uint32_t stall) {
+    Recorder &r = recorder();
+    init(r);
+    if (!r.on || !selected(r, r.flip + 1u)) return;
+    if (!r.recording) begin_flip(r, memory);
+    Event event;
+    event.kind = EventKind::ListRun;
+    event.a = list_id, event.b = pc, event.c = stall;
+    if (r.current.ge_state.empty()) {
+        ge.save_state(r.current.ge_state);
+    }
+    // The first event's memory is the base; later ones record what changed.
+    if (!r.current.events.empty()) diff_memory(r, memory, event.changes);
+    r.current.events.push_back(std::move(event));
+}
+
+void on_picture(const GuestMemory &memory, std::uint32_t address, std::uint32_t width, std::uint32_t height,
+                std::uint32_t stride, std::uint32_t pixel_mode) {
+    Recorder &r = recorder();
+    init(r);
+    if (!r.on || !selected(r, r.flip + 1u)) return;
+    if (!r.recording) begin_flip(r, memory);
+    Event event;
+    event.kind = EventKind::Picture;
+    event.a = address, event.b = width, event.c = height, event.d = stride, event.e = pixel_mode;
+    if (!r.current.events.empty()) diff_memory(r, memory, event.changes);
+    r.current.events.push_back(std::move(event));
+}
+
+void on_flip(const GuestMemory &memory, const DisplayInfo &display) {
+    Recorder &r = recorder();
+    init(r);
+    if (!r.on) {
+        ++r.flip;
+        return;
+    }
+    if (selected(r, r.flip + 1u)) {
+        if (!r.recording) begin_flip(r, memory);
+        Event event;
+        event.kind = EventKind::Flip;
+        event.a = display.framebuffer, event.b = display.pixel_format;
+        if (!r.current.events.empty()) diff_memory(r, memory, event.changes);
+        r.current.events.push_back(std::move(event));
+        r.current.display = display;
+        write_flip(r);
+        r.recording = false;
+    }
+    ++r.flip;
+}
+
+// ---- reading ---------------------------------------------------------------
+
+std::vector<std::uint64_t> list_flips(const std::filesystem::path &dir) {
+    std::vector<std::uint64_t> flips;
+    std::error_code error;
+    for (const auto &entry : std::filesystem::directory_iterator(dir, error)) {
+        const std::string name = entry.path().filename().string();
+        if (name.size() == 14 && name.rfind("flip_", 0) == 0 && name.substr(11) == ".ge")
+            flips.push_back(std::strtoull(name.c_str() + 5, nullptr, 10));
+    }
+    std::sort(flips.begin(), flips.end());
+    return flips;
+}
+
+Pack::~Pack() {
+    if (file_ != nullptr) std::fclose(file_);
+}
+
+bool Pack::open(const std::filesystem::path &file, std::string &error) {
+    file_ = std::fopen(file.string().c_str(), "rb");
+    if (file_ == nullptr) {
+        error = "cannot open " + file.string();
+        return false;
+    }
+    return true;
+}
+
+bool Pack::read_page(const PageRef &ref, std::uint8_t *out) {
+    if (ref.zero()) {
+        std::memset(out, 0, kPageSize);
+        return true;
+    }
+    ++pages_read_;
+    if (std::fseek(file_, static_cast<long>(ref.offset), SEEK_SET) != 0) return false;
+    if (ref.size >= kPageSize) return std::fread(out, 1, kPageSize, file_) == kPageSize;
+    scratch_.resize(ref.size);
+    if (std::fread(scratch_.data(), 1, ref.size, file_) != ref.size) return false;
+#if defined(PORTABLEKIT_HAS_ZLIB)
+    uLongf size = kPageSize;
+    return uncompress(out, &size, scratch_.data(), ref.size) == Z_OK && size == kPageSize;
+#else
+    return false;  // a compressed page, and this build has no zlib
+#endif
+}
+
+bool load_flip(const std::filesystem::path &dir, std::uint64_t flip, FlipDump &out, std::string &error) {
+    const std::filesystem::path path = dir / flip_name(flip);
+    std::FILE *file = std::fopen(path.string().c_str(), "rb");
+    if (file == nullptr) {
+        error = "no dump of flip " + std::to_string(flip) + " in " + dir.string();
+        return false;
+    }
+    std::vector<std::uint8_t> bytes;
+    std::fseek(file, 0, SEEK_END);
+    bytes.resize(static_cast<std::size_t>(std::ftell(file)));
+    std::fseek(file, 0, SEEK_SET);
+    const bool read_all = std::fread(bytes.data(), 1, bytes.size(), file) == bytes.size();
+    std::fclose(file);
+    if (!read_all || bytes.size() < 8 || std::memcmp(bytes.data(), kMagic, 8) != 0) {
+        error = path.string() + " is not a GE dump this build reads";
+        return false;
+    }
+    Reader in{bytes.data(), bytes.size(), 8};
+    out = FlipDump{};
+    out.flip = in.u64();
+    out.display.framebuffer = in.u32();
+    out.display.buffer_width = in.u32();
+    out.display.pixel_format = in.u32();
+    out.display.width = in.u32();
+    out.display.height = in.u32();
+    out.ram_size = in.u32();
+    out.vram_size = in.u32();
+    in.bytes(out.ge_state, in.u32());
+    const std::uint32_t base_count = in.u32();
+    if (!in.ok || base_count > (in.size - in.at) / 12u) {
+        error = path.string() + " is cut short";
+        return false;
+    }
+    out.base.resize(base_count);
+    for (PageRef &ref : out.base) ref = in.ref();
+    const std::uint32_t event_count = in.u32();
+    for (std::uint32_t i = 0; i < event_count && in.ok; ++i) {
+        Event event;
+        event.kind = static_cast<EventKind>(in.u32());
+        event.a = in.u32(), event.b = in.u32(), event.c = in.u32(), event.d = in.u32(), event.e = in.u32();
+        const std::uint32_t changes = in.u32();
+        if (!in.ok || changes > (in.size - in.at) / 16u) {
+            in.ok = false;
+            break;
+        }
+        event.changes.resize(changes);
+        for (PageChange &change : event.changes) {
+            change.page = in.u32();
+            change.ref = in.ref();
+        }
+        out.events.push_back(std::move(event));
+    }
+    if (!in.ok) {
+        error = path.string() + " is cut short";
+        return false;
+    }
+    return true;
+}
+
+namespace {
+
+bool write_page(psprecomp::GuestMemory &memory, const FlipDump &dump, std::uint32_t page, const std::uint8_t *data) {
+    const std::uint32_t ram_pages = dump.ram_size / kPageSize;
+    const std::uint32_t address =
+        page < ram_pages ? kRamBase + page * kPageSize : kVramBase + (page - ram_pages) * kPageSize;
+    if (!memory.contains(address, kPageSize)) return false;
+    memory.copy_in(address, std::span<const std::uint8_t>(data, kPageSize));
+    return true;
+}
+
+} // namespace
+
+bool restore_base(Pack &pack, const FlipDump &dump, psprecomp::GuestMemory &memory) {
+    std::vector<std::uint8_t> page(kPageSize);
+    for (std::uint32_t i = 0; i < dump.base.size(); ++i) {
+        if (!pack.read_page(dump.base[i], page.data()) || !write_page(memory, dump, i, page.data())) return false;
+    }
+    return true;
+}
+
+bool apply_event_memory(Pack &pack, const Event &event, const FlipDump &dump, psprecomp::GuestMemory &memory) {
+    std::vector<std::uint8_t> page(kPageSize);
+    for (const PageChange &change : event.changes) {
+        if (!pack.read_page(change.ref, page.data()) || !write_page(memory, dump, change.page, page.data()))
+            return false;
+    }
+    return true;
+}
+
+} // namespace portablekit::gpu::gedump
