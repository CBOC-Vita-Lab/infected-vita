+// ge_replay: runs recorded GE frames (host/gpu/ge_dump.hpp) through an
+// unmodified GeState into a renderer, with no guest code involved.
+//
+//   ge_replay <dump dir> [options]
+//     --flips LIST        flips to replay: N, A-B or A-B/STEP, comma separated
+//                         (default: every flip in the directory). Flips are
+//                         replayed in order by one renderer, so the targets and
+//                         the texture cache carry over from one to the next.
+//     --png PATH          write the presented picture of each flip; PATH may
+//                         hold {flip}, otherwise _<flip> goes before the extension
+//     --targets DIR       also write every render target after each flip
+//     --scale N           display framebuffer scale (default 2)
+//     --offscreen-scale N scale of the smaller render targets (default 1)
+//     --stats             print what each flip cost the renderer, and totals
+//     --analyze           do not render: list the draws (state summary)
+//     --regs              with --analyze: count the values the pixel, colour-test, stencil and logic-op
+//                         registers had at each draw, over every flip replayed
+//     --detail N,M        with --analyze: also print the vertices, matrices, fog and lights of draws N and M
+//     --null-draw         make every GL call except the draw calls
+//     --no-submit         walk the lists and decode vertices, give the renderer nothing
+//     --repeat N          replay the flip list N times (for timing)
+//     --set KEY=VALUE     a renderer setting (see apply_setting)
+#include "gpu/ge_dump.hpp"
+#include "gpu/ge_state.hpp"
+#include "gpu/renderer.hpp"
+#include "gpu/texture_decode.hpp"
+#if defined(GE_REPLAY_HAS_GL)
+#include "gpu/gl/gl_renderer.hpp"
+#endif
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <iostream>
+#include <map>
+#include <memory>
+#include <set>
+#include <string>
+#include <vector>
+
+namespace portablekit::gpu {
+// RendererConfig's default title; the replayer has no game name to give.
+std::string default_window_title() { return "ge_replay"; }
+} // namespace portablekit::gpu
+
+namespace {
