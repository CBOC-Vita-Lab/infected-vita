+// How the GLES2 backend is set up. The defaults are what a Vita build wants;
+// the replayer and the environment (<prefix>_GL_*) change them.
+struct GlSettings {
+    // A display framebuffer (480 pixels wide or more) is drawn at this multiple of
+    // the PSP's 480x272: 2 gives the Vita's 960x544.
+    std::uint32_t display_scale{2};
+    // The smaller targets the game renders into and samples again (240 and 120
+    // pixels wide in Infected): at 1 they are drawn at the PSP's own size and
+    // magnified when sampled, at 2 at the display's size.
+    std::uint32_t offscreen_scale{1};
+    // Pretend the driver has no glBlendColor, as on the Vita, so the blends that
+    // need one go through the shader (what the Vita build does).
+    bool force_no_blend_color{false};
+    // Through-mode draws (screen-space vertices) take part in the depth test.
+    bool through_depth{true};
+    // Frames between two checks that a cached texture still matches guest
+    // memory (0: never, trusting the first read). A check hashes a sample of the texture.
+    std::uint32_t texture_check_interval{30};
+    // Textures kept on the GPU, in bytes, before the least recently used go.
+    std::uint64_t texture_budget{96ull * 1024ull * 1024ull};
+    // Hash and re-decode a texture on every use (the behaviour to compare the cache against).
+    bool texture_always_validate{false};
+    // Merge consecutive draws with the same state into one GL draw.
+    bool merge_draws{true};
+    // Skip the glDraw* calls (the replayer's null-draw mode: everything else still runs).
+    bool null_draw{false};
+    // Depth buffer precision of every render target: 16 is what ES 2.0 guarantees
+    // (and what the PSP has), 24 needs OES_depth24.
+    std::uint32_t depth_bits{16};
+    // Sample a render target the GPU drew straight from its own texture; off,
+    // the (stale) guest memory under it is decoded instead.
+    bool target_textures{true};
+    // A clear that is a rectangle in through mode is done with glClear.
+    bool use_glclear{true};
+    // Store the displayed frame into guest memory (the CPU may read it): 0 never, 1 every presented
+    // frame, N every Nth. The store is a glReadPixels of the whole display, which stalls the GPU and costs
+    // a conversion pass, so it is off by default; a draw that copies a framebuffer (a GE block
+    // transfer) still reads it back on demand.
+    std::uint32_t writeback{0};
+    // Through-mode quads clamp their texture coordinates half a texel inside the rectangle they sample.
+    bool rect_clamp{true};
+    // Feature switches, for finding which one a wrong picture comes from.
+    bool cull{true};
+    bool lighting{true};
+    bool fog{true};
+    bool alpha_test{true};
+    bool blend{true};
+    bool depth_test{true};
+    // Reverses the face the culling keeps (the winding of a flipped y axis).
+    bool flip_winding{false};
+    // Print what each draw was turned into.
+    bool trace{false};
+    // Debugging: only the draws numbered draw_first..draw_last (1-based, per presented frame;
+    // draw_last 0: to the end) are drawn.
+    std::uint32_t draw_first{0};
+    std::uint32_t draw_last{0};
+};
+
+// Sets one field of GlSettings from a name and a number or on/off word ("1", "0", "on", "off");
+// false for a name it does not know. The replayer's --set and the host's <prefix>_GL_<NAME>
+// both go through it.
+bool apply_gl_setting(GlSettings &settings, const std::string &name, const std::string &value);
+// The names apply_gl_setting knows, lower case.
+[[nodiscard]] const std::vector<std::string> &gl_setting_names();
+
+// Counters of what a frame cost the renderer, for the cost report. Reset by
+// reset_frame_stats(); frame_stats() holds those since.
+struct GlStats {
+    std::uint64_t submits{};            // draw calls from the GE
+    std::uint64_t gl_draws{};           // glDraw* calls after merging
+    std::uint64_t merged{};             // submits that joined a draw in flight
+    std::uint64_t vertices_uploaded{};
+    std::uint64_t indices_uploaded{};
+    std::uint64_t bytes_uploaded{};     // vertex and index data
+    std::uint64_t target_switches{};    // framebuffer binds
+    std::uint64_t program_switches{};
+    std::uint64_t texture_binds{};
+    std::uint64_t blend_changes{};
+    std::uint64_t depth_changes{};
+    std::uint64_t cull_changes{};
+    std::uint64_t scissor_changes{};
+    std::uint64_t viewport_changes{};
+    std::uint64_t mask_changes{};
+    std::uint64_t uniform_uploads{};    // glUniform* calls issued
+    std::uint64_t uniform_skipped{};    // glUniform* calls the dirty tracking avoided
+    std::uint64_t texture_hits{};
+    std::uint64_t texture_misses{};     // decodes and uploads
+    std::uint64_t texture_checks{};     // revalidations of a cached texture
+    std::uint64_t texture_stale{};      // checks that found the guest's texture changed
+    std::uint64_t texture_upload_bytes{};
+    std::uint64_t hash_bytes{};         // guest bytes hashed for the texture cache
+    std::uint64_t hash_calls{};
+    std::uint64_t target_samples{};     // textures read straight from a render target
+    std::uint64_t feedback_copies{};    // copies made because a draw samples its own target
+    std::uint64_t uploads_frames{};     // upload_frame calls
+    std::uint64_t skipped_draws{};      // draws the backend could not or need not draw
+    std::uint64_t clears{};             // glClear calls
+    std::uint64_t texture_param_changes{};  // glTexParameteri calls
+    std::uint64_t vertices_in{};        // vertices the GE decoded for the draws (before merging and compaction)
+    std::uint64_t triangles{};          // triangles (or lines) sent to GL
+    std::uint64_t targets_created{};
+    std::uint64_t texture_hash_full{};  // textures hashed whole (creation or a full validation)
+    std::uint64_t texture_hash_sample{};  // revalidations that hashed a part
+    std::uint64_t texture_evicted{};
+    std::uint64_t clut_hash_bytes{};
+    std::uint64_t shader_compile_us{};
+    std::uint64_t unsupported_blend{};  // blend factors approximated
+    // Why a draw could not join the batch in flight: the state group that differed first
+    // (a draw can differ in several; it is counted once, under the first of these in order).
+    enum MergeBreak : std::size_t {
+        kBreakProgram, kBreakTarget, kBreakDepth, kBreakCull, kBreakBlend, kBreakTexture, kBreakTexEnv,
+        kBreakTransform, kBreakLighting, kBreakOther, kBreakCount
+    };
+    std::uint64_t merge_breaks[kBreakCount]{};
+};
+
+// The OpenGL ES 2.0 backend for the GE: one framebuffer object per guest
+// framebuffer address, GLSL ES 1.00 shaders, no window. See docs/GL_RENDERER.md.
+class GlRenderer final : public Renderer {
+public:
+    GlRenderer();
+    ~GlRenderer() override;
+
+    void set_settings(const GlSettings &settings);
+    [[nodiscard]] const GlSettings &settings() const noexcept;
+
+    bool initialize(const RendererConfig &config, std::string &error) override;
+    void shutdown() override;
+    [[nodiscard]] bool available() const noexcept override;
+
+    void begin_display_list() override;
+    void submit(const DrawCall &call, const GuestMemory &memory) override;
+    void write_back_frame(GuestMemory &memory) override;
+    void read_back_framebuffer(std::uint32_t source, GuestMemory &memory) override;
+    void upload_frame(std::uint32_t display_address, const std::uint8_t *pixels, std::uint32_t width,
+                      std::uint32_t height, std::uint32_t stride) override;
+    bool present(std::uint32_t display_address,
+                 std::optional<std::chrono::steady_clock::time_point> moment = std::nullopt) override;
+    bool capture_frame(const std::string &path) override;
+    [[nodiscard]] std::uint64_t frames_presented() const noexcept override;
+    [[nodiscard]] std::uint64_t draws_submitted() const noexcept override;
+
+    // ---- for tools ---------------------------------------------------------
+
+    // Ends the draws in flight (the GL calls are made) without presenting.
+    void flush();
+    // The presented picture as RGBA, top row first; false if nothing has been presented.
+    bool read_presented(std::vector<std::uint8_t> &rgba, std::uint32_t &width, std::uint32_t &height);
+    // Guest addresses of the render targets, and one target's pixels as RGBA, top row first.
+    [[nodiscard]] std::vector<std::uint32_t> target_addresses() const;
+    bool read_target(std::uint32_t address, std::vector<std::uint8_t> &rgba, std::uint32_t &width,
+                     std::uint32_t &height);
+    // What each target is: stride in pixels, guest format and size on the GPU.
+    struct TargetInfo {
+        std::uint32_t address{};
+        std::uint32_t stride{};
+        std::uint32_t format{};
+        std::uint32_t width{};
+        std::uint32_t height{};
+        std::uint32_t scale{};
+        std::uint64_t draws{};
+    };
+    [[nodiscard]] std::vector<TargetInfo> target_infos() const;
+    // Waits for the GPU (glFinish); for timing.
+    void finish();
+
+    [[nodiscard]] const GlStats &frame_stats() const noexcept;
+    [[nodiscard]] const GlStats &total_stats() const noexcept;
+    void reset_frame_stats();
+    // Distinct shader programs compiled so far, and a line naming each.
+    [[nodiscard]] std::size_t shader_variants() const noexcept;
+    [[nodiscard]] std::vector<std::string> shader_variant_names() const;
+    [[nodiscard]] std::string gl_description() const;
+    // Texture cache: entries and bytes held.
+    [[nodiscard]] std::size_t cached_textures() const noexcept;
+    [[nodiscard]] std::uint64_t cached_texture_bytes() const noexcept;
+    // Forgets every cached texture (a replayer does between unrelated dumps).
+    void clear_texture_cache();
+
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl_;
+};
+
+// Writes RGBA pixels (top row first) as a PNG (a BMP for a path ending in .bmp); false on a file error.
+bool write_png_rgba(const std::string &path, const std::uint8_t *rgba, std::uint32_t width, std::uint32_t height);
+
+} // namespace portablekit::gpu
diff --git a/host/gpu/gl/gl_shaders.cpp b/host/gpu/gl/gl_shaders.cpp
new file mode 100644
index 0000000..e8870be
--- /dev/null
+++ b/host/gpu/gl/gl_shaders.cpp
@@ -0,0 +1,291 @@
+#include "gl_shaders.hpp"
+
+namespace portablekit::gpu::glsl {
+namespace {
+
+const char *const kUniformNames[kUniformCount] = {
+    "u_transform", "u_world",         "u_screen",       "u_flip",           "u_uv",           "u_view_z",
+    "u_fog",       "u_fog_color",     "u_flags",        "u_emissive",       "u_material_ambient",
+    "u_material_diffuse", "u_material_specular", "u_ambient", "u_light_position", "u_light_direction",
+    "u_light_attenuation", "u_light_spot", "u_light_ambient", "u_light_diffuse", "u_light_specular",
+    "u_texture",   "u_texenv",        "u_alpha",        "u_blend",
+};
+
+std::string defines(std::uint32_t flags) {
+    std::string out;
+    if ((flags & kThrough) != 0u) out += "#define THROUGH 1\n";
+    if ((flags & kLight) != 0u) out += "#define LIGHT 1\n";
+    if ((flags & kFog) != 0u) out += "#define FOG 1\n";
+    if ((flags & kTexture) != 0u) out += "#define TEXTURE 1\n";
+    if ((flags & kAlphaTest) != 0u) out += "#define ALPHATEST 1\n";
+    if ((flags & kRectClamp) != 0u) out += "#define RECTCLAMP 1\n";
+    return out;
+}
+
+// The GE's per-vertex lighting, evaluated in world space; the same model as
+// ge.vert's light_vertex() (host/gpu/shaders), in GLSL ES 1.00: no integers
+// in the masks, no mat3(mat4), loops with constant bounds.
+const char *const kVertexSource = R"GLSL(
+precision highp float;
+attribute vec4 a_position;
+attribute vec3 a_normal;
+attribute vec2 a_texcoord;
+attribute vec4 a_color;
+uniform vec4 u_uv;
+varying vec2 v_texcoord;
+varying vec4 v_color;
+#ifdef RECTCLAMP
+varying vec4 v_rect;
+#endif
+#ifdef LIGHT
+varying vec3 v_specular;
+#endif
+#ifdef FOG
+varying float v_fog;
+#endif
+#ifdef THROUGH
+uniform vec2 u_screen;
+#else
+uniform mat4 u_transform;
+uniform vec2 u_flip;
+#endif
+#ifdef LIGHT
+uniform mat4 u_world;
+uniform vec4 u_flags;
+uniform vec4 u_emissive;
+uniform vec4 u_material_ambient;
+uniform vec4 u_material_diffuse;
+uniform vec4 u_material_specular;
+uniform vec4 u_ambient;
+uniform vec4 u_light_position[4];
+uniform vec4 u_light_direction[4];
+uniform vec4 u_light_attenuation[4];
+uniform vec4 u_light_spot[4];
+uniform vec4 u_light_ambient[4];
+uniform vec4 u_light_diffuse[4];
+uniform vec4 u_light_specular[4];
+
+void light_vertex(out vec4 color, out vec3 separate_specular) {
+    bool has_color = u_flags.x > 0.5;
+    vec4 ambient_material = (has_color && u_flags.y > 0.5) ? a_color : u_material_ambient;
+    vec3 diffuse_material = (has_color && u_flags.z > 0.5) ? a_color.rgb : u_material_diffuse.rgb;
+    vec3 specular_material = (has_color && u_flags.w > 0.5) ? a_color.rgb : u_material_specular.rgb;
+    float power = u_emissive.w;
+
+    vec3 world_position = (u_world * vec4(a_position.xyz, 1.0)).xyz;
+    // Skinned normals come out of the bone matrices far from unit length, so
+    // the GE's normalisation after the transform matters.
+    vec3 normal = (u_world * vec4(a_normal, 0.0)).xyz;
+    float length_squared = dot(normal, normal);
+    normal = length_squared > 0.0 ? normal * inversesqrt(length_squared) : vec3(0.0, 0.0, 1.0);
+    if (u_material_specular.w > 0.5) normal = -normal;
+
+    vec3 sum = u_emissive.rgb + u_ambient.rgb * ambient_material.rgb;
+    vec3 specular = vec3(0.0);
+    for (int i = 0; i < 4; ++i) {
+        if (u_light_position[i].w < 0.5) continue;
+        float type = u_light_direction[i].w;
+        float kind = u_light_attenuation[i].w;
+        vec3 to_light = u_light_position[i].xyz;
+        float scale = 1.0;
+        if (type > 0.5) {
+            to_light -= world_position;
+            float light_distance = length(to_light);
+            vec3 k = u_light_attenuation[i].xyz;
+            scale = clamp(1.0 / max(k.x + k.y * light_distance + k.z * light_distance * light_distance, 1e-20), 0.0, 1.0);
+        }
+        to_light = dot(to_light, to_light) > 0.0 ? normalize(to_light) : vec3(0.0, 0.0, 1.0);
+        if (type > 1.5) {
+            vec3 axis = u_light_direction[i].xyz;
+            axis = dot(axis, axis) > 0.0 ? normalize(axis) : vec3(0.0, 0.0, 1.0);
+            float angle = dot(axis, -to_light);
+            scale *= angle >= u_light_spot[i].y ? pow(max(angle, 0.0), u_light_spot[i].x) : 0.0;
+        }
+        float n_dot_l = dot(normal, to_light);
+        float diffuse = max(n_dot_l, 0.0);
+        if (kind > 1.5) diffuse = pow(diffuse, power);
+        sum += (u_light_ambient[i].rgb * ambient_material.rgb +
+                u_light_diffuse[i].rgb * diffuse_material * diffuse) * scale;
+        if (kind > 0.5 && kind < 1.5 && n_dot_l >= 0.0) {
+            // The viewer is taken to look down z, as the GE does.
+            vec3 half_vector = normalize(to_light + vec3(0.0, 0.0, 1.0));
+            specular += u_light_specular[i].rgb * specular_material *
+                        pow(max(dot(normal, half_vector), 0.0), power) * scale;
+        }
+    }
+    float alpha = u_ambient.a * ambient_material.a;
+    if (u_material_diffuse.w > 0.5) {
+        separate_specular = clamp(specular, 0.0, 1.0);
+    } else {
+        sum += specular;
+        separate_specular = vec3(0.0);
+    }
+    color = clamp(vec4(sum, alpha), 0.0, 1.0);
+}
+#endif
+#ifdef FOG
+uniform vec4 u_view_z;
+uniform vec4 u_fog;
+#endif
+
+void main() {
+    v_texcoord = a_texcoord * u_uv.xy + u_uv.zw;
+    v_color = a_color;
+#ifdef THROUGH
+#ifdef RECTCLAMP
+    // Through-mode quads carry the texels they may sample in the normal and w.
+    v_rect = vec4(a_normal.xy, a_normal.z, a_position.w);
+    v_rect = vec4(v_rect.xy * u_uv.xy + u_uv.zw, v_rect.zw * u_uv.xy + u_uv.zw);
+#endif
+    gl_Position = vec4(a_position.x / u_screen.x * 2.0 - 1.0, a_position.y / u_screen.y * 2.0 - 1.0,
+                       clamp(a_position.z / 65535.0, 0.0, 1.0) * 2.0 - 1.0, 1.0);
+#else
+#ifdef LIGHT
+    light_vertex(v_color, v_specular);
+#endif
+#ifdef FOG
+    // Fog runs linearly from 1 (clear) to 0 (fogged) with view-space z,
+    // which is negative in front of the camera: (z + end) * scale.
+    v_fog = (dot(u_view_z, vec4(a_position.xyz, 1.0)) + u_fog.x) * u_fog.y;
+#endif
+    vec4 clip_position = u_transform * vec4(a_position.xyz, 1.0);
+    clip_position.xy *= u_flip;
+    gl_Position = clip_position;
+#endif
+}
+)GLSL";
+
+const char *const kFragmentSource = R"GLSL(
+#ifdef GL_FRAGMENT_PRECISION_HIGH
+precision highp float;
+#else
+precision mediump float;
+#endif
+varying vec2 v_texcoord;
+varying vec4 v_color;
+#ifdef RECTCLAMP
+varying vec4 v_rect;
+#endif
+#ifdef LIGHT
+varying vec3 v_specular;
+#endif
+#ifdef FOG
+varying float v_fog;
+uniform vec4 u_fog_color;
+#endif
+#ifdef TEXTURE
+uniform sampler2D u_texture;
+uniform vec4 u_texenv;
+#endif
+#ifdef ALPHATEST
+uniform vec4 u_alpha;
+#endif
+uniform vec4 u_blend;
+
+void main() {
+    vec4 color = v_color;
+#ifdef TEXTURE
+#ifdef RECTCLAMP
+    vec4 texel = texture2D(u_texture, clamp(v_texcoord, v_rect.xy, v_rect.zw));
+#else
+    vec4 texel = texture2D(u_texture, v_texcoord);
+#endif
+    if (u_texenv.z > 0.5) texel.a = 1.0;   // a texture without alpha (a 5650 render target)
+    float texenv_function = u_texenv.x;
+    bool texture_alpha = u_texenv.y > 0.5;
+    if (texenv_function < 0.5) {            // modulate
+        color.rgb *= texel.rgb;
+        if (texture_alpha) color.a *= texel.a;
+    } else if (texenv_function < 1.5) {     // decal
+        color.rgb = texture_alpha ? mix(color.rgb, texel.rgb, texel.a) : texel.rgb;
+    } else if (texenv_function < 2.5) {     // blend (the environment colour is not modelled: the texel stands in)
+        color.rgb = mix(color.rgb, texel.rgb, texel.rgb);
+        if (texture_alpha) color.a *= texel.a;
+    } else if (texenv_function < 3.5) {     // replace
+        color.rgb = texel.rgb;
+        if (texture_alpha) color.a = texel.a;
+    } else {                         // add
+        color.rgb = min(color.rgb + texel.rgb, vec3(1.0));
+        if (texture_alpha) color.a *= texel.a;
+    }
+#endif
+#ifdef LIGHT
+    // A separate specular term is added after texturing; neither it nor fog touches alpha.
+    color.rgb = min(color.rgb + v_specular, vec3(1.0));
+#endif
+#ifdef FOG
+    color.rgb = mix(u_fog_color.rgb, color.rgb, clamp(v_fog, 0.0, 1.0));
+#endif
+#ifdef ALPHATEST
+    // The GE's alpha test on the 8-bit alpha: 0 never, 1 always, 2 equal, 3 not equal,
+    // 4 less, 5 less or equal, 6 greater, 7 greater or equal.
+    float alpha8 = floor(color.a * 255.0 + 0.5);
+    float reference = u_alpha.y;
+    float test = u_alpha.x;
+    bool passed = true;
+    if (test < 0.5) passed = false;
+    else if (test < 1.5) passed = true;
+    else if (test < 2.5) passed = alpha8 == reference;
+    else if (test < 3.5) passed = alpha8 != reference;
+    else if (test < 4.5) passed = alpha8 < reference;
+    else if (test < 5.5) passed = alpha8 <= reference;
+    else if (test < 6.5) passed = alpha8 > reference;
+    else passed = alpha8 >= reference;
+    if (!passed) discard;
+#endif
+    // Blend factors the hardware cannot give (a doubled source alpha, a fixed
+    // colour without glBlendColor) scale the source here, and the blend unit
+    // is told "one".
+    if (u_blend.x > 0.5) {
+        if (u_blend.x < 1.5) color.rgb *= clamp(color.a * 2.0, 0.0, 1.0);
+        else if (u_blend.x < 2.5) color.rgb *= clamp(1.0 - color.a * 2.0, 0.0, 1.0);
+        else if (u_blend.x < 3.5) color.rgb *= u_blend.yzw;
+        else {                       // a fixed colour on both sides, one the complement of the other:
+            color.rgb *= u_blend.yzw;  // the source is scaled by it and the blend unit weighs the
+            color.a = u_blend.y;       // destination by the rest, through the alpha it is given
+        }
+    }
+    gl_FragColor = color;
+}
+)GLSL";
+
+} // namespace
+
+const char *uniform_name(Uniform uniform) { return kUniformNames[uniform]; }
+
+std::string vertex_source(std::uint32_t flags) { return "#version 100\n" + defines(flags) + kVertexSource; }
+
+std::string fragment_source(std::uint32_t flags) { return "#version 100\n" + defines(flags) + kFragmentSource; }
+
+std::string describe(std::uint32_t flags) {
+    std::string out = (flags & kThrough) != 0u ? "through" : "transform";
+    if ((flags & kLight) != 0u) out += "+light";
+    if ((flags & kFog) != 0u) out += "+fog";
+    if ((flags & kTexture) != 0u) out += "+tex";
+    if ((flags & kAlphaTest) != 0u) out += "+alpha";
+    if ((flags & kRectClamp) != 0u) out += "+rect";
+    return out;
+}
+
+std::string blit_vertex_source() {
+    return "#version 100\n"
+           "precision highp float;\n"
+           "attribute vec2 a_position;\n"
+           "attribute vec2 a_texcoord;\n"
+           "varying vec2 v_texcoord;\n"
+           "void main() { v_texcoord = a_texcoord; gl_Position = vec4(a_position, 0.0, 1.0); }\n";
+}
+
+std::string blit_fragment_source() {
+    return "#version 100\n"
+           "#ifdef GL_FRAGMENT_PRECISION_HIGH\n"
+           "precision highp float;\n"
+           "#else\n"
+           "precision mediump float;\n"
+           "#endif\n"
+           "varying vec2 v_texcoord;\n"
+           "uniform sampler2D u_texture;\n"
+           "void main() { gl_FragColor = texture2D(u_texture, v_texcoord); }\n";
+}
+
+} // namespace portablekit::gpu::glsl
diff --git a/host/gpu/gl/gl_shaders.hpp b/host/gpu/gl/gl_shaders.hpp
new file mode 100644
index 0000000..348698f
--- /dev/null
+++ b/host/gpu/gl/gl_shaders.hpp
@@ -0,0 +1,63 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+// GLSL ES 1.00 sources for the GE's draws. A program is chosen by a handful of
+// flags (ProgramKey); everything else a draw varies in (texture function, alpha
+// test function and reference, blend mode, lights) is a uniform, so the number
+// of programs stays small enough to compile in advance (docs/GL_RENDERER.md).
+namespace portablekit::gpu::glsl {
+
+enum ProgramFlag : std::uint32_t {
+    kThrough = 1u << 0,  // vertices are screen pixels, not object space
+    kLight = 1u << 1,    // per-vertex lighting (transformed draws only)
+    kFog = 1u << 2,      // fog (transformed draws only)
+    kTexture = 1u << 3,  // a texture is sampled
+    kAlphaTest = 1u << 4,// the fragment may be discarded by the alpha test
+    kRectClamp = 1u << 5,// through-mode quads clamp their texture coordinates to a rectangle
+    kProgramFlagBits = 6,
+};
+
+// The uniforms every program may have; a program that lacks one (the compiler
+// removed it, or the shader never declared it) has location -1 for it.
+enum Uniform : std::uint32_t {
+    kUTransform,      // mat4: projection * view * world
+    kUWorld,          // mat4
+    kUScreen,         // vec2: target size in PSP pixels (through mode)
+    kUFlip,           // vec2: sign applied to clip x and y
+    kUUv,             // vec4: texture coordinate scale (xy) and offset (zw)
+    kUViewZ,          // vec4: the row of view * world that gives view-space z
+    kUFog,            // vec4: x end, y scale
+    kUFogColor,       // vec4
+    kUFlags,          // vec4: x has vertex colour, y/z/w: vertex colour replaces ambient/diffuse/specular
+    kUEmissive,       // vec4: rgb emissive, w specular power
+    kUMaterialAmbient,
+    kUMaterialDiffuse,   // rgb, w: 1 keeps specular apart
+    kUMaterialSpecular,  // rgb, w: 1 reverses normals
+    kUAmbient,
+    kULightPosition,  // vec4[4]: xyz, w enabled
+    kULightDirection, // vec4[4]: xyz, w type
+    kULightAttenuation, // vec4[4]: xyz, w kind
+    kULightSpot,      // vec4[4]
+    kULightAmbient,
+    kULightDiffuse,
+    kULightSpecular,
+    kUTexture,        // sampler2D, unit 0
+    kUTexEnv,         // vec4: x function, y 1 when the texture's alpha is used, z 1 for a texture with no alpha
+    kUAlpha,          // vec4: x function (0..7), y reference (0..255)
+    kUBlend,          // vec4: x mode (0 none, 1 double source alpha, 2 one minus that, 3 fixed colour, 4 fixed colour and its complement), yzw colour
+    kUniformCount,
+};
+
+[[nodiscard]] const char *uniform_name(Uniform uniform);
+[[nodiscard]] std::string vertex_source(std::uint32_t flags);
+[[nodiscard]] std::string fragment_source(std::uint32_t flags);
+// A short name for logs and the readiness note: "through+tex+alpha".
+[[nodiscard]] std::string describe(std::uint32_t flags);
+
+// A plain textured quad: positions in clip space, one texture, no state of the GE's.
+[[nodiscard]] std::string blit_vertex_source();
+[[nodiscard]] std::string blit_fragment_source();
+
+} // namespace portablekit::gpu::glsl
