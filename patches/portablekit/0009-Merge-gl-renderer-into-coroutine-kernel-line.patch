+# ge_replay: runs recorded GE frames (host/gpu/ge_dump.hpp, tools/ge_replay)
+# through GeState into the OpenGL ES 2.0 renderer, so the renderer can be
+# developed and checked with no game running. Without PORTABLEKIT_GL_RENDERER
+# it can still list a dump's draws (--analyze).
+option(PORTABLEKIT_GL_RENDERER "Build the OpenGL ES 2.0 renderer (host/gpu/gl)" OFF)
+option(PORTABLEKIT_GE_REPLAY "Build ge_replay, which replays recorded GE frames" OFF)
+if(PORTABLEKIT_GE_REPLAY)
+    set(_replay_sources
+        "${PORTABLEKIT_ROOT}/tools/ge_replay/ge_replay.cpp"
+        "${PORTABLEKIT_ROOT}/host/gpu/ge_state.cpp"
+        "${PORTABLEKIT_ROOT}/host/gpu/texture_decode.cpp"
+        "${PORTABLEKIT_ROOT}/host/gpu/ge_dump.cpp"
+        "${PORTABLEKIT_ROOT}/host/profile.cpp"
+        "${PORTABLEKIT_ROOT}/host/perf/frame_stats.cpp"
+        "${PORTABLEKIT_ROOT}/host/settings/settings.cpp"
+        "${PORTABLEKIT_ROOT}/host/input/bindings.cpp"
+        "${PORTABLEKIT_ROOT}/host/install/user_data.cpp"
+        "${PORTABLEKIT_ROOT}/host/app_paths.cpp"
+        "${PORTABLEKIT_ROOT}/tests/test_profile.cpp")
+    if(PORTABLEKIT_GL_RENDERER)
+        _portablekit_find_gl()
+        _portablekit_prefix(_replay_gl "${PORTABLEKIT_ROOT}" ${PORTABLEKIT_GL_RENDERER_SOURCES})
+        list(APPEND _replay_sources ${_replay_gl})
+    endif()
+    add_executable(ge_replay ${_replay_sources})
+    target_compile_features(ge_replay PRIVATE cxx_std_20)
+    target_include_directories(ge_replay PRIVATE "${PORTABLEKIT_ROOT}/host" "${PORTABLEKIT_ROOT}/third_party")
+    target_link_libraries(ge_replay PRIVATE psprecomp_core ${CMAKE_DL_LIBS})
+    find_package(Threads REQUIRED)
+    target_link_libraries(ge_replay PRIVATE Threads::Threads)
+    _portablekit_use_zlib(ge_replay)
+    if(PORTABLEKIT_GL_RENDERER)
+        target_compile_definitions(ge_replay PRIVATE GE_REPLAY_HAS_GL=1)
+        _portablekit_use_gl(ge_replay)
+    endif()
+    set_target_properties(ge_replay PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
+endif()
