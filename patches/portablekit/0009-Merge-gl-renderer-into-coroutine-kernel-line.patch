+#pragma once
+
+#include "ge_state.hpp"
+
+#include <cstdint>
+#include <cstdio>
+#include <filesystem>
+#include <string>
+#include <vector>
+
+// Frame recorder and the reader a replayer uses.
+//
+// With <prefix>_GE_DUMP=<dir> the host saves, for the flips named by
+// <prefix>_GE_DUMP_FLIPS, everything the GE side of a frame depends on: guest
+// RAM and VRAM as they are when the flip's first display list runs, the GE
+// state machine's state at that point, and the ordered events that follow (each
+// display list run with its pc and stall, each picture the CPU wrote into
+// VRAM, and the flip itself with the display it shows), each with the guest
+// memory pages that changed since the event before it. A replayer restores the
+// memory and the state, runs the same lists through an unmodified GeState and
+// hands the draw calls to a renderer, with no guest code, kernel or game data
+// involved.
+//
+//   <prefix>_GE_DUMP=<dir>            switch recording on
+//   <prefix>_GE_DUMP_FLIPS=<list>     comma-separated items: N, A-B or A-B/STEP
+//                                     (flips are counted from 1, as the
+//                                     bring-up statistics count them)
+//
+// Files in <dir>: pages.pack (zlib-compressed 4 KiB pages, each stored once)
+// and flip_<number>.ge (the flip's manifest, which points into the pack).
+namespace portablekit::gpu::gedump {
+
+inline constexpr std::uint32_t kPageSize = 4096u;
+inline constexpr std::uint32_t kRamBase = 0x08000000u;
+inline constexpr std::uint32_t kVramBase = 0x04000000u;
+
+// Where a stored page lies in pages.pack.
+struct PageRef {
+    std::uint64_t offset{};
+    std::uint32_t size{kZero};
+    static constexpr std::uint32_t kZero = 0xFFFFFFFFu;  // an all-zero page, nothing stored
+    [[nodiscard]] bool zero() const noexcept { return size == kZero; }
+};
+
+struct PageChange {
+    std::uint32_t page{};  // index over RAM pages, then VRAM pages
+    PageRef ref;
+};
+
+enum class EventKind : std::uint32_t {
+    ListRun = 1,  // a: list id, b: pc, c: stall
+    Picture = 2,  // a: address, b: width, c: height, d: stride, e: pixel mode (a CPU-written VRAM picture)
+    Flip = 3,     // the guest flipped to the display of FlipDump::display
+};
+
+struct Event {
+    EventKind kind{};
+    std::uint32_t a{}, b{}, c{}, d{}, e{};
+    std::vector<PageChange> changes;  // pages that differ from the previous event's memory
+};
+
+// The display the guest flipped to: sceDisplaySetFrameBuf's arguments plus
+// the size sceDisplaySetMode gave.
+struct DisplayInfo {
+    std::uint32_t framebuffer{};
+    std::uint32_t buffer_width{512u};
+    std::uint32_t pixel_format{3u};
+    std::uint32_t width{480u};
+    std::uint32_t height{272u};
+};
+
+struct FlipDump {
+    std::uint64_t flip{};
+    DisplayInfo display;
+    std::uint32_t ram_size{};
+    std::uint32_t vram_size{};
+    std::vector<std::uint8_t> ge_state;  // GeState::save_state() at the first list run
+    std::vector<PageRef> base;           // memory at the first event: RAM pages, then VRAM pages
+    std::vector<Event> events;
+};
+
+// ---- recording (called from the host) ------------------------------------
+
+[[nodiscard]] bool enabled();
+// A display list is about to run from `pc` up to `stall`.
+void on_list_run(const GuestMemory &memory, const GeState &ge, std::uint32_t list_id, std::uint32_t pc,
+                 std::uint32_t stall);
+// The CPU wrote a picture into a VRAM framebuffer (show_cpu_picture_in_vram).
+void on_picture(const GuestMemory &memory, std::uint32_t address, std::uint32_t width, std::uint32_t height,
+                std::uint32_t stride, std::uint32_t pixel_mode);
+// The guest flipped; ends the flip's recording and writes its manifest.
+void on_flip(const GuestMemory &memory, const DisplayInfo &display);
+// The number of the flip that the next list runs belong to (1 for the first).
+[[nodiscard]] std::uint64_t current_flip();
+
+// ---- reading ---------------------------------------------------------------
+
+// Flip numbers with a manifest in `dir`, ascending.
+[[nodiscard]] std::vector<std::uint64_t> list_flips(const std::filesystem::path &dir);
+
+class Pack {
+public:
+    Pack() = default;
+    ~Pack();
+    Pack(const Pack &) = delete;
+    Pack &operator=(const Pack &) = delete;
+    bool open(const std::filesystem::path &file, std::string &error);
+    // Fills kPageSize bytes; zero pages give zeros. False on a read error.
+    bool read_page(const PageRef &ref, std::uint8_t *out);
+    [[nodiscard]] std::uint64_t pages_read() const noexcept { return pages_read_; }
+
+private:
+    std::FILE *file_{};
+    std::vector<std::uint8_t> scratch_;
+    std::uint64_t pages_read_{};
+};
+
+bool load_flip(const std::filesystem::path &dir, std::uint64_t flip, FlipDump &out, std::string &error);
+// Sets all of `memory` to the flip's first state.
+bool restore_base(Pack &pack, const FlipDump &dump, psprecomp::GuestMemory &memory);
+// Applies the pages an event changed.
+bool apply_event_memory(Pack &pack, const Event &event, const FlipDump &dump, psprecomp::GuestMemory &memory);
+
+} // namespace portablekit::gpu::gedump
