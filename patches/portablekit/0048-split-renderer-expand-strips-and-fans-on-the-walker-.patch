     glEnable(GL_SCISSOR_TEST);
     glEnableVertexAttribArray(0u);
     glEnableVertexAttribArray(1u);
@@ -2883,6 +2894,19 @@ void GlRenderer::begin_display_list() {
 
 void GlRenderer::submit(const DrawCall &call, const GuestMemory &memory) { impl_->submit(call, memory); }
 
+void GlRenderer::prepare_draw(DrawCall &call) const {
+    // Only transformed draws: through-mode strips keep their shape for the sprite and picture clamps of submit().
+    if (call.through || (call.primitive != PrimitiveType::TriangleStrip && call.primitive != PrimitiveType::TriangleFan))
+        return;
+    const std::size_t vertex_total = call.vertices.size();
+    const std::size_t count = call.indices.empty() ? vertex_total : call.indices.size();
+    if (vertex_total == 0u || vertex_total > 65535u || count < 3u) return;
+    thread_local std::vector<std::uint16_t> list;
+    if (!triangle_indices(call.primitive, count, call.indices, vertex_total, list) || list.empty()) return;
+    call.indices.swap(list);
+    call.primitive = PrimitiveType::Triangles;
+}
+
 void GlRenderer::write_back_frame(GuestMemory &memory) {
     Impl &impl = *impl_;
     if (!impl.ready || !impl.has_presented || impl.settings.writeback == 0u) return;
