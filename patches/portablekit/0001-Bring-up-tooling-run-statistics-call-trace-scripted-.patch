+#pragma once
+
+#include "gpu/ge_state.hpp"
+#include "psprecomp/guest_memory.hpp"
+
+#include <cstdint>
+
+// A deliberately small software rasteriser for bring-up on a machine with no
+// GPU: it draws the GE's draw calls into shadow copies of the game's colour
+// buffers so that a flip can be written out as a PNG and looked at. It is not a
+// renderer: no lighting, no fog, nearest-neighbour sampling, painter's order
+// unless the game enables the depth test, and nothing the GE would write to
+// guest memory is written back, so render-to-texture shows what the texture
+// held before. It exists to tell a menu from a loading screen.
+//
+//   <prefix>_SHOT_DIR=<dir>       write shot_<flip>.png here
+//   <prefix>_SHOT_FLIPS=a,b-c,d-e/s  which flips: single, range, range with step
+//   <prefix>_SHOT_EVERY=N         every Nth flip (when no list is given)
+namespace portablekit::bringup::raster {
+
+[[nodiscard]] bool enabled();
+void install(const psprecomp::GuestMemory &memory);
+void draw(const gpu::DrawCall &call);
+// The guest block-copied pixels into video memory.
+void transfer(const gpu::BlockTransfer &transfer);
+// The game displayed `framebuffer`; writes a PNG if this flip is wanted.
+void flip(std::uint64_t flip_number, std::uint32_t framebuffer, std::uint32_t pixel_format);
+
+} // namespace portablekit::bringup::raster
