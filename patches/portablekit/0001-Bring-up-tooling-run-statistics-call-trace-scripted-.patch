 }
 
+// The guest's own computing takes no emulated time, which suits a game that
+// waits for the vblank each frame and does not suit one that measures its
+// frames. <prefix>_CPU_NS_PER_INSN=N charges N nanoseconds (fractions allowed)
+// for each instruction the interpreter has run since the last charge, at the
+// next system call that returns at once. The PSP's CPU runs at up to 333 MHz.
+void Kernel::charge_instruction_time() {
+    static const double ns_per_instruction = [] {
+        const char *text = portablekit::env("CPU_NS_PER_INSN");
+        return text != nullptr ? std::strtod(text, nullptr) : 0.0;
+    }();
+    if (ns_per_instruction <= 0.0) return;
+    const std::uint64_t total = psprecomp::interpreter_stats().instructions;
+    const std::uint64_t delta = total - charged_instructions_;
+    charged_instructions_ = total;
+    charged_remainder_ns_ += static_cast<std::uint64_t>(static_cast<double>(delta) * ns_per_instruction);
+    const std::uint64_t us = charged_remainder_ns_ / 1000u;
+    charged_remainder_ns_ %= 1000u;
+    if (us == 0u) return;
+    advance_clock(now_us_ + us);
+    process_timers();
+}
+
 void Kernel::charge_busy_time() {
     static const bool off = portablekit::env("NO_BUSY_CLOCK") != nullptr;
     if (off || interrupt_active_ || current_thread() == nullptr) return;
