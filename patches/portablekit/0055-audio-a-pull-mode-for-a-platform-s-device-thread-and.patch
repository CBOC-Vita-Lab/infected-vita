From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 17 Oct 2026 04:30:09 +0000
Subject: [PATCH] audio: a pull mode for a platform's device thread, and
 telemetry for a clock follower

AudioOutput.pulls: the device's own thread calls AudioSink::pull() for exactly the frames it needs instead of the sink pushing what
it retires, so the game's clock and the device's no longer have to match (a ring that filled during a long guest frame dropped
every burst after it). AudioSink::telemetry() reports fill, silent frames, drops, producer restarts and the least lead any recent
producer had over the device, which is the margin that decides whether a producer is found behind the device and restarted.

Verified: builds and runs on the desktop (the push path is unchanged). Not verified: on the PS Vita.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>

diff --git a/host/audio/audio_sink.cpp b/host/audio/audio_sink.cpp
index a69dc39..2c42452 100644
--- a/host/audio/audio_sink.cpp
+++ b/host/audio/audio_sink.cpp
@@ -5,6 +5,7 @@
 #include "settings/settings.hpp"
 
 #include <algorithm>
+#include <array>
 #include <cstdio>
 #include <cstdlib>
 #include <cmath>
@@ -29,6 +30,9 @@ AudioOutput g_output;
 constexpr std::size_t kRingFrames = 8192u;
 // The device is kept two guest buffers ahead of the write cursor.
 constexpr std::size_t kPrebufferFrames = 2048u;
+// A pulled device is not paced by the game's clock, so the guest has to stay ahead of the hardware by itself: a little more
+// room than the pushed devices need (~70 ms), still far less than the 340 ms the push model sat at.
+constexpr std::size_t kPulledPrebufferFrames = 3072u;
 
 [[nodiscard]] std::int16_t saturate(std::int32_t value) noexcept {
     return static_cast<std::int16_t>(std::clamp(value, -32768, 32767));
@@ -124,6 +128,19 @@ struct AudioSink::Impl {
 
     float gain{1.0f};
     bool output_open{};   // g_output is the device
+    bool output_pulls{};  // ... and it pulls (g_output.pulls): nothing here pushes to it
+    std::uint64_t prebuffer{kPrebufferFrames};   // how far ahead of the device a restarted producer starts
+    std::uint64_t total_restarts{};
+    std::uint64_t total_writes{};
+    // What each producer (a channel's cursor) had queued ahead of the device at its last write, and when (in pulls: the device's own
+    // clock). Eight producers are more than the game has channels.
+    struct ProducerMark {
+        const void *key{};
+        std::uint64_t ahead{};
+        std::uint64_t at{};
+    };
+    std::array<ProducerMark, 8> marks{};
+    std::uint64_t pulls_seen{};
 #if defined(PORTABLEKIT_HAS_SDL_AUDIO)
     SDL_AudioStream *stream{};
 #endif
@@ -171,7 +188,7 @@ struct AudioSink::Impl {
         if (time_source != nullptr) {
             target = time_source() * kSampleRate / 1'000'000u;
         } else {
-            target = write_end > kPrebufferFrames ? write_end - kPrebufferFrames : 0u;
+            target = write_end > prebuffer ? write_end - prebuffer : 0u;
         }
         // Never past the ring's reach of written frames, and in steps the ring can hold.
         while (target > read_position) {
@@ -261,14 +278,16 @@ void AudioSink::initialize() {
         std::cout << "Audio: disabled by " << portablekit::env_name("NO_AUDIO") << "\n";
         return;
     }
-    if (g_output.write != nullptr) {
+    if (g_output.write != nullptr || g_output.pulls) {
         if (g_output.open != nullptr && !g_output.open()) {
             std::cerr << "Audio: the platform device did not open; running silent\n";
             return;
         }
         impl.output_open = true;
+        impl.output_pulls = g_output.pulls;
+        if (impl.output_pulls) impl.prebuffer = kPulledPrebufferFrames;
         if (g_output.set_gain != nullptr) g_output.set_gain(impl.gain);
-        std::cout << "Audio: 44100 Hz stereo playback open (platform device)\n";
+        std::cout << "Audio: 44100 Hz stereo playback open (platform device, " << (impl.output_pulls ? "pulled" : "pushed") << ")\n";
         return;
     }
 #if defined(PORTABLEKIT_HAS_SDL_AUDIO)
@@ -339,6 +358,34 @@ void AudioSink::set_volume(float gain) {
 #endif
 }
 
+void AudioSink::pull(std::int16_t *out, std::size_t frames) {
+    Impl &impl = *impl_;
+    std::lock_guard<std::mutex> guard(impl.lock);
+    if (!impl.started || impl.closed) {
+        std::memset(out, 0, frames * kChannels * sizeof(std::int16_t));
+        return;
+    }
+    ++impl.pulls_seen;
+    impl.retire(frames, out, true);
+}
+
+AudioSink::Telemetry AudioSink::telemetry() const {
+    Impl &impl = *impl_;
+    std::lock_guard<std::mutex> guard(impl.lock);
+    Telemetry t;
+    t.fill = impl.write_end > impl.read_position ? impl.write_end - impl.read_position : 0u;
+    t.silent = impl.total_silent;
+    t.dropped = impl.total_dropped;
+    t.restarts = impl.total_restarts;
+    t.writes = impl.total_writes;
+    for (const auto &mark : impl.marks) {
+        if (mark.key == nullptr || impl.pulls_seen - mark.at > 20u) continue;   // about 0.4 s of 1024-frame periods
+        const auto ahead = static_cast<std::int64_t>(mark.ahead);
+        if (t.lead < 0 || ahead < t.lead) t.lead = ahead;
+    }
+    return t;
+}
+
 bool AudioSink::has_device() const {
     if (impl_->output_open) return true;
 #if defined(PORTABLEKIT_HAS_SDL_AUDIO)
@@ -377,18 +424,35 @@ void AudioSink::mix(std::uint64_t &cursor, const std::int16_t *frames, std::size
     }
 
 #if defined(PORTABLEKIT_HAS_SDL_AUDIO)
-    const bool device_drains = impl.stream != nullptr;
+    const bool device_drains = impl.stream != nullptr || impl.output_pulls;
 #else
-    const bool device_drains = false;
+    const bool device_drains = impl.output_pulls;
 #endif
     if (!device_drains) impl.drain_without_device();
 
     // A cursor behind the device belongs to a producer that stalled; restart it
     // at the write target rather than writing frames that already played.
     ++impl.window_writes;
-    if (cursor < impl.read_position + kPrebufferFrames / 4u) {
-        cursor = impl.read_position + kPrebufferFrames;
+    ++impl.total_writes;
+    if (cursor < impl.read_position + impl.prebuffer / 4u) {
+        cursor = impl.read_position + impl.prebuffer;
         ++impl.window_restarts;
+        ++impl.total_restarts;
+    }
+    if (impl.output_pulls) {
+        Impl::ProducerMark *mark = nullptr;
+        Impl::ProducerMark *stalest = &impl.marks[0];
+        for (auto &candidate : impl.marks) {
+            if (candidate.key == &cursor) {
+                mark = &candidate;
+                break;
+            }
+            if (candidate.key == nullptr || (stalest->key != nullptr && candidate.at < stalest->at)) stalest = &candidate;
+        }
+        if (mark == nullptr) mark = stalest;
+        mark->key = &cursor;
+        mark->ahead = cursor - impl.read_position;
+        mark->at = impl.pulls_seen;
     }
 
     // The ring cannot hold what a runaway producer wants to write. Retire the
diff --git a/host/audio/audio_sink.hpp b/host/audio/audio_sink.hpp
index 5f3f6a0..72553a1 100644
--- a/host/audio/audio_sink.hpp
+++ b/host/audio/audio_sink.hpp
@@ -9,8 +9,13 @@ namespace portablekit::audio {
 inline constexpr std::uint32_t kSampleRate = 44'100u;
 inline constexpr std::uint32_t kChannels = 2u;
 
-// A platform layer's playback device, for a build without SDL audio (the Vita's: a pump thread fed through a ring).
-// The sink pushes the frames it retires: everything older than its prebuffer, as soon as a producer has mixed past it.
+// A platform layer's playback device, for a build without SDL audio (the Vita's: a pump thread).
+// Two ways to drive it, chosen by `pulls`:
+//  - push (default): the sink retires the frames up to the game's clock whenever a producer mixes, and write() takes them. The
+//    game's clock and the device's run unrelated, so a device that is not draining at that pace either runs dry or drops frames
+//    (a ring that fills up with the silence of the first seconds drops every burst after a long guest frame).
+//  - pull: the device's own thread calls AudioSink::pull() for exactly the frames it needs, at the speed of the hardware, like the
+//    SDL device callback does. write() is not used.
 // Install it with set_audio_output() before AudioSink::initialize().
 struct AudioOutput {
     // Opens the device for 44100 Hz stereo s16; false: run silent.
@@ -20,6 +25,7 @@ struct AudioOutput {
     void (*close)() = nullptr;
     void (*set_gain)(float gain) = nullptr;       // optional, 0..1
     void (*set_paused)(bool paused) = nullptr;    // optional
+    bool pulls = false;                           // the device calls AudioSink::pull() itself (see above); write may be null
 };
 void set_audio_output(const AudioOutput &output) noexcept;
 
@@ -63,6 +69,24 @@ public:
     // none could be opened).
     [[nodiscard]] bool has_device() const;
 
+    // For a pulling AudioOutput: fills `frames` interleaved stereo frames for the device, silence where no producer has written.
+    // Safe from the device's thread. Before initialize() and after shutdown() it delivers silence.
+    void pull(std::int16_t *out, std::size_t frames);
+
+    // Running totals for a status line. `fill` is how far ahead of the device the producers have written, in frames (the latency).
+    struct Telemetry {
+        std::uint64_t fill{};      // frames written ahead of the device right now
+        std::uint64_t silent{};    // frames the device took that nobody had written
+        std::uint64_t dropped{};   // frames lost: retired unplayed because the ring overflowed, or refused by a push device
+        std::uint64_t restarts{};  // producer cursors found behind the device and restarted
+        std::uint64_t writes{};    // mix() calls
+        // For a pulling device's clock follower: the fewest frames any producer that wrote in the last ~0.4 s had queued ahead of the
+        // device when it wrote last (before adding its own chunk), or -1 when none did. This is the margin of the producer closest
+        // to being found behind the device and restarted; `fill` is the furthest one, which says nothing about that.
+        std::int64_t lead{-1};
+    };
+    [[nodiscard]] Telemetry telemetry() const;
+
     // Public only so the device callback, which lives outside the class, can
     // name it.
     struct Impl;
