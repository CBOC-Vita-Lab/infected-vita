diff --git a/tests/alpha_test_tests.cpp b/tests/alpha_test_tests.cpp
new file mode 100644
index 0000000..a55d5bb
--- /dev/null
+++ b/tests/alpha_test_tests.cpp
@@ -0,0 +1,137 @@
+// When the GE's alpha test cannot fail (host/gpu/gl/gl_alpha_test.hpp): the decision table, checked against a brute-force
+// evaluation of every alpha, plus the rows Infected relies on. No GL, no game.
+
+#include "gpu/gl/gl_alpha_test.hpp"
+
+#include <cstdio>
+
+namespace {
+
+using namespace portablekit::gpu::alpha_test;
+
+int g_failures = 0;
+
+void check(bool condition, const char *what) {
+    std::printf("%s %s\n", condition ? "ok  " : "FAIL", what);
+    if (!condition) ++g_failures;
+}
+
+// Every alpha of the range passes, found by trying them all.
+bool brute_force(std::uint32_t function, std::uint32_t reference, Range range) {
+    for (std::uint32_t alpha = range.low; alpha <= range.high; ++alpha)
+        if (!passes(function, reference, alpha)) return false;
+    return true;
+}
+
+Facts unlit(std::uint32_t low, std::uint32_t high) {
+    Facts facts;
+    facts.colour = {low, high};
+    return facts;
+}
+
+Facts textured(std::uint32_t low, std::uint32_t high, TexelAlpha use, bool opaque) {
+    Facts facts = unlit(low, high);
+    facts.texel = use;
+    facts.texel_opaque = opaque;
+    return facts;
+}
+
+} // namespace
+
+int main() {
+    // 1. The interval rule equals trying every alpha, for every function, a grid of references and ranges (the ranges include
+    //    the empty-looking single values and the whole 0..255).
+    {
+        bool same = true;
+        std::uint32_t rows = 0;
+        for (std::uint32_t function = 0; function < 8u; ++function)
+            for (std::uint32_t reference = 0; reference < 256u; reference += (reference < 4u || reference > 250u) ? 1u : 17u)
+                for (std::uint32_t low = 0; low < 256u; low += (low < 3u || low > 252u) ? 1u : 23u)
+                    for (std::uint32_t high = low; high < 256u; high += (high < 3u || high > 252u) ? 1u : 29u) {
+                        ++rows;
+                        if (passes_for_all(function, reference, {low, high}) != brute_force(function, reference, {low, high})) {
+                            same = false;
+                            std::printf("     differs: function %u reference %u range %u..%u\n", function, reference, low, high);
+                        }
+                    }
+        check(same, "passes_for_all equals trying every alpha of the range");
+        std::printf("     (%u rows)\n", rows);
+    }
+
+    // 2. The first version's rule: every fragment at 255.
+    check(cannot_fail_at_255(kGreater, 0u) && cannot_fail_at_255(kGreater, 254u) && !cannot_fail_at_255(kGreater, 255u),
+          "alpha 255 passes greater than every reference below 255");
+    check(cannot_fail_at_255(kGreaterEqual, 255u) && cannot_fail_at_255(kAlways, 0u), "alpha 255 passes greater-or-equal 255 and always");
+    check(cannot_fail_at_255(kEqual, 255u) && !cannot_fail_at_255(kEqual, 254u), "alpha 255 passes equal only to 255");
+    check(cannot_fail_at_255(kNotEqual, 0u) && !cannot_fail_at_255(kNotEqual, 255u), "alpha 255 passes not-equal to anything but 255");
+    check(cannot_fail_at_255(kLessEqual, 255u) && !cannot_fail_at_255(kLessEqual, 254u), "alpha 255 passes less-or-equal 255 only");
+    check(!cannot_fail_at_255(kLess, 255u) && !cannot_fail_at_255(kNever, 0u), "alpha 255 never passes less, never fails never");
+
+    // 3. The draws Infected makes: GREATER 0 (the game keeps the test on nearly everywhere).
+    check(cannot_fail(kGreater, 0u, unlit(255u, 255u)), "opaque vertices, no texture: greater than 0 cannot fail");
+    check(cannot_fail(kGreater, 0u, textured(255u, 255u, TexelAlpha::Multiply, true)), "opaque vertices, opaque texture: cannot fail");
+    check(!cannot_fail(kGreater, 0u, textured(255u, 255u, TexelAlpha::Multiply, false)), "opaque vertices, texture with holes: the test stays");
+    check(!cannot_fail(kGreater, 0u, textured(255u, 255u, TexelAlpha::Replace, false)), "replace with a texture with holes: the test stays");
+    check(cannot_fail(kGreater, 0u, textured(0u, 0u, TexelAlpha::Replace, true)), "replace with an opaque texture: the vertices' alpha does not matter");
+    check(cannot_fail(kGreater, 0u, textured(0u, 255u, TexelAlpha::Replace, true)), "replace with an opaque texture and unknown vertex alpha: cannot fail");
+    check(cannot_fail(kGreater, 0u, textured(255u, 255u, TexelAlpha::Unused, false)), "decal / no texture alpha: the texture's holes do not count");
+    check(!cannot_fail(kGreater, 0u, unlit(0u, 255u)), "unknown vertex alpha: the test stays");
+    check(!cannot_fail(kGreater, 0u, unlit(0u, 0u)), "vertices at alpha 0: the test stays (every fragment fails)");
+    check(!cannot_fail(kGreater, 0u, textured(128u, 128u, TexelAlpha::Multiply, false)), "a fade of a texture with holes: the test stays");
+
+    // 4. A constant fade of an opaque texture: alpha 16..254 is above 0 with room to spare.
+    check(cannot_fail(kGreater, 0u, textured(128u, 128u, TexelAlpha::Multiply, true)), "opaque texture at constant alpha 128: greater than 0 cannot fail");
+    check(cannot_fail(kGreater, 0u, textured(3u, 3u, TexelAlpha::Multiply, true)), "alpha 3 clears the guard of 2");
+    check(!cannot_fail(kGreater, 0u, textured(2u, 2u, TexelAlpha::Multiply, true)), "alpha 2 is inside the guard: the test stays");
+    check(!cannot_fail(kGreater, 0u, textured(1u, 1u, TexelAlpha::Multiply, true)), "alpha 1 is inside the guard: the test stays");
+    check(!cannot_fail(kGreater, 0u, textured(0u, 128u, TexelAlpha::Multiply, true)), "a fade that reaches 0 at a vertex: the test stays");
+    check(cannot_fail(kGreaterEqual, 1u, textured(128u, 128u, TexelAlpha::Multiply, true)), "greater-or-equal 1 likewise");
+    check(!cannot_fail(kGreater, 126u, textured(128u, 128u, TexelAlpha::Multiply, true)), "alpha 128 against reference 126: inside the guard");
+    check(cannot_fail(kGreater, 125u, textured(128u, 128u, TexelAlpha::Multiply, true)), "alpha 128 against reference 125: outside the guard");
+    check(cannot_fail(kLess, 200u, unlit(10u, 100u)) && !cannot_fail(kLess, 102u, unlit(10u, 100u)), "less than: the high end plus the guard decides");
+    check(cannot_fail(kNotEqual, 0u, textured(128u, 128u, TexelAlpha::Multiply, true)), "not equal to 0 at alpha 128");
+    check(!cannot_fail(kEqual, 128u, unlit(128u, 128u)), "equal is only decided for 255 (anything else is within the guard)");
+    check(cannot_fail(kEqual, 255u, unlit(255u, 255u)), "equal 255 at alpha 255");
+
+    // 5. The comparisons that need no look.
+    check(cannot_fail(kAlways, 0u, unlit(0u, 255u)), "always cannot fail");
+    check(!cannot_fail(kNever, 0u, unlit(255u, 255u)), "never always fails");
+
+    // 6. The texture function: which of them put the texel's alpha into the fragment.
+    check(texel_alpha_use(false, true, 0u) == TexelAlpha::Unused, "no texture: unused");
+    check(texel_alpha_use(true, false, 0u) == TexelAlpha::Unused, "a texture whose alpha is not used: unused");
+    check(texel_alpha_use(true, true, 1u) == TexelAlpha::Unused, "decal keeps the colour's alpha");
+    check(texel_alpha_use(true, true, 0u) == TexelAlpha::Multiply && texel_alpha_use(true, true, 2u) == TexelAlpha::Multiply &&
+              texel_alpha_use(true, true, 4u) == TexelAlpha::Multiply && texel_alpha_use(true, true, 7u) == TexelAlpha::Multiply,
+          "modulate, blend, add (and the codes above) multiply");
+    check(texel_alpha_use(true, true, 3u) == TexelAlpha::Replace, "replace takes the texel's alpha");
+
+    // 7. Lighting: the ambient alpha times the colour's.
+    {
+        const Range full = lit_alpha(255u, {255u, 255u});
+        check(full.low == 255u && full.high == 255u, "ambient 255 over alpha 255 is 255");
+        const Range half = lit_alpha(128u, {255u, 255u});
+        check(half.low == 128u && half.high == 128u, "ambient 128 over alpha 255 is 128");
+        const Range mixed = lit_alpha(100u, {50u, 200u});
+        check(mixed.low == 19u && mixed.high == 79u, "the product of ranges is rounded outwards (19..79)");
+        check(cannot_fail(kGreater, 0u, textured(half.low, half.high, TexelAlpha::Multiply, true)), "a lit draw at ambient alpha 128 with an opaque texture");
+        check(!cannot_fail(kGreater, 0u, textured(half.low, half.high, TexelAlpha::Multiply, false)), "... and with a texture with holes");
+        const Range off = lit_alpha(0u, {255u, 255u});
+        check(!cannot_fail(kGreater, 0u, unlit(off.low, off.high)), "ambient alpha 0: every fragment fails, the test stays");
+    }
+
+    // 8. The guard never makes a bound better than it was: the guarded range holds the original range.
+    {
+        bool holds = true;
+        for (std::uint32_t low = 0; low < 256u; ++low)
+            for (std::uint32_t high = low; high < 256u; high += 5u) {
+                const Range wide = guarded({low, high});
+                if (wide.low > low || wide.high < high) holds = false;
+            }
+        check(holds, "guarded() only widens");
+        check(guarded({255u, 255u}).low == 255u && guarded({0u, 0u}).high == 0u, "the ends 255 (low) and 0 (high) are exact");
+    }
+
+    std::printf("%s\n", g_failures == 0 ? "all passed" : "FAILURES");
+    return g_failures == 0 ? 0 : 1;
+}
