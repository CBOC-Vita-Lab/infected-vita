diff --git a/host/gpu/gl/gl_alpha_test.hpp b/host/gpu/gl/gl_alpha_test.hpp
new file mode 100644
index 0000000..0d40e0f
--- /dev/null
+++ b/host/gpu/gl/gl_alpha_test.hpp
@@ -0,0 +1,130 @@
+#pragma once
+
+// When the GE's alpha test cannot fail for any fragment of a draw, the draw does not need it: its program has no `discard`.
+// On a tile-based GPU (the Vita's PowerVR) a `discard` in a shader means the hardware cannot settle which fragment of a pixel is
+// visible before shading, so a draw that has one pays for all its overdraw. This header is the decision, with no GL and no
+// state in it so that a test can drive every row of the table; gl_renderer.cpp feeds it what it knows about a draw.
+//
+// The rule is one of intervals. Whatever reaches the test is an 8-bit alpha (the shader rounds: floor(alpha * 255 + 0.5)). From
+// the draw's colour source, the lighting and the texture function a range [low, high] that holds every such alpha is worked
+// out; the test is dropped when its comparison against the reference gives "pass" for every value of that range. Anything the
+// renderer cannot bound is the whole range 0..255, which only the comparison "always" passes. The range is widened by a guard
+// (kGuard) where the shader's interpolation and its half-precision arithmetic could move a value by a unit or two, so that a
+// bound that merely touches the reference does not drop the test.
+#include <cstdint>
+
+namespace portablekit::gpu::alpha_test {
+
+// AlphaTestState::function.
+enum Function : std::uint32_t {
+    kNever = 0u,
+    kAlways = 1u,
+    kEqual = 2u,
+    kNotEqual = 3u,
+    kLess = 4u,
+    kLessEqual = 5u,
+    kGreater = 6u,
+    kGreaterEqual = 7u,
+};
+
+// An inclusive range of 8-bit alpha values.
+struct Range {
+    std::uint32_t low{0u};
+    std::uint32_t high{255u};
+};
+
+// The comparison against `reference` (the shader's: the rounded 8-bit alpha on the left) for the single value `alpha`.
+[[nodiscard]] constexpr bool passes(std::uint32_t function, std::uint32_t reference, std::uint32_t alpha) noexcept {
+    switch (function) {
+    case kNever: return false;
+    case kAlways: return true;
+    case kEqual: return alpha == reference;
+    case kNotEqual: return alpha != reference;
+    case kLess: return alpha < reference;
+    case kLessEqual: return alpha <= reference;
+    case kGreater: return alpha > reference;
+    default: return alpha >= reference;   // 7, and the (unused) codes above it: the shader treats them as "greater or equal"
+    }
+}
+
+// True when the comparison passes for every alpha in the range, as an interval test (no loop).
+[[nodiscard]] constexpr bool passes_for_all(std::uint32_t function, std::uint32_t reference, Range range) noexcept {
+    switch (function) {
+    case kNever: return false;
+    case kAlways: return true;
+    case kEqual: return range.low == range.high && range.low == reference;
+    case kNotEqual: return reference < range.low || reference > range.high;
+    case kLess: return range.high < reference;
+    case kLessEqual: return range.high <= reference;
+    case kGreater: return range.low > reference;
+    default: return range.low >= reference;
+    }
+}
+
+// The units the bounds are widened by wherever they are not 255 (for low) or 0 (for high): at those two ends nothing can
+// move the value (a constant 1.0 and 0.0 interpolate to themselves), elsewhere the varying's precision and the product of two
+// alphas can be a unit off, and the rounding another half.
+constexpr std::uint32_t kGuard = 2u;
+
+[[nodiscard]] constexpr Range guarded(Range range) noexcept {
+    Range out;
+    out.low = range.low >= 255u ? 255u : (range.low > kGuard ? range.low - kGuard : 0u);
+    out.high = range.high == 0u ? 0u : (range.high + kGuard < 255u ? range.high + kGuard : 255u);
+    return out;
+}
+
+// How the draw's texture contributes to the fragment's alpha.
+enum class TexelAlpha : std::uint8_t {
+    Unused,    // no texture, a texture function that keeps the colour's alpha (decal), or a texture whose alpha is not used
+    Multiply,  // the colour's alpha times the texel's (modulate, blend, add)
+    Replace,   // the texel's alpha alone
+};
+
+// The GE texture functions: 0 modulate, 1 decal, 2 blend, 3 replace, 4 add (the shader treats 5..7 as add).
+[[nodiscard]] constexpr TexelAlpha texel_alpha_use(bool textured, bool alpha_from_texture, std::uint32_t texture_function) noexcept {
+    if (!textured || !alpha_from_texture || texture_function == 1u) return TexelAlpha::Unused;
+    return texture_function == 3u ? TexelAlpha::Replace : TexelAlpha::Multiply;
+}
+
+// The alpha of a lit draw's colour: the ambient alpha times the material's (or the vertex's) ambient alpha. A range for the
+// product of the ambient alpha and a colour alpha in [low, high], rounded outwards.
+[[nodiscard]] constexpr Range lit_alpha(std::uint32_t ambient_alpha, Range colour) noexcept {
+    Range out;
+    out.low = ambient_alpha * colour.low / 255u;
+    out.high = (ambient_alpha * colour.high + 254u) / 255u;
+    return out;
+}
+
+// What is known about the draw's alpha before the texture.
+struct Facts {
+    Range colour{};              // the alpha of the vertex colour / material / lit colour, 0..255 (the whole range when unknown)
+    TexelAlpha texel{TexelAlpha::Unused};
+    bool texel_opaque{};         // every texel the draw can read has alpha 255 (otherwise the texel's alpha is 0..255)
+};
+
+// The range of 8-bit alphas the fragments of a draw can have at the alpha test.
+[[nodiscard]] constexpr Range fragment_range(const Facts &facts) noexcept {
+    switch (facts.texel) {
+    case TexelAlpha::Unused: return facts.colour;
+    case TexelAlpha::Replace: return Range{facts.texel_opaque ? 255u : 0u, 255u};
+    default: break;
+    }
+    // colour * texel: the texel's alpha is 255 or anywhere in 0..255, so the product is the colour's alpha or runs from 0 to it.
+    return Range{facts.texel_opaque ? facts.colour.low : 0u, facts.colour.high};
+}
+
+// True when the alpha test of a draw with these facts passes for every fragment (the comparison "always" included, and the
+// rounding guard applied): the draw can be made with a program that has no alpha test.
+[[nodiscard]] constexpr bool cannot_fail(std::uint32_t function, std::uint32_t reference, const Facts &facts) noexcept {
+    if (function == kAlways) return true;
+    if (function == kNever) return false;
+    return passes_for_all(function, reference, guarded(fragment_range(facts)));
+}
+
+// The exact case the first version of the elision knew: every fragment has alpha 255. No guard (255 is a bound nothing
+// can exceed or fall below by more than the rounding), so this is the rule the renderer keeps behind `alpha_elide_range=0`.
+[[nodiscard]] constexpr bool cannot_fail_at_255(std::uint32_t function, std::uint32_t reference) noexcept {
+    return passes_for_all(function, reference, Range{255u, 255u});
+}
+
+} // namespace portablekit::gpu::alpha_test
