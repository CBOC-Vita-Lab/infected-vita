+            const std::uint8_t *b = data.data() + (static_cast<std::size_t>(by) * bw + bx) * (alpha ? 16u : 8u);
+            std::uint32_t a[16];
+            for (auto &v : a) v = 255u;
+            if (alpha) {
+                const std::uint32_t a0 = b[0], a1 = b[1];
+                std::uint32_t t[8] = {a0, a1};
+                if (a0 > a1) for (std::uint32_t i = 1; i < 7u; ++i) t[i + 1u] = ((7u - i) * a0 + i * a1) / 7u;
+                else { for (std::uint32_t i = 1; i < 5u; ++i) t[i + 1u] = ((5u - i) * a0 + i * a1) / 5u; t[6] = 0u; t[7] = 255u; }
+                std::uint64_t bits = 0u;
+                for (int i = 0; i < 6; ++i) bits |= static_cast<std::uint64_t>(b[2 + i]) << (8 * i);
+                for (std::uint32_t i = 0; i < 16u; ++i) a[i] = t[(bits >> (3u * i)) & 7u];
+                b += 8;
+            }
+            const std::uint32_t c0 = b[0] | b[1] << 8u, c1 = b[2] | b[3] << 8u;
+            if (c0 <= c1) bad_order = true;
+            std::uint32_t p[4][3] = {{e5(c0 >> 11u), e6((c0 >> 5u) & 63u), e5(c0 & 31u)}, {e5(c1 >> 11u), e6((c1 >> 5u) & 63u), e5(c1 & 31u)}};
+            for (int c = 0; c < 3; ++c) { p[2][c] = (2u * p[0][c] + p[1][c]) / 3u; p[3][c] = (p[0][c] + 2u * p[1][c]) / 3u; }
+            const std::uint32_t idx = b[4] | b[5] << 8u | b[6] << 16u | static_cast<std::uint32_t>(b[7]) << 24u;
+            for (std::uint32_t i = 0; i < 16u; ++i) {
+                const std::uint32_t x = bx * 4u + (i & 3u), y = by * 4u + (i >> 2u);
+                if (x >= w || y >= h) continue;
+                const std::uint32_t k = (idx >> (2u * i)) & 3u;
+                out[static_cast<std::size_t>(y) * w + x] = p[k][0] | p[k][1] << 8u | p[k][2] << 16u | a[i] << 24u;
+            }
+        }
+    return out;
+}
+
+double psnr(const std::vector<std::uint32_t> &a, const std::vector<std::uint32_t> &b, bool with_alpha) {
+    double se = 0.0;
+    const std::uint32_t channels = with_alpha ? 4u : 3u;
+    for (std::size_t i = 0; i < a.size(); ++i)
+        for (std::uint32_t c = 0; c < channels; ++c) {
+            const double d = static_cast<double>((a[i] >> (8u * c)) & 255u) - static_cast<double>((b[i] >> (8u * c)) & 255u);
+            se += d * d;
+        }
+    const double mse = se / (static_cast<double>(a.size()) * channels);
+    return mse == 0.0 ? 99.0 : 10.0 * std::log10(255.0 * 255.0 / mse);
+}
+
+} // namespace
+
+int main() {
+    std::vector<std::uint8_t> out;
+    bool bad = false;
+    for (int effort = 0; effort <= 2; ++effort) {
+        std::printf("-- effort %d\n", effort);
+        // A flat picture of every kind of colour, including black and white (the c0 > c1 corner cases).
+        for (const std::uint32_t colour : {0xFF000000u, 0xFFFFFFFFu, 0xFF804020u, 0xFF0000FFu, 0xFF010101u}) {
+            std::vector<std::uint32_t> img(8 * 8, colour);
+            dxt::encode_level(false, img.data(), 8, 8, out, effort);
+            bad = false;
+            const auto d = decode(false, out, 8, 8, bad);
+            check(!bad, "flat: four-colour mode");
+            check(psnr(img, d, false) > 36.0, "flat: close to the colour");
+        }
+        // A smooth ramp.
+        std::vector<std::uint32_t> ramp(64 * 32);
+        for (std::uint32_t y = 0; y < 32u; ++y)
+            for (std::uint32_t x = 0; x < 64u; ++x) ramp[y * 64u + x] = 0xFF000000u | (x * 4u) | ((y * 8u) << 8u) | ((255u - x * 4u) << 16u);
+        dxt::encode_level(false, ramp.data(), 64, 32, out, effort);
+        check(out.size() == dxt::encoded_bytes(false, 64, 32), "ramp: size");
+        bad = false;
+        check(psnr(ramp, decode(false, out, 64, 32, bad), false) > 34.0 && !bad, "ramp: PSNR above 34 dB (three independent ramps in a block), four-colour mode");
+        // Two flat colours with a hard edge inside blocks.
+        std::vector<std::uint32_t> edge(32 * 32);
+        for (std::uint32_t y = 0; y < 32u; ++y)
+            for (std::uint32_t x = 0; x < 32u; ++x) edge[y * 32u + x] = x < 13u ? 0xFF2040C0u : 0xFFE0A030u;
+        dxt::encode_level(false, edge.data(), 32, 32, out, effort);
+        bad = false;
+        check(psnr(edge, decode(false, out, 32, 32, bad), false) > 38.0, "edge: PSNR above 38 dB");
+        // Alpha: a ramp in alpha over a flat colour; a fully transparent and a fully opaque block.
+        std::vector<std::uint32_t> alpha(32 * 16);
+        for (std::uint32_t y = 0; y < 16u; ++y)
+            for (std::uint32_t x = 0; x < 32u; ++x) alpha[y * 32u + x] = (x < 4u ? 0u : (x >= 28u ? 255u : x * 8u)) << 24u | 0x00406080u;
+        dxt::encode_level(true, alpha.data(), 32, 16, out, effort);
+        check(out.size() == dxt::encoded_bytes(true, 32, 16), "alpha: size");
+        bad = false;
+        const auto da = decode(true, out, 32, 16, bad);
+        check(!bad, "alpha: four-colour mode");
+        bool exact_ends = true;
+        for (std::uint32_t y = 0; y < 16u; ++y) { if ((da[y * 32u] >> 24u) != 0u || (da[y * 32u + 31u] >> 24u) != 255u) exact_ends = false; }
+        check(exact_ends, "alpha: transparent and opaque blocks stay so");
+        double worst = 0.0;
+        for (std::size_t i = 0; i < alpha.size(); ++i) worst = std::max(worst, std::fabs(static_cast<double>(alpha[i] >> 24u) - static_cast<double>(da[i] >> 24u)));
+        check(worst <= 20.0, "alpha: ramp error at most 20 levels");
+        // Odd size: padding by edge repeat, no crash, size of the padded block grid.
+        std::vector<std::uint32_t> odd(7 * 5, 0xFF336699u);
+        dxt::encode_level(false, odd.data(), 7, 5, out, effort);
+        check(out.size() == 2u * 2u * 8u, "odd 7x5: 2x2 blocks");
+        bad = false;
+        check(psnr(odd, decode(false, out, 7, 5, bad), false) > 36.0, "odd 7x5: colour kept");
+        // 1x1 (the last level of a chain).
+        std::vector<std::uint32_t> one(1, 0xFF336699u);
+        dxt::encode_level(false, one.data(), 1, 1, out, effort);
+        check(out.size() == 8u, "1x1: one block");
+        // Noise: worst case for a two-colour block; only that it is valid and not absurd.
+        std::vector<std::uint32_t> noise(32 * 32);
+        std::uint32_t seed = 12345u;
+        for (auto &v : noise) { seed = seed * 1664525u + 1013904223u; v = 0xFF000000u | (seed >> 8u & 0xFFFFFFu); }
+        dxt::encode_level(false, noise.data(), 32, 32, out, effort);
+        bad = false;
+        const double q = psnr(noise, decode(false, out, 32, 32, bad), false);
+        check(!bad && q > 12.0, "noise: valid blocks, PSNR above 12 dB (uniform RGB noise)");
+    }
+    std::printf("%s\n", g_failures == 0 ? "all ok" : "FAILED");
+    return g_failures == 0 ? 0 : 1;
+}
