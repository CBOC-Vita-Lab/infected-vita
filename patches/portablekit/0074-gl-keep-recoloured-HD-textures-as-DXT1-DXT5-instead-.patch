index 0000000..840b81c
--- /dev/null
+++ b/host/gpu/dxt_encode.hpp
@@ -0,0 +1,272 @@
+#pragma once
+
+// A small DXT1 / DXT5 (BC1 / BC3) encoder for pictures the renderer builds at run time (a character texture rebuilt for the
+// palette the game uses now, gl_hd_textures.cpp), where an offline compressor cannot be used. Written for speed on the Vita's
+// ARM core, not for the last decibel: per 4x4 block one principal-axis estimate from the covariance, 565 endpoints, exact
+// nearest-index selection against the decoded palette and one least-squares refit of the endpoints. Own code, no external
+// source. Pixels are RGBA bytes with red in the low byte (the renderer's order), rows top to bottom.
+//
+// The output is the layout the pack blobs and the GL compressed formats use: DXT1 8 bytes a block (c0 u16, c1 u16, 32 bits of
+// 2-bit indices, texel 0 in the low bits) with c0 > c1 always (four-colour mode, so no black or transparent index appears),
+// DXT5 16 bytes (alpha: a0, a1, 48 bits of 3-bit indices, then the colour block), blocks left to right, rows top to bottom.
+// A level whose width or height is not a multiple of 4 is padded by repeating its edge texels.
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace portablekit::gpu::dxt {
+
+// Bytes of an encoded level.
+[[nodiscard]] inline std::size_t encoded_bytes(bool alpha, std::uint32_t width, std::uint32_t height) {
+    return static_cast<std::size_t>((width + 3u) / 4u) * ((height + 3u) / 4u) * (alpha ? 16u : 8u);
+}
+
+namespace detail {
+
+inline std::uint32_t expand5(std::uint32_t v) { return (v << 3u) | (v >> 2u); }
+inline std::uint32_t expand6(std::uint32_t v) { return (v << 2u) | (v >> 4u); }
+
+inline std::uint16_t pack565(int r, int g, int b) {   // r, g, b 0..255 -> nearest 565
+    // round(v * 31 / 255) and round(v * 63 / 255) without a division (exact for 0..255)
+    r = std::clamp(r, 0, 255), g = std::clamp(g, 0, 255), b = std::clamp(b, 0, 255);
+    const int r5 = (r * 249 + 1024) >> 11;
+    const int g6 = (g * 253 + 512) >> 10;
+    const int b5 = (b * 249 + 1024) >> 11;
+    return static_cast<std::uint16_t>((r5 << 11) | (g6 << 5) | b5);
+}
+
+inline void unpack565(std::uint16_t c, int &r, int &g, int &b) {
+    r = static_cast<int>(expand5((c >> 11u) & 31u));
+    g = static_cast<int>(expand6((c >> 5u) & 63u));
+    b = static_cast<int>(expand5(c & 31u));
+}
+
+// The colour part of a block: `px` are 16 texels (RGBA, red low). Writes 8 bytes.
+inline void encode_colour(const std::uint32_t *px, std::uint8_t *out, int effort) {
+    int rgb[16][3];
+    int lo[3] = {255, 255, 255}, hi[3] = {0, 0, 0};
+    int sum[3] = {0, 0, 0};
+    for (int i = 0; i < 16; ++i) {
+        rgb[i][0] = static_cast<int>(px[i] & 255u);
+        rgb[i][1] = static_cast<int>((px[i] >> 8u) & 255u);
+        rgb[i][2] = static_cast<int>((px[i] >> 16u) & 255u);
+        for (int c = 0; c < 3; ++c) {
+            lo[c] = std::min(lo[c], rgb[i][c]);
+            hi[c] = std::max(hi[c], rgb[i][c]);
+            sum[c] += rgb[i][c];
+        }
+    }
+    std::uint16_t c0, c1;
+    std::uint32_t indices = 0u;
+    if (lo[0] == hi[0] && lo[1] == hi[1] && lo[2] == hi[2]) {
+        // A flat block: the 565 value nearest to it, and index 0.
+        c0 = pack565(lo[0], lo[1], lo[2]);
+        c1 = c0 > 0u ? static_cast<std::uint16_t>(c0 - 1u) : static_cast<std::uint16_t>(0u);
+        std::uint8_t fill = 0u;   // index 0 = c0
+        if (c0 == 0u) {           // black: c0 = 1 (almost black) and c1 = 0, every texel index 1 = c1
+            c0 = 1u;
+            fill = 0x55u;
+        }
+        std::uint8_t *p = out;
+        p[0] = static_cast<std::uint8_t>(c0), p[1] = static_cast<std::uint8_t>(c0 >> 8u);
+        p[2] = static_cast<std::uint8_t>(c1), p[3] = static_cast<std::uint8_t>(c1 >> 8u);
+        p[4] = p[5] = p[6] = p[7] = fill;
+        return;
+    }
+    // The axis through the block's colours: the covariance's dominant direction, three power-iteration steps from the
+    // bounding box diagonal (the cheap guess when the colours lie along it).
+    const float mean[3] = {sum[0] / 16.0f, sum[1] / 16.0f, sum[2] / 16.0f};
+    float cov[6] = {0, 0, 0, 0, 0, 0};   // rr rg rb gg gb bb
+    for (int i = 0; i < 16; ++i) {
+        const float r = rgb[i][0] - mean[0], g = rgb[i][1] - mean[1], b = rgb[i][2] - mean[2];
+        cov[0] += r * r, cov[1] += r * g, cov[2] += r * b, cov[3] += g * g, cov[4] += g * b, cov[5] += b * b;
+    }
+    float axis[3] = {static_cast<float>(hi[0] - lo[0]), static_cast<float>(hi[1] - lo[1]), static_cast<float>(hi[2] - lo[2])};
+    // The box diagonal runs from the minimum to the maximum corner; the signs of the red-green and red-blue covariances say whether
+    // green and blue rise or fall with red.
+    if (cov[1] < 0.0f) axis[1] = -axis[1];
+    if (cov[2] < 0.0f) axis[2] = -axis[2];
+    for (int it = 0; it < (effort >= 2 ? 3 : 0); ++it) {
+        const float x = cov[0] * axis[0] + cov[1] * axis[1] + cov[2] * axis[2];
+        const float y = cov[1] * axis[0] + cov[3] * axis[1] + cov[4] * axis[2];
+        const float z = cov[2] * axis[0] + cov[4] * axis[1] + cov[5] * axis[2];
+        const float m = std::max({x < 0 ? -x : x, y < 0 ? -y : y, z < 0 ? -z : z});
+        if (m < 1e-6f) break;
+        axis[0] = x / m, axis[1] = y / m, axis[2] = z / m;
+    }
+    // Endpoints: the extremes of the projections onto the axis.
+    float tmin = 1e30f, tmax = -1e30f;
+    for (int i = 0; i < 16; ++i) {
+        const float t = (rgb[i][0] - mean[0]) * axis[0] + (rgb[i][1] - mean[1]) * axis[1] + (rgb[i][2] - mean[2]) * axis[2];
+        tmin = std::min(tmin, t);
+        tmax = std::max(tmax, t);
+    }
+    const float norm = axis[0] * axis[0] + axis[1] * axis[1] + axis[2] * axis[2];
+    float end[2][3];
+    for (int c = 0; c < 3; ++c) {
+        end[0][c] = mean[c] + axis[c] * tmax / (norm > 0 ? norm : 1.0f);
+        end[1][c] = mean[c] + axis[c] * tmin / (norm > 0 ? norm : 1.0f);
+    }
+    const auto quant = [&](const float (&e)[3]) {
+        return pack565(static_cast<int>(e[0] + 0.5f), static_cast<int>(e[1] + 0.5f), static_cast<int>(e[2] + 0.5f));
+    };
+    c0 = quant(end[0]);
+    c1 = quant(end[1]);
+    int palette[4][3];
+    const auto build = [&]() {
+        if (c0 < c1) std::swap(c0, c1);
+        if (c0 == c1) {   // keep the four-colour mode: c0 > c1
+            if (c0 != 0xFFFFu) ++c0; else --c1;
+        }
+        unpack565(c0, palette[0][0], palette[0][1], palette[0][2]);
+        unpack565(c1, palette[1][0], palette[1][1], palette[1][2]);
+        for (int c = 0; c < 3; ++c) {
+            palette[2][c] = (2 * palette[0][c] + palette[1][c]) / 3;
+            palette[3][c] = (palette[0][c] + 2 * palette[1][c]) / 3;
+        }
+    };
+    // The four palette colours lie on one line, so the nearest one is the one nearest by projection onto it: three comparisons
+    // against the midpoints instead of four distances.
+    const auto assign = [&]() {
+        const int dr = palette[0][0] - palette[1][0], dg = palette[0][1] - palette[1][1], db = palette[0][2] - palette[1][2];
+        int dot[4];
+        for (int k = 0; k < 4; ++k) dot[k] = palette[k][0] * dr + palette[k][1] * dg + palette[k][2] * db;
+        // dot[0] >= dot[2] >= dot[3] >= dot[1]
+        const int t1 = (dot[0] + dot[2]) / 2, t2 = (dot[2] + dot[3]) / 2, t3 = (dot[3] + dot[1]) / 2;
+        std::uint32_t result = 0u;
+        for (int i = 0; i < 16; ++i) {
+            const int d = rgb[i][0] * dr + rgb[i][1] * dg + rgb[i][2] * db;
+            const std::uint32_t code = d >= t1 ? 0u : (d >= t2 ? 2u : (d >= t3 ? 3u : 1u));
+            result |= code << (2 * i);
+        }
+        return result;
+    };
+    build();
+    indices = assign();
+    // One least-squares refit of the endpoints for the indices found (weights 1, 2/3, 1/3, 0 of c0), then the indices again.
+    if (effort >= 1) {
+        static const float w0[4] = {1.0f, 0.0f, 2.0f / 3.0f, 1.0f / 3.0f};   // index 0 = c0, 1 = c1, 2 = 2/3 c0 + 1/3 c1, 3 = 1/3 c0 + 2/3 c1
+        float aa = 0, bb = 0, ab = 0, ax[3] = {0, 0, 0}, bx[3] = {0, 0, 0};
+        for (int i = 0; i < 16; ++i) {
+            const float a = w0[(indices >> (2 * i)) & 3u], b = 1.0f - a;
+            aa += a * a, bb += b * b, ab += a * b;
+            for (int c = 0; c < 3; ++c) ax[c] += a * rgb[i][c], bx[c] += b * rgb[i][c];
+        }
+        const float det = aa * bb - ab * ab;
+        if (det > 1e-4f || det < -1e-4f) {
+            float e0[3], e1[3];
+            for (int c = 0; c < 3; ++c) {
+                e0[c] = (ax[c] * bb - bx[c] * ab) / det;
+                e1[c] = (bx[c] * aa - ax[c] * ab) / det;
+                e0[c] = std::clamp(e0[c], 0.0f, 255.0f);
+                e1[c] = std::clamp(e1[c], 0.0f, 255.0f);
+            }
+            const std::uint16_t n0 = quant(e0), n1 = quant(e1);
+            const std::uint16_t o0 = c0, o1 = c1;
+            const std::uint32_t old_indices = indices;
+            c0 = n0, c1 = n1;
+            build();
+            const std::uint32_t refit = assign();
+            // Keep the refit only when it is no worse than the first fit.
+            int err_new = 0;
+            for (int i = 0; i < 16; ++i) {
+                const int k = static_cast<int>((refit >> (2 * i)) & 3u);
+                for (int c = 0; c < 3; ++c) {
+                    const int d = rgb[i][c] - palette[k][c];
+                    err_new += d * d;
+                }
+            }
+            int p_old[4][3];
+            {
+                const std::uint16_t s0 = c0, s1 = c1;
+                c0 = o0, c1 = o1;
+                build();
+                for (int k = 0; k < 4; ++k)
+                    for (int c = 0; c < 3; ++c) p_old[k][c] = palette[k][c];
+                c0 = s0, c1 = s1;
+            }
+            int err_old = 0;
+            for (int i = 0; i < 16; ++i) {
+                const int k = static_cast<int>((old_indices >> (2 * i)) & 3u);
+                for (int c = 0; c < 3; ++c) {
+                    const int d = rgb[i][c] - p_old[k][c];
+                    err_old += d * d;
+                }
+            }
+            if (err_new <= err_old) {
+                indices = refit;
+            } else {
+                c0 = o0, c1 = o1;
+                build();
+                indices = old_indices;
+            }
+        }
+    }
+    // build() may have swapped the endpoints (c0 < c1 after the refit's quantisation): the indices were chosen against
+    // the palette it built, so they match what is written.
+    out[0] = static_cast<std::uint8_t>(c0), out[1] = static_cast<std::uint8_t>(c0 >> 8u);
+    out[2] = static_cast<std::uint8_t>(c1), out[3] = static_cast<std::uint8_t>(c1 >> 8u);
+    out[4] = static_cast<std::uint8_t>(indices), out[5] = static_cast<std::uint8_t>(indices >> 8u);
+    out[6] = static_cast<std::uint8_t>(indices >> 16u), out[7] = static_cast<std::uint8_t>(indices >> 24u);
+}
+
+// The alpha part of a DXT5 block (8 bytes): eight-level mode, a0 > a1.
+inline void encode_alpha(const std::uint32_t *px, std::uint8_t *out) {
+    int lo = 255, hi = 0;
+    int a[16];
+    for (int i = 0; i < 16; ++i) {
+        a[i] = static_cast<int>(px[i] >> 24u);
+        lo = std::min(lo, a[i]);
+        hi = std::max(hi, a[i]);
+    }
+    if (lo == hi) {
+        out[0] = static_cast<std::uint8_t>(hi);
+        out[1] = static_cast<std::uint8_t>(hi > 0 ? hi - 1 : 0);
+        if (hi == 0) out[0] = 1;   // keep a0 > a1; index 0 would then be 1, not 0: use a1 = 0 and index 1 instead
+        std::uint64_t bits = 0u;
+        if (hi == 0)
+            for (int i = 0; i < 16; ++i) bits |= static_cast<std::uint64_t>(1u) << (3 * i);   // index 1 = a1 = 0
+        for (int i = 0; i < 6; ++i) out[2 + i] = static_cast<std::uint8_t>(bits >> (8 * i));
+        return;
+    }
+    const int a0 = hi, a1 = lo;
+    std::uint64_t bits = 0u;
+    const int range = a0 - a1;
+    for (int i = 0; i < 16; ++i) {
+        // Step s in 0..7 along a0 -> a1; the code of step s is 0 for s = 0, 1 for s = 7, s + 1 between.
+        const int s = std::clamp(((a0 - a[i]) * 7 + range / 2) / range, 0, 7);
+        const int code = s == 0 ? 0 : (s == 7 ? 1 : s + 1);
+        bits |= static_cast<std::uint64_t>(code) << (3 * i);
+    }
+    out[0] = static_cast<std::uint8_t>(a0);
+    out[1] = static_cast<std::uint8_t>(a1);
+    for (int i = 0; i < 6; ++i) out[2 + i] = static_cast<std::uint8_t>(bits >> (8 * i));
+}
+
+} // namespace detail
+
+// Encodes a width x height level (RGBA, red low) into `out`, resized to encoded_bytes(); `alpha` selects DXT5 over DXT1.
+inline void encode_level(bool alpha, const std::uint32_t *rgba, std::uint32_t width, std::uint32_t height, std::vector<std::uint8_t> &out, int effort = 2) {
+    const std::uint32_t bw = (width + 3u) / 4u, bh = (height + 3u) / 4u;
+    out.resize(encoded_bytes(alpha, width, height));
+    std::uint8_t *o = out.data();
+    std::uint32_t px[16];
+    for (std::uint32_t by = 0; by < bh; ++by)
+        for (std::uint32_t bx = 0; bx < bw; ++bx) {
+            for (std::uint32_t y = 0; y < 4u; ++y) {
+                const std::uint32_t sy = std::min(by * 4u + y, height - 1u);
+                for (std::uint32_t x = 0; x < 4u; ++x) px[y * 4u + x] = rgba[static_cast<std::size_t>(sy) * width + std::min(bx * 4u + x, width - 1u)];
+            }
+            if (alpha) {
+                detail::encode_alpha(px, o);
+                detail::encode_colour(px, o + 8, effort);
+                o += 16;
+            } else {
+                detail::encode_colour(px, o, effort);
+                o += 8;
+            }
+        }
+}
+
+} // namespace portablekit::gpu::dxt
