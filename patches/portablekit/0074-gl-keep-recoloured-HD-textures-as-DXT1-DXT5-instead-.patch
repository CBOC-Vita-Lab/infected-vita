+// A rebuilt picture kept as DXT: every level down to 1x1 (to the last whole 4x4 block on the Vita, as the pack's own DXT
+// records), encoded one after the other. DXT5 when any texel of level 0 is not opaque, DXT1 otherwise. `level` is consumed.
+struct DxtChain {
+    std::vector<std::uint8_t> bytes;
+    std::uint32_t levels{};
+    bool alpha{};
+    double psnr{-1.0};          // level 0 against its source, when asked
+    std::uint64_t ns{};
+    std::uint64_t rgba_bytes{}; // the same chain as RGBA8
+};
+
+void build_dxt_chain(std::vector<std::uint32_t> &level, std::uint32_t width, std::uint32_t height, bool check, DxtChain &out) {
+    const auto start = std::chrono::steady_clock::now();
+    out.bytes.clear();
+    out.levels = 0u;
+    out.rgba_bytes = 0u;
+    out.alpha = false;
+    for (const std::uint32_t texel : level)
+        if ((texel >> 24u) != 0xFFu) {
+            out.alpha = true;
+            break;
+        }
+    std::vector<std::uint8_t> encoded;
+    std::vector<std::uint32_t> next, decoded;
+    std::uint32_t w = width, h = height;
+    for (;;) {
+#if defined(__vita__)
+        if (out.levels != 0u && (w < 4u || h < 4u)) break;   // vitaGL swizzles compressed levels in whole 4x4 blocks
+#endif
+        dxt::encode_level(out.alpha, level.data(), w, h, encoded, out.levels == 0u ? 1 : 0);
+        out.bytes.insert(out.bytes.end(), encoded.begin(), encoded.end());
+        out.rgba_bytes += static_cast<std::uint64_t>(w) * h * 4u;
+        if (out.levels == 0u && check) {
+            decode_dxt_level(out.alpha ? HdFormat::Dxt5 : HdFormat::Dxt1, encoded.data(), w, h, decoded);
+            double squared = 0.0;
+            for (std::size_t i = 0; i < decoded.size(); ++i)
+                for (std::uint32_t c = 0; c < 4u; ++c) {
+                    const double d = static_cast<double>((decoded[i] >> (8u * c)) & 255u) - static_cast<double>((level[i] >> (8u * c)) & 255u);
+                    squared += d * d;
+                }
+            const double mse = squared / (static_cast<double>(decoded.size()) * 4.0);
+            out.psnr = mse <= 0.0 ? 99.0 : 10.0 * std::log10(255.0 * 255.0 / mse);
+        }
+        ++out.levels;
+        if (w == 1u && h == 1u) break;
+        halve(level, w, h, next);
+        level.swap(next);
+        w = std::max(w / 2u, 1u);
