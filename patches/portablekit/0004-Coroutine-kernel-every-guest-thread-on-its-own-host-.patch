+# pk_runtime: the part of the system layer that runs the guest and answers its
+# system calls (cmake/PortableKit.cmake lists it): kernel, HLE modules, GE state,
+# texture decoding, SAS, the ATRAC and MPEG players, save data, the disc image
+# reader, with the interpreter and memory in psprecomp_core. It needs no SDL3,
+# Vulkan or ImGui, and FFmpeg only behind the decoder classes (without it they
+# report that they cannot decode). A platform layer for a target without a
+# desktop links it with its own window, renderer, audio device and input.
+# The tests below link it instead of compiling the sources again.
+if(PSPRECOMP_BUILD_TESTS OR PORTABLEKIT_BUILD_RUNTIME_LIBRARY)
+    set(_runtime_sources)
+    foreach(_source IN LISTS PORTABLEKIT_RUNTIME_SOURCES)
+        list(APPEND _runtime_sources "${PORTABLEKIT_ROOT}/${_source}")
+    endforeach()
+    # tiny-AES-c is C; the project only enables C++, which compiles it unchanged.
+    set_source_files_properties("${PORTABLEKIT_ROOT}/third_party/tiny_aes/aes.c" PROPERTIES LANGUAGE CXX)
+    add_library(pk_runtime STATIC ${_runtime_sources})
+    target_compile_features(pk_runtime PUBLIC cxx_std_20)
+    target_include_directories(pk_runtime PUBLIC "${PORTABLEKIT_ROOT}/host" "${PORTABLEKIT_ROOT}/third_party")
+    target_link_libraries(pk_runtime PUBLIC psprecomp_core)
+    find_package(Threads REQUIRED)
+    target_link_libraries(pk_runtime PUBLIC Threads::Threads ${CMAKE_DL_LIBS})
+    if(WIN32)
+        target_link_libraries(pk_runtime PUBLIC ws2_32 iphlpapi)
+    endif()
+endif()
