new file mode 100644
index 0000000..3a7033c
--- /dev/null
+++ b/tests/kernel_tests.cpp
@@ -0,0 +1,416 @@
+// The coroutine kernel (host/kernel): every guest thread on a host stack of its own,
+// scheduling order, pre-emption, waiting in the middle of nested guest calls,
+// interrupts, thread deletion and a stop from deep inside. The guest code is
+// hand-assembled MIPS that runs in the interpreter and calls native stubs; no game,
+// no corpus.
+//
+// The kernel is one object per process, so each scenario is a run of its own:
+// `portablekit_kernel_tests N` runs scenario N, and with no argument the test runs
+// every scenario in a process of its own.
+
+#include "kernel/kernel.hpp"
+
+#include "psprecomp/exec.hpp"
+#include "psprecomp/interpreter.hpp"
+#include "psprecomp/runtime.hpp"
+
+#include <cstdio>
+#include <cstdlib>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace {
+
+using namespace portablekit;
+using psprecomp::AllegrexContext;
+using psprecomp::CorpusRuntime;
+using psprecomp::Runtime;
+
+int g_failures = 0;
+
+void check(bool condition, const char *what) {
+    std::printf("%s %s\n", condition ? "ok  " : "FAIL", what);
+    if (!condition) ++g_failures;
+}
+
+std::vector<std::uint32_t> g_log;
+
+void log_is(const std::vector<std::uint32_t> &expected, const char *what) {
+    const bool same = g_log == expected;
+    check(same, what);
+    if (!same) {
+        std::printf("      got: ");
+        for (const std::uint32_t value : g_log) std::printf(" %X", value);
+        std::printf("\n      want:");
+        for (const std::uint32_t value : expected) std::printf(" %X", value);
+        std::printf("\n");
+    }
+}
+
+// ---------------------------------------------------------------------------
+// The native stubs the guest programs call. Like a system call, each ends by
+// returning to $ra.
+
+std::uint32_t arg(AllegrexContext &ctx, unsigned i) { return ctx.gpr[4 + i]; }
+void ret(AllegrexContext &ctx) { ctx.pc = ctx.gpr[31]; }
+
+void stub_log(CorpusRuntime &, AllegrexContext &ctx) {
+    g_log.push_back(arg(ctx, 0));
+    kernel().finish(ctx, 0u);
+    ret(ctx);
+}
+void stub_delay(CorpusRuntime &, AllegrexContext &ctx) {
+    kernel().delay_current(ctx, arg(ctx, 0));
+    ret(ctx);
+}
+void stub_start(CorpusRuntime &, AllegrexContext &ctx) {
+    const std::int32_t status = kernel().start_thread(ctx, static_cast<SceUID>(arg(ctx, 0)), 0u, 0u);
+    kernel().finish(ctx, static_cast<std::uint32_t>(status));
+    ret(ctx);
+}
+void stub_sleep(CorpusRuntime &, AllegrexContext &ctx) {
+    WaitState wait{};
+    wait.type = WaitType::Sleep;
+    kernel().block(ctx, wait, 0u);
+    ret(ctx);
+}
+void stub_exit(CorpusRuntime &, AllegrexContext &ctx) {
+    kernel().exit_current_thread(ctx, static_cast<std::int32_t>(arg(ctx, 0)), arg(ctx, 1) != 0u);
+}
+void stub_stop(CorpusRuntime &runtime, AllegrexContext &ctx) {
+    static_cast<Runtime &>(runtime).stop("test finished");
+    kernel().finish(ctx, 0u);
+    ret(ctx);
+}
+// call_guest(function a0, argument a1): logs the callee's v0 when it returns.
+void stub_call_guest(CorpusRuntime &, AllegrexContext &ctx) {
+    kernel().call_guest(ctx, arg(ctx, 0), {arg(ctx, 1), 0u, 0u, 0u}, [](AllegrexContext &returned, std::uint32_t result) {
+        g_log.push_back(result);
+        kernel().finish(returned, 0u);
+    });
+    ret(ctx);
+}
+// What an interrupt handler gets when it tries to wait: it cannot, and says so.
+void stub_try_wait(CorpusRuntime &, AllegrexContext &ctx) {
+    WaitState wait{};
+    wait.type = WaitType::Sleep;
+    kernel().block(ctx, wait, 0u);
+    g_log.push_back(ctx.gpr[2]);
+    kernel().finish(ctx, 0u);
+    ret(ctx);
+}
+void stub_queue_interrupt(CorpusRuntime &, AllegrexContext &ctx) {
+    InterruptCall call{};
+    call.function = arg(ctx, 0);
+    call.arguments = {arg(ctx, 1), 0u, 0u, 0u};
+    call.on_return = [](std::uint32_t result) { g_log.push_back(0x1000u + result); };
+    kernel().queue_interrupt(std::move(call));
+    kernel().finish(ctx, 0u);
+    ret(ctx);
+}
+void stub_terminate(CorpusRuntime &, AllegrexContext &ctx) {
+    const std::int32_t status = kernel().terminate_thread(ctx, static_cast<SceUID>(arg(ctx, 0)), arg(ctx, 1) != 0u);
+    kernel().finish(ctx, static_cast<std::uint32_t>(status));
+    ret(ctx);
+}
+void stub_priority(CorpusRuntime &, AllegrexContext &ctx) {
+    const std::int32_t status = kernel().change_priority(ctx, 0, arg(ctx, 0));
+    kernel().finish(ctx, static_cast<std::uint32_t>(status));
+    ret(ctx);
+}
+
+constexpr std::uint32_t kLog = 0x08800100u;
+constexpr std::uint32_t kDelay = 0x08800104u;
+constexpr std::uint32_t kStart = 0x08800108u;
+constexpr std::uint32_t kSleep = 0x0880010Cu;
+constexpr std::uint32_t kExit = 0x08800114u;
+constexpr std::uint32_t kStop = 0x08800118u;
+constexpr std::uint32_t kCallGuest = 0x0880011Cu;
+constexpr std::uint32_t kTryWait = 0x08800120u;
+constexpr std::uint32_t kQueueInterrupt = 0x08800124u;
+constexpr std::uint32_t kTerminate = 0x08800128u;
+constexpr std::uint32_t kPriority = 0x0880012Cu;
+
+// ---------------------------------------------------------------------------
+// A tiny assembler.
+
+constexpr std::uint32_t kCodeBase = 0x08A00000u;
+constexpr std::uint32_t kSlotBytes = 0x4000u;
+constexpr std::uint32_t kImageEnd = 0x08C00000u;  // thread stacks are allocated above this
+
+std::uint32_t slot_address(unsigned slot) { return kCodeBase + slot * kSlotBytes; }
+
+struct Code {
+    std::vector<std::uint32_t> words;
+
+    static std::uint32_t i_type(std::uint32_t opcode, std::uint32_t rs, std::uint32_t rt, std::uint32_t imm) {
+        return (opcode << 26u) | (rs << 21u) | (rt << 16u) | (imm & 0xFFFFu);
+    }
+    void op(std::uint32_t word) { words.push_back(word); }
+    void li(std::uint32_t reg, std::uint32_t value) {
+        op(i_type(0x0Fu, 0u, reg, value >> 16u));      // lui reg, hi
+        op(i_type(0x0Du, reg, reg, value & 0xFFFFu));  // ori reg, reg, lo
+    }
+    void call(std::uint32_t target) {
+        op((3u << 26u) | ((target >> 2u) & 0x03FFFFFFu));  // jal target
+        op(0u);                                            // nop (delay slot)
+    }
+    Code &log(std::uint32_t value) { li(4u, value); call(kLog); return *this; }
+    Code &delay(std::uint32_t us) { li(4u, us); call(kDelay); return *this; }
+    Code &start(std::int32_t uid) { li(4u, static_cast<std::uint32_t>(uid)); call(kStart); return *this; }
+    Code &sleep() { call(kSleep); return *this; }
+    Code &exit(std::uint32_t status, bool remove) { li(4u, status); li(5u, remove ? 1u : 0u); call(kExit); return *this; }
+    Code &stop() { call(kStop); return *this; }
+    Code &call_guest(std::uint32_t function, std::uint32_t argument) { li(4u, function); li(5u, argument); call(kCallGuest); return *this; }
+    Code &try_wait() { call(kTryWait); return *this; }
+    Code &queue_interrupt(std::uint32_t function, std::uint32_t argument) { li(4u, function); li(5u, argument); call(kQueueInterrupt); return *this; }
+    Code &terminate(std::int32_t uid, bool remove) { li(4u, static_cast<std::uint32_t>(uid)); li(5u, remove ? 1u : 0u); call(kTerminate); return *this; }
+    Code &priority(std::uint32_t value) { li(4u, value); call(kPriority); return *this; }
+    Code &set_v0(std::uint32_t value) { li(2u, value); return *this; }
+};
+
+// A guest function: a frame, the steps, a return. A step may set v0 last to answer.
+void install(Runtime &runtime, unsigned slot, const Code &body) {
+    Code function;
+    function.op(Code::i_type(0x09u, 29u, 29u, 0xFFE0u));  // addiu sp, sp, -32
+    function.op(Code::i_type(0x2Bu, 29u, 31u, 28u));      // sw ra, 28(sp)
+    function.words.insert(function.words.end(), body.words.begin(), body.words.end());
+    function.op(Code::i_type(0x23u, 29u, 31u, 28u));      // lw ra, 28(sp)
+    function.op(Code::i_type(0x09u, 29u, 29u, 32u));      // addiu sp, sp, 32
+    function.op(0x03E00008u);                             // jr ra
+    function.op(0u);                                      //   nop
+    const std::uint32_t base = slot_address(slot);
+    for (std::size_t i = 0; i < function.words.size(); ++i)
+        runtime.memory().store32(base + static_cast<std::uint32_t>(i) * 4u, function.words[i]);
+}
+
+struct Fixture {
+    Runtime runtime;
+    AllegrexContext caller{};  // what the kernel is called with outside a thread
+
+    Fixture() {
+        runtime.register_function(kLog, &stub_log, "log");
+        runtime.register_function(kDelay, &stub_delay, "delay");
+        runtime.register_function(kStart, &stub_start, "start");
+        runtime.register_function(kSleep, &stub_sleep, "sleep");
+        runtime.register_function(kExit, &stub_exit, "exit");
+        runtime.register_function(kStop, &stub_stop, "stop");
+        runtime.register_function(kCallGuest, &stub_call_guest, "call_guest");
+        runtime.register_function(kTryWait, &stub_try_wait, "try_wait");
+        runtime.register_function(kQueueInterrupt, &stub_queue_interrupt, "queue_interrupt");
+        runtime.register_function(kTerminate, &stub_terminate, "terminate");
+        runtime.register_function(kPriority, &stub_priority, "priority");
+        kernel().install(runtime, 0u, kImageEnd);
+    }
+
+    // A thread whose entry is code slot `slot`.
+    SceUID create(const char *name, unsigned slot, std::uint32_t priority) {
+        const std::int32_t uid = kernel().create_thread(name, slot_address(slot), priority, 0x4000u, 0u, 0u);
+        check(uid > 0, name);
+        return uid;
+    }
+    void start(SceUID uid) { check(kernel().start_thread(caller, uid, 0u, 0u) == 0, "thread started"); }
+    void run() {
+        g_log.clear();
+        kernel().run_main();
+    }
+};
+
+// ---------------------------------------------------------------------------
+// The scenarios.
+
+// Equal priorities run in the order they became ready; delays end in deadline order.
+void equal_priorities() {
+    Fixture f;
+    const SceUID starter = f.create("starter", 0, 20u);
+    const SceUID first = f.create("first", 1, 40u);
+    const SceUID second = f.create("second", 2, 40u);
+    install(f.runtime, 0, Code().start(first).start(second).log(0u).exit(0u, false));
+    install(f.runtime, 1, Code().log(1u).delay(1000u).log(4u).stop());
+    install(f.runtime, 2, Code().log(2u).delay(500u).log(3u).exit(0u, false));
+    f.start(starter);
+    f.run();
+    log_is({0u, 1u, 2u, 3u, 4u}, "equal priorities run in start order; delays end in deadline order");
+    check(f.runtime.stop_reason() == "test finished", "the guest's stop leaves the scheduler");
+}
+
+// A better thread pre-empts at once; the pre-empted one goes to the front of its queue.
+void preemption_front_of_queue() {
+    Fixture f;
+    const SceUID starter = f.create("starter", 0, 20u);
+    const SceUID low1 = f.create("low1", 1, 60u);
+    const SceUID low2 = f.create("low2", 2, 60u);
+    const SceUID high = f.create("high", 3, 30u);
+    install(f.runtime, 0, Code().start(low1).start(low2).exit(0u, false));
+    install(f.runtime, 1, Code().log(10u).start(high).log(11u).exit(0u, false));
+    install(f.runtime, 2, Code().log(12u).stop());
+    install(f.runtime, 3, Code().log(20u).exit(0u, false));
+    f.start(starter);
+    f.run();
+    log_is({10u, 20u, 11u, 12u}, "a better thread pre-empts at once; the pre-empted one resumes before its equals");
+}
+
+// A thread that lowers its own priority below a ready one gives the processor up.
+void priority_lowered() {
+    Fixture f;
+    const SceUID starter = f.create("starter", 0, 20u);
+    const SceUID worker = f.create("worker", 1, 40u);
+    const SceUID peer = f.create("peer", 2, 50u);
+    install(f.runtime, 0, Code().start(worker).start(peer).exit(0u, false));
+    install(f.runtime, 1, Code().log(1u).priority(60u).log(3u).exit(0u, false));
+    install(f.runtime, 2, Code().log(2u).delay(100u).log(4u).stop());
+    f.start(starter);
+    f.run();
+    log_is({1u, 2u, 3u, 4u}, "lowering its own priority gives the processor to a thread that now outranks it");
+}
+
+// A guest function called from the system waits; another thread runs meanwhile.
+void wait_inside_guest_call() {
+    Fixture f;
+    const SceUID starter = f.create("starter", 0, 20u);
+    const SceUID t1 = f.create("t1", 1, 40u);
+    const SceUID t2 = f.create("t2", 2, 40u);
+    install(f.runtime, 0, Code().start(t1).start(t2).exit(0u, false));
+    install(f.runtime, 1, Code().log(30u).call_guest(slot_address(4), 5u).log(33u).stop());
+    install(f.runtime, 2, Code().log(40u).exit(0u, false));
+    // The callee logs, waits 400 us, logs, and answers 77.
+    install(f.runtime, 4, Code().log(31u).delay(400u).log(32u).set_v0(77u));
+    f.start(starter);
+    f.run();
+    log_is({30u, 31u, 40u, 32u, 77u, 33u}, "a guest function called from the system may wait; another thread runs meanwhile");
+}
+
+// Interrupt handlers queued by a running thread run nested on it, before its system call returns.
+void interrupt_nested() {
+    Fixture f;
+    const SceUID starter = f.create("starter", 0, 20u);
+    const SceUID worker = f.create("worker", 1, 40u);
+    install(f.runtime, 0, Code().start(worker).exit(0u, false));
+    install(f.runtime, 1,
+            Code().queue_interrupt(slot_address(5), 1u).log(2u).delay(300u).queue_interrupt(slot_address(5), 3u).log(4u).stop());
+    // The handler logs, tries to wait (it cannot) and answers 9.
+    install(f.runtime, 5, Code().log(100u).try_wait().set_v0(9u));
+    f.start(starter);
+    f.run();
+    log_is({100u, 0x800201A7u, 0x1009u, 2u, 100u, 0x800201A7u, 0x1009u, 4u},
+           "interrupt handlers run nested on the thread, cannot wait, and the thread's registers survive");
+}
+
+// Interrupts that come while no thread runs go on a stack of their own.
+void interrupt_while_idle() {
+    Fixture f;
+    const SceUID starter = f.create("starter", 0, 20u);
+    const SceUID worker = f.create("worker", 1, 40u);
+    install(f.runtime, 0, Code().start(worker).exit(0u, false));
+    // The worker sleeps through the first vblank (16.7 ms); the hook queues the handler then.
+    install(f.runtime, 1, Code().log(1u).delay(40000u).log(7u).stop());
+    install(f.runtime, 5, Code().log(100u).try_wait().set_v0(9u));
+    bool queued = false;
+    kernel().add_vblank_hook([&] {
+        if (queued) return;
+        queued = true;
+        InterruptCall call{};
+        call.function = slot_address(5);
+        call.on_return = [](std::uint32_t result) { g_log.push_back(0x1000u + result); };
+        kernel().queue_interrupt(std::move(call));
+    });
+    f.start(starter);
+    f.run();
+    log_is({1u, 100u, 0x800201A7u, 0x1009u, 7u}, "an interrupt with every thread asleep runs, cannot wait, and the sleeper wakes on time");
+}
+
+// Terminating a waiting thread drops its host stack; a thread that exits deleting itself is gone.
+void terminate_and_delete() {
+    Fixture f;
+    const SceUID starter = f.create("starter", 0, 20u);
+    const SceUID sleeper = f.create("sleeper", 1, 40u);
+    const SceUID killer = f.create("killer", 2, 50u);
+    const SceUID closer = f.create("closer", 3, 70u);
+    install(f.runtime, 0, Code().start(sleeper).start(killer).start(closer).exit(0u, false));
+    install(f.runtime, 1, Code().log(1u).sleep().log(0xBADu));
+    install(f.runtime, 2, Code().log(2u).terminate(sleeper, true).log(3u).exit(0u, true));
+    install(f.runtime, 3, Code().log(4u).stop());
+    f.start(starter);
+    f.run();
+    log_is({1u, 2u, 3u, 4u}, "a terminated sleeper never runs again");
+    check(kernel().find_thread(sleeper) == nullptr, "terminate-and-delete removes the thread");
+    check(kernel().find_thread(killer) == nullptr, "a thread that exits deleting itself is gone once the scheduler is back");
+    check(kernel().find_thread(starter) != nullptr, "a thread that exits without deleting stays, dormant");
+}
+
+// Threads made, run to their end and deleted by themselves, in bulk: host stacks come and go.
+void many_short_lives() {
+    Fixture f;
+    const SceUID starter = f.create("starter", 0, 20u);
+    std::vector<SceUID> workers;
+    for (unsigned i = 0; i < 300u; ++i) workers.push_back(f.create("short", 1, 40u + (i & 7u)));
+    const SceUID last = f.create("last", 2, 70u);
+    Code spawn;
+    for (const SceUID worker : workers) spawn.start(worker);
+    spawn.exit(0u, false);
+    install(f.runtime, 0, spawn);
+    install(f.runtime, 1, Code().exit(0u, true));
+    install(f.runtime, 2, Code().log(7u).stop());
+    f.start(starter);
+    f.start(last);
+    f.run();
+    log_is({7u}, "300 threads that delete themselves leave the scheduler running; the last thread runs after them");
+    int alive = 0;
+    for (const SceUID worker : workers) alive += kernel().find_thread(worker) != nullptr ? 1 : 0;
+    check(alive == 0, "all 300 were deleted");
+}
+
+// A stop from three guest calls deep ends the run; nothing after it runs.
+void stop_from_deep_inside() {
+    Fixture f;
+    const SceUID starter = f.create("starter", 0, 20u);
+    install(f.runtime, 0, Code().log(1u).call_guest(slot_address(1), 0u).log(6u).exit(0u, false));
+    install(f.runtime, 1, Code().log(2u).call_guest(slot_address(2), 0u).log(5u));
+    install(f.runtime, 2, Code().log(3u).stop().log(4u));
+    f.start(starter);
+    f.run();
+    log_is({1u, 2u, 3u}, "a stop inside nested guest calls leaves at once");
+    check(f.runtime.stopped() && f.runtime.stop_reason() == "test finished", "the run ended with the guest's reason");
+}
+
+struct Scenario {
+    const char *name;
+    void (*run)();
+};
+
+const Scenario kScenarios[] = {
+    {"equal priorities", &equal_priorities},
+    {"pre-emption", &preemption_front_of_queue},
+    {"priority lowered", &priority_lowered},
+    {"wait inside a guest call", &wait_inside_guest_call},
+    {"interrupt nested", &interrupt_nested},
+    {"interrupt while idle", &interrupt_while_idle},
+    {"terminate and delete", &terminate_and_delete},
+    {"many short lives", &many_short_lives},
+    {"stop from deep inside", &stop_from_deep_inside},
+};
+constexpr std::size_t kScenarioCount = sizeof(kScenarios) / sizeof(kScenarios[0]);
+
+} // namespace
+
+int main(int argc, char **argv) {
+    if (argc > 1) {
+        const std::size_t index = static_cast<std::size_t>(std::strtoul(argv[1], nullptr, 10));
+        if (index >= kScenarioCount) {
+            std::printf("no scenario %zu (there are %zu)\n", index, kScenarioCount);
+            return 2;
+        }
+        std::printf("scenario %zu: %s\n", index, kScenarios[index].name);
+        kScenarios[index].run();
+        std::fflush(stdout);
+        return g_failures == 0 ? 0 : 1;
+    }
+    int failed = 0;
+    for (std::size_t i = 0; i < kScenarioCount; ++i) {
+        const std::string command = std::string("\"") + argv[0] + "\" " + std::to_string(i);
+        if (std::system(command.c_str()) != 0) ++failed;
+    }
+    std::printf("%s\n", failed == 0 ? "all kernel scenarios passed" : "kernel scenarios FAILED");
+    return failed == 0 ? 0 : 1;
+}
