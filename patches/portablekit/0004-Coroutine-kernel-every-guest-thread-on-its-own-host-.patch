+#include "kernel/kernel_platform.hpp"
+
+#if !defined(PORTABLEKIT_PLATFORM_CUSTOM)
+#include <chrono>
+#include <condition_variable>
+#include <mutex>
+#endif
+
+namespace portablekit {
+namespace {
+
+KernelPlatform g_platform{};
+
+#if !defined(PORTABLEKIT_PLATFORM_CUSTOM)
+// The default: the only place in the runtime that needs a host mutex.
+struct DefaultEvent {
+    std::mutex mutex;
+    std::condition_variable wake;
+    bool signalled = false;
+};
+
+DefaultEvent &default_event() {
+    static DefaultEvent event;
+    return event;
+}
+
+std::uint64_t default_monotonic_us() {
+    return static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(
+                                          std::chrono::steady_clock::now().time_since_epoch())
+                                          .count());
+}
+
+void default_wait_event(std::uint64_t timeout_us) {
+    DefaultEvent &event = default_event();
+    std::unique_lock<std::mutex> lock(event.mutex);
+    if (!event.signalled) event.wake.wait_for(lock, std::chrono::microseconds(timeout_us));
+    event.signalled = false;
+}
+
+void default_signal_event() {
+    DefaultEvent &event = default_event();
+    {
+        std::lock_guard<std::mutex> lock(event.mutex);
+        event.signalled = true;
+    }
+    event.wake.notify_all();
+}
+
+const bool g_default_installed = [] {
+    g_platform = KernelPlatform{&default_monotonic_us, &default_wait_event, &default_signal_event};
+    return true;
+}();
+#endif
+
+} // namespace
+
+void set_kernel_platform(const KernelPlatform &platform) noexcept { g_platform = platform; }
+const KernelPlatform &kernel_platform() noexcept { return g_platform; }
+void kernel_signal_event() noexcept {
+    if (g_platform.signal_event != nullptr) g_platform.signal_event();
+}
+
+} // namespace portablekit
