new file mode 100644
index 0000000..4f647a3
--- /dev/null
+++ b/host/kernel/kernel_platform.hpp
@@ -0,0 +1,34 @@
+#pragma once
+
+#include <cstdint>
+
+// What the kernel needs from the machine it runs on, and nothing else: a
+// monotonic clock, a way to sleep that another host thread can cut short, and the
+// call that cuts it short. The realtime clock (<prefix>_CLOCK=realtime) is built
+// on these three; the virtual clock does not use them at all.
+//
+// The desktop builds get a default made of <chrono>, a mutex and a condition
+// variable (kernel_platform.cpp). A platform layer that has its own primitives
+// (the Vita's sceKernelGetSystemTimeWide, an event flag with a timeout) defines
+// PORTABLEKIT_PLATFORM_CUSTOM when it compiles pk_runtime, so that file is left
+// out, and calls set_kernel_platform() before the kernel runs.
+namespace portablekit {
+
+struct KernelPlatform {
+    // Microseconds on a clock that never goes backwards. The origin is the
+    // platform's own: the kernel subtracts what it reads first.
+    std::uint64_t (*monotonic_us)() = nullptr;
+    // Sleeps for at most `timeout_us`; returns early once signal_event() ran
+    // since the last return (an event signalled before the sleep started is not lost).
+    void (*wait_event)(std::uint64_t timeout_us) = nullptr;
+    // Wakes wait_event(). Callable from any host thread.
+    void (*signal_event)() = nullptr;
+};
+
+void set_kernel_platform(const KernelPlatform &platform) noexcept;
+[[nodiscard]] const KernelPlatform &kernel_platform() noexcept;
+// For host threads that deliver something to the game (network data, audio): the
+// idle kernel wakes at once instead of at its next timer.
+void kernel_signal_event() noexcept;
+
+} // namespace portablekit
