+                                 static_cast<unsigned long long>(uploads), static_cast<double>(hd_movie_texture.convert_microseconds()) / 1000.0 / static_cast<double>(uploads),
+                                 static_cast<double>(hd_movie_texture.upload_microseconds()) / 1000.0 / static_cast<double>(uploads));
+            }
+        }
+        out.id = hd_movie_texture.id();
+        out.hd_movie = true;
+        out.opaque = true;
+        const float width = static_cast<float>(marker.width), height = static_cast<float>(marker.height);
+        if (call.through) {
+            out.scale[0] = 1.0f / width;
+            out.scale[1] = 1.0f / height;
