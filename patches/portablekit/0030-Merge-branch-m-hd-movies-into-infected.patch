+    bool resolve_hd_movie(const GuestMemory &memory, const DrawCall &call, TextureBinding &out) {
+        movie::HdMarker marker;
+        if (!movie::read_hd_marker(memory, call.texture.address, marker) || marker.width == 0u || marker.height == 0u) return false;
+        std::shared_ptr<const movie::HdPicture> picture = movie::HdFrameStore::instance().find(marker.session, marker.index);
+        if (!picture) return false;
+        if (picture != hd_movie_shown || hd_movie_texture.id() == 0u) {
+            flush();
+            if (hd_movie_texture.update(*picture) == 0u) return false;
+            cache.texture = ~0u;  // the update bound the texture itself
+            hd_movie_shown = picture;
+            static const bool trace = portablekit::env("TRACE_HDMOVIE") != nullptr;
+            if (trace) {
