diff --git a/host/gpu/gl/gl_hd_movie.cpp b/host/gpu/gl/gl_hd_movie.cpp
new file mode 100644
index 0000000..22b4d6e
--- /dev/null
+++ b/host/gpu/gl/gl_hd_movie.cpp
@@ -0,0 +1,93 @@
+#include "gl_hd_movie.hpp"
+
+#include <algorithm>
+
+namespace portablekit::gpu {
+
+namespace {
+inline std::uint8_t clamp8(int value) { return static_cast<std::uint8_t>(value < 0 ? 0 : (value > 255 ? 255 : value)); }
+} // namespace
+
+void hd_picture_to_rgba(const movie::Picture &picture, std::uint8_t *out) {
+    const std::uint32_t width = picture.width, height = picture.height;
+    const std::uint32_t chroma_width = (width + 1u) / 2u;
+    const bool full = picture.full_range;
+    // Q8 BT.601: limited range (Y 16..235, C 16..240) and full range (the movies of the disc are full range).
+    const int y_scale = full ? 256 : 298, y_bias = full ? 0 : 16;
+    const int r_v = full ? 359 : 409, g_u = full ? 88 : 100, g_v = full ? 183 : 208, b_u = full ? 454 : 516;
+    for (std::uint32_t row = 0; row < height; ++row) {
+        const std::uint8_t *luma = picture.y.data() + static_cast<std::size_t>(row) * width;
+        const std::uint8_t *cb = picture.cb.data() + static_cast<std::size_t>(row / 2u) * chroma_width;
+        const std::uint8_t *cr = picture.cr.data() + static_cast<std::size_t>(row / 2u) * chroma_width;
+        std::uint8_t *pixel = out + static_cast<std::size_t>(row) * width * 4u;
+        for (std::uint32_t x = 0; x < width; ++x) {
+            const int u = cb[x >> 1u] - 128, v = cr[x >> 1u] - 128;
+            const int c = y_scale * (luma[x] - y_bias) + 128;
+            pixel[0] = clamp8((c + r_v * v) >> 8);
+            pixel[1] = clamp8((c - g_u * u - g_v * v) >> 8);
+            pixel[2] = clamp8((c + b_u * u) >> 8);
+            pixel[3] = 255u;
+            pixel += 4;
+        }
+    }
+}
+
+namespace {
+HdNativeBinder *g_binder = nullptr;
+} // namespace
+
+void set_hd_native_binder(HdNativeBinder *binder) { g_binder = binder; }
+
+GLuint GlHdMovieTexture::update(const movie::HdPicture &picture) {
+    if (picture.native) {
+        if (g_binder == nullptr || picture.width == 0u || picture.height == 0u) return 0u;
+        const std::uint64_t begin = movie::thread_cpu_us();
+        const GLuint texture = g_binder->texture_for(picture);
+        if (texture == 0u) return 0u;
+        release();  // an own texture of an earlier software picture
+        texture_ = texture;
+        native_ = true;
+        width_ = picture.width;
+        height_ = picture.height;
+        upload_us_ += movie::thread_cpu_us() - begin;
+        ++uploads_;
+        glBindTexture(GL_TEXTURE_2D, texture_);
+        return texture_;
+    }
+    if (picture.yuv.y.empty() || picture.width == 0u || picture.height == 0u) return 0u;
+    if (native_) {
+        texture_ = 0u;
+        native_ = false;
+    }
+    if (texture_ == 0u || width_ != picture.width || height_ != picture.height) {
+        release();
+        glGenTextures(1, &texture_);
+        glBindTexture(GL_TEXTURE_2D, texture_);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, static_cast<GLsizei>(picture.width), static_cast<GLsizei>(picture.height), 0, GL_RGBA,
+                     GL_UNSIGNED_BYTE, nullptr);
+        width_ = picture.width;
+        height_ = picture.height;
+    } else {
+        glBindTexture(GL_TEXTURE_2D, texture_);
+    }
+    const std::uint64_t begin = movie::thread_cpu_us();
+    rgba_.resize(static_cast<std::size_t>(width_) * height_ * 4u);
+    hd_picture_to_rgba(picture.yuv, rgba_.data());
+    const std::uint64_t converted = movie::thread_cpu_us();
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+    glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, static_cast<GLsizei>(width_), static_cast<GLsizei>(height_), GL_RGBA, GL_UNSIGNED_BYTE,
+                    rgba_.data());
+    convert_us_ += converted - begin;
+    upload_us_ += movie::thread_cpu_us() - converted;
+    ++uploads_;
+    return texture_;
+}
+
+void GlHdMovieTexture::release() {
+    if (texture_ != 0u && !native_) glDeleteTextures(1, &texture_);
+    texture_ = 0u;
+    native_ = false;
+    width_ = height_ = 0u;
+}
+
+} // namespace portablekit::gpu
diff --git a/host/gpu/gl/gl_hd_movie.hpp b/host/gpu/gl/gl_hd_movie.hpp
new file mode 100644
index 0000000..82f9e29
--- /dev/null
+++ b/host/gpu/gl/gl_hd_movie.hpp
@@ -0,0 +1,55 @@
+#pragma once
+
+// The GL side of the HD replacement movies (host/movie/hd_movie.hpp): one texture that always holds the replacement picture
+// the game is showing, and the conversion that fills it.
+//
+// Desktop (and any platform without a video decoder of its own that hands over GPU frames): the picture is planar 4:2:0 in
+// system memory; it is converted to RGBA on the CPU and uploaded. A platform whose HdSource delivers a native frame
+// (HdPicture::native) registers an HdNativeBinder that makes a GL texture sample it (on the Vita the texture unit does the
+// conversion; vita/app/src/app_hd_movie.cpp).
+
+#include "../../movie/hd_movie.hpp"
+#include "gl_platform.h"
+
+#include <cstdint>
+#include <vector>
+
+namespace portablekit::gpu {
+
+// 4:2:0 planar to 32-bit RGBA (R first), BT.601 as the original movies are shown; `picture.full_range` selects the range.
+// `out` holds width * height * 4 bytes.
+void hd_picture_to_rgba(const movie::Picture &picture, std::uint8_t *out);
+
+// Makes the frame of a native HdPicture sampleable. Called on the render thread (GL calls are allowed).
+class HdNativeBinder {
+public:
+    virtual ~HdNativeBinder() = default;
+    // The GL texture that samples `picture.native` as a 2D texture of picture.width x picture.height; 0 when it cannot. The
+    // binder owns the texture; the same frame may be asked for again and again.
+    virtual GLuint texture_for(const movie::HdPicture &picture) = 0;
+};
+// Registers the binder of this platform (null: none; a native picture then cannot be shown and the original movie plays).
+void set_hd_native_binder(HdNativeBinder *binder);
+
+class GlHdMovieTexture {
+public:
+    ~GlHdMovieTexture() { release(); }
+    // Makes `picture` the content of the texture. Returns the texture name, 0 when it cannot be shown. The caller has
+    // flushed the draws that use the old content, and treats the texture binding as changed.
+    GLuint update(const movie::HdPicture &picture);
+    void release();
+    [[nodiscard]] GLuint id() const noexcept { return texture_; }
+    [[nodiscard]] std::uint64_t uploads() const noexcept { return uploads_; }
+    // CPU time of the render thread in the conversion and in the upload call, in microseconds, over all uploads.
+    [[nodiscard]] std::uint64_t convert_microseconds() const noexcept { return convert_us_; }
+    [[nodiscard]] std::uint64_t upload_microseconds() const noexcept { return upload_us_; }
+
+private:
+    GLuint texture_{};
+    bool native_{};  // texture_ belongs to the HdNativeBinder
+    std::uint32_t width_{}, height_{};
+    std::vector<std::uint8_t> rgba_;
+    std::uint64_t uploads_{}, convert_us_{}, upload_us_{};
+};
+
+} // namespace portablekit::gpu
