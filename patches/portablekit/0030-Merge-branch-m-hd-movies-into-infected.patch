diff --git a/host/movie/hd_frame_store.cpp b/host/movie/hd_frame_store.cpp
new file mode 100644
index 0000000..40de9df
--- /dev/null
+++ b/host/movie/hd_frame_store.cpp
@@ -0,0 +1,95 @@
+// The part of the HD movie module the renderer needs: the store the movie player publishes pictures into and the marker the
+// player leaves in the picture buffer (see movie/hd_movie.hpp).
+#include "movie/hd_movie.hpp"
+
+#include "psprecomp/guest_memory.hpp"
+
+#include <chrono>
+#if defined(__linux__)
+#include <time.h>
+#endif
+
+namespace portablekit::movie {
+
+std::uint64_t thread_cpu_us() noexcept {
+#if defined(__linux__)
+    timespec now{};
+    if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &now) == 0) return static_cast<std::uint64_t>(now.tv_sec) * 1000000u + static_cast<std::uint64_t>(now.tv_nsec) / 1000u;
+#endif
+    return static_cast<std::uint64_t>(
+        std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+namespace {
+
+constexpr std::uint32_t kMagicA = 0x564D4448u;  // "HDMV" read as a little-endian word
+constexpr std::uint32_t kMagicB = 0x49564F4Du;  // "MOVI"
+constexpr std::uint32_t kCheckKey = 0xA5C3E1F7u;
+
+} // namespace
+
+// ---- the frame store -----------------------------------------------------------------------------------------------------
+
+HdFrameStore &HdFrameStore::instance() {
+    static HdFrameStore store;
+    return store;
+}
+
+void HdFrameStore::publish(std::uint32_t session, std::uint64_t index, std::shared_ptr<const HdPicture> picture) {
+    const std::lock_guard<std::mutex> lock(mutex_);
+    Slot *target = &slots_[0];
+    for (Slot &slot : slots_) {
+        if (slot.session == session && slot.index == index && slot.picture) {
+            target = &slot;
+            break;
+        }
+        if (!slot.picture || slot.serial < target->serial) target = &slot;
+    }
+    target->session = session;
+    target->index = index;
+    target->serial = ++serial_;
+    target->picture = std::move(picture);
+    published_.store(true, std::memory_order_relaxed);
+}
+
+std::shared_ptr<const HdPicture> HdFrameStore::find(std::uint32_t session, std::uint64_t index) const {
+    const std::lock_guard<std::mutex> lock(mutex_);
+    const Slot *newest = nullptr;
+    for (const Slot &slot : slots_) {
+        if (!slot.picture || slot.session != session) continue;
+        if (slot.index == index) return slot.picture;
+        if (newest == nullptr || slot.serial > newest->serial) newest = &slot;
+    }
+    return newest != nullptr ? newest->picture : nullptr;
+}
+
+void HdFrameStore::clear() {
+    const std::lock_guard<std::mutex> lock(mutex_);
+    for (Slot &slot : slots_) slot = Slot{};
+}
+
+// ---- the marker ----------------------------------------------------------------------------------------------------------
+
+void write_hd_marker(psprecomp::GuestMemory &memory, std::uint32_t address, const HdMarker &marker) {
+    memory.store32(address + 0u, kMagicA);
+    memory.store32(address + 4u, kMagicB);
+    memory.store32(address + 8u, marker.session);
+    memory.store32(address + 12u, marker.index);
+    memory.store32(address + 16u, marker.width | marker.height << 16u);
+    memory.store32(address + 20u, marker.session ^ marker.index ^ kCheckKey);
+    memory.store32(address + 24u, 0u);
+    memory.store32(address + 28u, 0u);
+}
+
+bool read_hd_marker(const psprecomp::GuestMemory &memory, std::uint32_t address, HdMarker &marker) {
+    if (!memory.contains(address, kHdMarkerBytes)) return false;
+    if (memory.load32(address) != kMagicA || memory.load32(address + 4u) != kMagicB) return false;
+    marker.session = memory.load32(address + 8u);
+    marker.index = memory.load32(address + 12u);
+    const std::uint32_t size = memory.load32(address + 16u);
+    marker.width = size & 0xFFFFu;
+    marker.height = size >> 16u;
+    return memory.load32(address + 20u) == (marker.session ^ marker.index ^ kCheckKey);
+}
+
+} // namespace portablekit::movie
diff --git a/host/movie/hd_movie.cpp b/host/movie/hd_movie.cpp
new file mode 100644
index 0000000..f0afcf5
--- /dev/null
+++ b/host/movie/hd_movie.cpp
@@ -0,0 +1,327 @@
+#include "movie/hd_movie.hpp"
+
+#include "movie/psmf_header.hpp"
+#include "profile.hpp"
+
+#include "psprecomp/guest_memory.hpp"
+
+#include <algorithm>
+#include <atomic>
+#include <cctype>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <iostream>
+#include <sstream>
+
+namespace portablekit::movie {
+namespace {
+
+bool trace_enabled() {
+    static const bool enabled = portablekit::env("TRACE_HDMOVIE") != nullptr;
+    return enabled;
+}
+
+std::string lower(std::string text) {
+    for (char &c : text) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+    return text;
+}
+
+bool file_exists(const std::string &path) {
+    std::FILE *file = std::fopen(path.c_str(), "rb");
+    if (file == nullptr) return false;
+    std::fclose(file);
+    return true;
+}
+
+bool read_text_file(const std::string &path, std::string &out) {
+    std::FILE *file = std::fopen(path.c_str(), "rb");
+    if (file == nullptr) return false;
+    char buffer[4096];
+    std::size_t count;
+    out.clear();
+    while ((count = std::fread(buffer, 1, sizeof(buffer), file)) != 0u) out.append(buffer, count);
+    std::fclose(file);
+    return true;
+}
+
+std::string join(const std::string &directory, const std::string &name) {
+    if (directory.empty()) return name;
+    const char last = directory.back();
+    return last == '/' || last == ':' || last == '\\' ? directory + name : directory + "/" + name;
+}
+
+// The live sessions, for the pause listener.
+std::mutex &session_mutex() {
+    static std::mutex mutex;
+    return mutex;
+}
+std::vector<HdSession *> &live_sessions() {
+    static std::vector<HdSession *> sessions;
+    return sessions;
+}
+
+} // namespace
+
+// ---- helpers -------------------------------------------------------------------------------------------------------------
+
+std::uint32_t crc32(std::span<const std::uint8_t> bytes) noexcept {
+    static const auto table = [] {
+        struct Table {
+            std::uint32_t entry[256];
+        } t{};
+        for (std::uint32_t i = 0; i < 256u; ++i) {
+            std::uint32_t c = i;
+            for (int k = 0; k < 8; ++k) c = (c & 1u) != 0u ? 0xEDB88320u ^ (c >> 1u) : c >> 1u;
+            t.entry[i] = c;
+        }
+        return t;
+    }();
+    std::uint32_t crc = 0xFFFFFFFFu;
+    for (const std::uint8_t byte : bytes) crc = table.entry[(crc ^ byte) & 0xFFu] ^ (crc >> 8u);
+    return ~crc;
+}
+
+bool parse_psmf_timing(std::span<const std::uint8_t> header, PsmfTiming &timing) {
+    const auto parsed = parse_psmf_header(header);
+    if (!parsed || parsed->end_time <= parsed->start_time) return false;
+    timing.start = parsed->start_time;
+    timing.end = parsed->end_time;
+    timing.width = timing.height = 0u;
+    for (const PsmfStream &stream : parsed->streams) {
+        if (stream.type() == 0) {
+            timing.width = static_cast<std::uint32_t>(stream.info[0]) * 16u;
+            timing.height = static_cast<std::uint32_t>(stream.info[1]) * 16u;
+            break;
+        }
+    }
+    return timing.frames() != 0u && timing.width != 0u && timing.height != 0u;
+}
+
+bool is_idr_unit(std::span<const std::uint8_t> unit) noexcept {
+    for (std::size_t i = 0; i + 3u < unit.size(); ++i) {
+        if (unit[i] == 0u && unit[i + 1u] == 0u && unit[i + 2u] == 1u) {
+            if ((unit[i + 3u] & 0x1Fu) == 5u) return true;
+            i += 2u;
+        }
+    }
+    return false;
+}
+
+// ---- the library ---------------------------------------------------------------------------------------------------------
+
+HdLibrary &HdLibrary::instance() {
+    static HdLibrary library;
+    return library;
+}
+
+void HdLibrary::configure(const std::string &root) {
+    const std::lock_guard<std::mutex> lock(mutex_);
+    root_ = join(root, "movies_hd");
+    movies_.clear();
+    std::string text;
+    if (!read_text_file(join(root_, "index.txt"), text)) return;
+    std::istringstream lines(text);
+    std::string line;
+    while (std::getline(lines, line)) {
+        if (line.empty() || line[0] == '#') continue;
+        std::istringstream fields(line);
+        HdMovie movie;
+        std::string crc;
+        std::string size;
+        if (!(fields >> movie.name >> movie.frames >> crc)) continue;
+        movie.crc = static_cast<std::uint32_t>(std::strtoul(crc.c_str(), nullptr, 16));
+        movie.path = join(root_, movie.name + ".mp4");
+        if (movie.frames == 0u || !file_exists(movie.path)) continue;  // not installed: the original plays
+        movies_.push_back(std::move(movie));
+    }
+    if (trace_enabled()) std::cerr << "[hdmovie] " << movies_.size() << " replacement(s) in " << root_ << "\n";
+}
+
+const HdMovie *HdLibrary::identify(std::span<const std::uint8_t> header, std::string *why) const {
+    const std::lock_guard<std::mutex> lock(mutex_);
+    const auto reject = [why](const char *text) -> const HdMovie * {
+        if (why != nullptr) *why = text;
+        return nullptr;
+    };
+    if (movies_.empty() && root_.empty()) return reject("no replacement movies installed");
+    if (header.size() < kPsmfHeaderBytes) return reject("short header");
+    PsmfTiming timing;
+    if (!parse_psmf_timing(header.first(kPsmfHeaderBytes), timing)) return reject("not a PSMF header");
+    const std::uint32_t crc = crc32(header.first(kPsmfHeaderBytes));
+    for (const HdMovie &movie : movies_) {
+        if (movie.crc != crc) continue;
+        if (movie.frames != timing.frames()) return reject("the index lists another picture count for this header");
+        return &movie;
+    }
+    // Not in the index: the movie the game opened last, if a file of that name is there and the count agrees.
+    std::string stem = lower(last_opened_);
+    if (stem.empty()) return reject("unknown header and no movie file name");
+    for (const HdMovie &movie : movies_)
+        if (lower(movie.name) == stem && movie.frames == timing.frames()) return &movie;
+    return reject("no replacement for this movie");
+}
+
+void HdLibrary::note_file_opened(const std::string &path) {
+    // Only the name of a movie: "disc0:/PSP_GAME/USRDIR/IMAGE/movies/intro.pmf" -> "intro".
+    const std::size_t dot = path.rfind('.');
+    if (dot == std::string::npos || dot + 4u != path.size()) return;
+    const std::string extension = lower(path.substr(dot + 1u));
+    if (extension != "pmf") return;
+    std::size_t begin = path.find_last_of("/:\\");
+    begin = begin == std::string::npos ? 0u : begin + 1u;
+    const std::lock_guard<std::mutex> lock(mutex_);
+    last_opened_ = path.substr(begin, dot - begin);
+}
+
+std::string HdLibrary::last_opened() const {
+    const std::lock_guard<std::mutex> lock(mutex_);
+    return last_opened_;
+}
+
+// ---- a session -----------------------------------------------------------------------------------------------------------
+
+HdSession::HdSession(const HdMovie &movie, const PsmfTiming &timing) : movie_(movie), timing_(timing) {
+    static std::atomic<std::uint32_t> next_id{1u};
+    id_ = next_id.fetch_add(1u);
+    const std::lock_guard<std::mutex> lock(session_mutex());
+    live_sessions().push_back(this);
+    if (trace_enabled()) std::cerr << "[hdmovie] session " << id_ << ": " << movie_.name << ", " << movie_.frames << " pictures\n";
+}
+
+HdSession::~HdSession() {
+    {
+        const std::lock_guard<std::mutex> lock(session_mutex());
+        auto &sessions = live_sessions();
+        sessions.erase(std::remove(sessions.begin(), sessions.end(), this), sessions.end());
+    }
+    if (trace_enabled() || shown_ != 0u) std::cerr << "[hdmovie] session " << id_ << " ended: " << summary() << "\n";
+    if (source_) source_->close();
+}
+
+std::string HdSession::summary() const {
+    std::ostringstream text;
+    text << movie_.name << ": " << shown_ << " replacement pictures, " << original_ << " original";
+    if (source_) {
+        text << ", " << source_->pictures_decoded() << " decoded, " << source_->seeks() << " seek(s)";
+        if (source_->pictures_decoded() != 0u && source_->decode_cpu_us() != 0u)
+            text << ", decode " << static_cast<double>(source_->decode_cpu_us()) / 1000.0 / static_cast<double>(source_->pictures_decoded())
+                 << " ms CPU a picture";
+    }
+    return text.str();
+}
+
+bool HdSession::ensure_source() {
+    if (source_) return true;
+    if (source_failed_) return false;
+    source_ = make_hd_source();
+    if (!source_ || !source_->open(movie_.path)) {
+        std::cerr << "[hdmovie] " << movie_.name << ": " << (source_ ? source_->error() : std::string("no decoder in this build"))
+                  << "; the original movie plays\n";
+        source_.reset();
+        source_failed_ = true;
+        return false;
+    }
+    if (source_->frame_count() != movie_.frames) {
+        std::cerr << "[hdmovie] " << movie_.name << ": the replacement has " << source_->frame_count() << " pictures, the movie "
+                  << movie_.frames << "; the original movie plays\n";
+        source_.reset();
+        source_failed_ = true;
+        return false;
+    }
+    if (paused_) source_->pause();
+    return true;
+}
+
+void HdSession::remember(std::span<const std::uint8_t> unit) {
+    if (is_idr_unit(unit)) {
+        history_.clear();
+        history_bytes_ = 0u;
+        history_lost_ = false;
+    }
+    // A movie whose pictures depend on far more than a second of earlier ones is not replayed: past this the original
+    // decoder starts again at the next IDR picture after a switch.
+    if (history_.size() >= 240u || history_bytes_ + unit.size() > 8u * 1024u * 1024u) {
+        history_.clear();
+        history_bytes_ = 0u;
+        history_lost_ = true;
+        return;
+    }
+    history_.emplace_back(unit.begin(), unit.end());
+    history_bytes_ += unit.size();
+}
+
+bool HdSession::show(psprecomp::GuestMemory &memory, std::uint32_t destination, std::uint32_t stride, std::span<const std::uint8_t> unit,
+                     std::int64_t pts, bool want) {
+    const std::int64_t relative = pts - static_cast<std::int64_t>(timing_.start);
+    const std::int64_t index = (relative + kTicksPerPicture / 2) / kTicksPerPicture;
+    const bool in_range = relative >= -kTicksPerPicture / 2 && index >= 0 && index < static_cast<std::int64_t>(movie_.frames);
+    std::shared_ptr<const HdPicture> picture;
+    if (want && in_range && ensure_source()) picture = source_->frame_for(index * kTicksPerPicture);
+    if (!picture) {
+        // The original decoder shows this one. If the replacement showed the units before it, it has not seen them.
+        if (!history_.empty()) {
+            replay_ = std::move(history_);
+            history_.clear();
+            history_bytes_ = 0u;
+        }
+        history_lost_ = false;
+        blackened_.clear();
+        ++original_;
+        if (last_state_ == 1) ++switches_;
+        if (trace_enabled() && want && in_range && !source_failed_ && last_state_ != 2)
+            std::cerr << "[hdmovie] session " << id_ << ": no replacement picture " << index << ", the original shows it\n";
+        last_state_ = 2;
+        return false;
+    }
+    remember(unit);
+    HdFrameStore::instance().publish(id_, static_cast<std::uint64_t>(index), picture);
+    // Black everywhere except the marker: if a renderer did not understand it, the movie would be dark, not garbage.
+    if (std::find(blackened_.begin(), blackened_.end(), destination) == blackened_.end()) {
+        const std::uint32_t rows = timing_.height;
+        const std::size_t bytes = static_cast<std::size_t>(stride) * rows * 4u;
+        if (std::uint8_t *pixels = memory.raw_pointer(destination, bytes)) {
+            auto *words = reinterpret_cast<std::uint32_t *>(pixels);
+            std::fill(words, words + static_cast<std::size_t>(stride) * rows, 0xFF000000u);
+        }
+        if (blackened_.size() < 16u) blackened_.push_back(destination);
+    }
+    write_hd_marker(memory, destination, HdMarker{id_, static_cast<std::uint32_t>(index), timing_.width, timing_.height});
+    ++shown_;
+    if (last_state_ == 2) ++switches_;
+    last_state_ = 1;
+    return true;
+}
+
+std::vector<std::vector<std::uint8_t>> HdSession::take_replay() {
+    std::vector<std::vector<std::uint8_t>> units;
+    units.swap(replay_);
+    return units;
+}
+
+void HdSession::restart() {
+    history_.clear();
+    history_bytes_ = 0u;
+    history_lost_ = false;
+    replay_.clear();
+}
+
+void HdSession::pause() {
+    paused_ = true;
+    if (source_) source_->pause();
+}
+
+void HdSession::resume() {
+    paused_ = false;
+    if (source_) source_->resume();
+}
+
+void HdSession::pause_all(bool paused) {
+    const std::lock_guard<std::mutex> lock(session_mutex());
+    for (HdSession *session : live_sessions()) {
+        if (paused) session->pause();
+        else session->resume();
+    }
+}
+
+} // namespace portablekit::movie
