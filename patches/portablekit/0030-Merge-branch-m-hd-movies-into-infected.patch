+// ---- HD replacement movies (gfx.hd_movies, movie/hd_movie.hpp) ------------------------------------------------------------
+
+// Looks for the replacement of the movie whose PSMF header the game just showed the library. No replacement installed, or
+// none for this movie: the session stays empty and the original plays as before.
+void attach_hd_session(MpegState &state, std::span<const std::uint8_t> header) {
+    state.hd.reset();
+    movie::HdLibrary &library = movie::HdLibrary::instance();
+    if (!library.installed()) return;
+    std::string why;
+    const movie::HdMovie *replacement = library.identify(header, &why);
+    movie::PsmfTiming timing;
+    if (replacement == nullptr || !movie::parse_psmf_timing(header, timing)) {
+        if (portablekit::env("TRACE_HDMOVIE") != nullptr) std::cerr << "[hdmovie] no replacement: " << why << "\n";
+        return;
+    }
+    state.hd = std::make_unique<movie::HdSession>(*replacement, timing);
+}
+
+// Whether the replacement should stand in for the decoder now: the setting is on, the renderer shows replacements, and the
+// game decodes into main memory as 32-bit pixels (a picture in VRAM goes to the renderer by another way).
+bool hd_movies_wanted(const MpegState &state, std::uint32_t destination, std::uint32_t stride) {
+    if (!port::hd_movies() || state.pixel_mode != 3u || stride == 0u) return false;
+    if ((destination & 0x1F000000u) == 0x04000000u) return false;
+    const gpu::Renderer *renderer = media_renderer();
+    return renderer != nullptr && renderer->available() && renderer->supports_hd_movies();
+}
