+} // namespace
+
+int main() {
+    const fs::path dir = fs::temp_directory_path() / ("hd_movie_tests_" + std::to_string(static_cast<unsigned long long>(std::hash<std::string>{}(__FILE__))));
+    fs::remove_all(dir);
+    fs::create_directories(dir);
+    test_mp4(dir);
+    test_library(dir);
+    test_store_and_marker();
+    test_session(dir);
+    fs::remove_all(dir);
+    if (g_failures != 0) std::printf("%d failed\n", g_failures);
+    return g_failures == 0 ? 0 : 1;
+}
