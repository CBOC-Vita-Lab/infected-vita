+// Infected port (patch 0007): what the renderer told vitaGL about the next scene (vglSceneHint) and the options (vglSceneOptions).
+static GLboolean scene_depth_trim = GL_TRUE;
+GLboolean scene_mask_skip = GL_FALSE;
+static uint32_t scene_hints = 0;
+void vglSceneOptions(GLboolean depth_trim, GLboolean mask_skip) {
+	scene_depth_trim = depth_trim;
+	scene_mask_skip = mask_skip;
+}
+void vglSceneHint(uint32_t hints) {
+	scene_hints = hints;
+}
