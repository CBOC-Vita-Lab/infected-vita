+// Infected port (patch 0005): what vitaGL counts, for the port's status line. Every field is a 32-bit count since the last
+// reset (the *_us ones are microseconds); the port's glp::VitaglStats mirrors this struct field for field. Not thread safe:
+// read it from the thread that draws.
+typedef struct vgl_stats {
+	uint32_t scene_begins_display, scene_begins_fbo; // scenes begun on the display, on a framebuffer object (patch 0007)
+	uint32_t scene_begin_retries, scene_begin_failures; // sceGxmBeginScene refused: tried again, given up (patch 0006)
+	uint32_t scene_begin_us, scene_begin_us_max; // time in scene_reset from after the old scene's end to the end of the begin (patch 0007)
+	uint32_t mask_quads_begin, mask_quads_scissor; // mask-update draws of the scissor test: at a scene's begin, at a scissor change (patch 0007)
+	uint32_t depth_buffers_made; // depth surfaces allocated for framebuffer objects (patch 0007)
+	uint32_t depth_loads; // scenes begun with the depth force-loaded (a STORE_DEPTH_STENCIL build only) (patch 0007)
+	uint32_t depth_loads_trimmed; // scenes the renderer's hint spared the depth load (or that never had one) (patch 0007)
+	uint32_t mask_quads_skipped; // mask-update draws left out by vglSceneOptions (patch 0007)
+	uint32_t shader_cache_hits, shader_compiles, shader_compile_failures; // shaders read from the cache, compiled, failed to compile
+	uint32_t alloc_failures; // GPU allocations that failed their first try
+	uint32_t gc_pauses, gc_pause_us, gc_pause_us_max; // waits for the garbage collector after a failed allocation
+} vgl_stats;
+void vglGetStats(vgl_stats *out, GLboolean reset);
+
+// Infected port (patch 0005): after a GPU allocation failed, vitaGL asks its garbage collector to free memory and waited a full
+// second (sceKernelDelayThread(1000000)) for it, once per attempt and up to four attempts: a freeze of one to four seconds the
+// first time memory ran out. With a limit in milliseconds it waits for the collector's cycle to finish and no longer than that
+// (the cycle frees a handful of buffers, a fraction of a millisecond when it is not behind). 0 keeps the second.
+void vglSetGcPauseMs(uint32_t ms);
