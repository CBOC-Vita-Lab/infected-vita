@@ -155,6 +155,52 @@ static inline __attribute__((always_inline)) uint32_t vgl_cache_old_textures(siz
 #endif
 
 int unsafe_allocator_counter = 0;
+
+// Infected port (patch 0005): the counters (vglGetStats) and the bound on the wait for the garbage collector.
+vgl_stats vgl_stats_cur;
+void vglGetStats(vgl_stats *out, GLboolean reset) {
+	*out = vgl_stats_cur;
+	if (reset)
+		sceClibMemset(&vgl_stats_cur, 0, sizeof(vgl_stats_cur));
+}
+
+static uint32_t vgl_gc_pause_ms = 0;
+void vglSetGcPauseMs(uint32_t ms) {
+	vgl_gc_pause_ms = ms;
+}
+
+// Waits for the cycle the caller just asked the collector for (gc_mutex[0] signalled; `idle_count` is what the pull semaphore
+// counted before the caller took its slot: the collector gives the slot back when the cycle is done). With no limit set it sleeps
+// the second vitaGL always slept; with one it looks every millisecond and leaves as soon as the slot is back or the limit is up.
+static void vgl_wait_for_gc_cycle(int idle_count) {
+	uint64_t start = sceKernelGetSystemTimeWide();
+	if (vgl_gc_pause_ms == 0) {
+		sceKernelDelayThread(1000000);
+	} else {
+		uint64_t limit = (uint64_t)vgl_gc_pause_ms * 1000;
+		for (;;) {
+			sceKernelDelayThread(1000);
+			SceKernelSemaInfo info;
+			info.size = sizeof(info);
+			if (sceKernelGetSemaInfo(gc_mutex[1], &info) == 0 && info.currentCount >= idle_count)
+				break;
+			if (sceKernelGetSystemTimeWide() - start >= limit)
+				break;
+		}
+	}
+	uint32_t waited = (uint32_t)(sceKernelGetSystemTimeWide() - start);
+	vgl_stats_cur.gc_pauses++;
+	vgl_stats_cur.gc_pause_us += waited;
+	if (waited > vgl_stats_cur.gc_pause_us_max)
+		vgl_stats_cur.gc_pause_us_max = waited;
+}
+
+static int vgl_gc_idle_count(void) {
+	SceKernelSemaInfo info;
+	info.size = sizeof(info);
+	return sceKernelGetSemaInfo(gc_mutex[1], &info) == 0 ? info.currentCount : 0;
+}
