+// Infected port (patch 0003): the GXM state the custom-shader draws set, so that vglSkipRedundantState can leave out a
+// call that would set it to what it already is. Valid while vgl_gxm_state_epoch is the value it was recorded at.
+uint32_t vgl_gxm_state_epoch = 1;
+static GLboolean rs_enabled = GL_FALSE;
+static uint32_t rs_epoch = 0;
+static const SceGxmVertexProgram *rs_vprog = NULL;
+static const SceGxmFragmentProgram *rs_fprog = NULL;
+#define RS_FRAG_TEXTURES 4
+static SceGxmTexture rs_ftex[RS_FRAG_TEXTURES];
+static uint32_t rs_ftex_valid = 0;
+static const void *rs_stream[VERTEX_ATTRIBS_NUM];
+static uint32_t rs_stream_valid = 0;
+
+void vglSkipRedundantState(GLboolean enable) {
+	rs_enabled = enable;
+	vgl_gxm_state_touched();
+}
+
+static inline __attribute__((always_inline)) void rs_refresh(void) {
+	if (rs_epoch != vgl_gxm_state_epoch) {
+		rs_epoch = vgl_gxm_state_epoch;
+		rs_vprog = NULL;
+		rs_fprog = NULL;
+		rs_ftex_valid = 0;
+		rs_stream_valid = 0;
+	}
+}
+
+static inline __attribute__((always_inline)) void rs_set_vertex_program(const SceGxmVertexProgram *prog) {
+	if (rs_enabled) {
+		rs_refresh();
+		if (prog == rs_vprog)
+			return;
+		rs_vprog = prog;
+	}
+	sceGxmSetVertexProgram(gxm_context, prog);
+}
+
+static inline __attribute__((always_inline)) void rs_set_fragment_program(const SceGxmFragmentProgram *prog) {
+	if (rs_enabled) {
+		rs_refresh();
+		if (prog == rs_fprog)
+			return;
+		rs_fprog = prog;
+	}
+	sceGxmSetFragmentProgram(gxm_context, prog);
+}
+
+static inline __attribute__((always_inline)) void rs_set_fragment_texture(uint32_t unit, const SceGxmTexture *tex) {
+	if (rs_enabled && unit < RS_FRAG_TEXTURES) {
+		rs_refresh();
+		const uint32_t bit = 1u << unit;
+		if ((rs_ftex_valid & bit) && __builtin_memcmp(&rs_ftex[unit], tex, sizeof(SceGxmTexture)) == 0)
+			return;
+		rs_ftex[unit] = *tex;
+		rs_ftex_valid |= bit;
+	}
+	sceGxmSetFragmentTexture(gxm_context, unit, tex);
+}
+
+static inline __attribute__((always_inline)) void rs_set_vertex_stream(uint32_t index, const void *ptr) {
+	if (rs_enabled && index < VERTEX_ATTRIBS_NUM) {
+		rs_refresh();
+		const uint32_t bit = 1u << index;
+		if ((rs_stream_valid & bit) && rs_stream[index] == ptr)
+			return;
+		rs_stream[index] = ptr;
+		rs_stream_valid |= bit;
+	}
+	sceGxmSetVertexStream(gxm_context, index, ptr);
+}
